     .shadow-multiple {\n            box-shadow:\n                3px 3px 5px rgba(0,0,0,0.3),\n                -3px -3px 5px rgba(255,255,255,0.8);\n        }\n\n        /* Color shadow */\n        .shadow-color {\n            box-shadow: 8px 8px 0 blue;\n        }\n\n        /* Soft ambient shadow */\n        .shadow-ambient {\n            box-shadow: 0 10px 40px rgba(0,0,0,0.2);\n        }\n\n        /* Sharp shadow (no blur) */\n        .shadow-sharp {\n            box-shadow: 5px 5px 0 black;\n        }\n\n        /* Large blur */\n        .shadow-blur {\n            box-shadow: 0 0 30px 5px rgba(0,0,200,0.5);\n        }\n\n        /* Rounded corners with shadow */\n        .shadow-rounded {\n            border-radius: 20px;\n            box-shadow: 5px 5px 15px rgba(0,0,0,0.3);\n        }\n\n        /* Negative spread */\n        .shadow-negative-spread {\n            box-shadow: 0 10px 10px -5px rgba(0,0,0,0.5);\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":8,"y":8,"width":1184,"height":439.88},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"h1","layout":{"x":48,"y":69.44,"width":1104,"height":37},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Box Shadow Test","layout":{"rects":[{"x":48,"y":69.44,"width":264.33,"height":36}]}}]},{"nodeType":"element","tag":"div","layout":{"x":48,"y":127.88,"width":1104,"height":280},"computed":{"display":"flex","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":48,"y":127.88,"width":170,"height":120},"computed":{"display":"flex","textAlign":"center"},"children":[{"nodeType":"text","text":"Simple Shadow","layout":{"rects":[{"x":91.3,"y":173.88,"width":83.39,"height":14}]}},{"nodeType":"element","tag":"br","layout":{"x":174.69,"y":173.88,"width":0,"height":14},"computed":{"display":"block","textAlign":"center"},"