-color: #ffcccc; \n            grid-column: 1 / -1;\n        }\n        .item:nth-child(2) { background-color: #ccffcc; }\n        .item:nth-child(3) { background-color: #ccccff; }\n        .item:nth-child(4) { background-color: #ffffcc; }\n        .footer { \n            background-color: #ffccff; \n            grid-column: 1 / -1;\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":300},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":400,"height":300},"computed":{"display":"grid","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":12,"y":12,"width":376,"height":80},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Responsive Header","layout":{"rects":[{"x":138.52,"y":22,"width":122.97,"height":16}]}}]},{"nodeType":"element","tag":"div","layout":{"x":12,"y":102,"width":86.5,"height":116},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Auto 1","layout":{"rects":[{"x":35,"y":112,"width":40.48,"height":16}]}}]},{"nodeType":"element","tag":"div","layout":{"x":108.5,"y":102,"width":86.5,"height":116},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Auto 2","layout":{"rects":[{"x":131.5,"y":112,"width":40.48,"height":16}]}}]},{"nodeType":"element","tag":"div","layout":{"x":205,"y":102,"width":86.5,"height":116},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Auto 3","layout":{"rects":[{"x":228,"y":112,"width":40.48,"height":16}]}}]},{"nodeType":"element","tag":"div","layout":{"x":12,"y":228,"width":376,"height":60},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Responsive Footer","layout":{"rects":[{"x":141.23,"y":238,"width":117.52