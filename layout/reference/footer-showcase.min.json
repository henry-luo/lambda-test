{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":1015},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n  ","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n  ","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n  ","layout":{"rects":[]}},{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"Footer Showcase","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n  ","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; background: white; }\n    \n    main { max-width: 1200px; margin: 0 auto; padding: 4rem 1rem; }\n    main h1 { color: #333; margin-bottom: 2rem; text-align: center; }\n    \n    /* Hero Content */\n    .hero-content { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 4rem 2rem; border-radius: 8px; margin-bottom: 3rem; text-align: center; }\n    .hero-content p { font-size: 1.2rem; max-width: 600px; margin: 0 auto; }\n    \n    /* Footer */\n    footer { background: #2c3e50; color: white; }\n    \n    .footer-content { max-width: 1200px; margin: 0 auto; padding: 3rem 1rem; }\n    \n    /* Footer Grid */\n    .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin-bottom: 2rem; }\n    \n    .footer-section h3 { margin-bottom: 1rem; font-size: 1.1rem; color: white; }\n    \n    .footer-section ul { list-style: none; }\n    .footer-section li { margin-bottom: 0.75rem; }\n    .footer-section a { color: #ecf0f1; text-decoration: none; transition: color 0.3s; }\n    .footer-section a:hover { color: #3498db; }\n    \n    /* Social Links */\n    .social-links { display: flex; gap: 1rem; margin-top: 1rem; }\n    .social-links a { display: inline-block; width: 40px; height: 40px; background: rgba(255,255,255,0.1); border-radius: 50%; text-align: center; line-height: 40px; transition: background 0.3s; }\n    .social-links a:hover { background: #3498db; }\n    \n    /* Footer Bottom */\n    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }\n    .footer-bottom p { color: #bdc3c7; font-size: 0.9rem; }\n    \n    /* Newsletter Signup */\n    .newsletter { background: rgba(52, 152, 219, 0.2); padding: 2rem; border-radius: 8px; margin-bottom: 2rem; }\n    .newsletter h3 { margin-bottom: 1rem; }\n    .newsletter-form { display: flex; gap: 0.5rem; flex-wrap: wrap; }\n    .newsletter-form input { flex: 1; min-width: 200px; padding: 0.75rem; border: none; border-radius: 4px; }\n    .newsletter-form button { padding: 0.75rem 1.5rem; background: #3498db; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500; }\n    .newsletter-form button:hover { background: #2980b9; }\n    \n    @media (max-width: 768px) {\n      .footer-grid { grid-template-columns: 1fr; }\n      .footer-bottom { flex-direction: column; text-align: center; }\n    }\n  ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0