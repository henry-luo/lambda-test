      background-color: #f6f8fa;\n      border-radius: 6px;\n      font-size: 85%;\n      padding: 0.2em 0.4em;\n    }\n\n    /* ── KaTeX display math centering ──────────────────────────────────── */\n    .katex-display {\n      overflow-x: auto;\n      overflow-y: hidden;\n      padding: 4px 0;\n    }\n\n    /* ── Table improvements ─────────────────────────────────────────────── */\n    .markdown-body table {\n      display: block;\n      width: max-content;\n      max-width: 100%;\n      overflow: auto;\n    }\n\n    /* ── Footer ─────────────────────────────────────────────────────────── */\n    .gh-footer {\n      text-align: center;\n      padding: 24px 16px;\n      font-size: 12px;\n      color: #57606a;\n    }\n    .gh-footer a { color: #57606a; }\n  ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":1609.25},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":1200,"height":36.5},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"a","layout":{"x":16,"y":9,"width":131.95,"height":16},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"Markdown Test Suite","layout":{"rects":[{"x":16,"y":9,"width":131.95,"height":16}]}}]},{"nodeType":"text","text":"\n    ","layout":{"rects":[{"x":147.95,"y":9,"width":3.59,"height":16}]}},{"nodeType":"element","tag":"span","layout":{"x":155.55,"y":9,"width":3.89,"height":16},"selector":"span.sep:nth-of-type(1)","computed":{"display":"inline","textAlign":"start","fontFamily":"-apple-system, \"system-ui\", \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"","fontSize":13,"fontWeight":"400"},"children":[{"nodeType":"text","text":"/","layout":{"rects":[{"x":155.55,"y":9,"width":3.89,"height":16}]}}]},{"nodeType":"text","t