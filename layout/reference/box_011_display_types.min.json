.element {\n            margin: 5px;\n            padding: 10px;\n            border: 1px solid #666;\n            background-color: #f0f0f0;\n        }\n        \n        /* Block elements */\n        .block {\n            display: block;\n            background-color: #ffcccc;\n        }\n        \n        /* Inline elements */\n        .inline {\n            display: inline;\n            background-color: #ccffcc;\n        }\n        \n        /* Inline-block elements */\n        .inline-block {\n            display: inline-block;\n            width: 120px;\n            height: 60px;\n            background-color: #ccccff;\n            text-align: center;\n            line-height: 60px;\n        }\n        \n        /* None display */\n        .none {\n            display: none;\n            background-color: #ffffcc;\n        }\n        \n        /* Table display types */\n        .table {\n            display: table;\n            width: 100%;\n            background-color: #ffccff;\n            border-collapse: separate;\n            border-spacing: 2px;\n        }\n        \n        .table-row {\n            display: table-row;\n            background-color: #ccffff;\n        }\n        \n        .table-cell {\n            display: table-cell;\n            padding: 10px;\n            border: 1px solid #666;\n            background-color: #ffccaa;\n            text-align: center;\n        }\n        \n        /* List display types */\n        .list-item {\n            display: list-item;\n            margin-left: 20px;\n            background-color: #aaffcc;\n        }\n        \n        /* Flex display (basic) */\n        .flex {\n            display: flex;\n            gap: 10px;\n            background-color: #aaccff;\n            padding: 10px;\n        }\n        \n        .flex-item {\n            flex: 1;\n            padding: 10px;\n            border: 1px solid #666;\n            background-color: #ffaacc;\n            text-align: center;\n        }\n 