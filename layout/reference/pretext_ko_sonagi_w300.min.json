9.08,"height":24}]}},{"nodeType":"text","text":"을 갔던 아버지가 언제 돌아왔는지, “윤 초시 ","layout":{"rects":[{"x":0,"y":7224,"width":289.19,"height":24}]}},{"nodeType":"text","text":"댁도 말이 아니야, 그 많던 전답을 다 팔아 버","layout":{"rects":[{"x":0,"y":7248,"width":290.55,"height":24}]}},{"nodeType":"text","text":"리고, 대대로 살아오던 집마저 남의 손에 넘기","layout":{"rects":[{"x":0,"y":7272,"width":296.31,"height":24}]}},{"nodeType":"text","text":"더니, 또 악상까지 당하는걸 보면…….” 남폿","layout":{"rects":[{"x":0,"y":7296,"width":291.73,"height":24}]}},{"nodeType":"text","text":"불 밑에서 바느질감을 안고 있던 어머니가, ","layout":{"rects":[{"x":0,"y":7320,"width":277.11,"height":24}]}},{"nodeType":"text","text":"“증손이라곤 계집애 그 애 하나뿐이었지요?” ","layout":{"rects":[{"x":0,"y":7344,"width":290.97,"height":24}]}},{"nodeType":"text","text":"“그렇지, 사내 애 둘 있던 건 어려서 잃어버리","layout":{"rects":[{"x":0,"y":7368,"width":293.67,"height":24}]}},{"nodeType":"text","text":"고…….” “어쩌면 그렇게 자식복이 없을까.” ","layout":{"rects":[{"x":0,"y":7392,"width":287.73,"height":24}]}},{"nodeType":"text","text":"“글쎄 말이지. 이번 앤 꽤 여러 날 앓는 걸 약","layout":{"rects":[{"x":0,"y":7416,"width":287.91,"height":24}]}},{"nodeType":"text","text":"도 변변히 못써 봤다더군. 지금 같아서 윤초시","layout":{"rects":[{"x":0,"y":7440,"width":296.31,"height":24}]}},{"nodeType":"text","text":"네도 대가 끊긴 셈이지. ……그런데참, 이번 ","layout":{"rects":[{"x":0,"y":7464,"width":284.14,"height":24}]}},{"nodeType":"text","text":"계집앤 어린 것이 여간 잔망스럽지가 않아. 글","layout":{"rects":[{"x":0,"y":7488,"width":296.31,"height":24}]}},{"nodeType":"text","text":"쎄, 죽기전에 이런 말을 했다지 않아? 자기가 ","layout":{"rects":[{"x":0,"y":7512,"width":289.19,"height":24}]}},{"nodeType":"text","text":"죽거든 자기 입던 옷을 꼭그대로 입혀서 묻어 ","layout":{"rects":[{"x":0,"y":7536,"width":291.84,"height":24}]}},{"nodeType":"text","text":"달라고…….”","layout":{"rects":[{"x":0,"y":7560,"width":88.23,"height":24}]}}]}]}]}]}}