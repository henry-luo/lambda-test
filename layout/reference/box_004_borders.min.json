: top;\n        }\n        \n        .border-none {\n            border: none;\n            background-color: #ffcccc;\n        }\n        \n        .border-solid {\n            border: 3px solid #ff0000;\n            background-color: #ccffcc;\n        }\n        \n        .border-dashed {\n            border: 2px dashed #00aa00;\n            background-color: #ccccff;\n        }\n        \n        .border-dotted {\n            border: 4px dotted #0000ff;\n            background-color: #ffffcc;\n        }\n        \n        .border-double {\n            border: 6px double #aa00aa;\n            background-color: #ffccff;\n        }\n        \n        .border-individual {\n            border-top: 2px solid #ff0000;\n            border-right: 4px dashed #00aa00;\n            border-bottom: 3px dotted #0000ff;\n            border-left: 5px double #aa00aa;\n            background-color: #ccffaa;\n        }\n        \n        .border-radius {\n            border: 2px solid #666;\n            border-radius: 10px;\n            background-color: #aaccff;\n        }\n        \n        .border-radius-individual {\n            border: 2px solid #666;\n            border-top-left-radius: 20px;\n            border-top-right-radius: 5px;\n            border-bottom-right-radius: 15px;\n            border-bottom-left-radius: 0px;\n            background-color: #ffaacc;\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":600},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":700,"height":600},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":37,"y":37,"width":150,"height":80},"computed":{"display":"inline-block","textAlign":"center"},"children":[{"nodeType":"text","text":"No border","layout":{"rects":[{"x":85.31,"y":47,"wid