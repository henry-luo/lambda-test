deType":"text","text":"て、門の下を覗きこんだ。外には、唯、黑洞々","layout":{"rects":[{"x":0,"y":6720,"width":336,"height":24}]}},{"nodeType":"text","text":"たる夜があるばかりである。","layout":{"rects":[{"x":0,"y":6744,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6768,"width":350,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、既に、雨を冐して、京都の町へ强盜を","layout":{"rects":[{"x":0,"y":6768,"width":336,"height":24}]}},{"nodeType":"text","text":"働きに急いでゐた。","layout":{"rects":[{"x":0,"y":6792,"width":144,"height":24}]}}]}]}]}]}}