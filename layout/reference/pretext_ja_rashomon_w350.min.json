,"y":1944,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1968,"width":350,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、頸をちゞめながら、山吹の汗衫に重ね","layout":{"rects":[{"x":0,"y":1968,"width":336,"height":24}]}},{"nodeType":"text","text":"た、紺の襖の肩を高くして門のまはりを見まは","layout":{"rects":[{"x":0,"y":1992,"width":336,"height":24}]}},{"nodeType":"text","text":"した。雨風の患のない、人目にかゝる惧のな","layout":{"rects":[{"x":0,"y":2016,"width":320,"height":24}]}},{"nodeType":"text","text":"い、一晚樂にねられさうな所があれば、そこで","layout":{"rects":[{"x":0,"y":2040,"width":336,"height":24}]}},{"nodeType":"text","text":"ともかくも、夜を明かさうと思つたからであ","layout":{"rects":[{"x":0,"y":2064,"width":320,"height":24}]}},{"nodeType":"text","text":"る。すると、幸門の上の樓へ上る、幅の廣い、","layout":{"rects":[{"x":0,"y":2088,"width":336,"height":24}]}},{"nodeType":"text","text":"之も丹を塗つた梯子が眼についた。上なら、人","layout":{"rects":[{"x":0,"y":2112,"width":336,"height":24}]}},{"nodeType":"text","text":"がゐたにしても、どうせ死人ばかりである。下","layout":{"rects":[{"x":0,"y":2136,"width":336,"height":24}]}},{"nodeType":"text","text":"人は、そこで腰にさげた聖柄の太刀が鞘走らな","layout":{"rects":[{"x":0,"y":2160,"width":336,"height":24}]}},{"nodeType":"text","text":"いやうに氣をつけながら、藁草履をはいた足","layout":{"rects":[{"x":0,"y":2184,"width":320,"height":24}]}},{"nodeType":"text","text":"を、その梯子の一番下の段へふみかけた。","layout":{"rects":[{"x":0,"y":2208,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2232,"width":350,"height":360},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"それから、何分かの後である。羅生門の樓の上","layout":{"rects":[{"x":0,"y":2232,"width":336,"height":24}]}},{"nodeType":"text","text":"へ出る、幅の廣い梯子の中段に、一人の男が、","layout":{"rects":[{"x":0,"y":2256,"width":336,"height":24}]}},{"nodeType":"text","text":"猫のやうに身をちゞめて、息を殺しながら、上","layout":{"rects":[{"x":0,"y":2280,"width":336,"height":24}]}},{"nodeType":"text","text":"の容子を窺つてゐた。樓の上からさす火の光","layout":{"rects":[{"x":0,"y":2304,"width":320,"height":24}]}},{"nodeType":"text","text":"が、かすかに、その男の右の頰をぬらしてゐ","layout":{"rects":[{"x":0,"y":2328,"width":320,"height":24}]}},{"nodeType":"text","text":"る。短い鬚の中に、赤く膿を持つた面皰のある","layout":{"rects":[{"x":0,"y":2352,"width":336,"height":24}]}},{"nodeType":"text","text":"頰である。下人は、始めから、この上にゐる者","layout":{"rects":[{"x":0,"y":2376,"width":336,"height":24}]}},{"nodeType":"text","text":"は、死人ばかりだと高を括つてゐた。それが、","layout":{"rects":[{"x":0,"y":2400,"width":336,"height":24}]}},{"nodeType":"text","text":"梯子を二三段上つて見ると、上では誰か火をと","layout":{"rects":[{"x":0,"y":2424,"width":336,"height":24}]}},{"nodeType":"text","text":"ぼして、しかもその火を其處此處と動かしてゐ","layout":{"rects":[{"x":0,"y":2448,"width":336,"height":24}]}},{"nodeType":"text","text":"るらしい。これは、その濁つた、黃いろい光","layout":{"rects":[{"x":0,"y":2472,"width":320,"height":24}]}},{"nodeType":"text","text":"が、隅々に蜘蛛の巢をかけた天井裏に、ゆれな","layout":{"rects":[{"x":0,"y":2496,"width":336,"height":24}]}},{"nodeType":"text","text":"がら映つたので、すぐにそれと知れたのであ","layout":{"rects":[{"x":0,"y":2520,"width":320,"height":24}]}},{"nodeType":"text","text":"る。この雨の夜に、この羅生門の上で、火をと","layout":{"rects":[{"x":0,"y":2544,"width":336,"height":24}]}},{"nodeType":"text","text":"もしてゐるからは、どうせ唯の者ではない。","layout":{"rects":[{"x":0,"y":2568,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2592,"width":350,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、守宮のやうに足音をぬすんで、やつと","layout":{"rects":[{"x":0,"y":2592,"width":336,"height":24}]}},{"nodeType":"text","text":"急な梯子を、一番上の段まで這ふやうにして上","layout":{"rects":[{"x":0,"y":2616,"width":336,"height":24}]}},{"nodeType":"text","text":"りつめた。さうして體を出來る丈、平にしなが","layout":{"rects":[{"x":0,"y":2640,"width":336,"height":24}]}},{"nodeType":"text","text":"ら、頸を出來る丈、前へ出して、恐る恐る、樓","layout":{"rects":[{"x":0,"y":2664,"width":336,"height":24}]}},{"nodeType":"text","text":"の內を覗いて見た。","layout":{"rects":[{"x":0,"y":2688,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2712,"width":350,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"見ると、樓の內には、噂に聞いた通り、幾つか","layout":{"rects":[{"x":0,"y":2712,"width":336,"height":24}]}},{"nodeType":"text","text":"の屍骸が、無造作に棄てゝあるが、火の光の及","layout":{"rects":[{"x":0,"y":2736,"width":336,"height":24}]}},{"nodeType":"text","text":"ぶ範圍が、思つたより狹いので、數は幾つとも","layout":{"rects":[{"x":0,"y":2760,"width":336,"height":24}]}},{"nodeType":"text","text":"わからない。唯、おぼろげながら、知れるの","layout":{"rects":[{"x":0,"y":2784,"width":320,"height":24}]}},{"nodeType":"text","text":"は、その中に裸の屍骸と、着物を着た屍骸とが","layout":{"rects":[{"x":0,"y":2808,"width":336,"height":24}]}},{"nodeType":"text","text":"あると云ふ事である。勿論、中には女も男もま","layout":{"rects":[{"x":0,"y":2832,"width":336,"height":24}]}},{"nodeType":"text","text":"じつてゐるらしい。さうして、その屍骸は皆、","layout":{"rects":[{"x":0,"y":2856,"width":336,"height":24}]}},{"nodeType":"text","text":"それが、甞、生きてゐた人間だと云ふ事實さへ","layout":{"rects":[{"x":0,"y":2880,"width":336,"height":24}]}},{"nodeType":"text","text":"疑はれる程、土を捏ねて造つた人形のやうに、","layout":{"rects":[{"x":0,"y":2904,"width":336,"height":24}]}},{"nodeType":"text","text":"口を開いたり手を延ばしたりしてごろごろ床の","layout":{"rects":[{"x":0,"y":2928,"width":336,"height":24}]}},{"nodeType":"text","text":"上にころがつてゐた。しかも、肩とか胸とかの","layout":{"rects":[{"x":0,"y":2952,"width":336,"height":24}]}},{"nodeType":"text","text":"高くなつてゐる部分に、ぼんやりした火の光を","layout":{"rects":[{"x":0,"y":2976,"width":336,"height":24}]}},{"nodeType":"text","text":"うけて、低くなつてゐる部分の影を一層暗くし","layout":{"rects":[{"x":0,"y":3000,"width":336,"height":24}]}},{"nodeType":"text","text":"ながら、永久に啞の如く默つていた。","layout":{"rects":[{"x":0,"y":3024,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3048,"width":350,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、それらの屍骸の腐爛した臭氣に思は","layout":{"rects":[{"x":0,"y":3048,"width":320,"height":24}]}},{"nodeType":"text","text":"ず、鼻を掩つた。しかし、その手は、次の瞬間","layout":{"rects":[{"x":0,"y":3072,"width":336,"height":24}]}},{"nodeType":"text","text":"には、もう鼻を掩ふ事を忘れてゐた。或る强い","layout":{"rects":[{"x":0,"y":3096,"width":336,"height":24}]}},{"nodeType":"text","text":"感情が、殆悉この男の嗅覺を奪つてしまつたか","layout":{"rects":[{"x":0,"y":3120,"width":336,"height":24}]}},{"nodeType":"text","text":"らである。","layout":{"rects":[{"x":0,"y":3144,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3168,"width":350,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人の眼は、その時、はじめて、其屍骸の中に","layout":{"rects":[{"x":0,"y":3168,"width":336,"height":24}]}},{"nodeType":"text","text":"蹲つている人間を見た。檜肌色の着物を著た、","layout":{"rects":[{"x":0,"y":3192,"width":336,"height":24}]}},{"nodeType":"text","text":"背の低い、瘦せた、白髮頭の、猿のやうな老婆","layout":{"rects":[{"x":0,"y":3216,"width":336,"height":24}]}},{"nodeType":"text","text":"である。その老婆は、右の手に火をともした松","layout":{"rects":[{"x":0,"y":3240,"width":336,"height":24}]}},{"nodeType":"text","text":"の木片を持つて、その屍骸の一つの顏を覗きこ","layout":{"rects":[{"x":0,"y":3264,"width":336,"height":24}]}},{"nodeType":"text","text":"むやうに眺めてゐた。髮の毛の長い所を見る","layout":{"rects":[{"x":0,"y":3288,"width":320,"height":24}]}},{"nodeType":"text","text":"と、多分女の屍骸であらう。","layout":{"rects":[{"x":0,"y":3312,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3336,"width":350,"height":216},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、六分の恐怖と四分の好奇心とに動かさ","layout":{"rects":[{"x":0,"y":3336,"width":336,"height":24}]}},{"nodeType":"text","text":"れて、暫時は呼吸をするのさへ忘れてゐた。舊","layout":{"rects":[{"x":0,"y":3360,"width":336,"height":24}]}},{"nodeType":"text","text":"記の記者の語を借りれば、「頭身の毛も太る」","layout":{"rects":[{"x":0,"y":3384,"width":336,"height":24}]}},{"nodeType":"text","text":"やうに感じたのである。すると、老婆は、松の","layout":{"rects":[{"x":0,"y":3408,"width":336,"height":24}]}},{"nodeType":"text","text":"木片を、床板の間に挿して、それから、今まで","layout":{"rects":[{"x":0,"y":3432,"width":336,"height":24}]}},{"nodeType":"text","text":"眺めてゐた屍骸の首に兩手をかけると、丁度、","layout":{"rects":[{"x":0,"y":3456,"width":336,"height":24}]}},{"nodeType":"text","text":"猿の親が猿の子の虱をとるやうに、その長い髮","layout":{"rects":[{"x":0,"y":3480,"width":336,"height":24}]}},{"nodeType":"text","text":"の毛を一本づゝ拔きはじめた。髮は手に從つて","layout":{"rects":[{"x":0,"y":3504,"width":336,"height":24}]}},{"nodeType":"text","text":"拔けるらしい。","layout":{"rects":[{"x":0,"y":3528,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3552,"width":350,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その髮の毛が、一本ずゝ拔けるのに從つて下人","layout":{"rects":[{"x":0,"y":3552,"width":336,"height":24}]}},{"nodeType":"text","text":"の心からは、恐怖が少しづつ消えて行つた。さ","layout":{"rects":[{"x":0,"y":3576,"width":336,"height":24}]}},{"nodeType":"text","text":"うして、それと同時に、この老婆に對するはげ","layout":{"rects":[{"x":0,"y":3600,"width":336,"height":24}]}},{"nodeType":"text","text":"しい憎惡が、少しづゝ動いて來た。――いや、","layout":{"rects":[{"x":0,"y":3624,"width":336,"height":24}]}},{"nodeType":"text","text":"この老婆に對すると云つては、語弊があるかも","layout":{"rects":[{"x":0,"y":3648,"width":336,"height":24}]}},{"nodeType":"text","text":"知れない。寧、あらゆる惡に對する反感が、一","layout":{"rects":[{"x":0,"y":3672,"width":336,"height":24}]}},{"nodeType":"text","text":"分每に强さを增して來たのである。この時、誰","layout":{"rects":[{"x":0,"y":3696,"width":336,"height":24}]}},{"nodeType":"text","text":"かがこの下人に、さつき門の下でこの男が考へ","layout":{"rects":[{"x":0,"y":3720,"width":336,"height":24}]}},{"nodeType":"text","text":"てゐた、饑死をするか盜人になるかと云ふ問題","layout":{"rects":[{"x":0,"y":3744,"width":336,"height":24}]}},{"nodeType":"text","text":"を、改めて持出したら、恐らく下人は、何の未","layout":{"rects":[{"x":0,"y":3768,"width":336,"height":24}]}},{"nodeType":"text","text":"練もなく、饑死を選んだ事であらう。それほ","layout":{"rects":[{"x":0,"y":3792,"width":320,"height":24}]}},{"nodeType":"text","text":"ど、この男の惡を憎む心は、老婆の床に挿した","layout":{"rects":[{"x":0,"y":3816,"width":336,"height":24}]}},{"nodeType":"text","text":"松の木片のやうに、勢よく燃え上り出してゐた","layout":{"rects":[{"x":0,"y":3840,"width":336,"height":24}]}},{"nodeType":"text","text":"のである。","layout":{"rects":[{"x":0,"y":3864,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3888,"width":350,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人には、勿論、何故老婆が死人の髮の毛を拔","layout":{"rects":[{"x":0,"y":3888,"width":336,"height":24}]}},{"nodeType":"text","text":"くかわからなかつた。從つて、合理的には、そ","layout":{"rects":[{"x":0,"y":3912,"width":336,"height":24}]}},{"nodeType":"text","text":"れを善惡の何れに片づけてよいか知らなかつ","layout":{"rects":[{"x":0,"y":3936,"width":320,"height":24}]}},{"nodeType":"text","text":"た。しかし下人にとつては、この雨の夜に、こ","layout":{"rects":[{"x":0,"y":3960,"width":336,"height":24}]}},{"nodeType":"text","text":"の羅生門の上で、死人の髮の毛を拔くと云ふ事","layout":{"rects":[{"x":0,"y":3984,"width":336,"height":24}]}},{"nodeType":"text","text":"が、それ丈で既に許す可らざる惡であつた。勿","layout":{"rects":[{"x":0,"y":4008,"width":336,"height":24}]}},{"nodeType":"text","text":"論、下人は、さつき迄自分が、盜人になる氣で","layout":{"rects":[{"x":0,"y":4032,"width":336,"height":24}]}},{"nodeType":"text","text":"ゐた事なぞは、とうに忘れてゐるのである。","layout":{"rects":[{"x":0,"y":4056,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4080,"width":350,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"そこで、下人は、兩足に力を入れて、いきな","layout":{"rects":[{"x":0,"y":4080,"width":320,"height":24}]}},{"nodeType":"text","text":"り、梯子から上へ飛び上つた。さうして聖柄の","layout":{"rects":[{"x":0,"y":4104,"width":336,"height":24}]}},{"nodeType":"text","text":"太刀に手をかけながら、大股に老婆の前へ步み","layout":{"rects":[{"x":0,"y":4128,"width":336,"height":24}]}},{"nodeType":"text","text":"よつた。老婆が驚いたのは、云ふ迄もない。","layout":{"rects":[{"x":0,"y":4152,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4176,"width":350,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆は、一目下人を見ると、まるで弩にでも彈","layout":{"rects":[{"x":0,"y":4176,"width":336,"height":24}]}},{"nodeType":"text","text":"かれたやうに、飛び上つた。","layout":{"rects":[{"x":0,"y":4200,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4224,"width":350,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「おのれ、どこへ行く。」","layout":{"rects":[{"x":0,"y":4224,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4248,"width":350,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆が屍骸につまづきながら、慌てふ","layout":{"rects":[{"x":0,"y":4248,"width":336,"height":24}]}},{"nodeType":"text","text":"ためいて逃げようとする行手を塞いで、こう罵","layout":{"rects":[{"x":0,"y":4272,"width":336,"height":24}]}},{"nodeType":"text","text":"つた。老婆は、それでも下人をつきのけて行か","layout":{"rects":[{"x":0,"y":4296,"width":336,"height":24}]}},{"nodeType":"text","text":"うとする。下人は又、それを行かすまいとし","layout":{"rects":[{"x":0,"y":4320,"width":320,"height":24}]}},{"nodeType":"text","text":"て、押しもどす。二人は屍骸の中で、暫、無言","layout":{"rects":[{"x":0,"y":4344,"width":336,"height":24}]}},{"nodeType":"text","text":"のまゝ、つかみ合つた。しかし勝敗は、はじめ","layout":{"rects":[{"x":0,"y":4368,"width":336,"height":24}]}},{"nodeType":"text","text":"から、わかつている。下人はとうとう、老婆の","layout":{"rects":[{"x":0,"y":4392,"width":336,"height":24}]}},{"nodeType":"text","text":"腕をつかんで、無理にそこへ扭ぢ倒した。丁","layout":{"rects":[{"x":0,"y":4416,"width":320,"height":24}]}},{"nodeType":"text","text":"度、鷄の脚のやうな、骨と皮ばかりの腕であ","layout":{"rects":[{"x":0,"y":4440,"width":320,"height":24}]}},{"nodeType":"text","text":"る。","layout":{"rects":[{"x":0,"y":4464,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4488,"width":350,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「何をしてゐた。さあ何をしてゐた。云へ。云","layout":{"rects":[{"x":0,"y":4488,"width":336,"height":24}]}},{"nodeType":"text","text":"はぬと、これだぞよ。」","layout":{"rects":[{"x":0,"y":4512,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4536,"width":350,"height":360},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆をつき放すと、いきなり、太刀の","layout":{"rects":[{"x":0,"y":4536,"width":336,"height":24}]}},{"nodeType":"text","text":"鞘を拂つて、白い鋼の色をその眼の前へつきつ","layout":{"rects":[{"x":0,"y":4560,"width":336,"height":24}]}},{"nodeType":"text","text":"けた。けれども、老婆は默つてゐる。兩手をわ","layout":{"rects":[{"x":0,"y":4584,"width":336,"height":24}]}},{"nodeType":"text","text":"なわなふるはせて、肩で息を切りながら、眼","layout":{"rects":[{"x":0,"y":4608,"width":320,"height":24}]}},{"nodeType":"text","text":"を、眼球が眶の外へ出さうになる程、見開い","layout":{"rects":[{"x":0,"y":4632,"width":320,"height":24}]}},{"nodeType":"text","text":"て、啞のやうに執拗く默つてゐる。これを見る","layout":{"rects":[{"x":0,"y":4656,"width":336,"height":24}]}},{"nodeType":"text","text":"と、下人は始めて明白にこの老婆の生死が、全","layout":{"rects":[{"x":0,"y":4680,"width":336,"height":24}]}},{"nodeType":"text","text":"然、自分の意志に支配されてゐると云ふ事を意","layout":{"rects":[{"x":0,"y":4704,"width":336,"height":24}]}},{"nodeType":"text","text":"識した。さうして、この意識は、今まではげし","layout":{"rects":[{"x":0,"y":4728,"width":336,"height":24}]}},{"nodeType":"text","text":"く燃えてゐた憎惡の心を何時の間にか冷まして","layout":{"rects":[{"x":0,"y":4752,"width":336,"height":24}]}},{"nodeType":"text","text":"しまつた。後に殘つたのは、唯、或仕事をし","layout":{"rects":[{"x":0,"y":4776,"width":320,"height":24}]}},{"nodeType":"text","text":"て、それが圓滿に成就した時の、安らかな得意","layout":{"rects":[{"x":0,"y":4800,"width":336,"height":24}]}},{"nodeType":"text","text":"と滿足とがあるばかりである。そこで、下人","layout":{"rects":[{"x":0,"y":4824,"width":320,"height":24}]}},{"nodeType":"text","text":"は、老婆を見下しながら、少し聲を柔げてかう","layout":{"rects":[{"x":0,"y":4848,"width":336,"height":24}]}},{"nodeType":"text","text":"云つた。","layout":{"rects":[{"x":0,"y":4872,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4896,"width":350,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「己は檢非違使の廳の役人などではない。今し","layout":{"rects":[{"x":0,"y":4896,"width":336,"height":24}]}},{"nodeType":"text","text":"方この門の下を通りかゝつた旅の者だ。だから","layout":{"rects":[{"x":0,"y":4920,"width":336,"height":24}]}},{"nodeType":"text","text":"お前に繩をかけて、どうしようと云ふやうな事","layout":{"rects":[{"x":0,"y":4944,"width":336,"height":24}]}},{"nodeType":"text","text":"はない。唯、今時分、この門の上で、何をして","layout":{"rects":[{"x":0,"y":4968,"width":336,"height":24}]}},{"nodeType":"text","text":"居たのだか、それを己に話しさへすればいいの","layout":{"rects":[{"x":0,"y":4992,"width":336,"height":24}]}},{"nodeType":"text","text":"だ。」","layout":{"rects":[{"x":0,"y":5016,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5040,"width":350,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"すると、老婆は、見開いてゐた眼を、一層大き","layout":{"rects":[{"x":0,"y":5040,"width":336,"height":24}]}},{"nodeType":"text","text":"くして、ぢつとその下人の顏を見守つた。眶の","layout":{"rects":[{"x":0,"y":5064,"width":336,"height":24}]}},{"nodeType":"text","text":"赤くなつた、肉食鳥のやうな、銳い眼で見たの","layout":{"rects":[{"x":0,"y":5088,"width":336,"height":24}]}},{"nodeType":"text","text":"である。それから、皺で、殆、鼻と一つになつ","layout":{"rects":[{"x":0,"y":5112,"width":336,"height":24}]}},{"nodeType":"text","text":"た唇を、何か物でも嚙んでゐるやうに動かし","layout":{"rects":[{"x":0,"y":5136,"width":320,"height":24}]}},{"nodeType":"text","text":"た。細い喉で、尖つた喉佛の動いてゐるのが見","layout":{"rects":[{"x":0,"y":5160,"width":336,"height":24}]}},{"nodeType":"text","text":"える。その時、その喉から、鴉の啼くやうな聲","layout":{"rects":[{"x":0,"y":5184,"width":336,"height":24}]}},{"nodeType":"text","text":"が、喘ぎ喘ぎ、下人の耳へ傳はつて來た。","layout":{"rects":[{"x":0,"y":5208,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5232,"width":350,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「この髮を拔いてな、この女の髮を拔いてな、","layout":{"rects":[{"x":0,"y":5232,"width":336,"height":24}]}},{"nodeType":"text","text":"鬘にせうと思うたのぢや。」","layout":{"rects":[{"x":0,"y":5256,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5280,"width":350,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆の答が存外、平凡なのに失望し","layout":{"rects":[{"x":0,"y":5280,"width":320,"height":24}]}},{"nodeType":"text","text":"た。さうして失望すると同時に、又前の憎惡","layout":{"rects":[{"x":0,"y":5304,"width":320,"height":24}]}},{"nodeType":"text","text":"が、冷な侮蔑と一しよに、心の中へはいつて來","layout":{"rects":[{"x":0,"y":5328,"width":336,"height":24}]}},{"nodeType":"text","text":"た。すると、その氣色が、先方へも通じたので","layout":{"rects":[{"x":0,"y":5352,"width":336,"height":24}]}},{"nodeType":"text","text":"あらう。老婆は、片手に、まだ屍骸の頭から奪","layout":{"rects":[{"x":0,"y":5376,"width":336,"height":24}]}},{"nodeType":"text","text":"つた長い拔け毛を持つたなり、蟇のつぶやくや","layout":{"rects":[{"x":0,"y":5400,"width":336,"height":24}]}},{"nodeType":"text","text":"うな聲で、口ごもりながら、こんな事を云つ","layout":{"rects":[{"x":0,"y":5424,"width":320,"height":24}]}},{"nodeType":"text","text":"た。","layout":{"rects":[{"x":0,"y":5448,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5472,"width":350,"height":456},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"成程、死人の髮の毛を拔くと云ふ事は、惡い事","layout":{"rects":[{"x":0,"y":5472,"width":336,"height":24}]}},{"nodeType":"text","text":"かも知れぬ。しかし、かう云ふ死人の多くは、","layout":{"rects":[{"x":0,"y":5496,"width":336,"height":24}]}},{"nodeType":"text","text":"皆、その位な事を、されてもいゝ人間ばかりで","layout":{"rects":[{"x":0,"y":5520,"width":336,"height":24}]}},{"nodeType":"text","text":"ある。現に、自分が今、髮を拔いた女などは、","layout":{"rects":[{"x":0,"y":5544,"width":336,"height":24}]}},{"nodeType":"text","text":"蛇を四寸ばかりづゝに切つて干したのを、干魚","layout":{"rects":[{"x":0,"y":5568,"width":336,"height":24}]}},{"nodeType":"text","text":"だと云つて、太刀帶の陣へ賣りに行つた。疫病","layout":{"rects":[{"x":0,"y":5592,"width":336,"height":24}]}},{"nodeType":"text","text":"にかゝつて死ななかつたなら、今でも賣りに行","layout":{"rects":[{"x":0,"y":5616,"width":336,"height":24}]}},{"nodeType":"text","text":"つてゐたかもしれない。しかも、この女の賣る","layout":{"rects":[{"x":0,"y":5640,"width":336,"height":24}]}},{"nodeType":"text","text":"干魚は、味がよいと云ふので、太刀帶たちが、","layout":{"rects":[{"x":0,"y":5664,"width":336,"height":24}]}},{"nodeType":"text","text":"缺かさず菜料に買つてゐたのである。自分は、","layout":{"rects":[{"x":0,"y":5688,"width":336,"height":24}]}},{"nodeType":"text","text":"この女のした事が惡いとは思はない。しなけれ","layout":{"rects":[{"x":0,"y":5712,"width":336,"height":24}]}},{"nodeType":"text","text":"ば、饑死をするので、仕方がなくした事だから","layout":{"rects":[{"x":0,"y":5736,"width":336,"height":24}]}},{"nodeType":"text","text":"である。だから、又今、自分のしてゐた事も惡","layout":{"rects":[{"x":0,"y":5760,"width":336,"height":24}]}},{"nodeType":"text","text":"い事とは思はない。これもやはりしなければ、","layout":{"rects":[{"x":0,"y":5784,"width":336,"height":24}]}},{"nodeType":"text","text":"饑死をするので、仕方がなくする事だからであ","layout":{"rects":[{"x":0,"y":5808,"width":336,"height":24}]}},{"nodeType":"text","text":"る。さうして、その仕方がない事を、よく知つ","layout":{"rects":[{"x":0,"y":5832,"width":336,"height":24}]}},{"nodeType":"text","text":"てゐたこの女は、自分のする事を許してくれる","layout":{"rects":[{"x":0,"y":5856,"width":336,"height":24}]}},{"nodeType":"text","text":"のにちがひないと思ふからである。――老婆","layout":{"rects":[{"x":0,"y":5880,"width":320,"height":24}]}},{"nodeType":"text","text":"は、大體こんな意味の事を云つた。","layout":{"rects":[{"x":0,"y":5904,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5928,"width":350,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、太刀を鞘におさめて、その太刀の柄を","layout":{"rects":[{"x":0,"y":5928,"width":336,"height":24}]}},{"nodeType":"text","text":"左の手でおさへながら、冷然として、この話を","layout":{"rects":[{"x":0,"y":5952,"width":336,"height":24}]}},{"nodeType":"text","text":"聞いてゐた。勿論、右の手では、赤く頰に膿を","layout":{"rects":[{"x":0,"y":5976,"width":336,"height":24}]}},{"nodeType":"text","text":"持つた大きな面皰を氣にしながら、聞いてゐる","layout":{"rects":[{"x":0,"y":6000,"width":336,"height":24}]}},{"nodeType":"text","text":"のである。しかし、之を聞いてゐる中に、下人","layout":{"rects":[{"x":0,"y":6024,"width":336,"height":24}]}},{"nodeType":"text","text":"の心には、或勇氣が生まれて來た。それは、さ","layout":{"rects":[{"x":0,"y":6048,"width":336,"height":24}]}},{"nodeType":"text","text":"つき、門の下でこの男に缺けてゐた勇氣であ","layout":{"rects":[{"x":0,"y":6072,"width":320,"height":24}]}},{"nodeType":"text","text":"る。さうして、又さつき、この門の上へ上つ","layout":{"rects":[{"x":0,"y":6096,"width":320,"height":24}]}},{"nodeType":"text","text":"て、この老婆を捕へた時の勇氣とは、全然、反","layout":{"rects":[{"x":0,"y":6120,"width":336,"height":24}]}},{"nodeType":"text","text":"對な方向に動かうとする勇氣である。下人は、","layout":{"rects":[{"x":0,"y":6144,"width":336,"height":24}]}},{"nodeType":"text","text":"饑死をするか盜人になるかに迷はなかつたばか","layout":{"rects":[{"x":0,"y":6168,"width":336,"height":24}]}},{"nodeType":"text","text":"りではない。その時のこの男の心もちから云へ","layout":{"rects":[{"x":0,"y":6192,"width":336,"height":24}]}},{"nodeType":"text","text":"ば、饑死などと云ふ事は、殆、考へる事さへ出","layout":{"rects":[{"x":0,"y":6216,"width":336,"height":24}]}},{"nodeType":"text","text":"來ない程、意識の外に追ひ出されてゐた。","layout":{"rects":[{"x":0,"y":6240,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6264,"width":350,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「きつと、そうか。」","layout":{"rects":[{"x":0,"y":6264,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6288,"width":350,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆の話が完ると、下人は嘲るやうな聲で念を","layout":{"rects":[{"x":0,"y":6288,"width":336,"height":24}]}},{"nodeType":"text","text":"押した。さうして、一足前へ出ると、不意に、","layout":{"rects":[{"x":0,"y":6312,"width":336,"height":24}]}},{"nodeType":"text","text":"右の手を面皰から離して、老婆の襟上をつかみ","layout":{"rects":[{"x":0,"y":6336,"width":336,"height":24}]}},{"nodeType":"text","text":"ながら、かう云つた。","layout":{"rects":[{"x":0,"y":6360,"width":160,"height":24}]}}]},{"nodeType":"elemen