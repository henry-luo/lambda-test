lor: #333;\n        }\n        \n        .text-sample {\n            border: 1px solid #ccc;\n            padding: 5px;\n            margin: 10px 0;\n        }\n        \n        .line-height-normal {\n            line-height: normal;\n            background-color: #ffcccc;\n        }\n        \n        .line-height-1 {\n            line-height: 1;\n            background-color: #ccffcc;\n        }\n        \n        .line-height-1-5 {\n            line-height: 1.5;\n            background-color: #ccccff;\n        }\n        \n        .line-height-2 {\n            line-height: 2;\n            background-color: #ffffcc;\n        }\n        \n        .line-height-px {\n            line-height: 40px;\n            background-color: #ffccff;\n        }\n        \n        .line-height-percent {\n            line-height: 120%;\n            background-color: #ccffff;\n        }\n        \n        /* Inline mixing demonstration */\n        .inline-mix {\n            line-height: 1.5;\n        }\n        \n        .inline-large {\n            font-size: 24px;\n            background-color: #ffaaaa;\n        }\n        \n        .inline-small {\n            font-size: 12px;\n            background-color: #aaffaa;\n        }\n        \n        .inline-normal {\n            font-size: 16px;\n            background-color: #aaaaff;\n        }\n        \n        /* Baseline grid visualization */\n        .baseline-grid {\n            background-image: linear-gradient(to bottom, transparent 0px, transparent 15px, #ff000020 15px, #ff000020 16px, transparent 16px, transparent 31px, #ff000020 31px, #ff000020 32px);\n            background-size: 100% 32px;\n            line-height: 2; /* 32px line height for 16px font */\n            padding: 10px;\n            border: 1px solid #999;\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":800},"computed":{"display":