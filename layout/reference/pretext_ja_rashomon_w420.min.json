{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":5688},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"Pretext corpus: width 420px","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n@font-face {\n    font-family: 'Noto Sans SC';\n    src: url('../font/NotoSansSC-Subset.otf') format('opentype');\n}\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: 'Noto Sans SC', sans-serif; font-size: 16px; line-height: 1.5; font-kerning: none; text-spacing-trim: space-all; }\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":5688},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":420,"height":5688},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"p","layout":{"x":0,"y":0,"width":420,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"或日の暮方の事である。一人の下人が、羅生門の下で雨や","layout":{"rects":[{"x":0,"y":0,"width":416,"height":24}]}},{"nodeType":"text","text":"みを待つてゐた。","layout":{"rects":[{"x":0,"y":24,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":48,"width":420,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"廣い門の下には、この男の外に誰もゐない。唯、所々丹塗","layout":{"rects":[{"x":0,"y":48,"width":416,"height":24}]}},{"nodeType":"text","text":"の剝げた、大きな圓柱に、蟋蟀が一匹とまつてゐる。羅生","layout":{"rects":[{"x":0,"y":72,"width":416,"height":24}]}},{"nodeType":"text","text":"門が、朱雀大路にある以上は、この男の外にも、雨やみを","layout":{"rects":[{"x":0,"y":96,"width":416,"height":24}]}},{"nodeType":"text","text":"する市女笠や揉烏帽子が、もう二三人はありさうなもので","layout":{"rects":[{"x":0,"y":120,"width":416,"height":24}]}},{"nodeType":"text","text":"ある。それが、この男の外には誰もゐない。","layout":{"rects":[{"x":0,"y":144,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":168,"width":420,"height":288},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"何故かと云ふと、この二三年、京都には、地震とか辻風と","layout":{"rects":[{"x":0,"y":168,"width":416,"height":24}]}},{"nodeType":"text","text":"か火事とか饑饉とか云ふ災がつゞいて起つた。そこで洛中","layout":{"rects":[{"x":0,"y":192,"width":416,"height":24}]}},{"nodeType":"text","text":"のさびれ方は一通りでない。舊記によると、佛像や佛具を","layout":{"rects":[{"x":0,"y":216,"width":416,"height":24}]}},{"nodeType":"text","text":"打碎いて、その丹がついたり、金銀の箔がついたりした木","layout":{"rects":[{"x":0,"y":240,"width":416,"height":24}]}},{"nodeType":"text","text":"を、路ばたにつみ重ねて、薪の料に賣つてゐたと云ふ事で","layout":{"rects":[{"x":0,"y":264,"width":416,"height":24}]}},{"nodeType":"text","text":"ある。洛中がその始末であるから、羅生門の修理などは、","layout":{"rects":[{"x":0,"y":288,"width":416,"height":24}]}},{"nodeType":"text","text":"元より誰も捨てゝ顧る者がなかつた。するとその荒れ果て","layout":{"rects":[{"x":0,"y":312,"width":416,"height":24}]}},{"nodeType":"text","text":"たのをよい事にして、狐狸が棲む。盜人が棲む。とうとう","layout":{"rects":[{"x":0,"y":336,"width":416,"height":24}]}},{"nodeType":"text","text":"しまひには、引取り手のない死人を、この門へ持つて來","layout":{"rects":[{"x":0,"y":360,"width":400,"height":24}]}},{"nodeType":"text","text":"て、棄てゝ行くと云ふ習慣さへ出來た。そこで、日の目が","layout":{"rects":[{"x":0,"y":384,"width":416,"height":24}]}},{"nodeType":"text","text":"見えなくなると、誰でも氣味を惡るがつて、この門の近所","layout":{"rects":[{"x":0,"y":408,"width":416,"height":24}]}},{"nodeType":"text","text":"へは足ぶみをしない事になつてしまつたのである。","layout":{"rects":[{"x":0,"y":432,"width":368,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":456,"width":420,"height":288},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その代り又鴉が何處からか、たくさん集つて來た。晝間見","layout":{"rects":[{"x":0,"y":456,"width":416,"height":24}]}},{"nodeType":"text","text":"ると、その鴉が何羽となく輪を描いて高い鴟尾のまはりを","layout":{"rects":[{"x":0,"y":480,"width":416,"height":24}]}},{"nodeType":"text","text":"啼きながら、飛びまはつてゐる。殊に門の上の空が、夕燒","layout":{"rects":[{"x":0,"y":504,"width":416,"height":24}]}},{"nodeType":"text","text":"けであかくなる時には、それが胡麻をまいたやうにはつき","layout":{"rects":[{"x":0,"y":528,"width":416,"height":24}]}},{"nodeType":"text","text":"り見えた。鴉は、勿論、門の上にある死人の肉を、啄みに","layout":{"rects":[{"x":0,"y":552,"width":416,"height":24}]}},{"nodeType":"text","text":"來るのである。――尤も今日は、刻限が遲いせいか、一羽","layout":{"rects":[{"x":0,"y":576,"width":416,"height":24}]}},{"nodeType":"text","text":"も見えない。唯、所々、崩れかゝつた、さうしてその崩れ","layout":{"rects":[{"x":0,"y":600,"width":416,"height":24}]}},{"nodeType":"text","text":"目に長い草のはへた石段の上に、鴉の糞が、點々と白くこ","layout":{"rects":[{"x":0,"y":624,"width":416,"height":24}]}},{"nodeType":"text","text":"びりついてゐるのが見える。下人は七段ある石段の一番上","layout":{"rects":[{"x":0,"y":648,"width":416,"height":24}]}},{"nodeType":"text","text":"の段に洗ひざらした紺の襖の尻を据ゑて、右の頰に出來","layout":{"rects":[{"x":0,"y":672,"width":400,"height":24}]}},{"nodeType":"text","text":"た、大きな面皰を氣にしながら、ぼんやり、雨のふるのを","layout":{"rects":[{"x":0,"y":696,"width":416,"height":24}]}},{"nodeType":"text","text":"眺めてゐるのである。","layout":{"rects":[{"x":0,"y":720,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":744,"width":420,"height":408},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"作者はさつき、「下人が雨やみを待つてゐた」と書いた。","layout":{"rects":[{"x":0,"y":744,"width":416,"height":24}]}},{"nodeType":"text","text":"しかし、下人は、雨がやんでも格別どうしようと云ふ當て","layout":{"rects":[{"x":0,"y":768,"width":416,"height":24}]}},{"nodeType":"text","text":"はない。ふだんなら、勿論、主人の家へ歸る可き筈であ","layout":{"rects":[{"x":0,"y":792,"width":400,"height":24}]}},{"nodeType":"text","text":"る。所がその主人からは、四五日前に暇を出された。前に","layout":{"rects":[{"x":0,"y":816,"width":416,"height":24}]}},{"nodeType":"text","text":"も書いたやうに、當時京都の町は一通りならず衰微してゐ","layout":{"rects":[{"x":0,"y":840,"width":416,"height":24}]}},{"nodeType":"text","text":"た。今この下人が、永年、使はれてゐた主人から、暇を出","layout":{"rects":[{"x":0,"y":864,"width":416,"height":24}]}},{"nodeType":"text","text":"されたのも、この衰微の小さな餘波に外ならない。だから","layout":{"rects":[{"x":0,"y":888,"width":416,"height":24}]}},{"nodeType":"text","text":"「下人が雨やみを待つてゐた」と云ふよりも、「雨にふり","layout":{"rects":[{"x":0,"y":912,"width":416,"height":24}]}},{"nodeType":"text","text":"こめられた下人が、行き所がなくて、途方にくれてゐた」","layout":{"rects":[{"x":0,"y":936,"width":416,"height":24}]}},{"nodeType":"text","text":"と云ふ方が、適當である。その上、今日の空模樣も少から","layout":{"rects":[{"x":0,"y":960,"width":416,"height":24}]}},{"nodeType":"text","text":"ずこの平安朝の下人の Sentimentalisme に影響した。申","layout":{"rects":[{"x":0,"y":984,"width":406.36,"height":24}]}},{"nodeType":"text","text":"の刻下りからふり出した雨は、未に上るけしきがない。そ","layout":{"rects":[{"x":0,"y":1008,"width":416,"height":24}]}},{"nodeType":"text","text":"こで、下人は、何を措いても差當り明日の暮しをどうにか","layout":{"rects":[{"x":0,"y":1032,"width":416,"height":24}]}},{"nodeType":"text","text":"しようとして――云はゞどうにもならない事を、どうにか","layout":{"rects":[{"x":0,"y":1056,"width":416,"height":24}]}},{"nodeType":"text","text":"しようとして、とりとめもない考へをたどりながら、さつ","layout":{"rects":[{"x":0,"y":1080,"width":416,"height":24}]}},{"nodeType":"text","text":"きから朱雀大路にふる雨の音を、聞くともなく聞いてゐ","layout":{"rects":[{"x":0,"y":1104,"width":400,"height":24}]}},{"nodeType":"text","text":"た。","layout":{"rects":[{"x":0,"y":1128,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1152,"width":420,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"雨は、羅生門をつゝんで、遠くから、ざあつと云ふ音をあ","layout":{"rects":[{"x":0,"y":1152,"width":416,"height":24}]}},{"nodeType":"text","text":"つめて來る。夕闇は次第に空を低くして、見上げると、門","layout":{"rects":[{"x":0,"y":1176,"width":416,"height":24}]}},{"nodeType":"text","text":"の屋根が、斜につき出した甍の先に、重たくうす暗い雲を","layout":{"rects":[{"x":0,"y":1200,"width":416,"height":24}]}},{"nodeType":"text","text":"支へてゐる。","layout":{"rects":[{"x":0,"y":1224,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1248,"width":420,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"どうにもならない事を、どうにかする爲には、手段を選ん","layout":{"rects":[{"x":0,"y":1248,"width":416,"height":24}]}},{"nodeType":"text","text":"でゐる遑はない。選んでゐれば、築土の下か、道ばたの土","layout":{"rects":[{"x":0,"y":1272,"width":416,"height":24}]}},{"nodeType":"text","text":"の上で、饑死をするばかりである。さうして、この門の上","layout":{"rects":[{"x":0,"y":1296,"width":416,"height":24}]}},{"nodeType":"text","text":"へ持つて來て、犬のやうに棄てられてしまふばかりであ","layout":{"rects":[{"x":0,"y":1320,"width":400,"height":24}]}},{"nodeType":"text","text":"る。選ばないとすれば――下人の考へは、何度も同じ道を","layout":{"rects":[{"x":0,"y":1344,"width":416,"height":24}]}},{"nodeType":"text","text":"低徊した揚句に、やつとこの局所へ逢着した。しかしこの","layout":{"rects":[{"x":0,"y":1368,"width":416,"height":24}]}},{"nodeType":"text","text":"「すれば」は、何時までたつても、結局「すれば」であつ","layout":{"rects":[{"x":0,"y":1392,"width":416,"height":24}]}},{"nodeType":"text","text":"た。下人は、手段を選ばないといふ事を肯定しながらも、","layout":{"rects":[{"x":0,"y":1416,"width":416,"height":24}]}},{"nodeType":"text","text":"この「すれば」のかたをつける爲に、當然、その後に來る","layout":{"rects":[{"x":0,"y":1440,"width":416,"height":24}]}},{"nodeType":"text","text":"可き「盜人になるより外に仕方がない」と云ふ事を、積極","layout":{"rects":[{"x":0,"y":1464,"width":416,"height":24}]}},{"nodeType":"text","text":"的に肯定する丈の、勇氣が出ずにゐたのである。","layout":{"rects":[{"x":0,"y":1488,"width":352,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1512,"width":420,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、大きな嚏をして、それから、大儀さうに立上つ","layout":{"rects":[{"x":0,"y":1512,"width":400,"height":24}]}},{"nodeType":"text","text":"た。夕冷えのする京都は、もう火桶が欲しい程の寒さであ","layout":{"rects":[{"x":0,"y":1536,"width":416,"height":24}]}},{"nodeType":"text","text":"る。風は門の柱と柱との間を、夕闇と共に遠慮なく、吹き","layout":{"rects":[{"x":0,"y":1560,"width":416,"height":24}]}},{"nodeType":"text","text":"ぬける。丹塗の柱にとまつてゐた蟋蟀も、もうどこかへ行","layout":{"rects":[{"x":0,"y":1584,"width":416,"height":24}]}},{"nodeType":"text","text":"つてしまつた。","layout":{"rects":[{"x":0,"y":1608,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1632,"width":420,"height":216},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、頸をちゞめながら、山吹の汗衫に重ねた、紺の襖","layout":{"rects":[{"x":0,"y":1632,"width":416,"height":24}]}},{"nodeType":"text","text":"の肩を高くして門のまはりを見まはした。雨風の患のな","layout":{"rects":[{"x":0,"y":1656,"width":400,"height":24}]}},{"nodeType":"text","text":"い、人目にかゝる惧のない、一晚樂にねられさうな所があ","layout":{"rects":[{"x":0,"y":1680,"width":416,"height":24}]}},{"nodeType":"text","text":"れば、そこでともかくも、夜を明かさうと思つたからであ","layout":{"rects":[{"x":0,"y":1704,"width":416,"height":24}]}},{"nodeType":"text","text":"る。すると、幸門の上の樓へ上る、幅の廣い、之も丹を塗","layout":{"rects":[{"x":0,"y":1728,"width":416,"height":24}]}},{"nodeType":"text","text":"つた梯子が眼についた。上なら、人がゐたにしても、どう","layout":{"rects":[{"x":0,"y":1752,"width":416,"height":24}]}},{"nodeType":"text","text":"せ死人ばかりである。下人は、そこで腰にさげた聖柄の太","layout":{"rects":[{"x":0,"y":1776,"width":416,"height":24}]}},{"nodeType":"text","text":"刀が鞘走らないやうに氣をつけながら、藁草履をはいた足","layout":{"rects":[{"x":0,"y":1800,"width":416,"height":24}]}},{"nodeType":"text","text":"を、その梯子の一番下の段へふみかけた。","layout":{"rects":[{"x":0,"y":1824,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1848,"width":420,"height":288},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"それから、何分かの後である。羅生門の樓の上へ出る、幅","layout":{"rects":[{"x":0,"y":1848,"width":416,"height":24}]}},{"nodeType":"text","text":"の廣い梯子の中段に、一人の男が、猫のやうに身をちゞめ","layout":{"rects":[{"x":0,"y":1872,"width":416,"height":24}]}},{"nodeType":"text","text":"て、息を殺しながら、上の容子を窺つてゐた。樓の上から","layout":{"rects":[{"x":0,"y":1896,"width":416,"height":24}]}},{"nodeType":"text","text":"さす火の光が、かすかに、その男の右の頰をぬらしてゐ","layout":{"rects":[{"x":0,"y":1920,"width":400,"height":24}]}},{"nodeType":"text","text":"る。短い鬚の中に、赤く膿を持つた面皰のある頰である。","layout":{"rects":[{"x":0,"y":1944,"width":416,"height":24}]}},{"nodeType":"text","text":"下人は、始めから、この上にゐる者は、死人ばかりだと高","layout":{"rects":[{"x":0,"y":1968,"width":416,"height":24}]}},{"nodeType":"text","text":"を括つてゐた。それが、梯子を二三段上つて見ると、上で","layout":{"rects":[{"x":0,"y":1992,"width":416,"height":24}]}},{"nodeType":"text","text":"は誰か火をとぼして、しかもその火を其處此處と動かして","layout":{"rects":[{"x":0,"y":2016,"width":416,"height":24}]}},{"nodeType":"text","text":"ゐるらしい。これは、その濁つた、黃いろい光が、隅々に","layout":{"rects":[{"x":0,"y":2040,"width":416,"height":24}]}},{"nodeType":"text","text":"蜘蛛の巢をかけた天井裏に、ゆれながら映つたので、すぐ","layout":{"rects":[{"x":0,"y":2064,"width":416,"height":24}]}},{"nodeType":"text","text":"にそれと知れたのである。この雨の夜に、この羅生門の上","layout":{"rects":[{"x":0,"y":2088,"width":416,"height":24}]}},{"nodeType":"text","text":"で、火をともしてゐるからは、どうせ唯の者ではない。","layout":{"rects":[{"x":0,"y":2112,"width":400,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2136,"width":420,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、守宮のやうに足音をぬすんで、やつと急な梯子","layout":{"rects":[{"x":0,"y":2136,"width":400,"height":24}]}},{"nodeType":"text","text":"を、一番上の段まで這ふやうにして上りつめた。さうして","layout":{"rects":[{"x":0,"y":2160,"width":416,"height":24}]}},{"nodeType":"text","text":"體を出來る丈、平にしながら、頸を出來る丈、前へ出し","layout":{"rects":[{"x":0,"y":2184,"width":400,"height":24}]}},{"nodeType":"text","text":"て、恐る恐る、樓の內を覗いて見た。","layout":{"rects":[{"x":0,"y":2208,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2232,"width":420,"height":288},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"見ると、樓の內には、噂に聞いた通り、幾つかの屍骸が、","layout":{"rects":[{"x":0,"y":2232,"width":416,"height":24}]}},{"nodeType":"text","text":"無造作に棄てゝあるが、火の光の及ぶ範圍が、思つたより","layout":{"rects":[{"x":0,"y":2256,"width":416,"height":24}]}},{"nodeType":"text","text":"狹いので、數は幾つともわからない。唯、おぼろげなが","layout":{"rects":[{"x":0,"y":2280,"width":400,"height":24}]}},{"nodeType":"text","text":"ら、知れるのは、その中に裸の屍骸と、着物を着た屍骸と","layout":{"rects":[{"x":0,"y":2304,"width":416,"height":24}]}},{"nodeType":"text","text":"があると云ふ事である。勿論、中には女も男もまじつてゐ","layout":{"rects":[{"x":0,"y":2328,"width":416,"height":24}]}},{"nodeType":"text","text":"るらしい。さうして、その屍骸は皆、それが、甞、生きて","layout":{"rects":[{"x":0,"y":2352,"width":416,"height":24}]}},{"nodeType":"text","text":"ゐた人間だと云ふ事實さへ疑はれる程、土を捏ねて造つた","layout":{"rects":[{"x":0,"y":2376,"width":416,"height":24}]}},{"nodeType":"text","text":"人形のやうに、口を開いたり手を延ばしたりしてごろごろ","layout":{"rects":[{"x":0,"y":2400,"width":416,"height":24}]}},{"nodeType":"text","text":"床の上にころがつてゐた。しかも、肩とか胸とかの高くな","layout":{"rects":[{"x":0,"y":2424,"width":416,"height":24}]}},{"nodeType":"text","text":"つてゐる部分に、ぼんやりした火の光をうけて、低くなつ","layout":{"rects":[{"x":0,"y":2448,"width":416,"height":24}]}},{"nodeType":"text","text":"てゐる部分の影を一層暗くしながら、永久に啞の如く默つ","layout":{"rects":[{"x":0,"y":2472,"width":416,"height":24}]}},{"nodeType":"text","text":"ていた。","layout":{"rects":[{"x":0,"y":2496,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2520,"width":420,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、それらの屍骸の腐爛した臭氣に思はず、鼻を掩つ","layout":{"rects":[{"x":0,"y":2520,"width":416,"height":24}]}},{"nodeType":"text","text":"た。しかし、その手は、次の瞬間には、もう鼻を掩ふ事を","layout":{"rects":[{"x":0,"y":2544,"width":416,"height":24}]}},{"nodeType":"text","text":"忘れてゐた。或る强い感情が、殆悉この男の嗅覺を奪つて","layout":{"rects":[{"x":0,"y":2568,"width":416,"height":24}]}},{"nodeType":"text","text":"しまつたからである。","layout":{"rects":[{"x":0,"y":2592,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2616,"width":420,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人の眼は、その時、はじめて、其屍骸の中に蹲つている","layout":{"rects":[{"x":0,"y":2616,"width":416,"height":24}]}},{"nodeType":"text","text":"人間を見た。檜肌色の着物を著た、背の低い、瘦せた、白","layout":{"rects":[{"x":0,"y":2640,"width":416,"height":24}]}},{"nodeType":"text","text":"髮頭の、猿のやうな老婆である。その老婆は、右の手に火","layout":{"rects":[{"x":0,"y":2664,"width":416,"height":24}]}},{"nodeType":"text","text":"をともした松の木片を持つて、その屍骸の一つの顏を覗き","layout":{"rects":[{"x":0,"y":2688,"width":416,"height":24}]}},{"nodeType":"text","text":"こむやうに眺めてゐた。髮の毛の長い所を見ると、多分女","layout":{"rects":[{"x":0,"y":2712,"width":416,"height":24}]}},{"nodeType":"text","text":"の屍骸であらう。","layout":{"rects":[{"x":0,"y":2736,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2760,"width":420,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、六分の恐怖と四分の好奇心とに動かされて、暫時","layout":{"rects":[{"x":0,"y":2760,"width":416,"height":24}]}},{"nodeType":"text","text":"は呼吸をするのさへ忘れてゐた。舊記の記者の語を借りれ","layout":{"rects":[{"x":0,"y":2784,"width":416,"height":24}]}},{"nodeType":"text","text":"ば、「頭身の毛も太る」やうに感じたのである。すると、","layout":{"rects":[{"x":0,"y":2808,"width":416,"height":24}]}},{"nodeType":"text","text":"老婆は、松の木片を、床板の間に挿して、それから、今ま","layout":{"rects":[{"x":0,"y":2832,"width":416,"height":24}]}},{"nodeType":"text","text":"で眺めてゐた屍骸の首に兩手をかけると、丁度、猿の親が","layout":{"rects":[{"x":0,"y":2856,"width":416,"height":24}]}},{"nodeType":"text","text":"猿の子の虱をとるやうに、その長い髮の毛を一本づゝ拔き","layout":{"rects":[{"x":0,"y":2880,"width":416,"height":24}]}},{"nodeType":"text","text":"はじめた。髮は手に從つて拔けるらしい。","layout":{"rects":[{"x":0,"y":2904,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2928,"width":420,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その髮の毛が、一本ずゝ拔けるのに從つて下人の心から","layout":{"rects":[{"x":0,"y":2928,"width":400,"height":24}]}},{"nodeType":"text","text":"は、恐怖が少しづつ消えて行つた。さうして、それと同時","layout":{"rects":[{"x":0,"y":2952,"width":416,"height":24}]}},{"nodeType":"text","text":"に、この老婆に對するはげしい憎惡が、少しづゝ動いて來","layout":{"rects":[{"x":0,"y":2976,"width":416,"height":24}]}},{"nodeType":"text","text":"た。――いや、この老婆に對すると云つては、語弊がある","layout":{"rects":[{"x":0,"y":3000,"width":416,"height":24}]}},{"nodeType":"text","text":"かも知れない。寧、あらゆる惡に對する反感が、一分每に","layout":{"rects":[{"x":0,"y":3024,"width":416,"height":24}]}},{"nodeType":"text","text":"强さを增して來たのである。この時、誰かがこの下人に、","layout":{"rects":[{"x":0,"y":3048,"width":416,"height":24}]}},{"nodeType":"text","text":"さつき門の下でこの男が考へてゐた、饑死をするか盜人に","layout":{"rects":[{"x":0,"y":3072,"width":416,"height":24}]}},{"nodeType":"text","text":"なるかと云ふ問題を、改めて持出したら、恐らく下人は、","layout":{"rects":[{"x":0,"y":3096,"width":416,"height":24}]}},{"nodeType":"text","text":"何の未練もなく、饑死を選んだ事であらう。それほど、こ","layout":{"rects":[{"x":0,"y":3120,"width":416,"height":24}]}},{"nodeType":"text","text":"の男の惡を憎む心は、老婆の床に挿した松の木片のやう","layout":{"rects":[{"x":0,"y":3144,"width":400,"height":24}]}},{"nodeType":"text","text":"に、勢よく燃え上り出してゐたのである。","layout":{"rects":[{"x":0,"y":3168,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3192,"width":420,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人には、勿論、何故老婆が死人の髮の毛を拔くかわから","layout":{"rects":[{"x":0,"y":3192,"width":416,"height":24}]}},{"nodeType":"text","text":"なかつた。從つて、合理的には、それを善惡の何れに片づ","layout":{"rects":[{"x":0,"y":3216,"width":416,"height":24}]}},{"nodeType":"text","text":"けてよいか知らなかつた。しかし下人にとつては、この雨","layout":{"rects":[{"x":0,"y":3240,"width":416,"height":24}]}},{"nodeType":"text","text":"の夜に、この羅生門の上で、死人の髮の毛を拔くと云ふ事","layout":{"rects":[{"x":0,"y":3264,"width":416,"height":24}]}},{"nodeType":"text","text":"が、それ丈で既に許す可らざる惡であつた。勿論、下人","layout":{"rects":[{"x":0,"y":3288,"width":400,"height":24}]}},{"nodeType":"text","text":"は、さつき迄自分が、盜人になる氣でゐた事なぞは、とう","layout":{"rects":[{"x":0,"y":3312,"width":416,"height":24}]}},{"nodeType":"text","text":"に忘れてゐるのである。","layout":{"rects":[{"x":0,"y":3336,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3360,"width":420,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"そこで、下人は、兩足に力を入れて、いきなり、梯子から","layout":{"rects":[{"x":0,"y":3360,"width":416,"height":24}]}},{"nodeType":"text","text":"上へ飛び上つた。さうして聖柄の太刀に手をかけながら、","layout":{"rects":[{"x":0,"y":3384,"width":416,"height":24}]}},{"nodeType":"text","text":"大股に老婆の前へ步みよつた。老婆が驚いたのは、云ふ迄","layout":{"rects":[{"x":0,"y":3408,"width":416,"height":24}]}},{"nodeType":"text","text":"もない。","layout":{"rects":[{"x":0,"y":3432,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3456,"width":420,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆は、一目下人を見ると、まるで弩にでも彈かれたやう","layout":{"rects":[{"x":0,"y":3456,"width":416,"height":24}]}},{"nodeType":"text","text":"に、飛び上つた。","layout":{"rects":[{"x":0,"y":3480,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3504,"width":420,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「おのれ、どこへ行く。」","layout":{"rects":[{"x":0,"y":3504,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3528,"width":420,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆が屍骸につまづきながら、慌てふためいて逃","layout":{"rects":[{"x":0,"y":3528,"width":416,"height":24}]}},{"nodeType":"text","text":"げようとする行手を塞いで、こう罵つた。老婆は、それで","layout":{"rects":[{"x":0,"y":3552,"width":416,"height":24}]}},{"nodeType":"text","text":"も下人をつきのけて行かうとする。下人は又、それを行か","layout":{"rects":[{"x":0,"y":3576,"width":416,"height":24}]}},{"nodeType":"text","text":"すまいとして、押しもどす。二人は屍骸の中で、暫、無言","layout":{"rects":[{"x":0,"y":3600,"width":416,"height":24}]}},{"nodeType":"text","text":"のまゝ、つかみ合つた。しかし勝敗は、はじめから、わか","layout":{"rects":[{"x":0,"y":3624,"width":416,"height":24}]}},{"nodeType":"text","text":"つている。下人はとうとう、老婆の腕をつかんで、無理に","layout":{"rects":[{"x":0,"y":3648,"width":416,"height":24}]}},{"nodeType":"text","text":"そこへ扭ぢ倒した。丁度、鷄の脚のやうな、骨と皮ばかり","layout":{"rects":[{"x":0,"y":3672,"width":416,"height":24}]}},{"nodeType":"text","text":"の腕である。","layout":{"rects":[{"x":0,"y":3696,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3720,"width":420,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「何をしてゐた。さあ何をしてゐた。云へ。云はぬと、こ","layout":{"rects":[{"x":0,"y":3720,"width":416,"height":24}]}},{"nodeType":"text","text":"れだぞよ。」","layout":{"rects":[{"x":0,"y":3744,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3768,"width":420,"height":288},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆をつき放すと、いきなり、太刀の鞘を拂つ","layout":{"rects":[{"x":0,"y":3768,"width":400,"height":24}]}},{"nodeType":"text","text":"て、白い鋼の色をその眼の前へつきつけた。けれども、老","layout":{"rects":[{"x":0,"y":3792,"width":416,"height":24}]}},{"nodeType":"text","text":"婆は默つてゐる。兩手をわなわなふるはせて、肩で息を切","layout":{"rects":[{"x":0,"y":3816,"width":416,"height":24}]}},{"nodeType":"text","text":"りながら、眼を、眼球が眶の外へ出さうになる程、見開い","layout":{"rects":[{"x":0,"y":3840,"width":416,"height":24}]}},{"nodeType":"text","text":"て、啞のやうに執拗く默つてゐる。これを見ると、下人は","layout":{"rects":[{"x":0,"y":3864,"width":416,"height":24}]}},{"nodeType":"text","text":"始めて明白にこの老婆の生死が、全然、自分の意志に支配","layout":{"rects":[{"x":0,"y":3888,"width":416,"height":24}]}},{"nodeType":"text","text":"されてゐると云ふ事を意識した。さうして、この意識は、","layout":{"rects":[{"x":0,"y":3912,"width":416,"height":24}]}},{"nodeType":"text","text":"今まではげしく燃えてゐた憎惡の心を何時の間にか冷まし","layout":{"rects":[{"x":0,"y":3936,"width":416,"height":24}]}},{"nodeType":"text","text":"てしまつた。後に殘つたのは、唯、或仕事をして、それが","layout":{"rects":[{"x":0,"y":3960,"width":416,"height":24}]}},{"nodeType":"text","text":"圓滿に成就した時の、安らかな得意と滿足とがあるばかり","layout":{"rects":[{"x":0,"y":3984,"width":416,"height":24}]}},{"nodeType":"text","text":"である。そこで、下人は、老婆を見下しながら、少し聲を","layout":{"rects":[{"x":0,"y":4008,"width":416,"height":24}]}},{"nodeType":"text","text":"柔げてかう云つた。","layout":{"rects":[{"x":0,"y":4032,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4056,"width":420,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「己は檢非違使の廳の役人などではない。今し方この門の","layout":{"rects":[{"x":0,"y":4056,"width":416,"height":24}]}},{"nodeType":"text","text":"下を通りかゝつた旅の者だ。だからお前に繩をかけて、ど","layout":{"rects":[{"x":0,"y":4080,"width":416,"height":24}]}},{"nodeType":"text","text":"うしようと云ふやうな事はない。唯、今時分、この門の上","layout":{"rects":[{"x":0,"y":4104,"width":416,"height":24}]}},{"nodeType":"text","text":"で、何をして居たのだか、それを己に話しさへすればいい","layout":{"rects":[{"x":0,"y":4128,"width":416,"height":24}]}},{"nodeType":"text","text":"のだ。」","layout":{"rects":[{"x":0,"y":4152,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4176,"width":420,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"すると、老婆は、見開いてゐた眼を、一層大きくして、ぢ","layout":{"rects":[{"x":0,"y":4176,"width":416,"height":24}]}},{"nodeType":"text","text":"つとその下人の顏を見守つた。眶の赤くなつた、肉食鳥の","layout":{"rects":[{"x":0,"y":4200,"width":416,"height":24}]}},{"nodeType":"text","text":"やうな、銳い眼で見たのである。それから、皺で、殆、鼻","layout":{"rects":[{"x":0,"y":4224,"width":416,"height":24}]}},{"nodeType":"text","text":"と一つになつた唇を、何か物でも嚙んでゐるやうに動かし","layout":{"rects":[{"x":0,"y":4248,"width":416,"height":24}]}},{"nodeType":"text","text":"た。細い喉で、尖つた喉佛の動いてゐるのが見える。その","layout":{"rects":[{"x":0,"y":4272,"width":416,"height":24}]}},{"nodeType":"text","text":"時、その喉から、鴉の啼くやうな聲が、喘ぎ喘ぎ、下人の","layout":{"rects":[{"x":0,"y":4296,"width":416,"height":24}]}},{"nodeType":"text","text":"耳へ傳はつて來た。","layout":{"rects":[{"x":0,"y":4320,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4344,"width":420,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「この髮を拔いてな、この女の髮を拔いてな、鬘にせうと","layout":{"rects":[{"x":0,"y":4344,"width":416,"height":24}]}},{"nodeType":"text","text":"思うたのぢや。」","layout":{"rects":[{"x":0,"y":4368,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4392,"width":420,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆の答が存外、平凡なのに失望した。さうして","layout":{"rects":[{"x":0,"y":4392,"width":416,"height":24}]}},{"nodeType":"text","text":"失望すると同時に、又前の憎惡が、冷な侮蔑と一しよに、","layout":{"rects":[{"x":0,"y":4416,"width":416,"height":24}]}},{"nodeType":"text","text":"心の中へはいつて來た。すると、その氣色が、先方へも通","layout":{"rects":[{"x":0,"y":4440,"width":416,"height":24}]}},{"nodeType":"text","text":"じたのであらう。老婆は、片手に、まだ屍骸の頭から奪つ","layout":{"rects":[{"x":0,"y":4464,"width":416,"height":24}]}},{"nodeType":"text","text":"た長い拔け毛を持つたなり、蟇のつぶやくやうな聲で、口","layout":{"rects":[{"x":0,"y":4488,"width":416,"height":24}]}},{"nodeType":"text","text":"ごもりながら、こんな事を云つた。","layout":{"rects":[{"x":0,"y":4512,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4536,"width":420,"height":384},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"成程、死人の髮の毛を拔くと云ふ事は、惡い事かも知れ","layout":{"rects":[{"x":0,"y":4536,"width":400,"height":24}]}},{"nodeType":"text","text":"ぬ。しかし、かう云ふ死人の多くは、皆、その位な事を、","layout":{"rects":[{"x":0,"y":4560,"width":416,"height":24}]}},{"nodeType":"text","text":"されてもいゝ人間ばかりである。現に、自分が今、髮を拔","layout":{"rects":[{"x":0,"y":4584,"width":416,"height":24}]}},{"nodeType":"text","text":"いた女などは、蛇を四寸ばかりづゝに切つて干したのを、","layout":{"rects":[{"x":0,"y":4608,"width":416,"height":24}]}},{"nodeType":"text","text":"干魚だと云つて、太刀帶の陣へ賣りに行つた。疫病にかゝ","layout":{"rects":[{"x":0,"y":4632,"width":416,"height":24}]}},{"nodeType":"text","text":"つて死ななかつたなら、今でも賣りに行つてゐたかもしれ","layout":{"rects":[{"x":0,"y":4656,"width":416,"height":24}]}},{"nodeType":"text","text":"ない。しかも、この女の賣る干魚は、味がよいと云ふの","layout":{"rects":[{"x":0,"y":4680,"width":400,"height":24}]}},{"nodeType":"text","text":"で、太刀帶たちが、缺かさず菜料に買つてゐたのである。","layout":{"rects":[{"x":0,"y":4704,"width":416,"height":24}]}},{"nodeType":"text","text":"自分は、この女のした事が惡いとは思はない。しなけれ","layout":{"rects":[{"x":0,"y":4728,"width":400,"height":24}]}},{"nodeType":"text","text":"ば、饑死をするので、仕方がなくした事だからである。だ","layout":{"rects":[{"x":0,"y":4752,"width":416,"height":24}]}},{"nodeType":"text","text":"から、又今、自分のしてゐた事も惡い事とは思はない。こ","layout":{"rects":[{"x":0,"y":4776,"width":416,"height":24}]}},{"nodeType":"text","text":"れもやはりしなければ、饑死をするので、仕方がなくする","layout":{"rects":[{"x":0,"y":4800,"width":416,"height":24}]}},{"nodeType":"text","text":"事だからである。さうして、その仕方がない事を、よく知","layout":{"rects":[{"x":0,"y":4824,"width":416,"height":24}]}},{"nodeType":"text","text":"つてゐたこの女は、自分のする事を許してくれるのにちが","layout":{"rects":[{"x":0,"y":4848,"width":416,"height":24}]}},{"nodeType":"text","text":"ひないと思ふからである。――老婆は、大體こんな意味の","layout":{"rects":[{"x":0,"y":4872,"width":416,"height":24}]}},{"nodeType":"text","text":"事を云つた。","layout":{"rects":[{"x":0,"y":4896,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4920,"width":420,"height":288},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、太刀を鞘におさめて、その太刀の柄を左の手でお","layout":{"rects":[{"x":0,"y":4920,"width":416,"height":24}]}},{"nodeType":"text","text":"さへながら、冷然として、この話を聞いてゐた。勿論、右","layout":{"rects":[{"x":0,"y":4944,"width":416,"height":24}]}},{"nodeType":"text","text":"の手では、赤く頰に膿を持つた大きな面皰を氣にしなが","layout":{"rects":[{"x":0,"y":4968,"width":400,"height":24}]}},{"nodeType":"text","text":"ら、聞いてゐるのである。しかし、之を聞いてゐる中に、","layout":{"rects":[{"x":0,"y":4992,"width":416,"height":24}]}},{"nodeType":"text","text":"下人の心には、或勇氣が生まれて來た。それは、さつき、","layout":{"rects":[{"x":0,"y":5016,"width":416,"height":24}]}},{"nodeType":"text","text":"門の下でこの男に缺けてゐた勇氣である。さうして、又さ","layout":{"rects":[{"x":0,"y":5040,"width":416,"height":24}]}},{"nodeType":"text","text":"つき、この門の上へ上つて、この老婆を捕へた時の勇氣と","layout":{"rects":[{"x":0,"y":5064,"width":416,"height":24}]}},{"nodeType":"text","text":"は、全然、反對な方向に動かうとする勇氣である。下人","layout":{"rects":[{"x":0,"y":5088,"width":400,"height":24}]}},{"nodeType":"text","text":"は、饑死をするか盜人になるかに迷はなかつたばかりでは","layout":{"rects":[{"x":0,"y":5112,"width":416,"height":24}]}},{"nodeType":"text","text":"ない。その時のこの男の心もちから云へば、饑死などと云","layout":{"rects":[{"x":0,"y":5136,"width":416,"height":24}]}},{"nodeType":"text","text":"ふ事は、殆、考へる事さへ出來ない程、意識の外に追ひ出","layout":{"rects":[{"x":0,"y":5160,"width":416,"height":24}]}},{"nodeType":"text","text":"されてゐた。","layout":{"rects":[{"x":0,"y":5184,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5208,"width":420,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「きつと、そうか。」","layout":{"rects":[{"x":0,"y":5208,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5232,"width":420,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆の話が完ると、下人は嘲るやうな聲で念を押した。さ","layout":{"rects":[{"x":0,"y":5232,"width":416,"height":24}]}},{"nodeType":"text","text":"うして、一足前へ出ると、不意に、右の手を面皰から離し","layout":{"rects":[{"x":0,"y":5256,"width":416,"height":24}]}},{"nodeType":"text","text":"て、老婆の襟上をつかみながら、かう云つた。","layout":{"rects":[{"x":0,"y":5280,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5304,"width":420,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「では、己が引剝をしようと恨むまいな。己もさうしなけ","layout":{"rects":[{"x":0,"y":5304,"width":416,"height":24}]}},{"nodeType":"text","text":"れば、饑死をする體なのだ。」","layout":{"rects":[{"x":0,"y":5328,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5352,"width":420,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、すばやく、老婆の着物を剝ぎとつた。それから、","layout":{"rects":[{"x":0,"y":5352,"width":416,"height":24}]}},{"nodeType":"text","text":"足にしがみつかうとする老婆を、手荒く屍骸の上へ蹴倒し","layout":{"rects":[{"x":0,"y":5376,"width":416,"height":24}]}},{"nodeType":"text","text":"た。梯子の口までは、僅に五步を數へるばかりである。下","layout":{"rects":[{"x":0,"y":5400,"width":416,"height":24}]}},{"nodeType":"text","text":"人は、剝ぎとつた檜肌色の着物をわきにかゝへて、またゝ","layout":{"rects":[{"x":0,"y":5424,"width":416,"height":24}]}},{"nodeType":"text","text":"く間に急な梯子を夜の底へかけ下りた。","layout":{"rects":[{"x":0,"y":5448,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5472,"width":420,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"暫、死んだやうに倒れてゐた老婆が、屍骸の中から、その","layout":{"rects":[{"x":0,"y":5472,"width":416,"height":24}]}},{"nodeType":"text","text":"裸の體を起したのは、それから間もなくの事である。老婆","layout":{"rects":[{"x":0,"y":5496,"width":416,"height":24}]}},{"nodeType":"text","text":"は、つぶやくやうな、うめくやうな聲を立てながら、まだ","layout":{"rects":[{"x":0,"y":5520,"width":416,"height":24}]}},{"nodeType":"text","text":"燃えてゐる火の光をたよりに、梯子の口まで、這つて行つ","layout":{"rects":[{"x":0,"y":5544,"width":416,"height":24}]}},{"nodeType":"text","text":"た。さうして、そこから、短い白髮を倒にして、門の下を","layout":{"rects":[{"x":0,"y":5568,"width":416,"height":24}]}},{"nodeType":"text","text":"覗きこんだ。外には、唯、黑洞々たる夜があるばかりであ","layout":{"rects":[{"x":0,"y":5592,"width":416,"height":24}]}},{"nodeType":"text","text":"る。","layout":{"rects":[{"x":0,"y":5616,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5640,"width":420,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、既に、雨を冐して、京都の町へ强盜を働きに急い","layout":{"rects":[{"x":0,"y":5640,"width":416,"height":24}]}},{"nodeType":"text","text":"でゐた。","layout":{"rects":[{"x":0,"y":5664,"width":64,"height":24}]}}]}]}]}]}}