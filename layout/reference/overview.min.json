    max-width: 960px;\n      margin: 0 auto;\n    }\n\n    /* Cards */\n    .card {\n      background: #fff;\n      border-radius: 16px;\n      padding: 24px;\n      box-shadow: 0 2px 12px rgba(0,0,0,0.06);\n    }\n    .card h2 {\n      font-size: 1.25rem;\n      font-weight: 600;\n      margin-bottom: 16px;\n    }\n    .card h3 {\n      font-size: 0.8rem;\n      font-weight: 500;\n      color: #888;\n      margin-bottom: 10px;\n    }\n    .card-section {\n      border: 1.5px dashed #c8d0e0;\n      border-radius: 12px;\n      padding: 16px;\n      margin-bottom: 12px;\n    }\n    .card-section:last-child { margin-bottom: 0; }\n    .card-cols {\n      display: flex;\n      gap: 16px;\n    }\n    .card-cols > div { flex: 1; min-width: 0; }\n\n    /* Spans 2 columns */\n    .span-2 { grid-column: span 2; }\n    .span-row-2 { grid-row: span 2; }\n\n    /* Helpers */\n    .row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }\n    .row:last-child { margin-bottom: 0; }\n    .label { font-size: 0.8rem; color: #666; min-width: 50px; }\n    .vstack { display: flex; flex-direction: column; gap: 8px; }\n    .center { display: flex; justify-content: center; align-items: center; }\n\n    /* Override some puppertino spacing for compact display */\n    .card .p-btn { margin: 4px; font-size: 14px; }\n    .card .p-form-text, .card .p-form-text-alt { margin: 4px; font-size: 13px; width: 160px; }\n    .card .p-form-radio-cont, .card .p-form-checkbox-cont { margin: 0 6px; font-size: 13px; }\n    .card .p-form-switch { --width: 50px; }\n    .card .p-segmented-controls { margin-top: 0; }\n  ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":1610},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":30,"y":40,"width":1140,"height":104},"computed":{"display":"block","textAlign":"center"}