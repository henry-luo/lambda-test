\ncanvas { display: block; background: currentcolor }\n.test.width canvas,  .test.min-width canvas,  .test.max-width canvas  { width:  100% }\n.test.height canvas, .test.min-height canvas, .test.max-height canvas { height: 100% }\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":8,"y":8,"width":1184,"height":6000},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":100,"height":100},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":13,"y":13,"width":90,"height":90},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"XX ","layout":{"rects":[{"x":18,"y":18,"width":40,"height":20}]}},{"nodeType":"text","text":"XX","layout":{"rects":[{"x":18,"y":38,"width":40,"height":20}]}}]}]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":108,"width":100,"height":100},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":13,"y":113,"width":50,"height":90},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"XX ","layout":{"rects":[{"x":18,"y":118,"width":40,"height":20}]}},{"nodeType":"text","text":"XX","layout":{"rects":[{"x":18,"y":138,"width":40,"height":20}]}}]}]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":208,"width":100,"height":100},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":13,"y":213,"width":90,"height":90},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"XX ","layout":{"rects":[{"x":18,"y":218,"width":40,"height":20}]}},{"nodeType":"text","text":"XX","layout":{