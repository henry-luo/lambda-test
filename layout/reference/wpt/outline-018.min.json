{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":8},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"CSS Basic User Interface Test: non interpolable outline-style animation","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"link","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"link","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"link","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n@keyframes outline-anim {\n  from {\n    outline: solid 1px black;\n  }\n  to {\n    outline: dotted 1px black;\n  }\n}\n\n#test1 {\n  animation: outline-anim 3s 0s paused linear;\n  outline: solid 1px black;\n}\n#test2 {\n  animation: outline-anim 3s -1s paused linear;\n  outline: solid 1px black;\n}\n#test3 {\n  animation: outline-anim 3s -2s paused linear;\n  outline: solid 1px black;\n}\n#test4 {\n  animation: outline-anim 3s 0s paused reverse linear;\n  outline: solid 1px black;\n}\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n                    *, *::before, *::after {\n                        animation-duration: 0s !important;\n                        animation-delay: 0s !important;\n                        transition-duration: 0s !important;\n                        transition-delay: 0s !important;\n                    }\n                ","layout":{"rects":[]}}]}]},{"nodeType":"element","tag":"body","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n    // outline being a render-only property, its animation can be done off the main thread\n    // checking the values after the first paint is safer, hence requestAnimationFrame\n    setup({explicit_done:true});\n    requestAnimationFrame(function() {\n      // synchronous tests being run during the page's first paint\n      test(\n        function(){\n          var tests = document.querySelectorAll(\"div[id^='test']\");\n          assert_equals(getComputedStyle(tests[0]).outlineStyle, 'solid');\n          assert_equals(getComputedStyle(tests[1]).outlineStyle, 'solid');\n          assert_equals(getComputedStyle(tests[2]).outlineStyle, 'dotted');\n          assert_equals(getComputedStyle(tests[3]).outlineStyle, 'dotted');\n        }, \"outline-style is animated as a discrete type\"\n      );\n      done();\n    });\n","layout":{"rects":[]}}]}]}]}}