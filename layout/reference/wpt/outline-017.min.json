{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":8},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"CSS Basic User Interface Test: interpolable outline-* properties animation","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"link","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"link","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"link","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n@keyframes outline-anim {\n  from {\n    outline: solid 1px rgba(1, 0, 0, 0.5);\n    outline-offset: 1px;\n  }\n  to {\n    outline: solid 3px rgba(3, 0, 0, 0.5);\n    outline-offset: 3px;\n  }\n}\n\n#test {\n  animation: outline-anim 3s -1.5s paused linear;\n  outline: solid 1px rgba(1, 0, 0, 0.5);\n  outline-offset: 1px;\n}\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n                    *, *::before, *::after {\n                        animation-duration: 0s !important;\n                        animation-delay: 0s !important;\n                        transition-duration: 0s !important;\n                        transition-delay: 0s !important;\n                    }\n                ","layout":{"rects":[]}}]}]},{"nodeType":"element","tag":"body","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n    // outline being a render-only property, its animation can be done off the main thread\n    // checking the values after the first paint is safer, hence requestAnimationFrame\n    setup({explicit_done:true});\n    requestAnimationFrame(function() {\n        // synchronous tests being run during the page's first paint\n        test(\n          function(){\n            var test = document.getElementById(\"test\");\n            assert_equals(getComputedStyle(test).outlineColor, 'rgba(2, 0, 0, 0.5)');\n          }, \"outline-color is animated as a color\");\n        test(\n          function(){\n            var test = document.getElementById(\"test\");\n            assert_equals(getComputedStyle(test).outlineWidth, '2px');\n          }, \"outline-width is animated as a length\");\n        test(\n          function(){\n            var test = document.getElementById(\"test\");\n            assert_equals(getComputedStyle(test).outlineOffset, '2px');\n          }, \"outline-offset is animated as a length\");\n        done();\n    });\n","layout":{"rects":[]}}]}]}]}}