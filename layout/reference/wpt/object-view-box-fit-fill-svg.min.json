{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":130},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"CSS object-view-box with object-fit:fill","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"link","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"link","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"link","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":8,"y":8,"width":1184,"height":114},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n/* The test uses clip-path to avoid comparing edges with minor pixel differences\n   due to differences in scaling on highdpi devices */\n\n.view_box_subset {\n  object-view-box: inset(50px 0px 0px 0px);\n  object-fit: fill;\n  margin: 5px;\n  clip-path: inset(1px 0px 0px 0px);\n}\n\n.view_box_subset_with_position {\n  object-view-box: inset(50px 0px 0px 0px);\n  object-fit: fill;\n  margin: 5px;\n  object-position: 10px 10px;\n  background-color: grey;\n}\n\n.view_box_subset_with_scaling {\n  object-view-box: inset(50px 0px 0px 0px);\n  object-fit: fill;\n  margin: 5px;\n  width: 50px;\n  height: 100px;\n\n  /* The top row of pixels can have minor differences due to difference in order\n     of clipping and scaling operations */\n  clip-path: inset(1px 0px 0px 0px);\n}\n\n.view_box_superset {\n  object-view-box: inset(0px -50px 0px 0px);\n  object-fit: fill;\n  margin: 5px;\n  background-color: grey;\n}\n\n.view_box_superset_with_position {\n  object-view-box: inset(0px -50px 0px 0px);\n  object-fit: fill;\n  margin: 5px;\n  background-color: grey;\n  object-position: 10px 10px;\n}\n\n.view_box_superset_with_scaling {\n  object-view-box: inset(0px -50px 0px 0px);\n  object-fit: fill;\n  margin: 5px;\n  background-color: grey;\n  width: 50px;\n  height: 50px;\n}\n\n.view_box_intersection {\n  object-view-box: inset(-50px 25px 50px 0px);\n  object-fit: fill;\n  margin: 5px;\n  background-color: grey;\n  clip-path: inset(0px 0px 1px 0px);\n}\n\n.view_box_no_intersection {\n  object-view-box: inset(-50px 25px 100px 0px);\n  object-fit: fill;\n  margin: 5px;\n  background-color: grey;\n}\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"img","layout":{"x":13,"y":113,"width":0,"height":0},"computed":{"display":"inline","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[{"x":18,"y":104,"width":4,"height":18}]}},{"nodeType":"element","tag":"img","layout":{"x":27,"y":113,"width":0,"height":0},"computed":{"display":"inline","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[{"x":32,"y":104,"width":4,"height":18}]}},{"nodeType":"element","tag":"img","layout":{"x":41,"y":13,"width":50,"height":100},"computed":{"display":"inline","textAlign":"start"},"children":[]},{"n