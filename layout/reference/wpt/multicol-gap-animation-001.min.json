:{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n  #multicol {\n    column-gap: 0px;\n  }\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n    test(\n      function(){\n        var multicol = document.getElementById(\"multicol\");\n        assert_equals(getComputedStyle(multicol).columnGap, \"0px\");\n\n        var keyframes = [\n          { columnGap: \"100px\" },\n          { columnGap: \"200px\" }\n        ];\n        var options = {\n          duration: 10,\n          fill: \"forwards\",\n          easing: \"linear\"\n        };\n\n        var player = multicol.animate(keyframes, options);\n        player.pause();\n        player.currentTime = 0;\n        assert_equals(getComputedStyle(multicol).columnGap, \"100px\");\n        player.currentTime = 5;\n        assert_equals(getComputedStyle(multicol).columnGap, \"150px\");\n        player.currentTime = 10;\n        assert_equals(getComputedStyle(multicol).columnGap, \"200px\");\n      }, \"column-gap property is animatable\");\n  ","layout":{"rects":[]}}]}]}]}}