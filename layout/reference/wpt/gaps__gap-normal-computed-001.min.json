"\n#col,\n#grid,\n#flex {\n  /* Not using the shorthand because that's not what we're interested in,\n     and there are implementations that support column-gap without supporting the shorthand */\n  colum-gap: normal;\n  row-gap: normal;\n  float: right; /* for shrinkwrap*/\n}\n#col {\n  column-count: 2;\n  column-width: 50px;\n}\n#grid {\n  display: grid;\n  grid-template-columns: 50px 50px;\n  grid-template-rows: 50px 50px;\n}\n#flex {\n  display: flex;\n}\n#flex * { width: 50px; height: 50px;}\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n                    *, *::before, *::after {\n                        animation-duration: 0s !important;\n                        animation-delay: 0s !important;\n                        transition-duration: 0s !important;\n                        transition-delay: 0s !important;\n                    }\n                ","layout":{"rects":[]}}]}]},{"nodeType":"element","tag":"body","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":1076,"y":8,"width":116,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":1092,"y":8,"width":100,"height":100},"computed":{"display":"grid","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":992,"y":8,"width":100,"height":50},"computed":{"display":"flex","textAlign":"start"},"children":[{"nodeType":"element","tag":"span","layout":{"x":992,"y":8,"width":50,"height":50},"selector":"span:nth-of-type(1)","computed":{"display":"block","textAlign":