test {\n  position: absolute;\n  width: 100px;\n  height: 100px;\n  background: orange;\n  overflow: hidden;\n  resize: both;\n}\n#target {\n  position: absolute;\n  width: 150px;\n  height: 150px;\n  background: blue;\n}\n#log { margin-top: 200px; }\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n                    *, *::before, *::after {\n                        animation-duration: 0s !important;\n                        animation-delay: 0s !important;\n                        transition-duration: 0s !important;\n                        transition-delay: 0s !important;\n                    }\n                ","layout":{"rects":[]}}]}]},{"nodeType":"element","tag":"body","layout":{"x":8,"y":16,"width":1184,"height":55},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"p","layout":{"x":8,"y":16,"width":1184,"height":18},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Enlarge the orange box so that it at least covers the blue box entirely, then press the “done” button.","layout":{"rects":[{"x":8,"y":16,"width":631.38,"height":17}]}}]},{"nodeType":"element","tag":"button","layout":{"x":8,"y":50,"width":45.66,"height":21},"computed":{"display":"inline-block","textAlign":"center"},"children":[{"nodeType":"text","text":"done","layout":{"rects":[{"x":16,"y":53,"width":29.66,"height":15}]}}]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":71,"width":150,"height":150},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":71,"width":100,"height":100},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"div","layout":{"x":8,"y":271,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[]},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\nsetup({ explicit_done: true });\nfunction verify() {\n  test(\n    function(){\n      var test = document.getElementById(\"test\");\n      assert_regexp_match(test.style.width, /px$/, \"The width property of the style attribute should be set in pixels\");\n      assert_not_equals(test.style.width, \"100px\", \"The width should be different from the initial one\");\n      assert_regexp_match(test.style.height, /px$/, \"The height property of the style attribute should be set in pixels\");\n      assert_not_equals(test.style.height, \"100px\", \"The height should be different from the initial one\");\n    }, \"resize works by setting the width and height properties on the style attrbute in pixels\");\n  test(\n    function(){\n      var test = document.getElementById(\"test\");\n      assert_false(test.getAttribute(\"style\").includes(\"important\"));\n    }, \"resize does not set !important\");\n  done();\n}\n","layout":{"rects":[]}}]}]}]}}