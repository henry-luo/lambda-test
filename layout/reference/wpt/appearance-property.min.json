lement","tag":"body","layout":{"x":8,"y":8,"width":1184,"height":0},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\nfunction create(initialValue) {\n  var style = document.createElement('input').style;\n\n  style.setProperty('appearance', initialValue);\n\n  return style;\n}\n\ntest(function() {\n  var style = create('');\n\n  style.setProperty('appearance', 'none');\n\n  assert_equals(style.appearance, 'none');\n}, 'setProperty');\n\ntest(function() {\n  var style = create('none');\n\n  style.removeProperty('appearance');\n\n  assert_equals(style.appearance, '');\n}, 'removeProperty');\n\ntest(function() {\n  var style = create('');\n\n  style['appearance'] = 'none';\n\n  assert_equals(style.appearance, 'none');\n}, 'property assignment');\n\ntest(function() {\n  var style = create('none');\n\n  assert_equals(style.getPropertyValue('appearance'), 'none');\n}, 'getPropertyValue');\n\ntest(function() {\n  var style = create('none');\n\n  assert_equals(style['appearance'], 'none');\n}, 'property access');\n","layout":{"rects":[]}}]}]}]}}