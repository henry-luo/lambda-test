children":[]},{"nodeType":"element","tag":"script","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\nasync_test(t => {\n  window.addEventListener('message', t.step_func(e => {\n    const type = e.data.type;\n    if (type === 'DOMContentLoaded') {\n      // The resize may not be synchronous, so wait for an animation frame.\n      requestAnimationFrame(t.step_func(() => {\n        assert_equals(target.offsetHeight, 200);\n      }));\n    } else if (type === 'load') {\n      requestAnimationFrame(t.step_func(() => {\n        assert_equals(target.offsetHeight, 400);\n        t.done();\n      }));\n    }\n  }));\n}, \"`DOMContentLoaded` triggers resizing\");\n","layout":{"rects":[]}}]}]}]}}