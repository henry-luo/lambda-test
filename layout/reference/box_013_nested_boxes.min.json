{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":800},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n    ","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n    ","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n    ","layout":{"rects":[]}},{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"Test: Nested Box Models","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n    ","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n        /* Reset for consistency */\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Arial', sans-serif; font-size: 16px; }\n        \n        /* Test container */\n        .test-container {\n            width: 800px;\n            height: 800px;\n            border: 2px solid #333;\n            padding: 20px;\n            background-color: #f9f9f9;\n        }\n        \n        /* Test-specific CSS */\n        .nested-test {\n            margin: 20px 0;\n            padding: 15px;\n            border: 1px dashed #999;\n            background-color: white;\n        }\n        \n        .test-title {\n            font-weight: bold;\n            margin-bottom: 10px;\n            color: #333;\n        }\n        \n        /* Outer container */\n        .outer-box {\n            width: 400px;\n            height: 200px;\n            margin: 20px;\n            padding: 20px;\n            border: 3px solid #666;\n            background-color: #ffcccc;\n            position: relative;\n        }\n        \n        /* Middle container */\n        .middle-box {\n            width: 80%;\n            height: 70%;\n            margin: 10px;\n            padding: 15px;\n            border: 2px solid #333;\n            background-color: #ccffcc;\n            position: relative;\n        }\n        \n        /* Inner container */\n        .inner-box {\n            width: 60%;\n            height: 50%;\n            margin: 5px;\n            padding: 10px;\n            border: 1px solid #000;\n            background-color: #ccccff;\n            text-align: center;\n            font-size: 12px;\n            line-height: 1.2;\n        }\n        \n        /* Margin collapse demonstration */\n        .margin-collapse-parent {\n            background-color: #ffffcc;\n            border: 3px solid #666;\n            /* No padding to allow margin collapse */\n            width: 300px;\n            margin: 20px;\n        }\n        \n        .margin-collapse-child {\n            margin: 30px;\n            padding: 15px;\n            background-color: #ffccff;\n            border: 1px solid #333;\n        }\n        \n        /* Margin collapse prevented */\n        .margin-no-collapse-parent {\n            background-color: #ccffff;\n            border: 3px solid #666;\n            padding: 1px; /* Prevents margin collapse */\n            width: 300px;\n            margin: 20px;\n        }\n        \n        .margin-no-collapse-child {\n            margin: 30px;\n            padding: 15px;\n            background-color: #ffccaa;\n            border: 1px solid #333;\n        }\n        \n        /* Different box-sizing inheritance */\n        .content-box-parent {\n            box-sizing: content-box;\n            width: 200px;\n            height: 100px;\n            padding: 20px;\n            border: 5px solid #666;\n            background-color: #ffaacc;\n            margin: 10px;\n        }\n        \n        .border-box-child {\n            box-sizing: border-box;\n            width: 100%;\n            height: 100%;\n            padding: 10px;\n            border: 2px solid #333;\n            background-color: #aaffcc;\n        }\n        \n        /* Labels for measurements */\n        .label {\n            position: absolute;\n            background-color: rgba(255, 255, 255, 0.9);\n            padding: 2px 5px;\n            font-size: 10px;\n            border: 1px solid #999;\n            z-index: 10;\n        }\n        \n        .label-outer { top: -15px; left: 0; }\n        .label-middle { top: 25px; right: -60px; }\n        .label-inner { bottom: -15px; left: 0; }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":800},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":800,"height":800},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":22,"y":42,"width":756,"height":290},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":38,"y":58,"width":724,"height":18},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Nested box model with percentage dimensions","layout":{"rects":[{"x":38,"y":58,"width":357.41,"height":17}]}}]},{"nodeType":"element","tag":"div","layout":{"x":58,"y":96,"width":400,"height":200},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":61,"y":84,"width":92.34,"height":17},"computed":{"display":"block","textAlign":"start"},"children":