en":[{"nodeType":"text","text":"About the Author","layout":{"rects":[{"x":70,"y":311.23,"width":122.77,"height":17}]}}]},{"nodeType":"element","tag":"p","layout":{"x":70,"y":336.28,"width":237.59,"height":94},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"My name is Kevin Cannon. I live just outside ","layout":{"rects":[{"x":70,"y":336.28,"width":224.55,"height":12}]}},{"nodeType":"text","text":"of Vancouver,\nCanada. I've been dabbling in ","layout":{"rects":[{"x":70,"y":348.28,"width":221.42,"height":12}]}},{"nodeType":"text","text":"web design for a while, and this is\nmy fourth ","layout":{"rects":[{"x":70,"y":360.28,"width":224.91,"height":12}]}},{"nodeType":"text","text":"template submitted to OSWD. Most of my ","layout":{"rects":[{"x":70,"y":372.28,"width":210.39,"height":12}]}},{"nodeType":"text","text":"work, no wait ...\n","layout":{"rects":[{"x":70,"y":384.28,"width":86.23,"height":12}]}},{"nodeType":"element","tag":"b","layout":{"x":156.23,"y":384.28,"width":13.52,"height":12},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"all","layout":{"rects":[{"x":156.23,"y":384.28,"width":13.52,"height":12}]}}]},{"nodeType":"text","text":" of my work has been done ","layout":{"rects":[{"x":169.75,"y":384.28,"width":137.27,"height":12}]}},{"nodeType":"text","text":"for free so far. Maybe I will do \nweb design for ","layout":{"rects":[{"x":70,"y":396.28,"width":228.31,"height":12}]}},{"nodeType":"text","text":"a living, but probably not.","layout":{"rects":[{"x":70,"y":408.28,"width":130.59,"height":12}]}}]}]},{"nodeType":"element","tag":"div","layout":{"x":317.59,"y":90,"width":572.39,"height":599.31},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"h1","layout":{"x":355.39,"y":114,"width":496.8,"height":20.16},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Relic","layout":{"rects":[{"x":355.39,"y":109,"width":49.08,"height":25}]}}]},{"nodeType":"element","tag":"p","layout":{"x":355.39,"y":148.22,"width":496.8,"height":96.94},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Welcome to Relic, my most ambitious template yet.\nThis is a fluid, 3-column design. No ","layout":{"rects":[{"x":355.39,"y":149.22,"width":485.61,"height":13}]}},{"nodeType":"text","text":"matter which column is tallest, the design\nwill not fail, and the footer will always stay at ","layout":{"rects":[{"x":355.39,"y":165.38,"width":487.98,"height":13}]}},{"nodeType":"text","text":"the bottom of the page. The columns \nhave widths based in percentages, so the template ","layout":{"rects":[{"x":355.39,"y":181.53,"width":492.45,"height":13}]}},{"nodeType":"text","text":"will smoothly transfer to different \nscreen resolutions. This is all achieved through pure ","layout":{"rects":[{"x":355.39,"y":197.69,"width":477.69,"height":13}]}},{"nodeType":"text","text":"Css, no javascript at all. Sorry for all that \ntech-talk, its really much simpler than it ","layout":{"rects":[{"x":355.39,"y":213.84,"width":455.83,"height":13}]}},{"nodeType":"text","text":"sounds","layout":{"rects":[{"x":355.39,"y":230,"width":38.92,"height":13}]}}]},{"nodeType":"element","tag":"h1","layout":{"x":355.39,"y":269.16,"width":496.8,"height":20.16},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Simplicity","layout":{"rects":[{"x":355.39,"y":264.16,"width":102.47,"height":25}]}}]},{"nodeType":"element","tag":"p","layout":{"x":355.39,"y":303.38,"width":496.8,"height":48.47},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Because of the use of CSS and Xhtml in place of tables, you will find\nthis template ","layout":{"rects":[{"x":355.39,"y":304.38,"width":455.5,"height":13}]}},{"nodeType":"text","text":"incredibly easy to modify. To help you out even more, the \nCss and Xhtml is clearly ","layout":{"rects":[{"x":355.39,"y":320.53,"width":455.81,"height":13}]}},{"nodeType":"text","text":"labeled with comments throughout.","layout":{"rects":[{"x":355.39,"y":336.69,"width":197.19,"height":13}]}}]},{"nodeType":"element","tag":"h1","layout":{"x":355.39,"y":375.84,"width":496.8,"height":20.16},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"The design","layout":{"rects":[{"x":355.39,"y":370.84,"width":114.8,"height":25}]}}]},{"nodeType":"element","tag":"p","layout":{"x":355.39,"y":410.06,"width":496.8,"height":96.94},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":" Its July, so I chose a light summer\ncolour scheme with greens and blues. The header is ","layout":{"rects":[{"x":355.39,"y":411.06,"width":483.31,"height":13}]}},{"nodeType":"text","text":"off of the stock x-change,\nand is not included in the zip file, otherwise it would be over ","layout":{"rects":[{"x":355.39,"y":427.22,"width":480.52,"height":13}]}},{"nodeType":"text","text":"100kb. Instead\nI've hosted it externally. You will probably want to use your own header,\n","layout":{"rects":[{"x":355.39,"y":443.38,"width":487.73,"height":13}]}},{"nodeType":"text","text":"but if you really like this one it can be found ","layout":{"rects":[{"x":355.39,"y":459.53,"width":248.64,"height":13}]}},{"nodeType":"element","tag":"a","layout":{"x":604.03,"y":459.53,"width":24.77,"height":13},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"here","layout":{"rects":[{"x":604.03,"y":459.53,"width":24.77,"height":13}]}}]},{"nodeType":"text","text":". If you need\nany help at all with this ","layout":{"rects":[{"x":628.8,"y":459.53,"width":204.58,"height":13}]}},{"nodeType":"text","text":"template, don't hesitate to contact me through OSWD, \nor email - kmcannon [at] telus ","layout":{"rects":[{"x":355.39,"y":475.69,"width":477.34,"height":13}]}},{"nodeType":"text","text":"[dot] net.","layout":