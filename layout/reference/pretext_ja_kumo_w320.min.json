ut":{"rects":[{"x":0,"y":3024,"width":320,"height":24}]}},{"nodeType":"text","text":"でございます。 三 御釈迦様は極楽の蓮池の","layout":{"rects":[{"x":0,"y":3048,"width":311.17,"height":24}]}},{"nodeType":"text","text":"ふちに立って、この一部始終をじっと見てい","layout":{"rects":[{"x":0,"y":3072,"width":320,"height":24}]}},{"nodeType":"text","text":"らっしゃいましたが、やがて犍陀多が血の池","layout":{"rects":[{"x":0,"y":3096,"width":320,"height":24}]}},{"nodeType":"text","text":"の底へ石のように沈んでしまいますと、悲し","layout":{"rects":[{"x":0,"y":3120,"width":320,"height":24}]}},{"nodeType":"text","text":"そうな御顔をなさりながら、またぶらぶら御","layout":{"rects":[{"x":0,"y":3144,"width":320,"height":24}]}},{"nodeType":"text","text":"歩きになり始めました。自分ばかり地獄から","layout":{"rects":[{"x":0,"y":3168,"width":320,"height":24}]}},{"nodeType":"text","text":"ぬけ出そうとする、犍陀多の無慈悲な心が、","layout":{"rects":[{"x":0,"y":3192,"width":320,"height":24}]}},{"nodeType":"text","text":"そうしてその心相当な罰をうけて、元の地獄","layout":{"rects":[{"x":0,"y":3216,"width":320,"height":24}]}},{"nodeType":"text","text":"へ落ちてしまったのが、御釈迦様の御目から","layout":{"rects":[{"x":0,"y":3240,"width":320,"height":24}]}},{"nodeType":"text","text":"見ると、浅間しく思召されたのでございまし","layout":{"rects":[{"x":0,"y":3264,"width":320,"height":24}]}},{"nodeType":"text","text":"ょう。 しかし極楽の蓮池の蓮は、少しもそ","layout":{"rects":[{"x":0,"y":3288,"width":307.59,"height":24}]}},{"nodeType":"text","text":"んな事には頓着致しません。その玉のような","layout":{"rects":[{"x":0,"y":3312,"width":320,"height":24}]}},{"nodeType":"text","text":"白い花は、御釈迦様の御足のまわりに、ゆら","layout":{"rects":[{"x":0,"y":3336,"width":320,"height":24}]}},{"nodeType":"text","text":"ゆら萼を動かして、そのまん中にある金色の","layout":{"rects":[{"x":0,"y":3360,"width":320,"height":24}]}},{"nodeType":"text","text":"蕊からは、何とも云えない好い匂が、絶間な","layout":{"rects":[{"x":0,"y":3384,"width":320,"height":24}]}},{"nodeType":"text","text":"くあたりへ溢れて居ります。極楽ももう午に","layout":{"rects":[{"x":0,"y":3408,"width":320,"height":24}]}},{"nodeType":"text","text":"近くなったのでございましょう。","layout":{"rects":[{"x":0,"y":3432,"width":240,"height":24}]}}]}]}]}]}}