04,"height":24}]}},{"nodeType":"text","text":"ら、ここへ来てから何年にも出した事のない","layout":{"rects":[{"x":0,"y":2184,"width":320,"height":24}]}},{"nodeType":"text","text":"声で、「しめた。しめた。」と笑いました。","layout":{"rects":[{"x":0,"y":2208,"width":320,"height":24}]}},{"nodeType":"text","text":"ところがふと気がつきますと、蜘蛛の糸の下","layout":{"rects":[{"x":0,"y":2232,"width":320,"height":24}]}},{"nodeType":"text","text":"の方には、数限もない罪人たちが、自分のの","layout":{"rects":[{"x":0,"y":2256,"width":320,"height":24}]}},{"nodeType":"text","text":"ぼった後をつけて、まるで蟻の行列のよう","layout":{"rects":[{"x":0,"y":2280,"width":304,"height":24}]}},{"nodeType":"text","text":"に、やはり上へ上へ一心によじのぼって来る","layout":{"rects":[{"x":0,"y":2304,"width":320,"height":24}]}},{"nodeType":"text","text":"ではございませんか。犍陀多はこれを見る","layout":{"rects":[{"x":0,"y":2328,"width":304,"height":24}]}},{"nodeType":"text","text":"と、驚いたのと恐しいのとで、しばらくはた","layout":{"rects":[{"x":0,"y":2352,"width":320,"height":24}]}},{"nodeType":"text","text":"だ、莫迦のように大きな口を開いたまま、眼","layout":{"rects":[{"x":0,"y":2376,"width":320,"height":24}]}},{"nodeType":"text","text":"ばかり動かして居りました。自分一人でさえ","layout":{"rects":[{"x":0,"y":2400,"width":320,"height":24}]}},{"nodeType":"text","text":"断れそうな、この細い蜘蛛の糸が、どうして","layout":{"rects":[{"x":0,"y":2424,"width":320,"height":24}]}},{"nodeType":"text","text":"あれだけの人数の重みに堪える事が出来まし","layout":{"rects":[{"x":0,"y":2448,"width":320,"height":24}]}},{"nodeType":"text","text":"ょう。もし万一途中で断れたと致しました","layout":{"rects":[{"x":0,"y":2472,"width":304,"height":24}]}},{"nodeType":"text","text":"ら、折角ここへまでのぼって来たこの肝腎な","layout":{"rects":[{"x":0,"y":2496,"width":320,"height":24}]}},{"nodeType":"text","text":"自分までも、元の地獄へ逆落しに落ちてしま","layout":{"rects":[{"x":0,"y":2520,"width":320,"height":24}]}},{"nodeType":"text","text":"わなければなりません。そんな事があった","layout":{"rects":[{"x":0,"y":2544,"width":304,"height":24}]}},{"nodeType":"text","text":"ら、大変でございます。が、そう云う中に","layout":{"rects":[{"x":0,"y":2568,"width":304,"height":24}]}},{"nodeType":"text","text":"も、罪人たちは何百となく何千となく、まっ","layout":{"rects":[{"x":0,"y":2592,"width":320,"height":24}]}},{"nodeType":"text","text":"暗な血の池の底から、うようよと這い上っ","layout":{"rects":[{"x":0,"y":2616,"width":304,"height":24}]}},{"nodeType":"text","text":"て、細く光っている蜘蛛の糸を、一列になり","layout":{"rects":[{"x":0,"y":2640,"width":320,"height":24}]}},{"nodeType":"text","text":"ながら、せっせとのぼって参ります。今の中","layout":{"rects":[{"x":0,"y":2664,"width":320,"height":24}]}},{"nodeType":"text","text":"にどうかしなければ、糸はまん中から二つに","layout":{"rects":[{"x":0,"y":2688,"width":320,"height":24}]}},{"nodeType":"text","text":"断れて、落ちてしまうのに違いありません。 ","layout":{"rects":[{"x":0,"y":2712,"width":320,"height":24}]}},{"nodeType":"text","text":"そこで犍陀多は大きな声を出して、「こら、","layout":{"rects":[{"x":0,"y":2736,"width":320,"height":24}]}},{"nodeType":"text","text":"罪人ども。この蜘蛛の糸は己のものだぞ。お","layout":{"rects":[{"x":0,"y":2760,"width":320,"height":24}]}},{"nodeType":"text","text":"前たちは一体誰に尋いて、のぼって来た。下","layout":{"rects":[{"x":0,"y":2784,"width":320,"height":24}]}},{"nodeType":"text","text":"りろ。下りろ。」と喚きました。 その途端で","layout":{"rects":[{"x":0,"y":2808,"width":323.59,"height":24}]}},{"nodeType":"text","text":"ございます。今まで何ともなかった蜘蛛の糸","layout":{"rects":[{"x":0,"y":2832,"width":320,"height":24}]}},{"nodeType":"text","text":"が、急に犍陀多のぶら下っている所から、ぷ","layout":{"rects":[{"x":0,"y":2856,"width":320,"height":24}]}},{"nodeType":"text","text":"つりと音を立てて断れました。ですから犍陀","layout":{"rects":[{"x":0,"y":2880,"width":320,"height":24}]}},{"nodeType":"text","text":"多もたまりません。あっと云う間もなく風を","layout":{"rects":[{"x":0,"y":2904,"width":320,"height":24}]}},{"nodeType":"text","text":"切って、独楽のようにくるくるまわりなが","layout":{"rects":[{"x":0,"y":2928,"width":304,"height":24}]}},{"nodeType":"text","text":"ら、見る見る中に暗の底へ、まっさかさまに","layout":{"rects":[{"x":0,"y":2952,"width":320,"height":24}]}},{"nodeType":"text","text":"落ちてしまいました。 後にはただ極楽の蜘蛛","layout":{"rects":[{"x":0,"y":2976,"width":323.59,"height":24}]}},{"nodeType":"text","text":"の糸が、きらきらと細く光りながら、月も星","layout":{"rects":[{"x":0,"y":3000,"width":320,"height":24}]}},{"nodeType":"text","text":"もない空の中途に、短く垂れているばかりで","layout":{"rects":[{"x":0,"y":3024,"width":320,"height":24}]}},{"nodeType":"text","text":"ございます。 三 御釈迦様は極楽の蓮池のふち","layout":{"rects":[{"x":0,"y":3048,"width":327.17,"height":24}]}},{"nodeType":"text","text":"に立って、この一部始終をじっと見ていらっ","layout":{"rects":[{"x":0,"y":3072,"width":320,"height":24}]}},{"nodeType":"text","text":"しゃいましたが、やがて犍陀多が血の池の底","layout":{"rects":[{"x":0,"y":3096,"width":320,"height":24}]}},{"nodeType":"text","text":"へ石のように沈んでしまいますと、悲しそう","layout":{"rects":[{"x":0,"y":3120,"width":320,"height":24}]}},{"nodeType":"text","text":"な御顔をなさりながら、またぶらぶら御歩き","layout":{"rects":[{"x":0,"y":3144,"width":320,"height":24}]}},{"nodeType":"text","text":"になり始めました。自分ばかり地獄からぬけ","layout":{"rects":[{"x":0,"y":3168,"width":320,"height":24}]}},{"nodeType":"text","text":"出そうとする、犍陀多の無慈悲な心が、そう","layout":{"rects":[{"x":0,"y":3192,"width":320,"height":24}]}},{"nodeType":"text","text":"してその心相当な罰をうけて、元の地獄へ落","layout":{"rects":[{"x":0,"y":3216,"width":320,"height":24}]}},{"nodeType":"text","text":"ちてしまったのが、御釈迦様の御目から見る","layout":{"rects":[{"x":0,"y":3240,"width":320,"height":24}]}},{"nodeType":"text","text":"と、浅間しく思召されたのでございましょ","layout":{"rects":[{"x":0,"y":3264,"width":304,"height":24}]}},{"nodeType":"text","text":"う。 しかし極楽の蓮池の蓮は、少しもそんな","layout":{"rects":[{"x":0,"y":3288,"width":323.59,"height":24}]}},{"nodeType":"text","text":"事には頓着致しません。その玉のような白い","layout":{"rects":[{"x":0,"y":3312,"width":320,"height":24}]}},{"nodeType":"text","text":"花は、御釈迦様の御足のまわりに、ゆらゆら","layout":{"rects":[{"x":0,"y":3336,"width":320,"height":24}]}},{"nodeType":"text","text":"萼を動かして、そのまん中にある金色の蕊か","layout":{"rects":[{"x":0,"y":3360,"width":320,"height":24}]}},{"nodeType":"text","text":"らは、何とも云えない好い匂が、絶間なくあ","layout":{"rects":[{"x":0,"y":3384,"width":320,"height":24}]}},{"nodeType":"text","text":"たりへ溢れて居ります。極楽ももう午に近く","layout":{"rects":[{"x":0,"y":3408,"width":320,"height":24}]}},{"nodeType":"text","text":"なったのでございましょう。","layout":{"rects":[{"x":0,"y":3432,"width":208,"height":24}]}}]}]}]}]}}