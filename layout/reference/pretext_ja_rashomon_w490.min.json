","layout":{"rects":[{"x":0,"y":24,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":48,"width":490,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"廣い門の下には、この男の外に誰もゐない。唯、所々丹塗の剝げ","layout":{"rects":[{"x":0,"y":48,"width":464,"height":24}]}},{"nodeType":"text","text":"た、大きな圓柱に、蟋蟀が一匹とまつてゐる。羅生門が、朱雀大路","layout":{"rects":[{"x":0,"y":72,"width":480,"height":24}]}},{"nodeType":"text","text":"にある以上は、この男の外にも、雨やみをする市女笠や揉烏帽子","layout":{"rects":[{"x":0,"y":96,"width":464,"height":24}]}},{"nodeType":"text","text":"が、もう二三人はありさうなものである。それが、この男の外には","layout":{"rects":[{"x":0,"y":120,"width":480,"height":24}]}},{"nodeType":"text","text":"誰もゐない。","layout":{"rects":[{"x":0,"y":144,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":168,"width":490,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"何故かと云ふと、この二三年、京都には、地震とか辻風とか火事と","layout":{"rects":[{"x":0,"y":168,"width":480,"height":24}]}},{"nodeType":"text","text":"か饑饉とか云ふ災がつゞいて起つた。そこで洛中のさびれ方は一通","layout":{"rects":[{"x":0,"y":192,"width":480,"height":24}]}},{"nodeType":"text","text":"りでない。舊記によると、佛像や佛具を打碎いて、その丹がついた","layout":{"rects":[{"x":0,"y":216,"width":480,"height":24}]}},{"nodeType":"text","text":"り、金銀の箔がついたりした木を、路ばたにつみ重ねて、薪の料に","layout":{"rects":[{"x":0,"y":240,"width":480,"height":24}]}},{"nodeType":"text","text":"賣つてゐたと云ふ事である。洛中がその始末であるから、羅生門の","layout":{"rects":[{"x":0,"y":264,"width":480,"height":24}]}},{"nodeType":"text","text":"修理などは、元より誰も捨てゝ顧る者がなかつた。するとその荒れ","layout":{"rects":[{"x":0,"y":288,"width":480,"height":24}]}},{"nodeType":"text","text":"果てたのをよい事にして、狐狸が棲む。盜人が棲む。とうとうしま","layout":{"rects":[{"x":0,"y":312,"width":480,"height":24}]}},{"nodeType":"text","text":"ひには、引取り手のない死人を、この門へ持つて來て、棄てゝ行く","layout":{"rects":[{"x":0,"y":336,"width":480,"height":24}]}},{"nodeType":"text","text":"と云ふ習慣さへ出來た。そこで、日の目が見えなくなると、誰でも","layout":{"rects":[{"x":0,"y":360,"width":480,"height":24}]}},{"nodeType":"text","text":"氣味を惡るがつて、この門の近所へは足ぶみをしない事になつてし","layout":{"rects":[{"x":0,"y":384,"width":480,"height":24}]}},{"nodeType":"text","text":"まつたのである。","layout":{"rects":[{"x":0,"y":408,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":432,"width":490,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その代り又鴉が何處からか、たくさん集つて來た。晝間見ると、そ","layout":{"rects":[{"x":0,"y":432,"width":480,"height":24}]}},{"nodeType":"text","text":"の鴉が何羽となく輪を描いて高い鴟尾のまはりを啼きながら、飛び","layout":{"rects":[{"x":0,"y":456,"width":480,"height":24}]}},{"nodeType":"text","text":"まはつてゐる。殊に門の上の空が、夕燒けであかくなる時には、そ","layout":{"rects":[{"x":0,"y":480,"width":480,"height":24}]}},{"nodeType":"text","text":"れが胡麻をまいたやうにはつきり見えた。鴉は、勿論、門の上にあ","layout":{"rects":[{"x":0,"y":504,"width":480,"height":24}]}},{"nodeType":"text","text":"る死人の肉を、啄みに來るのである。――尤も今日は、刻限が遲い","layout":{"rects":[{"x":0,"y":528,"width":480,"height":24}]}},{"nodeType":"text","text":"せいか、一羽も見えない。唯、所々、崩れかゝつた、さうしてその","layout":{"rects":[{"x":0,"y":552,"width":480,"height":24}]}},{"nodeType":"text","text":"崩れ目に長い草のはへた石段の上に、鴉の糞が、點々と白くこびり","layout":{"rects":[{"x":0,"y":576,"width":480,"height":24}]}},{"nodeType":"text","text":"ついてゐるのが見える。下人は七段ある石段の一番上の段に洗ひざ","layout":{"rects":[{"x":0,"y":600,"width":480,"height":24}]}},{"nodeType":"text","text":"らした紺の襖の尻を据ゑて、右の頰に出來た、大きな面皰を氣にし","layout":{"rects":[{"x":0,"y":624,"width":480,"height":24}]}},{"nodeType":"text","text":"ながら、ぼんやり、雨のふるのを眺めてゐるのである。","layout":{"rects":[{"x":0,"y":648,"width":400,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":672,"width":490,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"作者はさつき、「下人が雨やみを待つてゐた」と書いた。しかし、","layout":{"rects":[{"x":0,"y":672,"width":480,"height":24}]}},{"nodeType":"text","text":"下人は、雨がやんでも格別どうしようと云ふ當てはない。ふだんな","layout":{"rects":[{"x":0,"y":696,"width":480,"height":24}]}},{"nodeType":"text","text":"ら、勿論、主人の家へ歸る可き筈である。所がその主人からは、四","layout":{"rects":[{"x":0,"y":720,"width":480,"height":24}]}},{"nodeType":"text","text":"五日前に暇を出された。前にも書いたやうに、當時京都の町は一通","layout":{"rects":[{"x":0,"y":744,"width":480,"height":24}]}},{"nodeType":"text","text":"りならず衰微してゐた。今この下人が、永年、使はれてゐた主人か","layout":{"rects":[{"x":0,"y":768,"width":480,"height":24}]}},{"nodeType":"text","text":"ら、暇を出されたのも、この衰微の小さな餘波に外ならない。だか","layout":{"rects":[{"x":0,"y":792,"width":480,"height":24}]}},{"nodeType":"text","text":"ら「下人が雨やみを待つてゐた」と云ふよりも、「雨にふりこめら","layout":{"rects":[{"x":0,"y":816,"width":480,"height":24}]}},{"nodeType":"text","text":"れた下人が、行き所がなくて、途方にくれてゐた」と云ふ方が、適","layout":{"rects":[{"x":0,"y":840,"width":480,"height":24}]}},{"nodeType":"text","text":"當である。その上、今日の空模樣も少からずこの平安朝の下人の ","layout":{"rects":[{"x":0,"y":864,"width":464,"height":24}]}},{"nodeType":"text","text":"Sentimentalisme に影響した。申の刻下りからふり出した雨は、未","layout":{"rects":[{"x":0,"y":888,"width":482.78,"height":24}]}},{"nodeType":"text","text":"に上るけしきがない。そこで、下人は、何を措いても差當り明日の","layout":{"rects":[{"x":0,"y":912,"width":480,"height":24}]}},{"nodeType":"text","text":"暮しをどうにかしようとして――云はゞどうにもならない事を、ど","layout":{"rects":[{"x":0,"y":936,"width":480,"height":24}]}},{"nodeType":"text","text":"うにかしようとして、とりとめもない考へをたどりながら、さつき","layout":{"rects":[{"x":0,"y":960,"width":480,"height":24}]}},{"nodeType":"text","text":"から朱雀大路にふる雨の音を、聞くともなく聞いてゐた。","layout":{"rects":[{"x":0,"y":984,"width":416,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1008,"width":490,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"雨は、羅生門をつゝんで、遠くから、ざあつと云ふ音をあつめて來","layout":{"rects":[{"x":0,"y":1008,"width":480,"height":24}]}},{"nodeType":"text","text":"る。夕闇は次第に空を低くして、見上げると、門の屋根が、斜につ","layout":{"rects":[{"x":0,"y":1032,"width":480,"height":24}]}},{"nodeType":"text","text":"き出した甍の先に、重たくうす暗い雲を支へてゐる。","layout":{"rects":[{"x":0,"y":1056,"width":384,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1080,"width":490,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"どうにもならない事を、どうにかする爲には、手段を選んでゐる遑","layout":{"rects":[{"x":0,"y":1080,"width":480,"height":24}]}},{"nodeType":"text","text":"はない。選んでゐれば、築土の下か、道ばたの土の上で、饑死をす","layout":{"rects":[{"x":0,"y":1104,"width":480,"height":24}]}},{"nodeType":"text","text":"るばかりである。さうして、この門の上へ持つて來て、犬のやうに","layout":{"rects":[{"x":0,"y":1128,"width":480,"height":24}]}},{"nodeType":"text","text":"棄てられてしまふばかりである。選ばないとすれば――下人の考へ","layout":{"rects":[{"x":0,"y":1152,"width":480,"height":24}]}},{"nodeType":"text","text":"は、何度も同じ道を低徊した揚句に、やつとこの局所へ逢着した。","layout":{"rects":[{"x":0,"y":1176,"width":480,"height":24}]}},{"nodeType":"text","text":"しかしこの「すれば」は、何時までたつても、結局「すれば」であ","layout":{"rects":[{"x":0,"y":1200,"width":480,"height":24}]}},{"nodeType":"text","text":"つた。下人は、手段を選ばないといふ事を肯定しながらも、この","layout":{"rects":[{"x":0,"y":1224,"width":464,"height":24}]}},{"nodeType":"text","text":"「すれば」のかたをつける爲に、當然、その後に來る可き「盜人に","layout":{"rects":[{"x":0,"y":1248,"width":480,"height":24}]}},{"nodeType":"text","text":"なるより外に仕方がない」と云ふ事を、積極的に肯定する丈の、勇","layout":{"rects":[{"x":0,"y":1272,"width":480,"height":24}]}},{"nodeType":"text","text":"氣が出ずにゐたのである。","layout":{"rects":[{"x":0,"y":1296,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1320,"width":490,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、大きな嚏をして、それから、大儀さうに立上つた。夕冷え","layout":{"rects":[{"x":0,"y":1320,"width":480,"height":24}]}},{"nodeType":"text","text":"のする京都は、もう火桶が欲しい程の寒さである。風は門の柱と柱","layout":{"rects":[{"x":0,"y":1344,"width":480,"height":24}]}},{"nodeType":"text","text":"との間を、夕闇と共に遠慮なく、吹きぬける。丹塗の柱にとまつて","layout":{"rects":[{"x":0,"y":1368,"width":480,"height":24}]}},{"nodeType":"text","text":"ゐた蟋蟀も、もうどこかへ行つてしまつた。","layout":{"rects":[{"x":0,"y":1392,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1416,"width":490,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、頸をちゞめながら、山吹の汗衫に重ねた、紺の襖の肩を高","layout":{"rects":[{"x":0,"y":1416,"width":480,"height":24}]}},{"nodeType":"text","text":"くして門のまはりを見まはした。雨風の患のない、人目にかゝる惧","layout":{"rects":[{"x":0,"y":1440,"width":480,"height":24}]}},{"nodeType":"text","text":"のない、一晚樂にねられさうな所があれば、そこでともかくも、夜","layout":{"rects":[{"x":0,"y":1464,"width":480,"height":24}]}},{"nodeType":"text","text":"を明かさうと思つたからである。すると、幸門の上の樓へ上る、幅","layout":{"rects":[{"x":0,"y":1488,"width":480,"height":24}]}},{"nodeType":"text","text":"の廣い、之も丹を塗つた梯子が眼についた。上なら、人がゐたにし","layout":{"rects":[{"x":0,"y":1512,"width":480,"height":24}]}},{"nodeType":"text","text":"ても、どうせ死人ばかりである。下人は、そこで腰にさげた聖柄の","layout":{"rects":[{"x":0,"y":1536,"width":480,"height":24}]}},{"nodeType":"text","text":"太刀が鞘走らないやうに氣をつけながら、藁草履をはいた足を、そ","layout":{"rects":[{"x":0,"y":1560,"width":480,"height":24}]}},{"nodeType":"text","text":"の梯子の一番下の段へふみかけた。","layout":{"rects":[{"x":0,"y":1584,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1608,"width":490,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"それから、何分かの後である。羅生門の樓の上へ出る、幅の廣い梯","layout":{"rects":[{"x":0,"y":1608,"width":480,"height":24}]}},{"nodeType":"text","text":"子の中段に、一人の男が、猫のやうに身をちゞめて、息を殺しなが","layout":{"rects":[{"x":0,"y":1632,"width":480,"height":24}]}},{"nodeType":"text","text":"ら、上の容子を窺つてゐた。樓の上からさす火の光が、かすかに、","layout":{"rects":[{"x":0,"y":1656,"width":480,"height":24}]}},{"nodeType":"text","text":"その男の右の頰をぬらしてゐる。短い鬚の中に、赤く膿を持つた面","layout":{"rects":[{"x":0,"y":1680,"width":480,"height":24}]}},{"nodeType":"text","text":"皰のある頰である。下人は、始めから、この上にゐる者は、死人ば","layout":{"rects":[{"x":0,"y":1704,"width":480,"height":24}]}},{"nodeType":"text","text":"かりだと高を括つてゐた。それが、梯子を二三段上つて見ると、上","layout":{"rects":[{"x":0,"y":1728,"width":480,"height":24}]}},{"nodeType":"text","text":"では誰か火をとぼして、しかもその火を其處此處と動かしてゐるら","layout":{"rects":[{"x":0,"y":1752,"width":480,"height":24}]}},{"nodeType":"text","text":"しい。これは、その濁つた、黃いろい光が、隅々に蜘蛛の巢をかけ","layout":{"rects":[{"x":0,"y":1776,"width":480,"height":24}]}},{"nodeType":"text","text":"た天井裏に、ゆれながら映つたので、すぐにそれと知れたのであ","layout":{"rects":[{"x":0,"y":1800,"width":464,"height":24}]}},{"nodeType":"text","text":"る。この雨の夜に、この羅生門の上で、火をともしてゐるからは、","layout":{"rects":[{"x":0,"y":1824,"width":480,"height":24}]}},{"nodeType":"text","text":"どうせ唯の者ではない。","layout":{"rects":[{"x":0,"y":1848,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1872,"width":490,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、守宮のやうに足音をぬすんで、やつと急な梯子を、一番上","layout":{"rects":[{"x":0,"y":1872,"width":480,"height":24}]}},{"nodeType":"text","text":"の段まで這ふやうにして上りつめた。さうして體を出來る丈、平に","layout":{"rects":[{"x":0,"y":1896,"width":480,"height":24}]}},{"nodeType":"text","text":"しながら、頸を出來る丈、前へ出して、恐る恐る、樓の內を覗いて","layout":{"rects":[{"x":0,"y":1920,"width":480,"height":24}]}},{"nodeType":"text","text":"見た。","layout":{"rects":[{"x":0,"y":1944,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1968,"width":490,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"見ると、樓の內には、噂に聞いた通り、幾つかの屍骸が、無造作に","layout":{"rects":[{"x":0,"y":1968,"width":480,"height":24}]}},{"nodeType":"text","text":"棄てゝあるが、火の光の及ぶ範圍が、思つたより狹いので、數は幾","layout":{"rects":[{"x":0,"y":1992,"width":480,"height":24}]}},{"nodeType":"text","text":"つともわからない。唯、おぼろげながら、知れるのは、その中に裸","layout":{"rects":[{"x":0,"y":2016,"width":480,"height":24}]}},{"nodeType":"text","text":"の屍骸と、着物を着た屍骸とがあると云ふ事である。勿論、中には","layout":{"rects":[{"x":0,"y":2040,"width":480,"height":24}]}},{"nodeType":"text","text":"女も男もまじつてゐるらしい。さうして、その屍骸は皆、それが、","layout":{"rects":[{"x":0,"y":2064,"width":480,"height":24}]}},{"nodeType":"text","text":"甞、生きてゐた人間だと云ふ事實さへ疑はれる程、土を捏ねて造つ","layout":{"rects":[{"x":0,"y":2088,"width":480,"height":24}]}},{"nodeType":"text","text":"た人形のやうに、口を開いたり手を延ばしたりしてごろごろ床の上","layout":{"rects":[{"x":0,"y":2112,"width":480,"height":24}]}},{"nodeType":"text","text":"にころがつてゐた。しかも、肩とか胸とかの高くなつてゐる部分","layout":{"rects":[{"x":0,"y":2136,"width":464,"height":24}]}},{"nodeType":"text","text":"に、ぼんやりした火の光をうけて、低くなつてゐる部分の影を一層","layout":{"rects":[{"x":0,"y":2160,"width":480,"height":24}]}},{"nodeType":"text","text":"暗くしながら、永久に啞の如く默つていた。","layout":{"rects":[{"x":0,"y":2184,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2208,"width":490,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、それらの屍骸の腐爛した臭氣に思はず、鼻を掩つた。しか","layout":{"rects":[{"x":0,"y":2208,"width":480,"height":24}]}},{"nodeType":"text","text":"し、その手は、次の瞬間には、もう鼻を掩ふ事を忘れてゐた。或る","layout":{"rects":[{"x":0,"y":2232,"width":480,"height":24}]}},{"nodeType":"text","text":"强い感情が、殆悉この男の嗅覺を奪つてしまつたからである。","layout":{"rects":[{"x":0,"y":2256,"width":448,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2280,"width":490,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人の眼は、その時、はじめて、其屍骸の中に蹲つている人間を見","layout":{"rects":[{"x":0,"y":2280,"width":480,"height":24}]}},{"nodeType":"text","text":"た。檜肌色の着物を著た、背の低い、瘦せた、白髮頭の、猿のやう","layout":{"rects":[{"x":0,"y":2304,"width":480,"height":24}]}},{"nodeType":"text","text":"な老婆である。その老婆は、右の手に火をともした松の木片を持つ","layout":{"rects":[{"x":0,"y":2328,"width":480,"height":24}]}},{"nodeType":"text","text":"て、その屍骸の一つの顏を覗きこむやうに眺めてゐた。髮の毛の長","layout":{"rects":[{"x":0,"y":2352,"width":480,"height":24}]}},{"nodeType":"text","text":"い所を見ると、多分女の屍骸であらう。","layout":{"rects":[{"x":0,"y":2376,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2400,"width":490,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、六分の恐怖と四分の好奇心とに動かされて、暫時は呼吸を","layout":{"rects":[{"x":0,"y":2400,"width":480,"height":24}]}},{"nodeType":"text","text":"するのさへ忘れてゐた。舊記の記者の語を借りれば、「頭身の毛も","layout":{"rects":[{"x":0,"y":2424,"width":480,"height":24}]}},{"nodeType":"text","text":"太る」やうに感じたのである。すると、老婆は、松の木片を、床板","layout":{"rects":[{"x":0,"y":2448,"width":480,"height":24}]}},{"nodeType":"text","text":"の間に挿して、それから、今まで眺めてゐた屍骸の首に兩手をかけ","layout":{"rects":[{"x":0,"y":2472,"width":480,"height":24}]}},{"nodeType":"text","text":"ると、丁度、猿の親が猿の子の虱をとるやうに、その長い髮の毛を","layout":{"rects":[{"x":0,"y":2496,"width":480,"height":24}]}},{"nodeType":"text","text":"一本づゝ拔きはじめた。髮は手に從つて拔けるらしい。","layout":{"rects":[{"x":0,"y":2520,"width":400,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2544,"width":490,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その髮の毛が、一本ずゝ拔けるのに從つて下人の心からは、恐怖が","layout":{"rects":[{"x":0,"y":2544,"width":480,"height":24}]}},{"nodeType":"text","text":"少しづつ消えて行つた。さうして、それと同時に、この老婆に對す","layout":{"rects":[{"x":0,"y":2568,"width":480,"height":24}]}},{"nodeType":"text","text":"るはげしい憎惡が、少しづゝ動いて來た。――いや、この老婆に對","layout":{"rects":[{"x":0,"y":2592,"width":480,"height":24}]}},{"nodeType":"text","text":"すると云つては、語弊があるかも知れない。寧、あらゆる惡に對す","layout":{"rects":[{"x":0,"y":2616,"width":480,"height":24}]}},{"nodeType":"text","text":"る反感が、一分每に强さを增して來たのである。この時、誰かがこ","layout":{"rects":[{"x":0,"y":2640,"width":480,"height":24}]}},{"nodeType":"text","text":"の下人に、さつき門の下でこの男が考へてゐた、饑死をするか盜人","layout":{"rects":[{"x":0,"y":2664,"width":480,"height":24}]}},{"nodeType":"text","text":"になるかと云ふ問題を、改めて持出したら、恐らく下人は、何の未","layout":{"rects":[{"x":0,"y":2688,"width":480,"height":24}]}},{"nodeType":"text","text":"練もなく、饑死を選んだ事であらう。それほど、この男の惡を憎む","layout":{"rects":[{"x":0,"y":2712,"width":480,"height":24}]}},{"nodeType":"text","text":"心は、老婆の床に挿した松の木片のやうに、勢よく燃え上り出して","layout":{"rects":[{"x":0,"y":2736,"width":480,"height":24}]}},{"nodeType":"text","text":"ゐたのである。","layout":{"rects":[{"x":0,"y":2760,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2784,"width":490,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人には、勿論、何故老婆が死人の髮の毛を拔くかわからなかつ","layout":{"rects":[{"x":0,"y":2784,"width":464,"height":24}]}},{"nodeType":"text","text":"た。從つて、合理的には、それを善惡の何れに片づけてよいか知ら","layout":{"rects":[{"x":0,"y":2808,"width":480,"height":24}]}},{"nodeType":"text","text":"なかつた。しかし下人にとつては、この雨の夜に、この羅生門の上","layout":{"rects":[{"x":0,"y":2832,"width":480,"height":24}]}},{"nodeType":"text","text":"で、死人の髮の毛を拔くと云ふ事が、それ丈で既に許す可らざる惡","layout":{"rects":[{"x":0,"y":2856,"width":480,"height":24}]}},{"nodeType":"text","text":"であつた。勿論、下人は、さつき迄自分が、盜人になる氣でゐた事","layout":{"rects":[{"x":0,"y":2880,"width":480,"height":24}]}},{"nodeType":"text","text":"なぞは、とうに忘れてゐるのである。","layout":{"rects":[{"x":0,"y":2904,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2928,"width":490,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"そこで、下人は、兩足に力を入れて、いきなり、梯子から上へ飛び","layout":{"rects":[{"x":0,"y":2928,"width":480,"height":24}]}},{"nodeType":"text","text":"上つた。さうして聖柄の太刀に手をかけながら、大股に老婆の前へ","layout":{"rects":[{"x":0,"y":2952,"width":480,"height":24}]}},{"nodeType":"text","text":"步みよつた。老婆が驚いたのは、云ふ迄もない。","layout":{"rects":[{"x":0,"y":2976,"width":352,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3000,"width":490,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆は、一目下人を見ると、まるで弩にでも彈かれたやうに、飛び","layout":{"rects":[{"x":0,"y":3000,"width":480,"height":24}]}},{"nodeType":"text","text":"上つた。","layout":{"rects":[{"x":0,"y":3024,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3048,"width":490,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「おのれ、どこへ行く。」","layout":{"rects":[{"x":0,"y":3048,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3072,"width":490,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆が屍骸につまづきながら、慌てふためいて逃げようと","layout":{"rects":[{"x":0,"y":3072,"width":480,"height":24}]}},{"nodeType":"text","text":"する行手を塞いで、こう罵つた。老婆は、それでも下人をつきのけ","layout":{"rects":[{"x":0,"y":3096,"width":480,"height":24}]}},{"nodeType":"text","text":"て行かうとする。下人は又、それを行かすまいとして、押しもど","layout":{"rects":[{"x":0,"y":3120,"width":464,"height":24}]}},{"nodeType":"text","text":"す。二人は屍骸の中で、暫、無言のまゝ、つかみ合つた。しかし勝","layout":{"rects":[{"x":0,"y":3144,"width":480,"height":24}]}},{"nodeType":"text","text":"敗は、はじめから、わかつている。下人はとうとう、老婆の腕をつ","layout":{"rects":[{"x":0,"y":3168,"width":480,"height":24}]}},{"nodeType":"text","text":"かんで、無理にそこへ扭ぢ倒した。丁度、鷄の脚のやうな、骨と皮","layout":{"rects":[{"x":0,"y":3192,"width":480,"height":24}]}},{"nodeType":"text","text":"ばかりの腕である。","layout":{"rects":[{"x":0,"y":3216,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3240,"width":490,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「何をしてゐた。さあ何をしてゐた。云へ。云はぬと、これだぞ","layout":{"rects":[{"x":0,"y":3240,"width":464,"height":24}]}},{"nodeType":"text","text":"よ。」","layout":{"rects":[{"x":0,"y":3264,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3288,"width":490,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆をつき放すと、いきなり、太刀の鞘を拂つて、白い鋼","layout":{"rects":[{"x":0,"y":3288,"width":480,"height":24}]}},{"nodeType":"text","text":"の色をその眼の前へつきつけた。けれども、老婆は默つてゐる。兩","layout":{"rects":[{"x":0,"y":3312,"width":480,"height":24}]}},{"nodeType":"text","text":"手をわなわなふるはせて、肩で息を切りながら、眼を、眼球が眶の","layout":{"rects":[{"x":0,"y":3336,"width":480,"height":24}]}},{"nodeType":"text","text":"外へ出さうになる程、見開いて、啞のやうに執拗く默つてゐる。こ","layout":{"rects":[{"x":0,"y":3360,"width":480,"height":24}]}},{"nodeType":"text","text":"れを見ると、下人は始めて明白にこの老婆の生死が、全然、自分の","layout":{"rects":[{"x":0,"y":3384,"width":480,"height":24}]}},{"nodeType":"text","text":"意志に支配されてゐると云ふ事を意識した。さうして、この意識","layout":{"rects":[{"x":0,"y":3408,"width":464,"height":24}]}},{"nodeType":"text","text":"は、今まではげしく燃えてゐた憎惡の心を何時の間にか冷ましてし","layout":{"rects":[{"x":0,"y":3432,"width":480,"height":24}]}},{"nodeType":"text","text":"まつた。後に殘つたのは、唯、或仕事をして、それが圓滿に成就し","layout":{"rects":[{"x":0,"y":3456,"width":480,"height":24}]}},{"nodeType":"text","text":"た時の、安らかな得意と滿足とがあるばかりである。そこで、下人","layout":{"rects":[{"x":0,"y":3480,"width":480,"height":24}]}},{"nodeType":"text","text":"は、老婆を見下しながら、少し聲を柔げてかう云つた。","layout":{"rects":[{"x":0,"y":3504,"width":400,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3528,"width":490,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「己は檢非違使の廳の役人などではない。今し方この門の下を通り","layout":{"rects":[{"x":0,"y":3528,"width":480,"height":24}]}},{"nodeType":"text","text":"かゝつた旅の者だ。だからお前に繩をかけて、どうしようと云ふや","layout":{"rects":[{"x":0,"y":3552,"width":480,"height":24}]}},{"nodeType":"text","text":"うな事はない。唯、今時分、この門の上で、何をして居たのだか、","layout":{"rects":[{"x":0,"y":3576,"width":480,"height":24}]}},{"nodeType":"text","text":"それを己に話しさへすればいいのだ。」","layout":{"rects":[{"x":0,"y":3600,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3624,"width":490,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"すると、老婆は、見開いてゐた眼を、一層大きくして、ぢつとその","layout":{"rects":[{"x":0,"y":3624,"width":480,"height":24}]}},{"nodeType":"text","text":"下人の顏を見守つた。眶の赤くなつた、肉食鳥のやうな、銳い眼で","layout":{"rects":[{"x":0,"y":3648,"width":480,"height":24}]}},{"nodeType":"text","text":"見たのである。それから、皺で、殆、鼻と一つになつた唇を、何か","layout":{"rects":[{"x":0,"y":3672,"width":480,"height":24}]}},{"nodeType":"text","text":"物でも嚙んでゐるやうに動かした。細い喉で、尖つた喉佛の動いて","layout":{"rects":[{"x":0,"y":3696,"width":480,"height":24}]}},{"nodeType":"text","text":"ゐるのが見える。その時、その喉から、鴉の啼くやうな聲が、喘ぎ","layout":{"rects":[{"x":0,"y":3720,"width":480,"height":24}]}},{"nodeType":"text","text":"喘ぎ、下人の耳へ傳はつて來た。","layout":{"rects":[{"x":0,"y":3744,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3768,"width":490,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「この髮を拔いてな、この女の髮を拔いてな、鬘にせうと思うたの","layout":{"rects":[{"x":0,"y":3768,"width":480,"height":24}]}},{"nodeType":"text","text":"ぢや。」","layout":{"rects":[{"x":0,"y":3792,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3816,"width":490,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆の答が存外、平凡なのに失望した。さうして失望する","layout":{"rects":[{"x":0,"y":3816,"width":480,"height":24}]}},{"nodeType":"text","text":"と同時に、又前の憎惡が、冷な侮蔑と一しよに、心の中へはいつて","layout":{"rects":[{"x":0,"y":3840,"width":480,"height":24}]}},{"nodeType":"text","text":"來た。すると、その氣色が、先方へも通じたのであらう。老婆は、","layout":{"rects":[{"x":0,"y":3864,"width":480,"height":24}]}},{"nodeType":"text","text":"片手に、まだ屍骸の頭から奪つた長い拔け毛を持つたなり、蟇のつ","layout":{"rects":[{"x":0,"y":3888,"width":480,"height":24}]}},{"nodeType":"text","text":"ぶやくやうな聲で、口ごもりながら、こんな事を云つた。","layout":{"rects":[{"x":0,"y":3912,"width":416,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3936,"width":490,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"成程、死人の髮の毛を拔くと云ふ事は、惡い事かも知れぬ。しか","layout":{"rects":[{"x":0,"y":3936,"width":464,"height":24}]}},{"nodeType":"text","text":"し、かう云ふ死人の多くは、皆、その位な事を、されてもいゝ人間","layout":{"rects":[{"x":0,"y":3960,"width":480,"height":24}]}},{"nodeType":"text","text":"ばかりである。現に、自分が今、髮を拔いた女などは、蛇を四寸ば","layout":{"rects":[{"x":0,"y":3984,"width":480,"height":24}]}},{"nodeType":"text","text":"かりづゝに切つて干したのを、干魚だと云つて、太刀帶の陣へ賣り","layout":{"rects":[{"x":0,"y":4008,"width":480,"height":24}]}},{"nodeType":"text","text":"に行つた。疫病にかゝつて死ななかつたなら、今でも賣りに行つて","layout":{"rects":[{"x":0,"y":4032,"width":480,"height":24}]}},{"nodeType":"text","text":"ゐたかもしれない。しかも、この女の賣る干魚は、味がよいと云ふ","layout":{"rects":[{"x":0,"y":4056,"width":480,"height":24}]}},{"nodeType":"text","text":"ので、太刀帶たちが、缺かさず菜料に買つてゐたのである。自分","layout":{"rects":[{"x":0,"y":4080,"width":464,"height":24}]}},{"nodeType":"text","text":"は、この女のした事が惡いとは思はない。しなければ、饑死をする","layout":{"rects":[{"x":0,"y":4104,"width":480,"height":24}]}},{"nodeType":"text","text":"ので、仕方がなくした事だからである。だから、又今、自分のして","layout":{"rects":[{"x":0,"y":4128,"width":480,"height":24}]}},{"nodeType":"text","text":"ゐた事も惡い事とは思はない。これもやはりしなければ、饑死をす","layout":{"rects":[{"x":0,"y":4152,"width":480,"height":24}]}},{"nodeType":"text","text":"るので、仕方がなくする事だからである。さうして、その仕方がな","layout":{"rects":[{"x":0,"y":4176,"width":480,"height":24}]}},{"nodeType":"text","text":"い事を、よく知つてゐたこの女は、自分のする事を許してくれるの","layout":{"rects":[{"x":0,"y":4200,"width":480,"height":24}]}},{"nodeType":"text","text":"にちがひないと思ふからである。――老婆は、大體こんな意味の事","layout":{"rects":[{"x":0,"y":4224,"width":480,"height":24}]}},{"nodeType":"text","text":"を云つた。","layout":{"rects":[{"x":0,"y":4248,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4272,"width":490,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、太刀を鞘におさめて、その太刀の柄を左の手でおさへなが","layout":{"rects":[{"x":0,"y":4272,"width":480,"height":24}]}},{"nodeType":"text","text":"ら、冷然として、この話を聞いてゐた。勿論、右の手では、赤く頰","layout":{"rects":[{"x":0,"y":4296,"width":480,"height":24}]}},{"nodeType":"text","text":"に膿を持つた大きな面皰を氣にしながら、聞いてゐるのである。し","layout":{"rects":[{"x":0,"y":4320,"width":480,"height":24}]}},{"nodeType":"text","text":"かし、之を聞いてゐる中に、下人の心には、或勇氣が生まれて來","layout":{"rects":[{"x":0,"y":4344,"width":464,"height":24}]}},{"nodeType":"text","text":"た。それは、さつき、門の下でこの男に缺けてゐた勇氣である。さ","layout":{"rects":[{"x":0,"y":4368,"width":480,"height":24}]}},{"nodeType":"text","text":"うして、又さつき、この門の上へ上つて、この老婆を捕へた時の勇","layout":{"rects":[{"x":0,"y":4392,"width":480,"height":24}]}},{"nodeType":"text","text":"氣とは、全然、反對な方向に動かうとする勇氣である。下人は、饑","layout":{"rects":[{"x":0,"y":4416,"width":480,"height":24}]}},{"nodeType":"text","text":"死をするか盜人になるかに迷はなかつたばかりではない。その時の","layout":{"rects":[{"x":0,"y":4440,"width":480,"height":24}]}},{"nodeType":"text","text":"この男の心もちから云へば、饑死などと云ふ事は、殆、考へる事さ","layout":{"rects":[{"x":0,"y":4464,"width":480,"height":24}]}},{"nodeType":"text","text":"へ出來ない程、意識の外に追ひ出されてゐた。","layout":{"rects":[{"x":0,"y":4488,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4512,"width":490,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「きつと、そうか。」","layout":{"rects":[{"x":0,"y":4512,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4536,"width":490,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆の話が完ると、下人は嘲るやうな聲で念を押した。さうして、","layout":{"rects":[{"x":0,"y":4536,"width":480,"height":24}]}},{"nodeType":"text","text":"一足前へ出ると、不意に、右の手を面皰から離して、老婆の襟上を","layout":{"rects":[{"x":0,"y":4560,"width":480,"height":24}]}},{"nodeType":"text","text":"つかみながら、かう云つた。","layout":{"rects":[{"x":0,"y":4584,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4608,"width":490,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「では、己が引剝をしようと恨むまいな。己もさうしなければ、饑","layout":{"rects":[{"x":0,"y":4608,"width":480,"height":24}]}},{"nodeType":"text","text":"死をする體なのだ。」","layout":{"rects":[{"x":0,"y":4632,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4656,"width":490,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、すばやく、老婆の着物を剝ぎとつた。それから、足にしが","layout":{"rects":[{"x":0,"y":4656,"width":480,"height":24}]}},{"nodeType":"text","text":"みつかうとする老婆を、手荒く屍骸の上へ蹴倒した。梯子の口まで","layout":{"rects":[{"x":0,"y":4680,"width":480,"height":24}]}},{"nodeType":"text","text":"は、僅に五步を數へるばかりである。下人は、剝ぎとつた檜肌色の","layout":{"rects":[{"x":0,"y":4704,"width":480,"height":24}]}},{"nodeType":"text","text":"着物をわきにかゝへて、またゝく間に急な梯子を夜の底へかけ下り","layout":{"rects":[{"x":0,"y":4728,"width":480,"height":24}]}},{"nodeType":"text","text":"た。","layout":{"rects":[{"x":0,"y":4752,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4776,"width":490,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"暫、死んだやうに倒れてゐた老婆が、屍骸の中から、その裸の體を","layout":{"rects":[{"x":0,"y":4776,"width":480,"height":24}]}},{"nodeType":"text","text":"起したのは、それから間もなくの事である。老婆は、つぶやくやう","layout":{"rects":[{"x":0,"y":4800,"width":480,"height":24}]}},{"nodeType":"text","text":"な、うめくやうな聲を立てながら、まだ燃えてゐる火の光をたより","layout":{"rects":[{"x":0,"y":4824,"width":480,"height":24}]}},{"nodeType":"text","text":"に、梯子の口まで、這つて行つた。さうして、そこから、短い白髮","layout":{"rects":[{"x":0,"y":4848,"width":480,"height":24}]}},{"nodeType":"text","text":"を倒にして、門の下を覗きこんだ。外には、唯、黑洞々たる夜があ","layout":{"rects":[{"x":0,"y":4872,"width":480,"height":24}]}},{"nodeType":"text","text":"るばかりである。","layout":{"rects":[{"x":0,"y":4896,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4920,"width":490,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、既に、雨を冐して、京都の町へ强盜を働きに急いでゐた。","layout":{"rects":[{"x":0,"y":4920,"width":480,"height":24}]}}]}]}]}]}}