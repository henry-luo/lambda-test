[{"x":0,"y":5688,"width":320,"height":24}]}},{"nodeType":"text","text":"事を云つた。","layout":{"rects":[{"x":0,"y":5712,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5736,"width":320,"height":480},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"成程、死人の髮の毛を拔くと云ふ事は、惡い","layout":{"rects":[{"x":0,"y":5736,"width":320,"height":24}]}},{"nodeType":"text","text":"事かも知れぬ。しかし、かう云ふ死人の多く","layout":{"rects":[{"x":0,"y":5760,"width":320,"height":24}]}},{"nodeType":"text","text":"は、皆、その位な事を、されてもいゝ人間ば","layout":{"rects":[{"x":0,"y":5784,"width":320,"height":24}]}},{"nodeType":"text","text":"かりである。現に、自分が今、髮を拔いた女","layout":{"rects":[{"x":0,"y":5808,"width":320,"height":24}]}},{"nodeType":"text","text":"などは、蛇を四寸ばかりづゝに切つて干した","layout":{"rects":[{"x":0,"y":5832,"width":320,"height":24}]}},{"nodeType":"text","text":"のを、干魚だと云つて、太刀帶の陣へ賣りに","layout":{"rects":[{"x":0,"y":5856,"width":320,"height":24}]}},{"nodeType":"text","text":"行つた。疫病にかゝつて死ななかつたなら、","layout":{"rects":[{"x":0,"y":5880,"width":320,"height":24}]}},{"nodeType":"text","text":"今でも賣りに行つてゐたかもしれない。しか","layout":{"rects":[{"x":0,"y":5904,"width":320,"height":24}]}},{"nodeType":"text","text":"も、この女の賣る干魚は、味がよいと云ふの","layout":{"rects":[{"x":0,"y":5928,"width":320,"height":24}]}},{"nodeType":"text","text":"で、太刀帶たちが、缺かさず菜料に買つてゐ","layout":{"rects":[{"x":0,"y":5952,"width":320,"height":24}]}},{"nodeType":"text","text":"たのである。自分は、この女のした事が惡い","layout":{"rects":[{"x":0,"y":5976,"width":320,"height":24}]}},{"nodeType":"text","text":"とは思はない。しなければ、饑死をするの","layout":{"rects":[{"x":0,"y":6000,"width":304,"height":24}]}},{"nodeType":"text","text":"で、仕方がなくした事だからである。だか","layout":{"rects":[{"x":0,"y":6024,"width":304,"height":24}]}},{"nodeType":"text","text":"ら、又今、自分のしてゐた事も惡い事とは思","layout":{"rects":[{"x":0,"y":6048,"width":320,"height":24}]}},{"nodeType":"text","text":"はない。これもやはりしなければ、饑死をす","layout":{"rects":[{"x":0,"y":6072,"width":320,"height":24}]}},{"nodeType":"text","text":"るので、仕方がなくする事だからである。さ","layout":{"rects":[{"x":0,"y":6096,"width":320,"height":24}]}},{"nodeType":"text","text":"うして、その仕方がない事を、よく知つてゐ","layout":{"rects":[{"x":0,"y":6120,"width":320,"height":24}]}},{"nodeType":"text","text":"たこの女は、自分のする事を許してくれるの","layout":{"rects":[{"x":0,"y":6144,"width":320,"height":24}]}},{"nodeType":"text","text":"にちがひないと思ふからである。――老婆","layout":{"rects":[{"x":0,"y":6168,"width":304,"height":24}]}},{"nodeType":"text","text":"は、大體こんな意味の事を云つた。","layout":{"rects":[{"x":0,"y":6192,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6216,"width":320,"height":360},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、太刀を鞘におさめて、その太刀の柄","layout":{"rects":[{"x":0,"y":6216,"width":320,"height":24}]}},{"nodeType":"text","text":"を左の手でおさへながら、冷然として、この","layout":{"rects":[{"x":0,"y":6240,"width":320,"height":24}]}},{"nodeType":"text","text":"話を聞いてゐた。勿論、右の手では、赤く頰","layout":{"rects":[{"x":0,"y":6264,"width":320,"height":24}]}},{"nodeType":"text","text":"に膿を持つた大きな面皰を氣にしながら、聞","layout":{"rects":[{"x":0,"y":6288,"width":320,"height":24}]}},{"nodeType":"text","text":"いてゐるのである。しかし、之を聞いてゐる","layout":{"rects":[{"x":0,"y":6312,"width":320,"height":24}]}},{"nodeType":"text","text":"中に、下人の心には、或勇氣が生まれて來","layout":{"rects":[{"x":0,"y":6336,"width":304,"height":24}]}},{"nodeType":"text","text":"た。それは、さつき、門の下でこの男に缺け","layout":{"rects":[{"x":0,"y":6360,"width":320,"height":24}]}},{"nodeType":"text","text":"てゐた勇氣である。さうして、又さつき、こ","layout":{"rects":[{"x":0,"y":6384,"width":320,"height":24}]}},{"nodeType":"text","text":"の門の上へ上つて、この老婆を捕へた時の勇","layout":{"rects":[{"x":0,"y":6408,"width":320,"height":24}]}},{"nodeType":"text","text":"氣とは、全然、反對な方向に動かうとする勇","layout":{"rects":[{"x":0,"y":6432,"width":320,"height":24}]}},{"nodeType":"text","text":"氣である。下人は、饑死をするか盜人になる","layout":{"rects":[{"x":0,"y":6456,"width":320,"height":24}]}},{"nodeType":"text","text":"かに迷はなかつたばかりではない。その時の","layout":{"rects":[{"x":0,"y":6480,"width":320,"height":24}]}},{"nodeType":"text","text":"この男の心もちから云へば、饑死などと云ふ","layout":{"rects":[{"x":0,"y":6504,"width":320,"height":24}]}},{"nodeType":"text","text":"事は、殆、考へる事さへ出來ない程、意識の","layout":{"rects":[{"x":0,"y":6528,"width":320,"height":24}]}},{"nodeType":"text","text":"外に追ひ出されてゐた。","layout":{"rects":[{"x":0,"y":6552,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6576,"width":320,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「きつと、そうか。」","layout":{"rects":[{"x":0,"y":6576,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6600,"width":320,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆の話が完ると、下人は嘲るやうな聲で念","layout":{"rects":[{"x":0,"y":6600,"width":320,"height":24}]}},{"nodeType":"text","text":"を押した。さうして、一足前へ出ると、不意","layout":{"rects":[{"x":0,"y":6624,"width":320,"height":24}]}},{"nodeType":"text","text":"に、右の手を面皰から離して、老婆の襟上を","layout":{"rects":[{"x":0,"y":6648,"width":320,"height":24}]}},{"nodeType":"text","text":"つかみながら、かう云つた。","layout":{"rects":[{"x":0,"y":6672,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6696,"width":320,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「では、己が引剝をしようと恨むまいな。己","layout":{"rects":[{"x":0,"y":6696,"width":320,"height":24}]}},{"nodeType":"text","text":"もさうしなければ、饑死をする體なのだ。」","layout":{"rects":[{"x":0,"y":6720,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6744,"width":320,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、すばやく、老婆の着物を剝ぎとつ","layout":{"rects":[{"x":0,"y":6744,"width":304,"height":24}]}},{"nodeType":"text","text":"た。それから、足にしがみつかうとする老婆","layout":{"rects":[{"x":0,"y":6768,"width":320,"height":24}]}},{"nodeType":"text","text":"を、手荒く屍骸の上へ蹴倒した。梯子の口ま","layout":{"rects":[{"x":0,"y":6