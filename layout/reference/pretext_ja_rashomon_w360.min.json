","layout":{"rects":[{"x":0,"y":24,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":48,"width":360,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"廣い門の下には、この男の外に誰もゐない。唯、","layout":{"rects":[{"x":0,"y":48,"width":352,"height":24}]}},{"nodeType":"text","text":"所々丹塗の剝げた、大きな圓柱に、蟋蟀が一匹と","layout":{"rects":[{"x":0,"y":72,"width":352,"height":24}]}},{"nodeType":"text","text":"まつてゐる。羅生門が、朱雀大路にある以上は、","layout":{"rects":[{"x":0,"y":96,"width":352,"height":24}]}},{"nodeType":"text","text":"この男の外にも、雨やみをする市女笠や揉烏帽子","layout":{"rects":[{"x":0,"y":120,"width":352,"height":24}]}},{"nodeType":"text","text":"が、もう二三人はありさうなものである。それ","layout":{"rects":[{"x":0,"y":144,"width":336,"height":24}]}},{"nodeType":"text","text":"が、この男の外には誰もゐない。","layout":{"rects":[{"x":0,"y":168,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":192,"width":360,"height":360},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"何故かと云ふと、この二三年、京都には、地震と","layout":{"rects":[{"x":0,"y":192,"width":352,"height":24}]}},{"nodeType":"text","text":"か辻風とか火事とか饑饉とか云ふ災がつゞいて起","layout":{"rects":[{"x":0,"y":216,"width":352,"height":24}]}},{"nodeType":"text","text":"つた。そこで洛中のさびれ方は一通りでない。舊","layout":{"rects":[{"x":0,"y":240,"width":352,"height":24}]}},{"nodeType":"text","text":"記によると、佛像や佛具を打碎いて、その丹がつ","layout":{"rects":[{"x":0,"y":264,"width":352,"height":24}]}},{"nodeType":"text","text":"いたり、金銀の箔がついたりした木を、路ばたに","layout":{"rects":[{"x":0,"y":288,"width":352,"height":24}]}},{"nodeType":"text","text":"つみ重ねて、薪の料に賣つてゐたと云ふ事であ","layout":{"rects":[{"x":0,"y":312,"width":336,"height":24}]}},{"nodeType":"text","text":"る。洛中がその始末であるから、羅生門の修理な","layout":{"rects":[{"x":0,"y":336,"width":352,"height":24}]}},{"nodeType":"text","text":"どは、元より誰も捨てゝ顧る者がなかつた。する","layout":{"rects":[{"x":0,"y":360,"width":352,"height":24}]}},{"nodeType":"text","text":"とその荒れ果てたのをよい事にして、狐狸が棲","layout":{"rects":[{"x":0,"y":384,"width":336,"height":24}]}},{"nodeType":"text","text":"む。盜人が棲む。とうとうしまひには、引取り手","layout":{"rects":[{"x":0,"y":408,"width":352,"height":24}]}},{"nodeType":"text","text":"のない死人を、この門へ持つて來て、棄てゝ行く","layout":{"rects":[{"x":0,"y":432,"width":352,"height":24}]}},{"nodeType":"text","text":"と云ふ習慣さへ出來た。そこで、日の目が見えな","layout":{"rects":[{"x":0,"y":456,"width":352,"height":24}]}},{"nodeType":"text","text":"くなると、誰でも氣味を惡るがつて、この門の近","layout":{"rects":[{"x":0,"y":480,"width":352,"height":24}]}},{"nodeType":"text","text":"所へは足ぶみをしない事になつてしまつたのであ","layout":{"rects":[{"x":0,"y":504,"width":352,"height":24}]}},{"nodeType":"text","text":"る。","layout":{"rects":[{"x":0,"y":528,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":552,"width":360,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その代り又鴉が何處からか、たくさん集つて來","layout":{"rects":[{"x":0,"y":552,"width":336,"height":24}]}},{"nodeType":"text","text":"た。晝間見ると、その鴉が何羽となく輪を描いて","layout":{"rects":[{"x":0,"y":576,"width":352,"height":24}]}},{"nodeType":"text","text":"高い鴟尾のまはりを啼きながら、飛びまはつてゐ","layout":{"rects":[{"x":0,"y":600,"width":352,"height":24}]}},{"nodeType":"text","text":"る。殊に門の上の空が、夕燒けであかくなる時に","layout":{"rects":[{"x":0,"y":624,"width":352,"height":24}]}},{"nodeType":"text","text":"は、それが胡麻をまいたやうにはつきり見えた。","layout":{"rects":[{"x":0,"y":648,"width":352,"height":24}]}},{"nodeType":"text","text":"鴉は、勿論、門の上にある死人の肉を、啄みに來","layout":{"rects":[{"x":0,"y":672,"width":352,"height":24}]}},{"nodeType":"text","text":"るのである。――尤も今日は、刻限が遲いせい","layout":{"rects":[{"x":0,"y":696,"width":336,"height":24}]}},{"nodeType":"text","text":"か、一羽も見えない。唯、所々、崩れかゝつた、","layout":{"rects":[{"x":0,"y":720,"width":352,"height":24}]}},{"nodeType":"text","text":"さうしてその崩れ目に長い草のはへた石段の上","layout":{"rects":[{"x":0,"y":744,"width":336,"height":24}]}},{"nodeType":"text","text":"に、鴉の糞が、點々と白くこびりついてゐるのが","layout":{"rects":[{"x":0,"y":768,"width":352,"height":24}]}},{"nodeType":"text","text":"見える。下人は七段ある石段の一番上の段に洗ひ","layout":{"rects":[{"x":0,"y":792,"width":352,"height":24}]}},{"nodeType":"text","text":"ざらした紺の襖の尻を据ゑて、右の頰に出來た、","layout":{"rects":[{"x":0,"y":816,"width":352,"height":24}]}},{"nodeType":"text","text":"大きな面皰を氣にしながら、ぼんやり、雨のふる","layout":{"rects":[{"x":0,"y":840,"width":352,"height":24}]}},{"nodeType":"text","text":"のを眺めてゐるのである。","layout":{"rects":[{"x":0,"y":864,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":888,"width":360,"height":456},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"作者はさつき、「下人が雨やみを待つてゐた」と","layout":{"rects":[{"x":0,"y":888,"width":352,"height":24}]}},{"nodeType":"text","text":"書いた。しかし、下人は、雨がやんでも格別どう","layout":{"rects":[{"x":0,"y":912,"width":352,"height":24}]}},{"nodeType":"text","text":"しようと云ふ當てはない。ふだんなら、勿論、主","layout":{"rects":[{"x":0,"y":936,"width":352,"height":24}]}},{"nodeType":"text","text":"人の家へ歸る可き筈である。所がその主人から","layout":{"rects":[{"x":0,"y":960,"width":336,"height":24}]}},{"nodeType":"text","text":"は、四五日前に暇を出された。前にも書いたやう","layout":{"rects":[{"x":0,"y":984,"width":352,"height":24}]}},{"nodeType":"text","text":"に、當時京都の町は一通りならず衰微してゐた。","layout":{"rects":[{"x":0,"y":1008,"width":352,"height":24}]}},{"nodeType":"text","text":"今この下人が、永年、使はれてゐた主人から、暇","layout":{"rects":[{"x":0,"y":1032,"width":352,"height":24}]}},{"nodeType":"text","text":"を出されたのも、この衰微の小さな餘波に外なら","layout":{"rects":[{"x":0,"y":1056,"width":352,"height":24}]}},{"nodeType":"text","text":"ない。だから「下人が雨やみを待つてゐた」と云","layout":{"rects":[{"x":0,"y":1080,"width":352,"height":24}]}},{"nodeType":"text","text":"ふよりも、「雨にふりこめられた下人が、行き所","layout":{"rects":[{"x":0,"y":1104,"width":352,"height":24}]}},{"nodeType":"text","text":"がなくて、途方にくれてゐた」と云ふ方が、適當","layout":{"rects":[{"x":0,"y":1128,"width":352,"height":24}]}},{"nodeType":"text","text":"である。その上、今日の空模樣も少からずこの平","layout":{"rects":[{"x":0,"y":1152,"width":352,"height":24}]}},{"nodeType":"text","text":"安朝の下人の Sentimentalisme に影響した。申の","layout":{"rects":[{"x":0,"y":1176,"width":358.36,"height":24}]}},{"nodeType":"text","text":"刻下りからふり出した雨は、未に上るけしきがな","layout":{"rects":[{"x":0,"y":1200,"width":352,"height":24}]}},{"nodeType":"text","text":"い。そこで、下人は、何を措いても差當り明日の","layout":{"rects":[{"x":0,"y":1224,"width":352,"height":24}]}},{"nodeType":"text","text":"暮しをどうにかしようとして――云はゞどうにも","layout":{"rects":[{"x":0,"y":1248,"width":352,"height":24}]}},{"nodeType":"text","text":"ならない事を、どうにかしようとして、とりとめ","layout":{"rects":[{"x":0,"y":1272,"width":352,"height":24}]}},{"nodeType":"text","text":"もない考へをたどりながら、さつきから朱雀大路","layout":{"rects":[{"x":0,"y":1296,"width":352,"height":24}]}},{"nodeType":"text","text":"にふる雨の音を、聞くともなく聞いてゐた。","layout":{"rects":[{"x":0,"y":1320,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1344,"width":360,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"雨は、羅生門をつゝんで、遠くから、ざあつと云","layout":{"rects":[{"x":0,"y":1344,"width":352,"height":24}]}},{"nodeType":"text","text":"ふ音をあつめて來る。夕闇は次第に空を低くし","layout":{"rects":[{"x":0,"y":1368,"width":336,"height":24}]}},{"nodeType":"text","text":"て、見上げると、門の屋根が、斜につき出した甍","layout":{"rects":[{"x":0,"y":1392,"width":352,"height":24}]}},{"nodeType":"text","text":"の先に、重たくうす暗い雲を支へてゐる。","layout":{"rects":[{"x":0,"y":1416,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1440,"width":360,"height":312},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"どうにもならない事を、どうにかする爲には、手","layout":{"rects":[{"x":0,"y":1440,"width":352,"height":24}]}},{"nodeType":"text","text":"段を選んでゐる遑はない。選んでゐれば、築土の","layout":{"rects":[{"x":0,"y":1464,"width":352,"height":24}]}},{"nodeType":"text","text":"下か、道ばたの土の上で、饑死をするばかりであ","layout":{"rects":[{"x":0,"y":1488,"width":352,"height":24}]}},{"nodeType":"text","text":"る。さうして、この門の上へ持つて來て、犬のや","layout":{"rects":[{"x":0,"y":1512,"width":352,"height":24}]}},{"nodeType":"text","text":"うに棄てられてしまふばかりである。選ばないと","layout":{"rects":[{"x":0,"y":1536,"width":352,"height":24}]}},{"nodeType":"text","text":"すれば――下人の考へは、何度も同じ道を低徊し","layout":{"rects":[{"x":0,"y":1560,"width":352,"height":24}]}},{"nodeType":"text","text":"た揚句に、やつとこの局所へ逢着した。しかしこ","layout":{"rects":[{"x":0,"y":1584,"width":352,"height":24}]}},{"nodeType":"text","text":"の「すれば」は、何時までたつても、結局「すれ","layout":{"rects":[{"x":0,"y":1608,"width":352,"height":24}]}},{"nodeType":"text","text":"ば」であつた。下人は、手段を選ばないといふ事","layout":{"rects":[{"x":0,"y":1632,"width":352,"height":24}]}},{"nodeType":"text","text":"を肯定しながらも、この「すれば」のかたをつけ","layout":{"rects":[{"x":0,"y":1656,"width":352,"height":24}]}},{"nodeType":"text","text":"る爲に、當然、その後に來る可き「盜人になるよ","layout":{"rects":[{"x":0,"y":1680,"width":352,"height":24}]}},{"nodeType":"text","text":"り外に仕方がない」と云ふ事を、積極的に肯定す","layout":{"rects":[{"x":0,"y":1704,"width":352,"height":24}]}},{"nodeType":"text","text":"る丈の、勇氣が出ずにゐたのである。","layout":{"rects":[{"x":0,"y":1728,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1752,"width":360,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、大きな嚏をして、それから、大儀さうに","layout":{"rects":[{"x":0,"y":1752,"width":352,"height":24}]}},{"nodeType":"text","text":"立上つた。夕冷えのする京都は、もう火桶が欲し","layout":{"rects":[{"x":0,"y":1776,"width":352,"height":24}]}},{"nodeType":"text","text":"い程の寒さである。風は門の柱と柱との間を、夕","layout":{"rects":[{"x":0,"y":1800,"width":352,"height":24}]}},{"nodeType":"text","text":"闇と共に遠慮なく、吹きぬける。丹塗の柱にとま","layout":{"rects":[{"x":0,"y":1824,"width":352,"height":24}]}},{"nodeType":"text","text":"つてゐた蟋蟀も、もうどこかへ行つてしまつた。","layout":{"rects":[{"x":0,"y":1848,"width":352,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1872,"width":360,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、頸をちゞめながら、山吹の汗衫に重ね","layout":{"rects":[{"x":0,"y":1872,"width":336,"height":24}]}},{"nodeType":"text","text":"た、紺の襖の肩を高くして門のまはりを見まはし","layout":{"rects":[{"x":0,"y":1896,"width":352,"height":24}]}},{"nodeType":"text","text":"た。雨風の患のない、人目にかゝる惧のない、一","layout":{"rects":[{"x":0,"y":1920,"width":352,"height":24}]}},{"nodeType":"text","text":"晚樂にねられさうな所があれば、そこでともかく","layout":{"rects":[{"x":0,"y":1944,"width":352,"height":24}]}},{"nodeType":"text","text":"も、夜を明かさうと思つたからである。すると、","layout":{"rects":[{"x":0,"y":1968,"width":352,"height":24}]}},{"nodeType":"text","text":"幸門の上の樓へ上る、幅の廣い、之も丹を塗つた","layout":{"rects":[{"x":0,"y":1992,"width":352,"height":24}]}},{"nodeType":"text","text":"梯子が眼についた。上なら、人がゐたにしても、","layout":{"rects":[{"x":0,"y":2016,"width":352,"height":24}]}},{"nodeType":"text","text":"どうせ死人ばかりである。下人は、そこで腰にさ","layout":{"rects":[{"x":0,"y":2040,"width":352,"height":24}]}},{"nodeType":"text","text":"げた聖柄の太刀が鞘走らないやうに氣をつけなが","layout":{"rects":[{"x":0,"y":2064,"width":352,"height":24}]}},{"nodeType":"text","text":"ら、藁草履をはいた足を、その梯子の一番下の段","layout":{"rects":[{"x":0,"y":2088,"width":352,"height":24}]}},{"nodeType":"text","text":"へふみかけた。","layout":{"rects":[{"x":0,"y":2112,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2136,"width":360,"height":360},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"それから、何分かの後である。羅生門の樓の上へ","layout":{"rects":[{"x":0,"y":2136,"width":352,"height":24}]}},{"nodeType":"text","text":"出る、幅の廣い梯子の中段に、一人の男が、猫の","layout":{"rects":[{"x":0,"y":2160,"width":352,"height":24}]}},{"nodeType":"text","text":"やうに身をちゞめて、息を殺しながら、上の容子","layout":{"rects":[{"x":0,"y":2184,"width":352,"height":24}]}},{"nodeType":"text","text":"を窺つてゐた。樓の上からさす火の光が、かすか","layout":{"rects":[{"x":0,"y":2208,"width":352,"height":24}]}},{"nodeType":"text","text":"に、その男の右の頰をぬらしてゐる。短い鬚の中","layout":{"rects":[{"x":0,"y":2232,"width":352,"height":24}]}},{"nodeType":"text","text":"に、赤く膿を持つた面皰のある頰である。下人","layout":{"rects":[{"x":0,"y":2256,"width":336,"height":24}]}},{"nodeType":"text","text":"は、始めから、この上にゐる者は、死人ばかりだ","layout":{"rects":[{"x":0,"y":2280,"width":352,"height":24}]}},{"nodeType":"text","text":"と高を括つてゐた。それが、梯子を二三段上つて","layout":{"rects":[{"x":0,"y":2304,"width":352,"height":24}]}},{"nodeType":"text","text":"見ると、上では誰か火をとぼして、しかもその火","layout":{"rects":[{"x":0,"y":2328,"width":352,"height":24}]}},{"nodeType":"text","text":"を其處此處と動かしてゐるらしい。これは、その","layout":{"rects":[{"x":0,"y":2352,"width":352,"height":24}]}},{"nodeType":"text","text":"濁つた、黃いろい光が、隅々に蜘蛛の巢をかけた","layout":{"rects":[{"x":0,"y":2376,"width":352,"height":24}]}},{"nodeType":"text","text":"天井裏に、ゆれながら映つたので、すぐにそれと","layout":{"rects":[{"x":0,"y":2400,"width":352,"height":24}]}},{"nodeType":"text","text":"知れたのである。この雨の夜に、この羅生門の上","layout":{"rects":[{"x":0,"y":2424,"width":352,"height":24}]}},{"nodeType":"text","text":"で、火をともしてゐるからは、どうせ唯の者では","layout":{"rects":[{"x":0,"y":2448,"width":352,"height":24}]}},{"nodeType":"text","text":"ない。","layout":{"rects":[{"x":0,"y":2472,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2496,"width":360,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、守宮のやうに足音をぬすんで、やつと急","layout":{"rects":[{"x":0,"y":2496,"width":352,"height":24}]}},{"nodeType":"text","text":"な梯子を、一番上の段まで這ふやうにして上りつ","layout":{"rects":[{"x":0,"y":2520,"width":352,"height":24}]}},{"nodeType":"text","text":"めた。さうして體を出來る丈、平にしながら、頸","layout":{"rects":[{"x":0,"y":2544,"width":352,"height":24}]}},{"nodeType":"text","text":"を出來る丈、前へ出して、恐る恐る、樓の內を覗","layout":{"rects":[{"x":0,"y":2568,"width":352,"height":24}]}},{"nodeType":"text","text":"いて見た。","layout":{"rects":[{"x":0,"y":2592,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2616,"width":360,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"見ると、樓の內には、噂に聞いた通り、幾つかの","layout":{"rects":[{"x":0,"y":2616,"width":352,"height":24}]}},{"nodeType":"text","text":"屍骸が、無造作に棄てゝあるが、火の光の及ぶ範","layout":{"rects":[{"x":0,"y":2640,"width":352,"height":24}]}},{"nodeType":"text","text":"圍が、思つたより狹いので、數は幾つともわから","layout":{"rects":[{"x":0,"y":2664,"width":352,"height":24}]}},{"nodeType":"text","text":"ない。唯、おぼろげながら、知れるのは、その中","layout":{"rects":[{"x":0,"y":2688,"width":352,"height":24}]}},{"nodeType":"text","text":"に裸の屍骸と、着物を着た屍骸とがあると云ふ事","layout":{"rects":[{"x":0,"y":2712,"width":352,"height":24}]}},{"nodeType":"text","text":"である。勿論、中には女も男もまじつてゐるらし","layout":{"rects":[{"x":0,"y":2736,"width":352,"height":24}]}},{"nodeType":"text","text":"い。さうして、その屍骸は皆、それが、甞、生き","layout":{"rects":[{"x":0,"y":2760,"width":352,"height":24}]}},{"nodeType":"text","text":"てゐた人間だと云ふ事實さへ疑はれる程、土を捏","layout":{"rects":[{"x":0,"y":2784,"width":352,"height":24}]}},{"nodeType":"text","text":"ねて造つた人形のやうに、口を開いたり手を延ば","layout":{"rects":[{"x":0,"y":2808,"width":352,"height":24}]}},{"nodeType":"text","text":"したりしてごろごろ床の上にころがつてゐた。し","layout":{"rects":[{"x":0,"y":2832,"width":352,"height":24}]}},{"nodeType":"text","text":"かも、肩とか胸とかの高くなつてゐる部分に、ぼ","layout":{"rects":[{"x":0,"y":2856,"width":352,"height":24}]}},{"nodeType":"text","text":"んやりした火の光をうけて、低くなつてゐる部分","layout":{"rects":[{"x":0,"y":2880,"width":352,"height":24}]}},{"nodeType":"text","text":"の影を一層暗くしながら、永久に啞の如く默つて","layout":{"rects":[{"x":0,"y":2904,"width":352,"height":24}]}},{"nodeType":"text","text":"いた。","layout":{"rects":[{"x":0,"y":2928,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2952,"width":360,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、それらの屍骸の腐爛した臭氣に思はず、","layout":{"rects":[{"x":0,"y":2952,"width":352,"height":24}]}},{"nodeType":"text","text":"鼻を掩つた。しかし、その手は、次の瞬間には、","layout":{"rects":[{"x":0,"y":2976,"width":352,"height":24}]}},{"nodeType":"text","text":"もう鼻を掩ふ事を忘れてゐた。或る强い感情が、","layout":{"rects":[{"x":0,"y":3000,"width":352,"height":24}]}},{"nodeType":"text","text":"殆悉この男の嗅覺を奪つてしまつたからである。","layout":{"rects":[{"x":0,"y":3024,"width":352,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3048,"width":360,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人の眼は、その時、はじめて、其屍骸の中に蹲","layout":{"rects":[{"x":0,"y":3048,"width":352,"height":24}]}},{"nodeType":"text","text":"つている人間を見た。檜肌色の着物を著た、背の","layout":{"rects":[{"x":0,"y":3072,"width":352,"height":24}]}},{"nodeType":"text","text":"低い、瘦せた、白髮頭の、猿のやうな老婆であ","layout":{"rects":[{"x":0,"y":3096,"width":336,"height":24}]}},{"nodeType":"text","text":"る。その老婆は、右の手に火をともした松の木片","layout":{"rects":[{"x":0,"y":3120,"width":352,"height":24}]}},{"nodeType":"text","text":"を持つて、その屍骸の一つの顏を覗きこむやうに","layout":{"rects":[{"x":0,"y":3144,"width":352,"height":24}]}},{"nodeType":"text","text":"眺めてゐた。髮の毛の長い所を見ると、多分女の","layout":{"rects":[{"x":0,"y":3168,"width":352,"height":24}]}},{"nodeType":"text","text":"屍骸であらう。","layout":{"rects":[{"x":0,"y":3192,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3216,"width":360,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、六分の恐怖と四分の好奇心とに動かされ","layout":{"rects":[{"x":0,"y":3216,"width":352,"height":24}]}},{"nodeType":"text","text":"て、暫時は呼吸をするのさへ忘れてゐた。舊記の","layout":{"rects":[{"x":0,"y":3240,"width":352,"height":24}]}},{"nodeType":"text","text":"記者の語を借りれば、「頭身の毛も太る」やうに","layout":{"rects":[{"x":0,"y":3264,"width":352,"height":24}]}},{"nodeType":"text","text":"感じたのである。すると、老婆は、松の木片を、","layout":{"rects":[{"x":0,"y":3288,"width":352,"height":24}]}},{"nodeType":"text","text":"床板の間に挿して、それから、今まで眺めてゐた","layout":{"rects":[{"x":0,"y":3312,"width":352,"height":24}]}},{"nodeType":"text","text":"屍骸の首に兩手をかけると、丁度、猿の親が猿の","layout":{"rects":[{"x":0,"y":3336,"width":352,"height":24}]}},{"nodeType":"text","text":"子の虱をとるやうに、その長い髮の毛を一本づゝ","layout":{"rects":[{"x":0,"y":3360,"width":352,"height":24}]}},{"nodeType":"text","text":"拔きはじめた。髮は手に從つて拔けるらしい。","layout":{"rects":[{"x":0,"y":3384,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3408,"width":360,"height":312},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その髮の毛が、一本ずゝ拔けるのに從つて下人の","layout":{"rects":[{"x":0,"y":3408,"width":352,"height":24}]}},{"nodeType":"text","text":"心からは、恐怖が少しづつ消えて行つた。さうし","layout":{"rects":[{"x":0,"y":3432,"width":352,"height":24}]}},{"nodeType":"text","text":"て、それと同時に、この老婆に對するはげしい憎","layout":{"rects":[{"x":0,"y":3456,"width":352,"height":24}]}},{"nodeType":"text","text":"惡が、少しづゝ動いて來た。――いや、この老婆","layout":{"rects":[{"x":0,"y":3480,"width":352,"height":24}]}},{"nodeType":"text","text":"に對すると云つては、語弊があるかも知れない。","layout":{"rects":[{"x":0,"y":3504,"width":352,"height":24}]}},{"nodeType":"text","text":"寧、あらゆる惡に對する反感が、一分每に强さを","layout":{"rects":[{"x":0,"y":3528,"width":352,"height":24}]}},{"nodeType":"text","text":"增して來たのである。この時、誰かがこの下人","layout":{"rects":[{"x":0,"y":3552,"width":336,"height":24}]}},{"nodeType":"text","text":"に、さつき門の下でこの男が考へてゐた、饑死を","layout":{"rects":[{"x":0,"y":3576,"width":352,"height":24}]}},{"nodeType":"text","text":"するか盜人になるかと云ふ問題を、改めて持出し","layout":{"rects":[{"x":0,"y":3600,"width":352,"height":24}]}},{"nodeType":"text","text":"たら、恐らく下人は、何の未練もなく、饑死を選","layout":{"rects":[{"x":0,"y":3624,"width":352,"height":24}]}},{"nodeType":"text","text":"んだ事であらう。それほど、この男の惡を憎む心","layout":{"rects":[{"x":0,"y":3648,"width":352,"height":24}]}},{"nodeType":"text","text":"は、老婆の床に挿した松の木片のやうに、勢よく","layout":{"rects":[{"x":0,"y":3672,"width":352,"height":24}]}},{"nodeType":"text","text":"燃え上り出してゐたのである。","layout":{"rects":[{"x":0,"y":3696,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3720,"width":360,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人には、勿論、何故老婆が死人の髮の毛を拔く","layout":{"rects":[{"x":0,"y":3720,"width":352,"height":24}]}},{"nodeType":"text","text":"かわからなかつた。從つて、合理的には、それを","layout":{"rects":[{"x":0,"y":3744,"width":352,"height":24}]}},{"nodeType":"text","text":"善惡の何れに片づけてよいか知らなかつた。しか","layout":{"rects":[{"x":0,"y":3768,"width":352,"height":24}]}},{"nodeType":"text","text":"し下人にとつては、この雨の夜に、この羅生門の","layout":{"rects":[{"x":0,"y":3792,"width":352,"height":24}]}},{"nodeType":"text","text":"上で、死人の髮の毛を拔くと云ふ事が、それ丈で","layout":{"rects":[{"x":0,"y":3816,"width":352,"height":24}]}},{"nodeType":"text","text":"既に許す可らざる惡であつた。勿論、下人は、さ","layout":{"rects":[{"x":0,"y":3840,"width":352,"height":24}]}},{"nodeType":"text","text":"つき迄自分が、盜人になる氣でゐた事なぞは、と","layout":{"rects":[{"x":0,"y":3864,"width":352,"height":24}]}},{"nodeType":"text","text":"うに忘れてゐるのである。","layout":{"rects":[{"x":0,"y":3888,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3912,"width":360,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"そこで、下人は、兩足に力を入れて、いきなり、","layout":{"rects":[{"x":0,"y":3912,"width":352,"height":24}]}},{"nodeType":"text","text":"梯子から上へ飛び上つた。さうして聖柄の太刀に","layout":{"rects":[{"x":0,"y":3936,"width":352,"height":24}]}},{"nodeType":"text","text":"手をかけながら、大股に老婆の前へ步みよつた。","layout":{"rects":[{"x":0,"y":3960,"width":352,"height":24}]}},{"nodeType":"text","text":"老婆が驚いたのは、云ふ迄もない。","layout":{"rects":[{"x":0,"y":3984,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4008,"width":360,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆は、一目下人を見ると、まるで弩にでも彈か","layout":{"rects":[{"x":0,"y":4008,"width":352,"height":24}]}},{"nodeType":"text","text":"れたやうに、飛び上つた。","layout":{"rects":[{"x":0,"y":4032,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4056,"width":360,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「おのれ、どこへ行く。」","layout":{"rects":[{"x":0,"y":4056,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4080,"width":360,"height":216},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆が屍骸につまづきながら、慌てふた","layout":{"rects":[{"x":0,"y":4080,"width":352,"height":24}]}},{"nodeType":"text","text":"めいて逃げようとする行手を塞いで、こう罵つ","layout":{"rects":[{"x":0,"y":4104,"width":336,"height":24}]}},{"nodeType":"text","text":"た。老婆は、それでも下人をつきのけて行かうと","layout":{"rects":[{"x":0,"y":4128,"width":352,"height":24}]}},{"nodeType":"text","text":"する。下人は又、それを行かすまいとして、押し","layout":{"rects":[{"x":0,"y":4152,"width":352,"height":24}]}},{"nodeType":"text","text":"もどす。二人は屍骸の中で、暫、無言のまゝ、つ","layout":{"rects":[{"x":0,"y":4176,"width":352,"height":24}]}},{"nodeType":"text","text":"かみ合つた。しかし勝敗は、はじめから、わかつ","layout":{"rects":[{"x":0,"y":4200,"width":352,"height":24}]}},{"nodeType":"text","text":"ている。下人はとうとう、老婆の腕をつかんで、","layout":{"rects":[{"x":0,"y":4224,"width":352,"height":24}]}},{"nodeType":"text","text":"無理にそこへ扭ぢ倒した。丁度、鷄の脚のやう","layout":{"rects":[{"x":0,"y":4248,"width":336,"height":24}]}},{"nodeType":"text","text":"な、骨と皮ばかりの腕である。","layout":{"rects":[{"x":0,"y":4272,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4296,"width":360,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「何をしてゐた。さあ何をしてゐた。云へ。云は","layout":{"rects":[{"x":0,"y":4296,"width":352,"height":24}]}},{"nodeType":"text","text":"ぬと、これだぞよ。」","layout":{"rects":[{"x":0,"y":4320,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4344,"width":360,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆をつき放すと、いきなり、太刀の鞘","layout":{"rects":[{"x":0,"y":4344,"width":352,"height":24}]}},{"nodeType":"text","text":"を拂つて、白い鋼の色をその眼の前へつきつけ","layout":{"rects":[{"x":0,"y":4368,"width":336,"height":24}]}},{"nodeType":"text","text":"た。けれども、老婆は默つてゐる。兩手をわなわ","layout":{"rects":[{"x":0,"y":4392,"width":352,"height":24}]}},{"nodeType":"text","text":"なふるはせて、肩で息を切りながら、眼を、眼球","layout":{"rects":[{"x":0,"y":4416,"width":352,"height":24}]}},{"nodeType":"text","text":"が眶の外へ出さうになる程、見開いて、啞のやう","layout":{"rects":[{"x":0,"y":4440,"width":352,"height":24}]}},{"nodeType":"text","text":"に執拗く默つてゐる。これを見ると、下人は始め","layout":{"rects":[{"x":0,"y":4464,"width":352,"height":24}]}},{"nodeType":"text","text":"て明白にこの老婆の生死が、全然、自分の意志に","layout":{"rects":[{"x":0,"y":4488,"width":352,"height":24}]}},{"nodeType":"text","text":"支配されてゐると云ふ事を意識した。さうして、","layout":{"rects":[{"x":0,"y":4512,"width":352,"height":24}]}},{"nodeType":"text","text":"この意識は、今まではげしく燃えてゐた憎惡の心","layout":{"rects":[{"x":0,"y":4536,"width":352,"height":24}]}},{"nodeType":"text","text":"を何時の間にか冷ましてしまつた。後に殘つたの","layout":{"rects":[{"x":0,"y":4560,"width":352,"height":24}]}},{"nodeType":"text","text":"は、唯、或仕事をして、それが圓滿に成就した時","layout":{"rects":[{"x":0,"y":4584,"width":352,"height":24}]}},{"nodeType":"text","text":"の、安らかな得意と滿足とがあるばかりである。","layout":{"rects":[{"x":0,"y":4608,"width":352,"height":24}]}},{"nodeType":"text","text":"そこで、下人は、老婆を見下しながら、少し聲を","layout":{"rects":[{"x":0,"y":4632,"width":352,"height":24}]}},{"nodeType":"text","text":"柔げてかう云つた。","layout":{"rects":[{"x":0,"y":4656,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4680,"width":360,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「己は檢非違使の廳の役人などではない。今し方","layout":{"rects":[{"x":0,"y":4680,"width":352,"height":24}]}},{"nodeType":"text","text":"この門の下を通りかゝつた旅の者だ。だからお前","layout":{"rects":[{"x":0,"y":4704,"width":352,"height":24}]}},{"nodeType":"text","text":"に繩をかけて、どうしようと云ふやうな事はな","layout":{"rects":[{"x":0,"y":4728,"width":336,"height":24}]}},{"nodeType":"text","text":"い。唯、今時分、この門の上で、何をして居たの","layout":{"rects":[{"x":0,"y":4752,"width":352,"height":24}]}},{"nodeType":"text","text":"だか、それを己に話しさへすればいいのだ。」","layout":{"rects":[{"x":0,"y":4776,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4800,"width":360,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"すると、老婆は、見開いてゐた眼を、一層大きく","layout":{"rects":[{"x":0,"y":4800,"width":352,"height":24}]}},{"nodeType":"text","text":"して、ぢつとその下人の顏を見守つた。眶の赤く","layout":{"rects":[{"x":0,"y":4824,"width":352,"height":24}]}},{"nodeType":"text","text":"なつた、肉食鳥のやうな、銳い眼で見たのであ","layout":{"rects":[{"x":0,"y":4848,"width":336,"height":24}]}},{"nodeType":"text","text":"る。それから、皺で、殆、鼻と一つになつた唇","layout":{"rects":[{"x":0,"y":4872,"width":336,"height":24}]}},{"nodeType":"text","text":"を、何か物でも嚙んでゐるやうに動かした。細い","layout":{"rects":[{"x":0,"y":4896,"width":352,"height":24}]}},{"nodeType":"text","text":"喉で、尖つた喉佛の動いてゐるのが見える。その","layout":{"rects":[{"x":0,"y":4920,"width":352,"height":24}]}},{"nodeType":"text","text":"時、その喉から、鴉の啼くやうな聲が、喘ぎ喘","layout":{"rects":[{"x":0,"y":4944,"width":336,"height":24}]}},{"nodeType":"text","text":"ぎ、下人の耳へ傳はつて來た。","layout":{"rects":[{"x":0,"y":4968,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4992,"width":360,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「この髮を拔いてな、この女の髮を拔いてな、鬘","layout":{"rects":[{"x":0,"y":4992,"width":352,"height":24}]}},{"nodeType":"text","text":"にせうと思うたのぢや。」","layout":{"rects":[{"x":0,"y":5016,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5040,"width":360,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆の答が存外、平凡なのに失望した。","layout":{"rects":[{"x":0,"y":5040,"width":352,"height":24}]}},{"nodeType":"text","text":"さうして失望すると同時に、又前の憎惡が、冷な","layout":{"rects":[{"x":0,"y":5064,"width":352,"height":24}]}},{"nodeType":"text","text":"侮蔑と一しよに、心の中へはいつて來た。する","layout":{"rects":[{"x":0,"y":5088,"width":336,"height":24}]}},{"nodeType":"text","text":"と、その氣色が、先方へも通じたのであらう。老","layout":{"rects":[{"x":0,"y":5112,"width":352,"height":24}]}},{"nodeType":"text","text":"婆は、片手に、まだ屍骸の頭から奪つた長い拔け","layout":{"rects":[{"x":0,"y":5136,"width":352,"height":24}]}},{"nodeType":"text","text":"毛を持つたなり、蟇のつぶやくやうな聲で、口ご","layout":{"rects":[{"x":0,"y":5160,"width":352,"height":24}]}},{"nodeType":"text","text":"もりながら、こんな事を云つた。","layout":{"rects":[{"x":0,"y":5184,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5208,"width":360,"height":432},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"成程、死人の髮の毛を拔くと云ふ事は、惡い事か","layout":{"rects":[{"x":0,"y":5208,"width":352,"height":24}]}},{"nodeType":"text","text":"も知れぬ。しかし、かう云ふ死人の多くは、皆、","layout":{"rects":[{"x":0,"y":5232,"width":352,"height":24}]}},{"nodeType":"text","text":"その位な事を、されてもいゝ人間ばかりである。","layout":{"rects":[{"x":0,"y":5256,"width":352,"height":24}]}},{"nodeType":"text","text":"現に、自分が今、髮を拔いた女などは、蛇を四寸","layout":{"rects":[{"x":0,"y":5280,"width":352,"height":24}]}},{"nodeType":"text","text":"ばかりづゝに切つて干したのを、干魚だと云つ","layout":{"rects":[{"x":0,"y":5304,"width":336,"height":24}]}},{"nodeType":"text","text":"て、太刀帶の陣へ賣りに行つた。疫病にかゝつて","layout":{"rects":[{"x":0,"y":5328,"width":352,"height":24}]}},{"nodeType":"text","text":"死ななかつたなら、今でも賣りに行つてゐたかも","layout":{"rects":[{"x":0,"y":5352,"width":352,"height":24}]}},{"nodeType":"text","text":"しれない。しかも、この女の賣る干魚は、味がよ","layout":{"rects":[{"x":0,"y":5376,"width":352,"height":24}]}},{"nodeType":"text","text":"いと云ふので、太刀帶たちが、缺かさず菜料に買","layout":{"rects":[{"x":0,"y":5400,"width":352,"height":24}]}},{"nodeType":"text","text":"つてゐたのである。自分は、この女のした事が惡","layout":{"rects":[{"x":0,"y":5424,"width":352,"height":24}]}},{"nodeType":"text","text":"いとは思はない。しなければ、饑死をするので、","layout":{"rects":[{"x":0,"y":5448,"width":352,"height":24}]}},{"nodeType":"text","text":"仕方がなくした事だからである。だから、又今、","layout":{"rects":[{"x":0,"y":5472,"width":352,"height":24}]}},{"nodeType":"text","text":"自分のしてゐた事も惡い事とは思はない。これも","layout":{"rects":[{"x":0,"y":5496,"width":352,"height":24}]}},{"nodeType":"text","text":"やはりしなければ、饑死をするので、仕方がなく","layout":{"rects":[{"x":0,"y":5520,"width":352,"height":24}]}},{"nodeType":"text","text":"する事だからである。さうして、その仕方がない","layout":{"rects":[{"x":0,"y":5544,"width":352,"height":24}]}},{"nodeType":"text","text":"事を、よく知つてゐたこの女は、自分のする事を","layout":{"rects":[{"x":0,"y":5568,"width":352,"height":24}]}},{"nodeType":"text","text":"許してくれるのにちがひないと思ふからである。","layout":{"rects":[{"x":0,"y":5592,"width":352,"height":24}]}},{"nodeType":"text","text":"――老婆は、大體こんな意味の事を云つた。","layout":{"rects":[{"x":0,"y":5616,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5640,"width":360,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、太刀を鞘におさめて、その太刀の柄を左","layout":{"rects":[{"x":0,"y":5640,"width":352,"height":24}]}},{"nodeType":"text","text":"の手でおさへながら、冷然として、この話を聞い","layout":{"rects":[{"x":0,"y":5664,"width":352,"height":24}]}},{"nodeType":"text","text":"てゐた。勿論、右の手では、赤く頰に膿を持つた","layout":{"rects":[{"x":0,"y":5688,"width":352,"height":24}]}},{"nodeType":"text","text":"大きな面皰を氣にしながら、聞いてゐるのであ","layout":{"rects":[{"x":0,"y":5712,"width":336,"height":24}]}},{"nodeType":"text","text":"る。しかし、之を聞いてゐる中に、下人の心に","layout":{"rects":[{"x":0,"y":5736,"width":336,"height":24}]}},{"nodeType":"text","text":"は、或勇氣が生まれて來た。それは、さつき、門","layout":{"rects":[{"x":0,"y":5760,"width":352,"height":24}]}},{"nodeType":"text","text":"の下でこの男に缺けてゐた勇氣である。さうし","layout":{"rects":[{"x":0,"y":5784,"width":336,"height":24}]}},{"nodeType":"text","text":"て、又さつき、この門の上へ上つて、この老婆を","layout":{"rects":[{"x":0,"y":5808,"width":352,"height":24}]}},{"nodeType":"text","text":"捕へた時の勇氣とは、全然、反對な方向に動かう","layout":{"rects":[{"x":0,"y":5832,"width":352,"height":24}]}},{"nodeType":"text","text":"とする勇氣である。下人は、饑死をするか盜人に","layout":{"rects":[{"x":0,"y":5856,"width":352,"height":24}]}},{"nodeType":"text","text":"なるかに迷はなかつたばかりではない。その時の","layout":{"rects":[{"x":0,"y":5880,"width":352,"height":24}]}},{"nodeType":"text","text":"この男の心もちから云へば、饑死などと云ふ事","layout":{"rects":[{"x":0,"y":5904,"width":336,"height":24}]}},{"nodeType":"text","text":"は、殆、考へる事さへ出來ない程、意識の外に追","layout":{"rects":[{"x":0,"y":5928,"width":352,"height":24}]}},{"nodeType":"text","text":"ひ出されてゐた。","layout":{"rects":[{"x":0,"y":5952,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5976,"width":360,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「きつと、そうか。」","layout":{"rects":[{"x":0,"y":5976,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6000,"width":360,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆の話が完ると、下人は嘲るやうな聲で念を押","layout":{"rects":[{"x":0,"y":6000,"width":352,"height":24}]}},{"nodeType":"text","text":"した。さうして、一足前へ出ると、不意に、右の","layout":{"rects":[{"x":0,"y":6024,"width":352,"height":24}]}},{"nodeType":"text","text":"手を面皰から離して、老婆の襟上をつかみなが","layout":{"rects":[{"x":0,"y":6048,"width":336,"height":24}]}},{"nodeType":"text","text":"ら、かう云つた。","layout":{"rects":[{"x":0,"y":6072,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6096,"width":360,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「では、己が引剝をしようと恨むまいな。己もさ","layout":{"rects":[{"x":0,"y":6096,"width":352,"height":24}]}},{"nodeType":"text","text":"うしなければ、饑死をする體なのだ。」","layout":{"rects":[{"x":0,"y":6120,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6144,"width":360,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、すばやく、老婆の着物を剝ぎとつた。そ","layout":{"rects":[{"x":0,"y":6144,"width":352,"height":24}]}},{"nodeType":"text","text":"れから、足にしがみつかうとする老婆を、手荒く","layout":{"rects":[{"x":0,"y":6168,"width":352,"height":24}]}},{"nodeType":"text","text":"屍骸の上へ蹴倒した。梯子の口までは、僅に五步","layout":{"rects":[{"x":0,"y":6192,"width":352,"height":24}]}},{"nodeType":"text","text":"を數へるばかりである。下人は、剝ぎとつた檜肌","layout":{"rects":[{"x":0,"y":6216,"width":352,"height":24}]}},{"nodeType":"text","text":"色の着物をわきにかゝへて、またゝく間に急な梯","layout":{"rects":[{"x":0,"y":6240,"width":352,"height":24}]}},{"nodeType":"text","text":"子を夜の底へかけ下りた。","layout":{"rects":[{"x":0,"y":6264,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6288,"width":360,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"暫、死んだやうに倒れてゐた老婆が、屍骸の中か","layout":{"rects":[{"x":0,"y":6288,"width":352,"height":24}]}},{"nodeType":"text","text":"ら、その裸の體を起したのは、それから間もなく","layout":{"rects":[{"x":0,"y":6312,"width":352,"height":24}]}},{"nodeType":"text","text":"の事である。老婆は、つぶやくやうな、うめくや","layout":{"rects":[{"x":0,"y":6336,"width":352,"height":24}]}},{"nodeType":"text","text":"うな聲を立てながら、まだ燃えてゐる火の光をた","layout":{"rects":[{"x":0,"y":6360,"width":352,"height":24}]}},{"nodeType":"text","text":"よりに、梯子の口まで、這つて行つた。さうし","layout":{"rects":[{"x":0,"y":6384,"width":336,"height":24}]}},{"nodeType":"text","text":"て、そこから、短い白髮を倒にして、門の下を覗","layout":{"rects":[{"x":0,"y":6408,"width":352,"height":24}]}},{"nodeType":"text","text":"きこんだ。外には、唯、黑洞々たる夜があるばか","layout":{"rects":[{"x":0,"y":6432,"width":352,"height":24}]}},{"nodeType":"text","text":"りである。","layout":{"rects":[{"x":0,"y":6456,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6480,"width":360,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、既に、雨を冐して、京都の町へ强盜を働","layout":{"rects":[{"x":0,"y":6480,"width":352,"height":24}]}},{"nodeType":"text","text":"きに急いでゐた。","layout":{"rects":[{"x":0,"y":6504,"width":128,"height":24}]}}]}]}]}]}}