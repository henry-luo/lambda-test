{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":5136},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"Pretext corpus: width 470px","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n@font-face {\n    font-family: 'Noto Sans SC';\n    src: url('../font/NotoSansSC-Subset.otf') format('opentype');\n}\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: 'Noto Sans SC', sans-serif; font-size: 16px; line-height: 1.5; font-kerning: none; text-spacing-trim: space-all; }\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":5136},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":470,"height":5136},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"p","layout":{"x":0,"y":0,"width":470,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"或日の暮方の事である。一人の下人が、羅生門の下で雨やみを待","layout":{"rects":[{"x":0,"y":0,"width":464,"height":24}]}},{"nodeType":"text","text":"つてゐた。","layout":{"rects":[{"x":0,"y":24,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":48,"width":470,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"廣い門の下には、この男の外に誰もゐない。唯、所々丹塗の剝げ","layout":{"rects":[{"x":0,"y":48,"width":464,"height":24}]}},{"nodeType":"text","text":"た、大きな圓柱に、蟋蟀が一匹とまつてゐる。羅生門が、朱雀大","layout":{"rects":[{"x":0,"y":72,"width":464,"height":24}]}},{"nodeType":"text","text":"路にある以上は、この男の外にも、雨やみをする市女笠や揉烏帽","layout":{"rects":[{"x":0,"y":96,"width":464,"height":24}]}},{"nodeType":"text","text":"子が、もう二三人はありさうなものである。それが、この男の外","layout":{"rects":[{"x":0,"y":120,"width":464,"height":24}]}},{"nodeType":"text","text":"には誰もゐない。","layout":{"rects":[{"x":0,"y":144,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":168,"width":470,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"何故かと云ふと、この二三年、京都には、地震とか辻風とか火事","layout":{"rects":[{"x":0,"y":168,"width":464,"height":24}]}},{"nodeType":"text","text":"とか饑饉とか云ふ災がつゞいて起つた。そこで洛中のさびれ方は","layout":{"rects":[{"x":0,"y":192,"width":464,"height":24}]}},{"nodeType":"text","text":"一通りでない。舊記によると、佛像や佛具を打碎いて、その丹が","layout":{"rects":[{"x":0,"y":216,"width":464,"height":24}]}},{"nodeType":"text","text":"ついたり、金銀の箔がついたりした木を、路ばたにつみ重ねて、","layout":{"rects":[{"x":0,"y":240,"width":464,"height":24}]}},{"nodeType":"text","text":"薪の料に賣つてゐたと云ふ事である。洛中がその始末であるか","layout":{"rects":[{"x":0,"y":264,"width":448,"height":24}]}},{"nodeType":"text","text":"ら、羅生門の修理などは、元より誰も捨てゝ顧る者がなかつた。","layout":{"rects":[{"x":0,"y":288,"width":464,"height":24}]}},{"nodeType":"text","text":"するとその荒れ果てたのをよい事にして、狐狸が棲む。盜人が棲","layout":{"rects":[{"x":0,"y":312,"width":464,"height":24}]}},{"nodeType":"text","text":"む。とうとうしまひには、引取り手のない死人を、この門へ持つ","layout":{"rects":[{"x":0,"y":336,"width":464,"height":24}]}},{"nodeType":"text","text":"て來て、棄てゝ行くと云ふ習慣さへ出來た。そこで、日の目が見","layout":{"rects":[{"x":0,"y":360,"width":464,"height":24}]}},{"nodeType":"text","text":"えなくなると、誰でも氣味を惡るがつて、この門の近所へは足ぶ","layout":{"rects":[{"x":0,"y":384,"width":464,"height":24}]}},{"nodeType":"text","text":"みをしない事になつてしまつたのである。","layout":{"rects":[{"x":0,"y":408,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":432,"width":470,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その代り又鴉が何處からか、たくさん集つて來た。晝間見ると、","layout":{"rects":[{"x":0,"y":432,"width":464,"height":24}]}},{"nodeType":"text","text":"その鴉が何羽となく輪を描いて高い鴟尾のまはりを啼きながら、","layout":{"rects":[{"x":0,"y":456,"width":464,"height":24}]}},{"nodeType":"text","text":"飛びまはつてゐる。殊に門の上の空が、夕燒けであかくなる時に","layout":{"rects":[{"x":0,"y":480,"width":464,"height":24}]}},{"nodeType":"text","text":"は、それが胡麻をまいたやうにはつきり見えた。鴉は、勿論、門","layout":{"rects":[{"x":0,"y":504,"width":464,"height":24}]}},{"nodeType":"text","text":"の上にある死人の肉を、啄みに來るのである。――尤も今日は、","layout":{"rects":[{"x":0,"y":528,"width":464,"height":24}]}},{"nodeType":"text","text":"刻限が遲いせいか、一羽も見えない。唯、所々、崩れかゝつた、","layout":{"rects":[{"x":0,"y":552,"width":464,"height":24}]}},{"nodeType":"text","text":"さうしてその崩れ目に長い草のはへた石段の上に、鴉の糞が、","layout":{"rects":[{"x":0,"y":576,"width":448,"height":24}]}},{"nodeType":"text","text":"點々と白くこびりついてゐるのが見える。下人は七段ある石段の","layout":{"rects":[{"x":0,"y":600,"width":464,"height":24}]}},{"nodeType":"text","text":"一番上の段に洗ひざらした紺の襖の尻を据ゑて、右の頰に出來","layout":{"rects":[{"x":0,"y":624,"width":448,"height":24}]}},{"nodeType":"text","text":"た、大きな面皰を氣にしながら、ぼんやり、雨のふるのを眺めて","layout":{"rects":[{"x":0,"y":648,"width":464,"height":24}]}},{"nodeType":"text","text":"ゐるのである。","layout":{"rects":[{"x":0,"y":672,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":696,"width":470,"height":360},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"作者はさつき、「下人が雨やみを待つてゐた」と書いた。しか","layout":{"rects":[{"x":0,"y":696,"width":448,"height":24}]}},{"nodeType":"text","text":"し、下人は、雨がやんでも格別どうしようと云ふ當てはない。ふ","layout":{"rects":[{"x":0,"y":720,"width":464,"height":24}]}},{"nodeType":"text","text":"だんなら、勿論、主人の家へ歸る可き筈である。所がその主人か","layout":{"rects":[{"x":0,"y":744,"width":464,"height":24}]}},{"nodeType":"text","text":"らは、四五日前に暇を出された。前にも書いたやうに、當時京都","layout":{"rects":[{"x":0,"y":768,"width":464,"height":24}]}},{"nodeType":"text","text":"の町は一通りならず衰微してゐた。今この下人が、永年、使はれ","layout":{"rects":[{"x":0,"y":792,"width":464,"height":24}]}},{"nodeType":"text","text":"てゐた主人から、暇を出されたのも、この衰微の小さな餘波に外","layout":{"rects":[{"x":0,"y":816,"width":464,"height":24}]}},{"nodeType":"text","text":"ならない。だから「下人が雨やみを待つてゐた」と云ふよりも、","layout":{"rects":[{"x":0,"y":840,"width":464,"height":24}]}},{"nodeType":"text","text":"「雨にふりこめられた下人が、行き所がなくて、途方にくれてゐ","layout":{"rects":[{"x":0,"y":864,"width":464,"height":24}]}},{"nodeType":"text","text":"た」と云ふ方が、適當である。その上、今日の空模樣も少からず","layout":{"rects":[{"x":0,"y":888,"width":464,"height":24}]}},{"nodeType":"text","text":"この平安朝の下人の Sentimentalisme に影響した。申の刻下り","layout":{"rects":[{"x":0,"y":912,"width":454.36,"height":24}]}},{"nodeType":"text","text":"からふり出した雨は、未に上るけしきがない。そこで、下人は、","layout":{"rects":[{"x":0,"y":936,"width":464,"height":24}]}},{"nodeType":"text","text":"何を措いても差當り明日の暮しをどうにかしようとして――云","layout":{"rects":[{"x":0,"y":960,"width":448,"height":24}]}},{"nodeType":"text","text":"はゞどうにもならない事を、どうにかしようとして、とりとめも","layout":{"rects":[{"x":0,"y":984,"width":464,"height":24}]}},{"nodeType":"text","text":"ない考へをたどりながら、さつきから朱雀大路にふる雨の音を、","layout":{"rects":[{"x":0,"y":1008,"width":464,"height":24}]}},{"nodeType":"text","text":"聞くともなく聞いてゐた。","layout":{"rects":[{"x":0,"y":1032,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1056,"width":470,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"雨は、羅生門をつゝんで、遠くから、ざあつと云ふ音をあつめて","layout":{"rects":[{"x":0,"y":1056,"width":464,"height":24}]}},{"nodeType":"text","text":"來る。夕闇は次第に空を低くして、見上げると、門の屋根が、斜","layout":{"rects":[{"x":0,"y":1080,"width":464,"height":24}]}},{"nodeType":"text","text":"につき出した甍の先に、重たくうす暗い雲を支へてゐる。","layout":{"rects":[{"x":0,"y":1104,"width":416,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1128,"width":470,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"どうにもならない事を、どうにかする爲には、手段を選んでゐる","layout":{"rects":[{"x":0,"y":1128,"width":464,"height":24}]}},{"nodeType":"text","text":"遑はない。選んでゐれば、築土の下か、道ばたの土の上で、饑死","layout":{"rects":[{"x":0,"y":1152,"width":464,"height":24}]}},{"nodeType":"text","text":"をするばかりである。さうして、この門の上へ持つて來て、犬の","layout":{"rects":[{"x":0,"y":1176,"width":464,"height":24}]}},{"nodeType":"text","text":"やうに棄てられてしまふばかりである。選ばないとすれば――下","layout":{"rects":[{"x":0,"y":1200,"width":464,"height":24}]}},{"nodeType":"text","text":"人の考へは、何度も同じ道を低徊した揚句に、やつとこの局所へ","layout":{"rects":[{"x":0,"y":1224,"width":464,"height":24}]}},{"nodeType":"text","text":"逢着した。しかしこの「すれば」は、何時までたつても、結局","layout":{"rects":[{"x":0,"y":1248,"width":448,"height":24}]}},{"nodeType":"text","text":"「すれば」であつた。下人は、手段を選ばないといふ事を肯定し","layout":{"rects":[{"x":0,"y":1272,"width":464,"height":24}]}},{"nodeType":"text","text":"ながらも、この「すれば」のかたをつける爲に、當然、その後に","layout":{"rects":[{"x":0,"y":1296,"width":464,"height":24}]}},{"nodeType":"text","text":"來る可き「盜人になるより外に仕方がない」と云ふ事を、積極的","layout":{"rects":[{"x":0,"y":1320,"width":464,"height":24}]}},{"nodeType":"text","text":"に肯定する丈の、勇氣が出ずにゐたのである。","layout":{"rects":[{"x":0,"y":1344,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1368,"width":470,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、大きな嚏をして、それから、大儀さうに立上つた。夕冷","layout":{"rects":[{"x":0,"y":1368,"width":464,"height":24}]}},{"nodeType":"text","text":"えのする京都は、もう火桶が欲しい程の寒さである。風は門の柱","layout":{"rects":[{"x":0,"y":1392,"width":464,"height":24}]}},{"nodeType":"text","text":"と柱との間を、夕闇と共に遠慮なく、吹きぬける。丹塗の柱にと","layout":{"rects":[{"x":0,"y":1416,"width":464,"height":24}]}},{"nodeType":"text","text":"まつてゐた蟋蟀も、もうどこかへ行つてしまつた。","layout":{"rects":[{"x":0,"y":1440,"width":368,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1464,"width":470,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、頸をちゞめながら、山吹の汗衫に重ねた、紺の襖の肩を","layout":{"rects":[{"x":0,"y":1464,"width":464,"height":24}]}},{"nodeType":"text","text":"高くして門のまはりを見まはした。雨風の患のない、人目にかゝ","layout":{"rects":[{"x":0,"y":1488,"width":464,"height":24}]}},{"nodeType":"text","text":"る惧のない、一晚樂にねられさうな所があれば、そこでともかく","layout":{"rects":[{"x":0,"y":1512,"width":464,"height":24}]}},{"nodeType":"text","text":"も、夜を明かさうと思つたからである。すると、幸門の上の樓へ","layout":{"rects":[{"x":0,"y":1536,"width":464,"height":24}]}},{"nodeType":"text","text":"上る、幅の廣い、之も丹を塗つた梯子が眼についた。上なら、人","layout":{"rects":[{"x":0,"y":1560,"width":464,"height":24}]}},{"nodeType":"text","text":"がゐたにしても、どうせ死人ばかりである。下人は、そこで腰に","layout":{"rects":[{"x":0,"y":1584,"width":464,"height":24}]}},{"nodeType":"text","text":"さげた聖柄の太刀が鞘走らないやうに氣をつけながら、藁草履を","layout":{"rects":[{"x":0,"y":1608,"width":464,"height":24}]}},{"nodeType":"text","text":"はいた足を、その梯子の一番下の段へふみかけた。","layout":{"rects":[{"x":0,"y":1632,"width":368,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1656,"width":470,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"それから、何分かの後である。羅生門の樓の上へ出る、幅の廣い","layout":{"rects":[{"x":0,"y":1656,"width":464,"height":24}]}},{"nodeType":"text","text":"梯子の中段に、一人の男が、猫のやうに身をちゞめて、息を殺し","layout":{"rects":[{"x":0,"y":1680,"width":464,"height":24}]}},{"nodeType":"text","text":"ながら、上の容子を窺つてゐた。樓の上からさす火の光が、かす","layout":{"rects":[{"x":0,"y":1704,"width":464,"height":24}]}},{"nodeType":"text","text":"かに、その男の右の頰をぬらしてゐる。短い鬚の中に、赤く膿を","layout":{"rects":[{"x":0,"y":1728,"width":464,"height":24}]}},{"nodeType":"text","text":"持つた面皰のある頰である。下人は、始めから、この上にゐる者","layout":{"rects":[{"x":0,"y":1752,"width":464,"height":24}]}},{"nodeType":"text","text":"は、死人ばかりだと高を括つてゐた。それが、梯子を二三段上つ","layout":{"rects":[{"x":0,"y":1776,"width":464,"height":24}]}},{"nodeType":"text","text":"て見ると、上では誰か火をとぼして、しかもその火を其處此處と","layout":{"rects":[{"x":0,"y":1800,"width":464,"height":24}]}},{"nodeType":"text","text":"動かしてゐるらしい。これは、その濁つた、黃いろい光が、隅々","layout":{"rects":[{"x":0,"y":1824,"width":464,"height":24}]}},{"nodeType":"text","text":"に蜘蛛の巢をかけた天井裏に、ゆれながら映つたので、すぐにそ","layout":{"rects":[{"x":0,"y":1848,"width":464,"height":24}]}},{"nodeType":"text","text":"れと知れたのである。この雨の夜に、この羅生門の上で、火をと","layout":{"rects":[{"x":0,"y":1872,"width":464,"height":24}]}},{"nodeType":"text","text":"もしてゐるからは、どうせ唯の者ではない。","layout":{"rects":[{"x":0,"y":1896,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1920,"width":470,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、守宮のやうに足音をぬすんで、やつと急な梯子を、一番","layout":{"rects":[{"x":0,"y":1920,"width":464,"height":24}]}},{"nodeType":"text","text":"上の段まで這ふやうにして上りつめた。さうして體を出來る丈、","layout":{"rects":[{"x":0,"y":1944,"width":464,"height":24}]}},{"nodeType":"text","text":"平にしながら、頸を出來る丈、前へ出して、恐る恐る、樓の內を","layout":{"rects":[{"x":0,"y":1968,"width":464,"height":24}]}},{"nodeType":"text","text":"覗いて見た。","layout":{"rects":[{"x":0,"y":1992,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2016,"width":470,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"見ると、樓の內には、噂に聞いた通り、幾つかの屍骸が、無造作","layout":{"rects":[{"x":0,"y":2016,"width":464,"height":24}]}},{"nodeType":"text","text":"に棄てゝあるが、火の光の及ぶ範圍が、思つたより狹いので、數","layout":{"rects":[{"x":0,"y":2040,"width":464,"height":24}]}},{"nodeType":"text","text":"は幾つともわからない。唯、おぼろげながら、知れるのは、その","layout":{"rects":[{"x":0,"y":2064,"width":464,"height":24}]}},{"nodeType":"text","text":"中に裸の屍骸と、着物を着た屍骸とがあると云ふ事である。勿","layout":{"rects":[{"x":0,"y":2088,"width":448,"height":24}]}},{"nodeType":"text","text":"論、中には女も男もまじつてゐるらしい。さうして、その屍骸は","layout":{"rects":[{"x":0,"y":2112,"width":464,"height":24}]}},{"nodeType":"text","text":"皆、それが、甞、生きてゐた人間だと云ふ事實さへ疑はれる程、","layout":{"rects":[{"x":0,"y":2136,"width":464,"height":24}]}},{"nodeType":"text","text":"土を捏ねて造つた人形のやうに、口を開いたり手を延ばしたりし","layout":{"rects":[{"x":0,"y":2160,"width":464,"height":24}]}},{"nodeType":"text","text":"てごろごろ床の上にころがつてゐた。しかも、肩とか胸とかの高","layout":{"rects":[{"x":0,"y":2184,"width":464,"height":24}]}},{"nodeType":"text","text":"くなつてゐる部分に、ぼんやりした火の光をうけて、低くなつて","layout":{"rects":[{"x":0,"y":2208,"width":464,"height":24}]}},{"nodeType":"text","text":"ゐる部分の影を一層暗くしながら、永久に啞の如く默つていた。","layout":{"rects":[{"x":0,"y":2232,"width":464,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2256,"width":470,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、それらの屍骸の腐爛した臭氣に思はず、鼻を掩つた。し","layout":{"rects":[{"x":0,"y":2256,"width":464,"height":24}]}},{"nodeType":"text","text":"かし、その手は、次の瞬間には、もう鼻を掩ふ事を忘れてゐた。","layout":{"rects":[{"x":0,"y":2280,"width":464,"height":24}]}},{"nodeType":"text","text":"或る强い感情が、殆悉この男の嗅覺を奪つてしまつたからであ","layout":{"rects":[{"x":0,"y":2304,"width":448,"height":24}]}},{"nodeType":"text","text":"る。","layout":{"rects":[{"x":0,"y":2328,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2352,"width":470,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人の眼は、その時、はじめて、其屍骸の中に蹲つている人間を","layout":{"rects":[{"x":0,"y":2352,"width":464,"height":24}]}},{"nodeType":"text","text":"見た。檜肌色の着物を著た、背の低い、瘦せた、白髮頭の、猿の","layout":{"rects":[{"x":0,"y":2376,"width":464,"height":24}]}},{"nodeType":"text","text":"やうな老婆である。その老婆は、右の手に火をともした松の木片","layout":{"rects":[{"x":0,"y":2400,"width":464,"height":24}]}},{"nodeType":"text","text":"を持つて、その屍骸の一つの顏を覗きこむやうに眺めてゐた。髮","layout":{"rects":[{"x":0,"y":2424,"width":464,"height":24}]}},{"nodeType":"text","text":"の毛の長い所を見ると、多分女の屍骸であらう。","layout":{"rects":[{"x":0,"y":2448,"width":352,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2472,"width":470,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、六分の恐怖と四分の好奇心とに動かされて、暫時は呼吸","layout":{"rects":[{"x":0,"y":2472,"width":464,"height":24}]}},{"nodeType":"text","text":"をするのさへ忘れてゐた。舊記の記者の語を借りれば、「頭身の","layout":{"rects":[{"x":0,"y":2496,"width":464,"height":24}]}},{"nodeType":"text","text":"毛も太る」やうに感じたのである。すると、老婆は、松の木片","layout":{"rects":[{"x":0,"y":2520,"width":448,"height":24}]}},{"nodeType":"text","text":"を、床板の間に挿して、それから、今まで眺めてゐた屍骸の首に","layout":{"rects":[{"x":0,"y":2544,"width":464,"height":24}]}},{"nodeType":"text","text":"兩手をかけると、丁度、猿の親が猿の子の虱をとるやうに、その","layout":{"rects":[{"x":0,"y":2568,"width":464,"height":24}]}},{"nodeType":"text","text":"長い髮の毛を一本づゝ拔きはじめた。髮は手に從つて拔けるらし","layout":{"rects":[{"x":0,"y":2592,"width":464,"height":24}]}},{"nodeType":"text","text":"い。","layout":{"rects":[{"x":0,"y":2616,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2640,"width":470,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その髮の毛が、一本ずゝ拔けるのに從つて下人の心からは、恐怖","layout":{"rects":[{"x":0,"y":2640,"width":464,"height":24}]}},{"nodeType":"text","text":"が少しづつ消えて行つた。さうして、それと同時に、この老婆に","layout":{"rects":[{"x":0,"y":2664,"width":464,"height":24}]}},{"nodeType":"text","text":"對するはげしい憎惡が、少しづゝ動いて來た。――いや、この老","layout":{"rects":[{"x":0,"y":2688,"width":464,"height":24}]}},{"nodeType":"text","text":"婆に對すると云つては、語弊があるかも知れない。寧、あらゆる","layout":{"rects":[{"x":0,"y":2712,"width":464,"height":24}]}},{"nodeType":"text","text":"惡に對する反感が、一分每に强さを增して來たのである。この","layout":{"rects":[{"x":0,"y":2736,"width":448,"height":24}]}},{"nodeType":"text","text":"時、誰かがこの下人に、さつき門の下でこの男が考へてゐた、饑","layout":{"rects":[{"x":0,"y":2760,"width":464,"height":24}]}},{"nodeType":"text","text":"死をするか盜人になるかと云ふ問題を、改めて持出したら、恐ら","layout":{"rects":[{"x":0,"y":2784,"width":464,"height":24}]}},{"nodeType":"text","text":"く下人は、何の未練もなく、饑死を選んだ事であらう。それほ","layout":{"rects":[{"x":0,"y":2808,"width":448,"height":24}]}},{"nodeType":"text","text":"ど、この男の惡を憎む心は、老婆の床に挿した松の木片のやう","layout":{"rects":[{"x":0,"y":2832,"width":448,"height":24}]}},{"nodeType":"text","text":"に、勢よく燃え上り出してゐたのである。","layout":{"rects":[{"x":0,"y":2856,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2880,"width":470,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人には、勿論、何故老婆が死人の髮の毛を拔くかわからなかつ","layout":{"rects":[{"x":0,"y":2880,"width":464,"height":24}]}},{"nodeType":"text","text":"た。從つて、合理的には、それを善惡の何れに片づけてよいか知","layout":{"rects":[{"x":0,"y":2904,"width":464,"height":24}]}},{"nodeType":"text","text":"らなかつた。しかし下人にとつては、この雨の夜に、この羅生門","layout":{"rects":[{"x":0,"y":2928,"width":464,"height":24}]}},{"nodeType":"text","text":"の上で、死人の髮の毛を拔くと云ふ事が、それ丈で既に許す可ら","layout":{"rects":[{"x":0,"y":2952,"width":464,"height":24}]}},{"nodeType":"text","text":"ざる惡であつた。勿論、下人は、さつき迄自分が、盜人になる氣","layout":{"rects":[{"x":0,"y":2976,"width":464,"height":24}]}},{"nodeType":"text","text":"でゐた事なぞは、とうに忘れてゐるのである。","layout":{"rects":[{"x":0,"y":3000,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3024,"width":470,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"そこで、下人は、兩足に力を入れて、いきなり、梯子から上へ飛","layout":{"rects":[{"x":0,"y":3024,"width":464,"height":24}]}},{"nodeType":"text","text":"び上つた。さうして聖柄の太刀に手をかけながら、大股に老婆の","layout":{"rects":[{"x":0,"y":3048,"width":464,"height":24}]}},{"nodeType":"text","text":"前へ步みよつた。老婆が驚いたのは、云ふ迄もない。","layout":{"rects":[{"x":0,"y":3072,"width":384,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3096,"width":470,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆は、一目下人を見ると、まるで弩にでも彈かれたやうに、飛","layout":{"rects":[{"x":0,"y":3096,"width":464,"height":24}]}},{"nodeType":"text","text":"び上つた。","layout":{"rects":[{"x":0,"y":3120,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3144,"width":470,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「おのれ、どこへ行く。」","layout":{"rects":[{"x":0,"y":3144,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3168,"width":470,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆が屍骸につまづきながら、慌てふためいて逃げよう","layout":{"rects":[{"x":0,"y":3168,"width":464,"height":24}]}},{"nodeType":"text","text":"とする行手を塞いで、こう罵つた。老婆は、それでも下人をつき","layout":{"rects":[{"x":0,"y":3192,"width":464,"height":24}]}},{"nodeType":"text","text":"のけて行かうとする。下人は又、それを行かすまいとして、押し","layout":{"rects":[{"x":0,"y":3216,"width":464,"height":24}]}},{"nodeType":"text","text":"もどす。二人は屍骸の中で、暫、無言のまゝ、つかみ合つた。し","layout":{"rects":[{"x":0,"y":3240,"width":464,"height":24}]}},{"nodeType":"text","text":"かし勝敗は、はじめから、わかつている。下人はとうとう、老婆","layout":{"rects":[{"x":0,"y":3264,"width":464,"height":24}]}},{"nodeType":"text","text":"の腕をつかんで、無理にそこへ扭ぢ倒した。丁度、鷄の脚のやう","layout":{"rects":[{"x":0,"y":3288,"width":464,"height":24}]}},{"nodeType":"text","text":"な、骨と皮ばかりの腕である。","layout":{"rects":[{"x":0,"y":3312,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3336,"width":470,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「何をしてゐた。さあ何をしてゐた。云へ。云はぬと、これだぞ","layout":{"rects":[{"x":0,"y":3336,"width":464,"height":24}]}},{"nodeType":"text","text":"よ。」","layout":{"rects":[{"x":0,"y":3360,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3384,"width":470,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆をつき放すと、いきなり、太刀の鞘を拂つて、白い","layout":{"rects":[{"x":0,"y":3384,"width":464,"height":24}]}},{"nodeType":"text","text":"鋼の色をその眼の前へつきつけた。けれども、老婆は默つてゐ","layout":{"rects":[{"x":0,"y":3408,"width":448,"height":24}]}},{"nodeType":"text","text":"る。兩手をわなわなふるはせて、肩で息を切りながら、眼を、眼","layout":{"rects":[{"x":0,"y":3432,"width":464,"height":24}]}},{"nodeType":"text","text":"球が眶の外へ出さうになる程、見開いて、啞のやうに執拗く默つ","layout":{"rects":[{"x":0,"y":3456,"width":464,"height":24}]}},{"nodeType":"text","text":"てゐる。これを見ると、下人は始めて明白にこの老婆の生死が、","layout":{"rects":[{"x":0,"y":3480,"width":464,"height":24}]}},{"nodeType":"text","text":"全然、自分の意志に支配されてゐると云ふ事を意識した。さうし","layout":{"rects":[{"x":0,"y":3504,"width":464,"height":24}]}},{"nodeType":"text","text":"て、この意識は、今まではげしく燃えてゐた憎惡の心を何時の間","layout":{"rects":[{"x":0,"y":3528,"width":464,"height":24}]}},{"nodeType":"text","text":"にか冷ましてしまつた。後に殘つたのは、唯、或仕事をして、そ","layout":{"rects":[{"x":0,"y":3552,"width":464,"height":24}]}},{"nodeType":"text","text":"れが圓滿に成就した時の、安らかな得意と滿足とがあるばかりで","layout":{"rects":[{"x":0,"y":3576,"width":464,"height":24}]}},{"nodeType":"text","text":"ある。そこで、下人は、老婆を見下しながら、少し聲を柔げてか","layout":{"rects":[{"x":0,"y":3600,"width":464,"height":24}]}},{"nodeType":"text","text":"う云つた。","layout":{"rects":[{"x":0,"y":3624,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3648,"width":470,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「己は檢非違使の廳の役人などではない。今し方この門の下を通","layout":{"rects":[{"x":0,"y":3648,"width":464,"height":24}]}},{"nodeType":"text","text":"りかゝつた旅の者だ。だからお前に繩をかけて、どうしようと云","layout":{"rects":[{"x":0,"y":3672,"width":464,"height":24}]}},{"nodeType":"text","text":"ふやうな事はない。唯、今時分、この門の上で、何をして居たの","layout":{"rects":[{"x":0,"y":3696,"width":464,"height":24}]}},{"nodeType":"text","text":"だか、それを己に話しさへすればいいのだ。」","layout":{"rects":[{"x":0,"y":3720,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3744,"width":470,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"すると、老婆は、見開いてゐた眼を、一層大きくして、ぢつとそ","layout":{"rects":[{"x":0,"y":3744,"width":464,"height":24}]}},{"nodeType":"text","text":"の下人の顏を見守つた。眶の赤くなつた、肉食鳥のやうな、銳い","layout":{"rects":[{"x":0,"y":3768,"width":464,"height":24}]}},{"nodeType":"text","text":"眼で見たのである。それから、皺で、殆、鼻と一つになつた唇","layout":{"rects":[{"x":0,"y":3792,"width":448,"height":24}]}},{"nodeType":"text","text":"を、何か物でも嚙んでゐるやうに動かした。細い喉で、尖つた喉","layout":{"rects":[{"x":0,"y":3816,"width":464,"height":24}]}},{"nodeType":"text","text":"佛の動いてゐるのが見える。その時、その喉から、鴉の啼くやう","layout":{"rects":[{"x":0,"y":3840,"width":464,"height":24}]}},{"nodeType":"text","text":"な聲が、喘ぎ喘ぎ、下人の耳へ傳はつて來た。","layout":{"rects":[{"x":0,"y":3864,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3888,"width":470,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「この髮を拔いてな、この女の髮を拔いてな、鬘にせうと思うた","layout":{"rects":[{"x":0,"y":3888,"width":464,"height":24}]}},{"nodeType":"text","text":"のぢや。」","layout":{"rects":[{"x":0,"y":3912,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3936,"width":470,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆の答が存外、平凡なのに失望した。さうして失望す","layout":{"rects":[{"x":0,"y":3936,"width":464,"height":24}]}},{"nodeType":"text","text":"ると同時に、又前の憎惡が、冷な侮蔑と一しよに、心の中へはい","layout":{"rects":[{"x":0,"y":3960,"width":464,"height":24}]}},{"nodeType":"text","text":"つて來た。すると、その氣色が、先方へも通じたのであらう。老","layout":{"rects":[{"x":0,"y":3984,"width":464,"height":24}]}},{"nodeType":"text","text":"婆は、片手に、まだ屍骸の頭から奪つた長い拔け毛を持つたな","layout":{"rects":[{"x":0,"y":4008,"width":448,"height":24}]}},{"nodeType":"text","text":"り、蟇のつぶやくやうな聲で、口ごもりながら、こんな事を云つ","layout":{"rects":[{"x":0,"y":4032,"width":464,"height":24}]}},{"nodeType":"text","text":"た。","layout":{"rects":[{"x":0,"y":4056,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4080,"width":470,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"成程、死人の髮の毛を拔くと云ふ事は、惡い事かも知れぬ。しか","layout":{"rects":[{"x":0,"y":4080,"width":464,"height":24}]}},{"nodeType":"text","text":"し、かう云ふ死人の多くは、皆、その位な事を、されてもいゝ人","layout":{"rects":[{"x":0,"y":4104,"width":464,"height":24}]}},{"nodeType":"text","text":"間ばかりである。現に、自分が今、髮を拔いた女などは、蛇を四","layout":{"rects":[{"x":0,"y":4128,"width":464,"height":24}]}},{"nodeType":"text","text":"寸ばかりづゝに切つて干したのを、干魚だと云つて、太刀帶の陣","layout":{"rects":[{"x":0,"y":4152,"width":464,"height":24}]}},{"nodeType":"text","text":"へ賣りに行つた。疫病にかゝつて死ななかつたなら、今でも賣り","layout":{"rects":[{"x":0,"y":4176,"width":464,"height":24}]}},{"nodeType":"text","text":"に行つてゐたかもしれない。しかも、この女の賣る干魚は、味が","layout":{"rects":[{"x":0,"y":4200,"width":464,"height":24}]}},{"nodeType":"text","text":"よいと云ふので、太刀帶たちが、缺かさず菜料に買つてゐたので","layout":{"rects":[{"x":0,"y":4224,"width":464,"height":24}]}},{"nodeType":"text","text":"ある。自分は、この女のした事が惡いとは思はない。しなけれ","layout":{"rects":[{"x":0,"y":4248,"width":448,"height":24}]}},{"nodeType":"text","text":"ば、饑死をするので、仕方がなくした事だからである。だから、","layout":{"rects":[{"x":0,"y":4272,"width":464,"height":24}]}},{"nodeType":"text","text":"又今、自分のしてゐた事も惡い事とは思はない。これもやはりし","layout":{"rects":[{"x":0,"y":4296,"width":464,"height":24}]}},{"nodeType":"text","text":"なければ、饑死をするので、仕方がなくする事だからである。さ","layout":{"rects":[{"x":0,"y":4320,"width":464,"height":24}]}},{"nodeType":"text","text":"うして、その仕方がない事を、よく知つてゐたこの女は、自分の","layout":{"rects":[{"x":0,"y":4344,"width":464,"height":24}]}},{"nodeType":"text","text":"する事を許してくれるのにちがひないと思ふからである。――老","layout":{"rects":[{"x":0,"y":4368,"width":464,"height":24}]}},{"nodeType":"text","text":"婆は、大體こんな意味の事を云つた。","layout":{"rects":[{"x":0,"y":4392,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4416,"width":470,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、太刀を鞘におさめて、その太刀の柄を左の手でおさへな","layout":{"rects":[{"x":0,"y":4416,"width":464,"height":24}]}},{"nodeType":"text","text":"がら、冷然として、この話を聞いてゐた。勿論、右の手では、赤","layout":{"rects":[{"x":0,"y":4440,"width":464,"height":24}]}},{"nodeType":"text","text":"く頰に膿を持つた大きな面皰を氣にしながら、聞いてゐるのであ","layout":{"rects":[{"x":0,"y":4464,"width":464,"height":24}]}},{"nodeType":"text","text":"る。しかし、之を聞いてゐる中に、下人の心には、或勇氣が生ま","layout":{"rects":[{"x":0,"y":4488,"width":464,"height":24}]}},{"nodeType":"text","text":"れて來た。それは、さつき、門の下でこの男に缺けてゐた勇氣で","layout":{"rects":[{"x":0,"y":4512,"width":464,"height":24}]}},{"nodeType":"text","text":"ある。さうして、又さつき、この門の上へ上つて、この老婆を捕","layout":{"rects":[{"x":0,"y":4536,"width":464,"height":24}]}},{"nodeType":"text","text":"へた時の勇氣とは、全然、反對な方向に動かうとする勇氣であ","layout":{"rects":[{"x":0,"y":4560,"width":448,"height":24}]}},{"nodeType":"text","text":"る。下人は、饑死をするか盜人になるかに迷はなかつたばかりで","layout":{"rects":[{"x":0,"y":4584,"width":464,"height":24}]}},{"nodeType":"text","text":"はない。その時のこの男の心もちから云へば、饑死などと云ふ事","layout":{"rects":[{"x":0,"y":4608,"width":464,"height":24}]}},{"nodeType":"text","text":"は、殆、考へる事さへ出來ない程、意識の外に追ひ出されてゐ","layout":{"rects":[{"x":0,"y":4632,"width":448,"height":24}]}},{"nodeType":"text","text":"た。","layout":{"rects":[{"x":0,"y":4656,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4680,"width":470,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「きつと、そうか。」","layout":{"rects":[{"x":0,"y":4680,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4704,"width":470,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆の話が完ると、下人は嘲るやうな聲で念を押した。さうし","layout":{"rects":[{"x":0,"y":4704,"width":448,"height":24}]}},{"nodeType":"text","text":"て、一足前へ出ると、不意に、右の手を面皰から離して、老婆の","layout":{"rects":[{"x":0,"y":4728,"width":464,"height":24}]}},{"nodeType":"text","text":"襟上をつかみながら、かう云つた。","layout":{"rects":[{"x":0,"y":4752,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4776,"width":470,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「では、己が引剝をしようと恨むまいな。己もさうしなければ、","layout":{"rects":[{"x":0,"y":4776,"width":464,"height":24}]}},{"nodeType":"text","text":"饑死をする體なのだ。」","layout":{"rects":[{"x":0,"y":4800,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4824,"width":470,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、すばやく、老婆の着物を剝ぎとつた。それから、足にし","layout":{"rects":[{"x":0,"y":4824,"width":464,"height":24}]}},{"nodeType":"text","text":"がみつかうとする老婆を、手荒く屍骸の上へ蹴倒した。梯子の口","layout":{"rects":[{"x":0,"y":4848,"width":464,"height":24}]}},{"nodeType":"text","text":"までは、僅に五步を數へるばかりである。下人は、剝ぎとつた檜","layout":{"rects":[{"x":0,"y":4872,"width":464,"height":24}]}},{"nodeType":"text","text":"肌色の着物をわきにかゝへて、またゝく間に急な梯子を夜の底へ","layout":{"rects":[{"x":0,"y":4896,"width":464,"height":24}]}},{"nodeType":"text","text":"かけ下りた。","layout":{"rects":[{"x":0,"y":4920,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4944,"width":470,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"暫、死んだやうに倒れてゐた老婆が、屍骸の中から、その裸の體","layout":{"rects":[{"x":0,"y":4944,"width":464,"height":24}]}},{"nodeType":"text","text":"を起したのは、それから間もなくの事である。老婆は、つぶやく","layout":{"rects":[{"x":0,"y":4968,"width":464,"height":24}]}},{"nodeType":"text","text":"やうな、うめくやうな聲を立てながら、まだ燃えてゐる火の光を","layout":{"rects":[{"x":0,"y":4992,"width":464,"height":24}]}},{"nodeType":"text","text":"たよりに、梯子の口まで、這つて行つた。さうして、そこから、","layout":{"rects":[{"x":0,"y":5016,"width":464,"height":24}]}},{"nodeType":"text","text":"短い白髮を倒にして、門の下を覗きこんだ。外には、唯、黑洞々","layout":{"rects":[{"x":0,"y":5040,"width":464,"height":24}]}},{"nodeType":"text","text":"たる夜があるばかりである。","layout":{"rects":[{"x":0,"y":5064,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5088,"width":470,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、既に、雨を冐して、京都の町へ强盜を働きに急いでゐ","layout":{"rects":[{"x":0,"y":5088,"width":448,"height":24}]}},{"nodeType":"text","text":"た。","layout":{"rects":[{"x":0,"y":5112,"width":32,"height":24}]}}]}]}]}]}}