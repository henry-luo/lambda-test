c; \n            justify-self: start;\n            align-self: start;\n        }\n        .item:nth-child(2) { \n            background-color: #ccffcc; \n            justify-self: end;\n            align-self: start;\n        }\n        .item:nth-child(3) { \n            background-color: #ccccff; \n            justify-self: center;\n            align-self: center;\n        }\n        .item:nth-child(4) { \n            background-color: #ffffcc; \n            justify-self: stretch;\n            align-self: stretch;\n            width: auto;\n            height: auto;\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":300},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":400,"height":300},"computed":{"display":"grid","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":12,"y":12,"width":80,"height":60},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Start/Start","layout":{"rects":[{"x":20.48,"y":14,"width":63.03,"height":16}]}}]},{"nodeType":"element","tag":"div","layout":{"x":308,"y":12,"width":80,"height":60},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"End/Start","layout":{"rects":[{"x":318.81,"y":14,"width":58.38,"height":16}]}}]},{"nodeType":"element","tag":"div","layout":{"x":63.5,"y":191.5,"width":80,"height":60},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Center","layout":{"rects":[{"x":82.48,"y":193.5,"width":42.03,"height":16}]}}]},{"nodeType":"element","tag":"div","layout":{"x":205,"y":155,"width":183,"height":133},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Stretch","layout":{"rects":[{"x":274.31,"y":157,"width":44.36,"height":16}]}}]}]},{"nodeTyp