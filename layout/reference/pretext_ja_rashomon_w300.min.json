out":{"rects":[{"x":0,"y":1224,"width":288,"height":24}]}},{"nodeType":"text","text":"してゐた。今この下人が、永年、使はれ","layout":{"rects":[{"x":0,"y":1248,"width":288,"height":24}]}},{"nodeType":"text","text":"てゐた主人から、暇を出されたのも、こ","layout":{"rects":[{"x":0,"y":1272,"width":288,"height":24}]}},{"nodeType":"text","text":"の衰微の小さな餘波に外ならない。だか","layout":{"rects":[{"x":0,"y":1296,"width":288,"height":24}]}},{"nodeType":"text","text":"ら「下人が雨やみを待つてゐた」と云ふ","layout":{"rects":[{"x":0,"y":1320,"width":288,"height":24}]}},{"nodeType":"text","text":"よりも、「雨にふりこめられた下人が、","layout":{"rects":[{"x":0,"y":1344,"width":288,"height":24}]}},{"nodeType":"text","text":"行き所がなくて、途方にくれてゐた」と","layout":{"rects":[{"x":0,"y":1368,"width":288,"height":24}]}},{"nodeType":"text","text":"云ふ方が、適當である。その上、今日の","layout":{"rects":[{"x":0,"y":1392,"width":288,"height":24}]}},{"nodeType":"text","text":"空模樣も少からずこの平安朝の下人の ","layout":{"rects":[{"x":0,"y":1416,"width":272,"height":24}]}},{"nodeType":"text","text":"Sentimentalisme に影響した。申の刻下","layout":{"rects":[{"x":0,"y":1440,"width":290.78,"height":24}]}},{"nodeType":"text","text":"りからふり出した雨は、未に上るけしき","layout":{"rects":[{"x":0,"y":1464,"width":288,"height":24}]}},{"nodeType":"text","text":"がない。そこで、下人は、何を措いても","layout":{"rects":[{"x":0,"y":1488,"width":288,"height":24}]}},{"nodeType":"text","text":"差當り明日の暮しをどうにかしようとし","layout":{"rects":[{"x":0,"y":1512,"width":288,"height":24}]}},{"nodeType":"text","text":"て――云はゞどうにもならない事を、ど","layout":{"rects":[{"x":0,"y":1536,"width":288,"height":24}]}},{"nodeType":"text","text":"うにかしようとして、とりとめもない考","layout":{"rects":[{"x":0,"y":1560,"width":288,"height":24}]}},{"nodeType":"text","text":"へをたどりながら、さつきから朱雀大路","layout":{"rects":[{"x":0,"y":1584,"width":288,"height":24}]}},{"nodeType":"text","text":"にふる雨の音を、聞くともなく聞いてゐ","layout":{"rects":[{"x":0,"y":1608,"width":288,"height":24}]}},{"nodeType":"text","text":"た。","layout":{"rects":[{"x":0,"y":1632,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1656,"width":300,"heigh