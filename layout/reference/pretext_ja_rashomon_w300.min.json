,"width":288,"height":24}]}},{"nodeType":"text","text":"全然、自分の意志に支配されてゐると云","layout":{"rects":[{"x":0,"y":5496,"width":288,"height":24}]}},{"nodeType":"text","text":"ふ事を意識した。さうして、この意識","layout":{"rects":[{"x":0,"y":5520,"width":272,"height":24}]}},{"nodeType":"text","text":"は、今まではげしく燃えてゐた憎惡の心","layout":{"rects":[{"x":0,"y":5544,"width":288,"height":24}]}},{"nodeType":"text","text":"を何時の間にか冷ましてしまつた。後に","layout":{"rects":[{"x":0,"y":5568,"width":288,"height":24}]}},{"nodeType":"text","text":"殘つたのは、唯、或仕事をして、それが","layout":{"rects":[{"x":0,"y":5592,"width":288,"height":24}]}},{"nodeType":"text","text":"圓滿に成就した時の、安らかな得意と滿","layout":{"rects":[{"x":0,"y":5616,"width":288,"height":24}]}},{"nodeType":"text","text":"足とがあるばかりである。そこで、下人","layout":{"rects":[{"x":0,"y":5640,"width":288,"height":24}]}},{"nodeType":"text","text":"は、老婆を見下しながら、少し聲を柔げ","layout":{"rects":[{"x":0,"y":5664,"width":288,"height":24}]}},{"nodeType":"text","text":"てかう云つた。","layout":{"rects":[{"x":0,"y":5688,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5712,"width":300,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「己は檢非違使の廳の役人などではな","layout":{"rects":[{"x":0,"y":5712,"width":272,"height":24}]}},{"nodeType":"text","text":"い。今し方この門の下を通りかゝつた旅","layout":{"rects":[{"x":0,"y":5736,"width":288,"height":24}]}},{"nodeType":"text","text":"の者だ。だからお前に繩をかけて、どう","layout":{"rects":[{"x":0,"y":5760,"width":288,"height":24}]}},{"nodeType":"text","text":"しようと云ふやうな事はない。唯、今時","layout":{"rects":[{"x":0,"y":5784,"width":288,"height":24}]}},{"nodeType":"text","text":"分、この門の上で、何をして居たのだ","layout":{"rects":[{"x":0,"y":5808,"width":272,"height":24}]}},{"nodeType":"text","text":"か、それを己に話しさへすればいいの","layout":{"rects":[{"x":0,"y":5832,"width":272,"height":24}]}},{"nodeType":"text","text":"だ。」","layout":{"rects":[{"x":0,"y":5856,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5880,"width":300,"height":240},"computed