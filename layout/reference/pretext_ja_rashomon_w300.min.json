","layout":{"rects":[{"x":0,"y":24,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":48,"width":300,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"廣い門の下には、この男の外に誰もゐな","layout":{"rects":[{"x":0,"y":48,"width":288,"height":24}]}},{"nodeType":"text","text":"い。唯、所々丹塗の剝げた、大きな圓柱","layout":{"rects":[{"x":0,"y":72,"width":288,"height":24}]}},{"nodeType":"text","text":"に、蟋蟀が一匹とまつてゐる。羅生門","layout":{"rects":[{"x":0,"y":96,"width":272,"height":24}]}},{"nodeType":"text","text":"が、朱雀大路にある以上は、この男の外","layout":{"rects":[{"x":0,"y":120,"width":288,"height":24}]}},{"nodeType":"text","text":"にも、雨やみをする市女笠や揉烏帽子","layout":{"rects":[{"x":0,"y":144,"width":272,"height":24}]}},{"nodeType":"text","text":"が、もう二三人はありさうなものであ","layout":{"rects":[{"x":0,"y":168,"width":272,"height":24}]}},{"nodeType":"text","text":"る。それが、この男の外には誰もゐな","layout":{"rects":[{"x":0,"y":192,"width":272,"height":24}]}},{"nodeType":"text","text":"い。","layout":{"rects":[{"x":0,"y":216,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":240,"width":300,"height":432},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"何故かと云ふと、この二三年、京都に","layout":{"rects":[{"x":0,"y":240,"width":272,"height":24}]}},{"nodeType":"text","text":"は、地震とか辻風とか火事とか饑饉とか","layout":{"rects":[{"x":0,"y":264,"width":288,"height":24}]}},{"nodeType":"text","text":"云ふ災がつゞいて起つた。そこで洛中の","layout":{"rects":[{"x":0,"y":288,"width":288,"height":24}]}},{"nodeType":"text","text":"さびれ方は一通りでない。舊記による","layout":{"rects":[{"x":0,"y":312,"width":272,"height":24}]}},{"nodeType":"text","text":"と、佛像や佛具を打碎いて、その丹がつ","layout":{"rects":[{"x":0,"y":336,"width":288,"height":24}]}},{"nodeType":"text","text":"いたり、金銀の箔がついたりした木を、","layout":{"rects":[{"x":0,"y":360,"width":288,"height":24}]}},{"nodeType":"text","text":"路ばたにつみ重ねて、薪の料に賣つてゐ","layout":{"rects":[{"x":0,"y":384,"width":288,"height":24}]}},{"nodeType":"text","text":"たと云ふ事である。洛中がその始末であ","layout":{"rects":[{"x":0,"y":408,"width":288,"height":24}]}},{"nodeType":"text","text":"るから、羅生門の修理などは、元より誰","layout":{"rects":[{"x":0,"y":432,"width":288,"height":24}]}},{"nodeType":"text","text":"も捨てゝ顧る者がなかつた。するとその","layout":{"rects":[{"x":0,"y":456,"width":288,"height":24}]}},{"nodeType":"text","text":"荒れ果てたのをよい事にして、狐狸が棲","layout":{"rects":[{"x":0,"y":480,"width":288,"height":24}]}},{"nodeType":"text","text":"む。盜人が棲む。とうとうしまひには、","layout":{"rects":[{"x":0,"y":504,"width":288,"height":24}]}},{"nodeType":"text","text":"引取り手のない死人を、この門へ持つて","layout":{"rects":[{"x":0,"y":528,"width":288,"height":24}]}},{"nodeType":"text","text":"來て、棄てゝ行くと云ふ習慣さへ出來","layout":{"rects":[{"x":0,"y":552,"width":272,"height":24}]}},{"nodeType":"text","text":"た。そこで、日の目が見えなくなると、","layout":{"rects":[{"x":0,"y":576,"width":288,"height":24}]}},{"nodeType":"text","text":"誰でも氣味を惡るがつて、この門の近所","layout":{"rects":[{"x":0,"y":600,"width":288,"height":24}]}},{"nodeType":"text","text":"へは足ぶみをしない事になつてしまつた","layout":{"rects":[{"x":0,"y":624,"width":288,"height":24}]}},{"nodeType":"text","text":"のである。","layout":{"rects":[{"x":0,"y":648,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":672,"width":300,"height":408},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その代り又鴉が何處からか、たくさん集","layout":{"rects":[{"x":0,"y":672,"width":288,"height":24}]}},{"nodeType":"text","text":"つて來た。晝間見ると、その鴉が何羽と","layout":{"rects":[{"x":0,"y":696,"width":288,"height":24}]}},{"nodeType":"text","text":"なく輪を描いて高い鴟尾のまはりを啼き","layout":{"rects":[{"x":0,"y":720,"width":288,"height":24}]}},{"nodeType":"text","text":"ながら、飛びまはつてゐる。殊に門の上","layout":{"rects":[{"x":0,"y":744,"width":288,"height":24}]}},{"nodeType":"text","text":"の空が、夕燒けであかくなる時には、そ","layout":{"rects":[{"x":0,"y":768,"width":288,"height":24}]}},{"nodeType":"text","text":"れが胡麻をまいたやうにはつきり見え","layout":{"rects":[{"x":0,"y":792,"width":272,"height":24}]}},{"nodeType":"text","text":"た。鴉は、勿論、門の上にある死人の肉","lay