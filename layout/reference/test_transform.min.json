margin-top: 8px;\n            font-size: 11px;\n            color: #666;\n            text-align: center;\n        }\n\n        /* Transform examples */\n        .translate {\n            transform: translate(20px, 10px);\n        }\n\n        .scale {\n            transform: scale(1.3);\n        }\n\n        .scale-xy {\n            transform: scale(1.5, 0.8);\n        }\n\n        .rotate {\n            transform: rotate(15deg);\n        }\n\n        .rotate-negative {\n            transform: rotate(-30deg);\n        }\n\n        .skew {\n            transform: skew(10deg, 5deg);\n        }\n\n        .skewX {\n            transform: skewX(15deg);\n        }\n\n        .combined {\n            transform: translate(10px, 5px) rotate(10deg) scale(1.1);\n        }\n\n        .origin-top-left {\n            transform-origin: top left;\n            transform: rotate(20deg);\n        }\n\n        .origin-bottom-right {\n            transform-origin: bottom right;\n            transform: rotate(20deg);\n        }\n\n        .matrix {\n            /* matrix(a, b, c, d, e, f) - slight rotation and scale */\n            transform: matrix(0.9, 0.2, -0.2, 0.9, 5, 5);\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":8,"y":8,"width":1184,"height":639.88},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"h1","layout":{"x":48,"y":69.44,"width":1104,"height":37},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"CSS Transform Test","layout":{"rects":[{"x":48,"y":69.44,"width":303.48,"height":36}]}}]},{"nodeType":"element","tag":"div","layout":{"x":48,"y":127.88,"width":1104,"height":480},"computed":{"display":"flex","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":48,"y":127.88,"width":150,"height":120},"computed":{"display":"flex","textAlign":"start"},"children":[{"nodeTy