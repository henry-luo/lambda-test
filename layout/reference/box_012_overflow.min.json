     .overflow-box {\n            width: 200px;\n            height: 100px;\n            border: 2px solid #666;\n            background-color: #f0f0f0;\n            padding: 10px;\n            margin: 10px;\n            display: inline-block;\n            vertical-align: top;\n        }\n        \n        .content {\n            background-color: #ffcccc;\n            padding: 5px;\n            border: 1px solid #999;\n        }\n        \n        .long-content {\n            width: 300px;\n            height: 150px;\n            background-color: #ccffcc;\n            border: 1px solid #666;\n            padding: 10px;\n        }\n        \n        /* Overflow behaviors */\n        .overflow-visible {\n            overflow: visible;\n            background-color: #ffffcc;\n        }\n        \n        .overflow-hidden {\n            overflow: hidden;\n            background-color: #ffccff;\n        }\n        \n        .overflow-scroll {\n            overflow: scroll;\n            background-color: #ccffff;\n        }\n        \n        .overflow-auto {\n            overflow: auto;\n            background-color: #ccccff;\n        }\n        \n        /* Individual axis overflow */\n        .overflow-x-scroll {\n            overflow-x: scroll;\n            overflow-y: hidden;\n            background-color: #ffccaa;\n        }\n        \n        .overflow-y-scroll {\n            overflow-x: hidden;\n            overflow-y: scroll;\n            background-color: #ccffaa;\n        }\n        \n        /* Text overflow */\n        .text-overflow-test {\n            width: 150px;\n            height: 30px;\n            border: 1px solid #666;\n            background-color: white;\n            padding: 5px;\n            margin: 5px;\n            display: inline-block;\n            line-height: 20px;\n        }\n        \n        .text-ellipsis {\n            white-space: nowrap;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            background-color: #ffeecc;\n        }\n        \n        .text-clip {\n            white-space: nowrap;\n            overflow: hidden;\n            text-overflow: clip;\n            background-color: #eeffcc;\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":900},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":800,"height":900},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":22,"y":42,"width":756,"height":180},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":38,"y":58,"width":724,"height":18},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Overflow: visible (default)","layout":{"rects":[{"x":38,"y":58,"width":195.59,"height":17}]}}]},{"nodeType":"element","tag":"div","layout":{"x":48,"y":96,"width":200,"height":100},"computed":{"display":"inline-block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":60,"y":108,"width":300,"height":150},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"\n                    This content is larger than its container ","layout":{"rects":[{"x":71,"y":119,"width":274.81,"height":17}]}},{"nodeType":"text","text":"and will overflow visibly outside the ","layout":{"rects":[{"x":71,"y":137,"width":248.13,"height":17}]}},{"nodeType":"text","text":"bounds.\n                ","layout":{"rects":[{"x":71,"y":155,"width":56.94,"height":17}]}}]}]}]},{"nodeType":"element","tag":"div","layout":{"x":22,"y":242,"width":756,"height":180},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":38,"y":258,"width":724,"height":18},"computed":{"display":"block","textAlign":"s