{\n            width: 40px;\n            height: 40px;\n            border-radius: 12px;\n            background: conic-gradient(from 210deg, #22c55e, #0ea5e9, #6366f1, #22c55e);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: #020617;\n            font-weight: 700;\n            font-size: 22px;\n        }\n\n        .brand-text h1 {\n            margin: 0;\n            font-size: 26px;\n            font-weight: 550;\n            letter-spacing: 0.03em;\n        }\n\n        .brand-text p {\n            margin: 4px 0 0;\n            font-size: 13px;\n            color: #9ca3af;\n        }\n\n        .hero-tagline {\n            margin-top: 12px;\n            padding: 8px 10px;\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n            border-radius: 999px;\n            font-size: 11px;\n            letter-spacing: 0.08em;\n            text-transform: uppercase;\n            background: rgba(15, 23, 42, 0.9);\n            border: 1px solid rgba(148, 163, 184, 0.5);\n            color: #cbd5f5;\n        }\n\n        .hero-tagline span.badge {\n            padding: 3px 7px 4px;\n            border-radius: 999px;\n            background: linear-gradient(120deg, #22c55e, #0ea5e9);\n            color: #020617;\n            font-weight: 600;\n        }\n\n        .hero-copy {\n            margin-top: 14px;\n            font-size: 13px;\n            line-height: 1.6;\n            color: #9ca3af;\n        }\n\n        .hero-copy strong {\n            color: #e5e7eb;\n            font-weight: 600;\n        }\n\n        .hero-actions {\n            margin-top: 16px;\n            display: flex;\n            flex-wrap: wrap;\n            gap: 10px;\n        }\n\n        .pill {\n            display: inline-flex;\n            align-items: center;\n            gap: 6px;\n            padding: 7px 12px;\n            border-radius: 999px;\n            border: 1px solid rgba(148, 163, 184, 0.6);\n            background: rgba(15, 23, 42, 0.9);\n            font-size: 11px;\n            color: #cbd5f5;\n            text-decoration: none;\n            white-space: nowrap;\n        }\n\n        .pill.primary {\n            border-color: transparent;\n            background: linear-gradient(135deg, #22c55e, #0ea5e9);\n            color: #020617;\n            font-weight: 600;\n        }\n\n        .pill code {\n            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n            font-size: 10px;\n        }\n\n        .hero-matrix {\n            border-radius: 14px;\n            padding: 14px 14px 12px;\n            background:\n                radial-gradient(circle at top left, rgba(56, 189, 248, 0.16), transparent 55%),\n                radial-gradient(circle at bottom right, rgba(34, 197, 94, 0.18), transparent 55%),\n                rgba(15, 23, 42, 0.96);\n            border: 1px solid rgba(148, 163, 184, 0.5);\n            box-shadow: 0 22px 55px rgba(0, 0, 0, 0.6);\n        }\n\n        .hero-matrix h2 {\n            margin: 0 0 10px;\n            font-size: 13px;\n            text-transform: uppercase;\n            letter-spacing: 0.16em;\n            color: #9ca3af;\n        }\n\n        .hero-matrix-grid {\n            display: grid;\n            grid-template-columns: repeat(2, minmax(0, 1fr));\n            gap: 8px;\n        }\n\n        .hero-card {\n            padding: 10px 10px 9px;\n            border-radius: 12px;\n            background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.7));\n            border: 1px solid rgba(148, 163, 184, 0.45);\n        }\n\n        .hero-card h3 {\n            margin: 0 0 4px;\n            font-size: 12px;\n            font-weight: 600;\n        }\n\n        .hero-card p {\n            margin: 0 0 4px;\n            font-size: 11px;\n            line-height: 1.5;\n            color: #9ca3af;\n        }\n\n        .hero-card pre {\n            margin: 4px 0 0;\n            padding: 6px 7px;\n            border-radius: 8px;\n            background: rgba(15, 23, 42, 0.9);\n            border: 1px solid rgba(31, 41, 55, 0.9);\n            font-size: 10px;\n            line-height: 1.4;\n            color: #e5e7eb;\n            overflow-x: auto;\n        }\n\n        .hero-card code {\n            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n        }\n\n        main {\n            display: grid;\n            grid-template-columns: minmax(0, 2.1fr) minmax(0, 3fr);\n            gap: 20px;\n        }\n\n        .nav-panel {\n            display: flex;\n            flex-direction: column;\n            gap: 14px;\n        }\n\n        .nav-group h2 {\n            margin: 0 0 6px;\n            font-size: 11px;\n            letter-spacing: 0.16em;\n            text-transform: uppercase;\n            color: #9ca3af;\n        }\n\n        .nav-links {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 6px;\n        }\n\n        .nav-links a {\n            display: inline-flex;\n            align-items: center;\n            gap: 6px;\n            padding: 6px 10px;\n            border-radius: 999px;\n            border: 1px solid rgba(31, 41, 55, 0.95);\n            background: rgba(15, 23, 42, 0.96);\n            font-size: 11px;\n            text-decoration: none;\n            color: #d1d5db;\n            white-space: nowrap;\n        }\n\n        .nav-links a:hover {\n            border-color: rgba(96, 165, 250, 0.9);\n            color: #e5e7eb;\n        }\n\n        .nav-links a.active {\n            border-color: rgba(59, 130, 246, 1);\n            background: linear-gradient(135deg, rgba(37, 99, 235, 0.9), rgba(15, 23, 42, 0.95));\n            color: #e5e7eb;\n        }\n\n        .viewer {\n            border-radius: 16px;\n            overflow: hidden;\n            background: rgba(15, 23, 42, 0.95);\n            border: 1px solid rgba(31, 41, 55, 0.95);\n            box-shadow: 0 20px 55px rgba(0, 0, 0, 0.7);\n            align-self: start;\n        }\n\n        .viewer-header {\n            display: flex;\n            align-items: center;\n            padding: 8px 10px;\n            gap: 8px;\n            background: linear-gradient(90deg, #020617, #020617 30%, #020617 100%);\n            border-bottom: 1px solid rgba(31, 41, 55, 0.95);\n        }\n\n        .viewer-dots {\n            display: flex;\n            align-items: center;\n            gap: 6px;\n        }\n\n        .viewer-dot {\n            width: 9px;\n            height: 9px;\n            border-radius: 999px;\n        }\n\n        .viewer-dot.red { background: #ef4444; }\n        .viewer-dot.amber { background: #f59e0b; }\n        .viewer-dot.green { background: #22c55e; }\n\n        .viewer-title {\n            flex: 1;\n            text-align: center;\n            font-size: 11px;\n            color: #9ca3af;\n        }\n\n        iframe[name=\"main_frame\"] {\n            width: 100%;\n            height: 100px;\n            border: none;\n            background: #ffffff;\n        }\n\n        footer {\n            margin-top: 18px;\n            padding-top: 12px;\n            border-top: 1px solid rgba(31, 41, 55, 0.8);\n            font-size: 11px;\n            color: #6b7280;\n            display: flex;\n            justify-content: space-between;\n            flex-wrap: wrap;\n            gap: 8px;\n        }\n\n        footer .links a {\n            text-decoration: none;\n            color: #6b7280;\n        }\n\n        footer .links a:hover {\n            color: #9ca3af;\n        }\n\n        @media (max-width: 960px) {\n            header {\n                grid-template-columns: minmax(0, 1fr);\n            }\n            main {\n                grid-template-columns: minmax(0, 1fr);\n            }\n            iframe[name=\"main_frame\"] {