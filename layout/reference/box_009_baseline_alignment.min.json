            font-weight: bold;\n            margin-bottom: 10px;\n            line-height: normal;\n        }\n        \n        /* Different font sizes */\n        .small-text {\n            font-size: 12px;\n            background-color: #ffcccc;\n            vertical-align: baseline;\n        }\n        \n        .medium-text {\n            font-size: 16px;\n            background-color: #ccffcc;\n            vertical-align: baseline;\n        }\n        \n        .large-text {\n            font-size: 24px;\n            background-color: #ccccff;\n            vertical-align: baseline;\n        }\n        \n        .xlarge-text {\n            font-size: 32px;\n            background-color: #ffffcc;\n            vertical-align: baseline;\n        }\n        \n        /* Inline blocks with different heights */\n        .inline-block {\n            display: inline-block;\n            padding: 5px 10px;\n            margin: 0 5px;\n            border: 1px solid #666;\n            text-align: center;\n        }\n        \n        .short-block {\n            height: 30px;\n            line-height: 20px;\n            background-color: #ffccff;\n            vertical-align: baseline;\n        }\n        \n        .medium-block {\n            height: 50px;\n            line-height: 40px;\n            background-color: #ccffff;\n            vertical-align: baseline;\n        }\n        \n        .tall-block {\n            height: 70px;\n            line-height: 60px;\n            background-color: #ffccaa;\n            vertical-align: baseline;\n        }\n        \n        /* Different vertical alignments for comparison */\n        .align-top {\n            vertical-align: top;\n            background-color: #aaffcc;\n        }\n        \n        .align-middle {\n            vertical-align: middle;\n            background-color: #aaccff;\n        }\n        \n        .align-bottom {\n            vertical-align: bottom;\n            background-color: #ffaacc;\n        }\n        \n        /* Visual baseline indicator */\n        .baseline-indicator {\n            border-bottom: 2px solid red;\n            display: inline;\n            position: relative;\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":700},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":800,"height":700},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":22,"y":42,"width":756,"height":156},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"span","layout":{"x":38,"y":58,"width":724,"height":18},"selector":"span.test-title:nth-of-type(1)","computed":{"display":"block","textAlign":"start","fontFamily":"Arial, sans-serif","fontSize":16,"fontWeight":"700"},"children":[{"nodeType":"text","text":"Mixed font sizes on baseline:","layout":{"rects":[{"x":38,"y":58,"width":221.38,"height":17}]}}]},{"nodeType":"element","tag":"span","layout":{"x":38,"y":134,"width":30.02,"height":14},"selector":"span.small-text:nth-of-type(2)","computed":{"display":"inline","textAlign":"start","fontFamily":"Arial, sans-serif","fontSize":12,"fontWeight":"400"},"children":[{"nodeType":"text","text":"Small","layout":{"rects":[{"x":38,"y":134,"width":30.02,"height":14}]}}]},{"nodeType":"text","text":"\n            ","layout":{"rects":[{"x":68.02,"y":131,"width":4.45,"height":17}]}},{"nodeType":"element","tag":"span","layout":{"x":72.47,"y":131,"width":56.91,"height":17},"selector":"span.medium-text:nth-of-type(3)","computed":{"display":"inline","textAlign":"start","fontFamily":"Arial, sans-serif","fontSize":16,"fontWeight":"400"},"children":[{"nodeType":"text","text":"Medium","layout":{"rects":[{"x":72.47,"y":131,"width":56.91,"height":17}]}}]},{"nodeType":"text","text":"\n            ","layout":{"