{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":6840},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"Pretext corpus: width 380px","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n@font-face {\n    font-family: 'Noto Sans SC';\n    src: url('../font/NotoSansSC-Subset.otf') format('opentype');\n}\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: 'Noto Sans SC', sans-serif; font-size: 16px; line-height: 1.5; font-kerning: none; text-spacing-trim: space-all; }\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":6840},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":380,"height":6840},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"p","layout":{"x":0,"y":0,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我冒了嚴寒，回到相隔二千餘里，別了二十餘年的故","layout":{"rects":[{"x":0,"y":0,"width":368,"height":24}]}},{"nodeType":"text","text":"鄕去。","layout":{"rects":[{"x":0,"y":24,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":48,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"時候既然是深冬；漸近故鄕時，天氣又陰晦了，冷風","layout":{"rects":[{"x":0,"y":48,"width":368,"height":24}]}},{"nodeType":"text","text":"吹進船艙中，嗚嗚的響，從篷隙向外一望，蒼黃的天","layout":{"rects":[{"x":0,"y":72,"width":368,"height":24}]}},{"nodeType":"text","text":"底下，遠近橫着幾個蕭索的荒村，沒有一些活氣。我","layout":{"rects":[{"x":0,"y":96,"width":368,"height":24}]}},{"nodeType":"text","text":"的心禁不住悲涼起來了。","layout":{"rects":[{"x":0,"y":120,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":144,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"阿！這不是我二十年來時時記得的故鄕？","layout":{"rects":[{"x":0,"y":144,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":168,"width":380,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我所記得的故鄕全不如此。我的故鄕好得多了。但要","layout":{"rects":[{"x":0,"y":168,"width":368,"height":24}]}},{"nodeType":"text","text":"我記起他的美麗，說出他的佳處來，卻又沒有影像，","layout":{"rects":[{"x":0,"y":192,"width":368,"height":24}]}},{"nodeType":"text","text":"沒有言辭了。彷彿也就如此。於是我自己解釋說：故","layout":{"rects":[{"x":0,"y":216,"width":368,"height":24}]}},{"nodeType":"text","text":"鄕本也如此，——雖然沒有進步，也未必有如我所感","layout":{"rects":[{"x":0,"y":240,"width":368,"height":24}]}},{"nodeType":"text","text":"的悲涼，這只是我自己心情的改變罷了，因爲我這次","layout":{"rects":[{"x":0,"y":264,"width":368,"height":24}]}},{"nodeType":"text","text":"回鄕，本沒有什麽好心緖。","layout":{"rects":[{"x":0,"y":288,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":312,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我這次是專爲了別他而來的。我們多年聚族而居的老","layout":{"rects":[{"x":0,"y":312,"width":368,"height":24}]}},{"nodeType":"text","text":"屋，已經公同賣給別姓了，交屋的期限，只在本年，","layout":{"rects":[{"x":0,"y":336,"width":368,"height":24}]}},{"nodeType":"text","text":"所以必須趕在正月初一以前，永別了熟識的老屋，而","layout":{"rects":[{"x":0,"y":360,"width":368,"height":24}]}},{"nodeType":"text","text":"且遠離了熟識的故鄕，搬家到我在謀食的異地去。","layout":{"rects":[{"x":0,"y":384,"width":352,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":408,"width":380,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"第二日淸早晨我到了我家的門口了。瓦楞上許多枯草","layout":{"rects":[{"x":0,"y":408,"width":368,"height":24}]}},{"nodeType":"text","text":"的斷莖當風抖着，正在說明這老屋難免易主的原因。","layout":{"rects":[{"x":0,"y":432,"width":368,"height":24}]}},{"nodeType":"text","text":"幾房的本家大約已經搬走了，所以很寂靜。我到了自","layout":{"rects":[{"x":0,"y":456,"width":368,"height":24}]}},{"nodeType":"text","text":"家的房外，我的母親早已迎着出來了，接着便飛出了","layout":{"rects":[{"x":0,"y":480,"width":368,"height":24}]}},{"nodeType":"text","text":"八歲的姪兒宏兒。","layout":{"rects":[{"x":0,"y":504,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":528,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我的母親很高興，但也藏着許多淒涼的神情，教我坐","layout":{"rects":[{"x":0,"y":528,"width":368,"height":24}]}},{"nodeType":"text","text":"下，歇息，喝茶，且不談搬家的事。宏兒沒有見過","layout":{"rects":[{"x":0,"y":552,"width":352,"height":24}]}},{"nodeType":"text","text":"我，遠遠的對面站着只是看。","layout":{"rects":[{"x":0,"y":576,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":600,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"但我們終於談到搬家的事。我說外間的寓所已經租定","layout":{"rects":[{"x":0,"y":600,"width":368,"height":24}]}},{"nodeType":"text","text":"了，又買了幾件家具，此外須將家裏所有的木器賣","layout":{"rects":[{"x":0,"y":624,"width":352,"height":24}]}},{"nodeType":"text","text":"去，再去增添。母親也說好，而且行李也略已齊集，","layout":{"rects":[{"x":0,"y":648,"width":368,"height":24}]}},{"nodeType":"text","text":"木器不便搬運的，也小半賣去了，只是收不起錢來。","layout":{"rects":[{"x":0,"y":672,"width":368,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":696,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『你休息一兩天，去拜望親戚本家一回，我們便可以","layout":{"rects":[{"x":0,"y":696,"width":368,"height":24}]}},{"nodeType":"text","text":"走了。』母親說。","layout":{"rects":[{"x":0,"y":720,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":744,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『是的。』","layout":{"rects":[{"x":0,"y":744,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":768,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『還有閏土，他每到我家來時，總問起你，很想見你","layout":{"rects":[{"x":0,"y":768,"width":368,"height":24}]}},{"nodeType":"text","text":"一回面。我已經將你到家的大約日期通知他，他也許","layout":{"rects":[{"x":0,"y":792,"width":368,"height":24}]}},{"nodeType":"text","text":"就要來了。』","layout":{"rects":[{"x":0,"y":816,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":840,"width":380,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"這時候，我的腦裏忽然閃出一幅神異的圖畫來：深藍","layout":{"rects":[{"x":0,"y":840,"width":368,"height":24}]}},{"nodeType":"text","text":"的天空中掛着一輪金黃的圓月，下面是海邊的沙地，","layout":{"rects":[{"x":0,"y":864,"width":368,"height":24}]}},{"nodeType":"text","text":"都種着一望無際的碧綠的西瓜，其間有一個十一二歲","layout":{"rects":[{"x":0,"y":888,"width":368,"height":24}]}},{"nodeType":"text","text":"的少年，項帶銀圈，手揑一柄鋼叉，向一匹猹儘力的","layout":{"rects":[{"x":0,"y":912,"width":368,"height":24}]}},{"nodeType":"text","text":"刺去，那猹卻將身一扭，反從他的胯下逃走了。","layout":{"rects":[{"x":0,"y":936,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":960,"width":380,"height":264},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"這少年便是閏土。我認識他時，也不過十多歲，離現","layout":{"rects":[{"x":0,"y":960,"width":368,"height":24}]}},{"nodeType":"text","text":"在將有三十年了；那時我的父親還在世，家景也好，","layout":{"rects":[{"x":0,"y":984,"width":368,"height":24}]}},{"nodeType":"text","text":"我正是一個少爺。那一年，我家是一件大祭祀的値","layout":{"rects":[{"x":0,"y":1008,"width":352,"height":24}]}},{"nodeType":"text","text":"年。這祭祀，說是三十多年纔能輪到一回，所以很鄭","layout":{"rects":[{"x":0,"y":1032,"width":368,"height":24}]}},{"nodeType":"text","text":"重；正月裏供祖像，供品很多，祭器很講究，拜的人","layout":{"rects":[{"x":0,"y":1056,"width":368,"height":24}]}},{"nodeType":"text","text":"也很多，祭器也很要防偸去。我家只有一個忙月（我","layout":{"rects":[{"x":0,"y":1080,"width":368,"height":24}]}},{"nodeType":"text","text":"們這里給人做工的分三種：整年給一定人家做工的叫","layout":{"rects":[{"x":0,"y":1104,"width":368,"height":24}]}},{"nodeType":"text","text":"長年；按日給人做工的叫短工；自己也種地，只在過","layout":{"rects":[{"x":0,"y":1128,"width":368,"height":24}]}},{"nodeType":"text","text":"年過節以及收租時候來給一定的人家做工的稱忙","layout":{"rects":[{"x":0,"y":1152,"width":336,"height":24}]}},{"nodeType":"text","text":"月），忙不過來，他便對父親說，可以叫他的兒子閏","layout":{"rects":[{"x":0,"y":1176,"width":368,"height":24}]}},{"nodeType":"text","text":"土來管祭器的。","layout":{"rects":[{"x":0,"y":1200,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1224,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我的父親允許了；我也很高興，因爲我早聽到閏土這","layout":{"rects":[{"x":0,"y":1224,"width":368,"height":24}]}},{"nodeType":"text","text":"名字，而且知道他和我彷彿年紀，閏月生的，五行缺","layout":{"rects":[{"x":0,"y":1248,"width":368,"height":24}]}},{"nodeType":"text","text":"土，所以他的父親叫他閏土。他是能裝弶捉小鳥雀","layout":{"rects":[{"x":0,"y":1272,"width":352,"height":24}]}},{"nodeType":"text","text":"的。","layout":{"rects":[{"x":0,"y":1296,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1320,"width":380,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我於是日日盼望新年，新年到，閏土也就到了。好容","layout":{"rects":[{"x":0,"y":1320,"width":368,"height":24}]}},{"nodeType":"text","text":"易到了年末，有一日，母親告訴我，閏土來了，我便","layout":{"rects":[{"x":0,"y":1344,"width":368,"height":24}]}},{"nodeType":"text","text":"飛跑的去看。他正在廚房裏，紫色的圓臉，頭戴一頂","layout":{"rects":[{"x":0,"y":1368,"width":368,"height":24}]}},{"nodeType":"text","text":"小氈帽，頸上套一個明晃晃的銀項圈，這可見他的父","layout":{"rects":[{"x":0,"y":1392,"width":368,"height":24}]}},{"nodeType":"text","text":"親十分愛他，怕他死去，所以在神佛面前許下願心，","layout":{"rects":[{"x":0,"y":1416,"width":368,"height":24}]}},{"nodeType":"text","text":"用圈子將他套住了。他見人很怕羞，只是不怕我，沒","layout":{"rects":[{"x":0,"y":1440,"width":368,"height":24}]}},{"nodeType":"text","text":"有旁人的時候，便和我說話，於是不到半日，我們便","layout":{"rects":[{"x":0,"y":1464,"width":368,"height":24}]}},{"nodeType":"text","text":"熟識了。","layout":{"rects":[{"x":0,"y":1488,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1512,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我們那時候不知道談些什麽，只記得閏土很高興，說","layout":{"rects":[{"x":0,"y":1512,"width":368,"height":24}]}},{"nodeType":"text","text":"是上城之後，見了許多沒有見過的東西。","layout":{"rects":[{"x":0,"y":1536,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1560,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"第二日，我便要他捕鳥。他說：","layout":{"rects":[{"x":0,"y":1560,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1584,"width":380,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『這不能。須大雪下了纔好。我們沙地上，下了雪，","layout":{"rects":[{"x":0,"y":1584,"width":368,"height":24}]}},{"nodeType":"text","text":"我掃出一塊空地來，用短棒支起一個大竹匾，撒下粃","layout":{"rects":[{"x":0,"y":1608,"width":368,"height":24}]}},{"nodeType":"text","text":"穀，看鳥雀來喫時，我遠遠地將縛在棒上的繩子只一","layout":{"rects":[{"x":0,"y":1632,"width":368,"height":24}]}},{"nodeType":"text","text":"拉，那鳥雀就罩在竹匾下了。什麽都有：稻雞、角","layout":{"rects":[{"x":0,"y":1656,"width":352,"height":24}]}},{"nodeType":"text","text":"雞、鵓鴣、藍背……』","layout":{"rects":[{"x":0,"y":1680,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1704,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我於是又很盼望下雪。","layout":{"rects":[{"x":0,"y":1704,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1728,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"閏土又對我說：","layout":{"rects":[{"x":0,"y":1728,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1752,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『現在太冷，你夏天到我們這里來。我們日裏到海邊","layout":{"rects":[{"x":0,"y":1752,"width":368,"height":24}]}},{"nodeType":"text","text":"檢貝殼去，紅的綠的都有，鬼見怕也有，觀音手也","layout":{"rects":[{"x":0,"y":1776,"width":352,"height":24}]}},{"nodeType":"text","text":"有，晚上我和爹管西瓜去，你也去。』","layout":{"rects":[{"x":0,"y":1800,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1824,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『管賊麽？』","layout":{"rects":[{"x":0,"y":1824,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1848,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『不是。走路的人口渴了摘一個瓜喫，我們這里是不","layout":{"rects":[{"x":0,"y":1848,"width":368,"height":24}]}},{"nodeType":"text","text":"算偸的。要管的是獾豬、刺蝟、猹。月亮地下，你","layout":{"rects":[{"x":0,"y":1872,"width":352,"height":24}]}},{"nodeType":"text","text":"聽，啦啦的響了，猹在咬瓜了。你便揑了胡叉，輕輕","layout":{"rects":[{"x":0,"y":1896,"width":368,"height":24}]}},{"nodeType":"text","text":"地走去……』","layout":{"rects":[{"x":0,"y":1920,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1944,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我那時並不知道這所謂猹的是怎麽一件東西——便是","layout":{"rects":[{"x":0,"y":1944,"width":368,"height":24}]}},{"nodeType":"text","text":"現在也沒有知道——只是無端的覺得狀如小狗而很凶","layout":{"rects":[{"x":0,"y":1968,"width":368,"height":24}]}},{"nodeType":"text","text":"猛。","layout":{"rects":[{"x":0,"y":1992,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2016,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『他不咬人麽？』","layout":{"rects":[{"x":0,"y":2016,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2040,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『有胡叉呢。走到了，看見猹了，你便刺。這畜生很","layout":{"rects":[{"x":0,"y":2040,"width":368,"height":24}]}},{"nodeType":"text","text":"伶俐，倒向你奔來，反從胯下竄了。他的皮毛是油一","layout":{"rects":[{"x":0,"y":2064,"width":368,"height":24}]}},{"nodeType":"text","text":"般的滑。……』","layout":{"rects":[{"x":0,"y":2088,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2112,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我素不知道天下有這許多新鮮事：海邊有如許五色的","layout":{"rects":[{"x":0,"y":2112,"width":368,"height":24}]}},{"nodeType":"text","text":"貝殼；西瓜有這樣危險的經歷，我先前單知道他在水","layout":{"rects":[{"x":0,"y":2136,"width":368,"height":24}]}},{"nodeType":"text","text":"果店裏出賣罷了。","layout":{"rects":[{"x":0,"y":2160,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2184,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『我們沙地裏，潮汛要來的時候，就有許多跳魚兒只","layout":{"rects":[{"x":0,"y":2184,"width":368,"height":24}]}},{"nodeType":"text","text":"是跳，都有靑蛙似的兩個脚。……』","layout":{"rects":[{"x":0,"y":2208,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2232,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"阿！閏土的心裏有無窮無盡的希奇的事，都是我往常","layout":{"rects":[{"x":0,"y":2232,"width":368,"height":24}]}},{"nodeType":"text","text":"的朋友所不知道的。他們不知道一些事，閏土在海邊","layout":{"rects":[{"x":0,"y":2256,"width":368,"height":24}]}},{"nodeType":"text","text":"時，他們都和我一樣只看見院子裏高牆上的四角的天","layout":{"rects":[{"x":0,"y":2280,"width":368,"height":24}]}},{"nodeType":"text","text":"空。","layout":{"rects":[{"x":0,"y":2304,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2328,"width":380,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"可惜正月過去了，閏土須回家裏去，我急得大哭，他","layout":{"rects":[{"x":0,"y":2328,"width":368,"height":24}]}},{"nodeType":"text","text":"也躱到廚房裏，哭着不肯出門，但終於被他父親帶走","layout":{"rects":[{"x":0,"y":2352,"width":368,"height":24}]}},{"nodeType":"text","text":"了。他後來還託他的父親帶給我一包貝殼和幾枝很好","layout":{"rects":[{"x":0,"y":2376,"width":368,"height":24}]}},{"nodeType":"text","text":"看的鳥毛，我也曾送他一兩次東西，但從此沒有再見","layout":{"rects":[{"x":0,"y":2400,"width":368,"height":24}]}},{"nodeType":"text","text":"面。","layout":{"rects":[{"x":0,"y":2424,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2448,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"現在我的母親提起了他，我這兒時的記憶，忽而全都","layout":{"rects":[{"x":0,"y":2448,"width":368,"height":24}]}},{"nodeType":"text","text":"閃電似的蘇生過來，似乎看到了我的美麗的故鄕了。","layout":{"rects":[{"x":0,"y":2472,"width":368,"height":24}]}},{"nodeType":"text","text":"我應聲說：","layout":{"rects":[{"x":0,"y":2496,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2520,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『這好極！他，——怎樣？……』","layout":{"rects":[{"x":0,"y":2520,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2544,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『他？……他景況也很不如意……』母親說着，便向","layout":{"rects":[{"x":0,"y":2544,"width":368,"height":24}]}},{"nodeType":"text","text":"房外看，『這些人又來了。說是買木器，順手也就隨","layout":{"rects":[{"x":0,"y":2568,"width":368,"height":24}]}},{"nodeType":"text","text":"便拿走的，我得去看看。』","layout":{"rects":[{"x":0,"y":2592,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2616,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"母親站起身，出去了。門外有幾個女人的聲音，我便","layout":{"rects":[{"x":0,"y":2616,"width":368,"height":24}]}},{"nodeType":"text","text":"招宏兒走近面前，和他閒話：問他可會寫字，可願意","layout":{"rects":[{"x":0,"y":2640,"width":368,"height":24}]}},{"nodeType":"text","text":"出門。","layout":{"rects":[{"x":0,"y":2664,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2688,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『我們坐火車去麽？』","layout":{"rects":[{"x":0,"y":2688,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2712,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『我們坐火車去。』","layout":{"rects":[{"x":0,"y":2712,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2736,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『船呢？』","layout":{"rects":[{"x":0,"y":2736,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2760,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『先坐船，……』","layout":{"rects":[{"x":0,"y":2760,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2784,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『哈！這模樣了！鬍子這麽長了！』一種尖利的怪聲","layout":{"rects":[{"x":0,"y":2784,"width":368,"height":24}]}},{"nodeType":"text","text":"突然大叫起來。","layout":{"rects":[{"x":0,"y":2808,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2832,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我喫了一嚇，趕忙擡起頭，卻見一個凸顴骨，薄嘴","layout":{"rects":[{"x":0,"y":2832,"width":352,"height":24}]}},{"nodeType":"text","text":"唇，五十歲上下的女人站在我面前，兩手搭在髀間，","layout":{"rects":[{"x":0,"y":2856,"width":368,"height":24}]}},{"nodeType":"text","text":"沒有繫裙，張着兩脚，正像一個畫圖儀器裏細脚伶仃","layout":{"rects":[{"x":0,"y":2880,"width":368,"height":24}]}},{"nodeType":"text","text":"的圓規。","layout":{"rects":[{"x":0,"y":2904,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2928,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我愕然了。","layout":{"rects":[{"x":0,"y":2928,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2952,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『不認識了麽？我還抱你咧！』","layout":{"rects":[{"x":0,"y":2952,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2976,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我愈加愕然了。幸而我的母親也就進來，從旁說：","layout":{"rects":[{"x":0,"y":2976,"width":352,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3000,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『他多年出門，統忘卻了。你該記得罷，』便向着我","layout":{"rects":[{"x":0,"y":3000,"width":368,"height":24}]}},{"nodeType":"text","text":"說，『這是斜對門的楊二嫂，……開豆腐店的。』","layout":{"rects":[{"x":0,"y":3024,"width":352,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3048,"width":380,"height":216},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"哦，我記得了。我孩子時候，在斜對門的豆腐店裏確","layout":{"rects":[{"x":0,"y":3048,"width":368,"height":24}]}},{"nodeType":"text","text":"乎終日坐着一個楊二嫂，人都叫伊『豆腐西施』。但","layout":{"rects":[{"x":0,"y":3072,"width":368,"height":24}]}},{"nodeType":"text","text":"是擦着白粉，顴骨沒有這麽高，嘴脣也沒有這麽薄。","layout":{"rects":[{"x":0,"y":3096,"width":368,"height":24}]}},{"nodeType":"text","text":"而且終日坐着，我也從沒有見過這圓規式的姿勢。那","layout":{"rects":[{"x":0,"y":3120,"width":368,"height":24}]}},{"nodeType":"text","text":"時人說：因爲伊，這豆腐店的買賣非常好。但這大約","layout":{"rects":[{"x":0,"y":3144,"width":368,"height":24}]}},{"nodeType":"text","text":"因爲年齡的關係，我卻並未蒙着一毫感化，所以竟完","layout":{"rects":[{"x":0,"y":3168,"width":368,"height":24}]}},{"nodeType":"text","text":"全忘卻了。然而圓規很不平，顯出鄙夷的神色，彷彿","layout":{"rects":[{"x":0,"y":3192,"width":368,"height":24}]}},{"nodeType":"text","text":"嗤笑法國人不知道拿破崙，美國人不知道華盛頓似","layout":{"rects":[{"x":0,"y":3216,"width":352,"height":24}]}},{"nodeType":"text","text":"的，冷笑說：","layout":{"rects":[{"x":0,"y":3240,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3264,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『忘了？這眞是貴人眼高。……』","layout":{"rects":[{"x":0,"y":3264,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3288,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『那有這事……我……』我惶恐着，站起來說。","layout":{"rects":[{"x":0,"y":3288,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3312,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『那麽，我對你說。迅哥兒，你闊了，搬動又笨重，","layout":{"rects":[{"x":0,"y":3312,"width":368,"height":24}]}},{"nodeType":"text","text":"你還要什麽這些破爛木器，讓我拿去罷。我們小戶人","layout":{"rects":[{"x":0,"y":3336,"width":368,"height":24}]}},{"nodeType":"text","text":"家，用得着。』","layout":{"rects":[{"x":0,"y":3360,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3384,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『我並沒有闊哩。我須賣了這些，再去……』","layout":{"rects":[{"x":0,"y":3384,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3408,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『阿呀呀，你放了道台了，還說不闊？你現在有三房","layout":{"rects":[{"x":0,"y":3408,"width":368,"height":24}]}},{"nodeType":"text","text":"姨太太；出門便是八擡的大轎，還說不闊？嚇，什麽","layout":{"rects":[{"x":0,"y":3432,"width":368,"height":24}]}},{"nodeType":"text","text":"都瞞不過我。』","layout":{"rects":[{"x":0,"y":3456,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3480,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我知道無話可說了，便閉了口，默默的站着。","layout":{"rects":[{"x":0,"y":3480,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3504,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『阿呀阿呀，眞是愈有錢，便愈是一毫不肯放鬆，愈","layout":{"rects":[{"x":0,"y":3504,"width":368,"height":24}]}},{"nodeType":"text","text":"是一毫不肯放鬆，便愈有錢……』圓規一面憤憤的回","layout":{"rects":[{"x":0,"y":3528,"width":368,"height":24}]}},{"nodeType":"text","text":"轉身，一面絮絮的說，慢慢向外走，順便將我母親的","layout":{"rects":[{"x":0,"y":3552,"width":368,"height":24}]}},{"nodeType":"text","text":"一副手套塞在褲腰裏，出去了。","layout":{"rects":[{"x":0,"y":3576,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3600,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"此後又有近處的本家和親戚來訪問我。我一面應酬，","layout":{"rects":[{"x":0,"y":3600,"width":368,"height":24}]}},{"nodeType":"text","text":"偸空便收拾些行李，這樣的過了三四天。","layout":{"rects":[{"x":0,"y":3624,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3648,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"一日是天氣很冷的午後，我喫過午飯，坐着喝茶，覺","layout":{"rects":[{"x":0,"y":3648,"width":368,"height":24}]}},{"nodeType":"text","text":"得外面有人進來了，便回頭去看。我看時，不由的非","layout":{"rects":[{"x":0,"y":3672,"width":368,"height":24}]}},{"nodeType":"text","text":"常出驚，慌忙站起身，迎着走去。","layout":{"rects":[{"x":0,"y":3696,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3720,"width":380,"height":216},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"這來的便是閏土。雖然我一見便知道是閏土，但又不","layout":{"rects":[{"x":0,"y":3720,"width":368,"height":24}]}},{"nodeType":"text","text":"是我這記憶上的閏土了。他身材增加了一倍；先前的","layout":{"rects":[{"x":0,"y":3744,"width":368,"height":24}]}},{"nodeType":"text","text":"紫色的圓臉，已經變作灰黃，而且加上了很深的皺","layout":{"rects":[{"x":0,"y":3768,"width":352,"height":24}]}},{"nodeType":"text","text":"紋；眼睛也像他父親一樣，周圍都腫得通紅，這我知","layout":{"rects":[{"x":0,"y":3792,"width":368,"height":24}]}},{"nodeType":"text","text":"道，在海邊種地的人，終日吹着海風，大抵是這樣","layout":{"rects":[{"x":0,"y":3816,"width":352,"height":24}]}},{"nodeType":"text","text":"的。他頭上是一頂破氈帽，身上只一件極薄的棉衣，","layout":{"rects":[{"x":0,"y":3840,"width":368,"height":24}]}},{"nodeType":"text","text":"渾身瑟索着；手裏提着一個紙包和一枝長煙管，那手","layout":{"rects":[{"x":0,"y":3864,"width":368,"height":24}]}},{"nodeType":"text","text":"也不是我所記得的紅活圓實的手，卻又粗又笨而且開","layout":{"rects":[{"x":0,"y":3888,"width":368,"height":24}]}},{"nodeType":"text","text":"裂，像是松樹皮了。","layout":{"rects":[{"x":0,"y":3912,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3936,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我這時很興奮，但不知道怎麽說纔好，只是說：","layout":{"rects":[{"x":0,"y":3936,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3960,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『阿！閏土哥，——你來了？……』","layout":{"rects":[{"x":0,"y":3960,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3984,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我接着便有許多話，想要連珠一般湧出：角雞、跳魚","layout":{"rects":[{"x":0,"y":3984,"width":368,"height":24}]}},{"nodeType":"text","text":"兒、貝殼、猹，……但又總覺得被什麽擋着似的。單","layout":{"rects":[{"x":0,"y":4008,"width":368,"height":24}]}},{"nodeType":"text","text":"在腦裏面回旋，吐不出口外去。","layout":{"rects":[{"x":0,"y":4032,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4056,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"他站住了，臉上現出歡喜和淒涼的神情；動着嘴脣，","layout":{"rects":[{"x":0,"y":4056,"width":368,"height":24}]}},{"nodeType":"text","text":"卻沒有作聲。他的態度終於恭敬起來了，分明的叫","layout":{"rects":[{"x":0,"y":4080,"width":352,"height":24}]}},{"nodeType":"text","text":"道：","layout":{"rects":[{"x":0,"y":4104,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4128,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『老爺！……』","layout":{"rects":[{"x":0,"y":4128,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4152,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我似乎打了一個寒噤；我就知道，我們之間已經隔了","layout":{"rects":[{"x":0,"y":4152,"width":368,"height":24}]}},{"nodeType":"text","text":"一層可悲的厚障壁了。我也說不出話。","layout":{"rects":[{"x":0,"y":4176,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4200,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"他回過頭去說：『水生，給老爺磕頭。』便拖出躱在","layout":{"rects":[{"x":0,"y":4200,"width":368,"height":24}]}},{"nodeType":"text","text":"背後的孩子來，這正是一個二十年前的閏土，只是黃","layout":{"rects":[{"x":0,"y":4224,"width":368,"height":24}]}},{"nodeType":"text","text":"瘦些，頸子上沒有銀圈罷了。『這是第五個孩子，沒","layout":{"rects":[{"x":0,"y":4248,"width":368,"height":24}]}},{"nodeType":"text","text":"有見過世面，躱躱閃閃。……』","layout":{"rects":[{"x":0,"y":4272,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4296,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"母親和宏兒下樓來了，他們大約也聽到了聲音。","layout":{"rects":[{"x":0,"y":4296,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4320,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『老太太。信是早收到了。我實在喜歡的了不得，知","layout":{"rects":[{"x":0,"y":4320,"width":368,"height":24}]}},{"nodeType":"text","text":"道老爺回來……』閏土說。","layout":{"rects":[{"x":0,"y":4344,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4368,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『阿，你怎的這樣客氣起來。你們先前不是哥弟稱呼","layout":{"rects":[{"x":0,"y":4368,"width":368,"height":24}]}},{"nodeType":"text","text":"麽？還是照舊：迅哥兒。』母親高興的說。","layout":{"rects":[{"x":0,"y":4392,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4416,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『阿呀，老太太眞是……這成什麽規矩。那時是孩","layout":{"rects":[{"x":0,"y":4416,"width":352,"height":24}]}},{"nodeType":"text","text":"子，不懂事……』閏土說着，又叫水生上來打拱，那","layout":{"rects":[{"x":0,"y":4440,"width":368,"height":24}]}},{"nodeType":"text","text":"孩子卻害羞，緊緊的只貼在他背後。","layout":{"rects":[{"x":0,"y":4464,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4488,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『他就是水生？第五個？都是生人，怕生也難怪的；","layout":{"rects":[{"x":0,"y":4488,"width":368,"height":24}]}},{"nodeType":"text","text":"還是宏兒和他去走走。』母親說。","layout":{"rects":[{"x":0,"y":4512,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4536,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"宏兒聽得這話，便來招水生，水生卻鬆鬆爽爽同他一","layout":{"rects":[{"x":0,"y":4536,"width":368,"height":24}]}},{"nodeType":"text","text":"路出去了。母親叫閏土坐，他遲疑了一回，終於就了","layout":{"rects":[{"x":0,"y":4560,"width":368,"height":24}]}},{"nodeType":"text","text":"坐，將長煙管靠在桌旁，遞過紙包來，說：","layout":{"rects":[{"x":0,"y":4584,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4608,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『冬天沒有什麽東西了。這一點乾靑豆倒是自家曬在","layout":{"rects":[{"x":0,"y":4608,"width":368,"height":24}]}},{"nodeType":"text","text":"那里的，請老爺……』","layout":{"rects":[{"x":0,"y":4632,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4656,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我問問他的景況。他只是搖頭。","layout":{"rects":[{"x":0,"y":4656,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4680,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『非常難。第六個孩子也會幫忙了，卻總是喫不","layout":{"rects":[{"x":0,"y":4680,"width":336,"height":24}]}},{"nodeType":"text","text":"够……又不太平……什麽地方都要錢，沒有定規……","layout":{"rects":[{"x":0,"y":4704,"width":368,"height":24}]}},{"nodeType":"text","text":"收成又壞。種出東西來，挑去賣，總要捐幾回錢，折","layout":{"rects":[{"x":0,"y":4728,"width":368,"height":24}]}},{"nodeType":"text","text":"了本；不去賣，又只能爛掉。……』","layout":{"rects":[{"x":0,"y":4752,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4776,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"他只是搖頭；臉上雖然刻着許多皺紋，卻全然不動，","layout":{"rects":[{"x":0,"y":4776,"width":368,"height":24}]}},{"nodeType":"text","text":"彷彿石像一般。他大約只是覺得苦，卻又形容不出，","layout":{"rects":[{"x":0,"y":4800,"width":368,"height":24}]}},{"nodeType":"text","text":"沈默了片時，便拿起煙管來默默的吸煙了。","layout":{"rects":[{"x":0,"y":4824,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4848,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"母親問他，知道他的家裏事務忙，明天便得回去；又","layout":{"rects":[{"x":0,"y":4848,"width":368,"height":24}]}},{"nodeType":"text","text":"沒有喫過午飯，便叫他自己到廚下炒飯喫去。","layout":{"rects":[{"x":0,"y":4872,"width":320,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4896,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"他出去了；母親和我都歎息他的景況：多子、饑荒、","layout":{"rects":[{"x":0,"y":4896,"width":368,"height":24}]}},{"nodeType":"text","text":"苛稅、兵、匪、官、紳，都苦得他像一個木偶人了。","layout":{"rects":[{"x":0,"y":4920,"width":368,"height":24}]}},{"nodeType":"text","text":"母親對我說，凡是不必搬走的東西，儘可以送他，可","layout":{"rects":[{"x":0,"y":4944,"width":368,"height":24}]}},{"nodeType":"text","text":"以聽他自己去揀擇。","layout":{"rects":[{"x":0,"y":4968,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4992,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下午，他揀好了幾件東西：兩條長桌，四個椅子，一","layout":{"rects":[{"x":0,"y":4992,"width":368,"height":24}]}},{"nodeType":"text","text":"副香爐和燭臺，一桿擡秤。他又要所有的草灰（我們","layout":{"rects":[{"x":0,"y":5016,"width":368,"height":24}]}},{"nodeType":"text","text":"這裏煑飯是燒稻草的，那灰，可以做沙地的肥料），","layout":{"rects":[{"x":0,"y":5040,"width":368,"height":24}]}},{"nodeType":"text","text":"待我們啓程的時候，他用船來載去。","layout":{"rects":[{"x":0,"y":5064,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5088,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"夜間，我們又談些閒天，都是無關緊要的話；第二天","layout":{"rects":[{"x":0,"y":5088,"width":368,"height":24}]}},{"nodeType":"text","text":"早晨，他就領了水生回去了。","layout":{"rects":[{"x":0,"y":5112,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5136,"width":380,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"又過了九日，是我們啓程的日期。閏土早晨便到了，","layout":{"rects":[{"x":0,"y":5136,"width":368,"height":24}]}},{"nodeType":"text","text":"水生沒有同來，卻只帶着一個五歲的女兒管船隻。我","layout":{"rects":[{"x":0,"y":5160,"width":368,"height":24}]}},{"nodeType":"text","text":"們終日很忙碌，再沒有談天的工夫。來客也不少，有","layout":{"rects":[{"x":0,"y":5184,"width":368,"height":24}]}},{"nodeType":"text","text":"送行的，有拿東西的，有送行兼拿東西的。待到傍晚","layout":{"rects":[{"x":0,"y":5208,"width":368,"height":24}]}},{"nodeType":"text","text":"我們上船的時候，這老屋裏的所有破舊大小粗細東","layout":{"rects":[{"x":0,"y":5232,"width":352,"height":24}]}},{"nodeType":"text","text":"西，已經一掃而空了。","layout":{"rects":[{"x":0,"y":5256,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5280,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我們的船向前走，兩岸的靑山在黃昏中，都裝成了深","layout":{"rects":[{"x":0,"y":5280,"width":368,"height":24}]}},{"nodeType":"text","text":"黛顏色，連着退向船後梢去。","layout":{"rects":[{"x":0,"y":5304,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5328,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"宏兒和我靠着船窗，同看外面模糊的風景，他忽然問","layout":{"rects":[{"x":0,"y":5328,"width":368,"height":24}]}},{"nodeType":"text","text":"道：","layout":{"rects":[{"x":0,"y":5352,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5376,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『大伯！我們甚麽時候回來？』","layout":{"rects":[{"x":0,"y":5376,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5400,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『回來？你怎麽還沒有走就想回來了。』","layout":{"rects":[{"x":0,"y":5400,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5424,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"『可是，水生約我到他家玩去咧……』他睜着大的黑","layout":{"rects":[{"x":0,"y":5424,"width":368,"height":24}]}},{"nodeType":"text","text":"眼睛，癡癡的想。","layout":{"rects":[{"x":0,"y":5448,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5472,"width":380,"height":216},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我和母親也都有些惘然，於是又提起閏土來。母親","layout":{"rects":[{"x":0,"y":5472,"width":352,"height":24}]}},{"nodeType":"text","text":"說：那豆腐西施的楊二嫂，自從我家收拾行李以來，","layout":{"rects":[{"x":0,"y":5496,"width":368,"height":24}]}},{"nodeType":"text","text":"本是每日必到的，前天伊在灰堆裏，掏出十多個碗碟","layout":{"rects":[{"x":0,"y":5520,"width":368,"height":24}]}},{"nodeType":"text","text":"來，議論之後，便定說是閏土埋着的，他可以在運灰","layout":{"rects":[{"x":0,"y":5544,"width":368,"height":24}]}},{"nodeType":"text","text":"的時候，一齊搬回家裏去；楊二嫂發見了這件事，自","layout":{"rects":[{"x":0,"y":5568,"width":368,"height":24}]}},{"nodeType":"text","text":"己很以爲功，便拿了那狗氣殺（這是我們這裏養雞的","layout":{"rects":[{"x":0,"y":5592,"width":368,"height":24}]}},{"nodeType":"text","text":"器具，木盤上面有着柵欄，內盛食料，雞可以伸進頸","layout":{"rects":[{"x":0,"y":5616,"width":368,"height":24}]}},{"nodeType":"text","text":"子去啄，狗卻不能，只能看着氣死），飛也似的跑","layout":{"rects":[{"x":0,"y":5640,"width":352,"height":24}]}},{"nodeType":"text","text":"了，虧伊裝着這麽高底的小脚，竟跑得這樣快。","layout":{"rects":[{"x":0,"y":5664,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5688,"width":380,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老屋離我愈遠了；故鄕的山水也都漸漸遠離了我，但","layout":{"rects":[{"x":0,"y":5688,"width":368,"height":24}]}},{"nodeType":"text","text":"我卻並不感到怎樣的留戀。我只覺得我四面有看不見","layout":{"rects":[{"x":0,"y":5712,"width":368,"height":24}]}},{"nodeType":"text","text":"的高牆，將我隔成孤身，使我非常氣悶；那西瓜地上","layout":{"rects":[{"x":0,"y":5736,"width":368,"height":24}]}},{"nodeType":"text","text":"的銀項圈的小英雄的影象，我本來十分淸楚，現在卻","layout":{"rects":[{"x":0,"y":5760,"width":368,"height":24}]}},{"nodeType":"text","text":"忽地模糊了，又使我非常的悲哀。","layout":{"rects":[{"x":0,"y":5784,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5808,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"母親和宏兒都睡着了。","layout":{"rects":[{"x":0,"y":5808,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5832,"width":380,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我躺着，聽船底潺潺的水聲，知道我在走我的路，我","layout":{"rects":[{"x":0,"y":5832,"width":368,"height":24}]}},{"nodeType":"text","text":"想：我竟與閏土隔絕到這地步了，但我們的後輩還是","layout":{"rects":[{"x":0,"y":5856,"width":368,"height":24}]}},{"nodeType":"text","text":"一氣，宏兒不是正在想念水生麽。我希望他們不再像","layout":{"rects":[{"x":0,"y":5880,"width":368,"height":24}]}},{"nodeType":"text","text":"我，又大家隔膜起來……然而我又不願意他們因爲要","layout":{"rects":[{"x":0,"y":5904,"width":368,"height":24}]}},{"nodeType":"text","text":"一氣，都如我的辛苦展轉而生活，也不願意他們都如","layout":{"rects":[{"x":0,"y":5928,"width":368,"height":24}]}},{"nodeType":"text","text":"閏土的辛苦麻木而生活，也不願意都如別人的辛苦恣","layout":{"rects":[{"x":0,"y":5952,"width":368,"height":24}]}},{"nodeType":"text","text":"睢而生活。他們應該有新的生活，爲我們所未經生活","layout":{"rects":[{"x":0,"y":5976,"width":368,"height":24}]}},{"nodeType":"text","text":"過的。","layout":{"rects":[{"x":0,"y":6000,"width":48,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6024,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我想到希望，忽然害怕起來了。閏土要香爐和燭臺的","layout":{"rects":[{"x":0,"y":6024,"width":368,"height":24}]}},{"nodeType":"text","text":"時候，我還暗地裏笑他，以爲他總是崇拜偶像，什麽","layout":{"rects":[{"x":0,"y":6048,"width":368,"height":24}]}},{"nodeType":"text","text":"時候都不忘卻。現在我所謂希望，不也是我自己手製","layout":{"rects":[{"x":0,"y":6072,"width":368,"height":24}]}},{"nodeType":"text","text":"的偶像麽？只是他的願望切近，我的願望茫遠罷了。","layout":{"rects":[{"x":0,"y":6096,"width":368,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6120,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"我在朦朧中，眼前展開一片海邊碧綠的沙地來，上面","layout":{"rects":[{"x":0,"y":6120,"width":368,"height":24}]}},{"nodeType":"text","text":"深藍的天空中掛着一輪金黃的圓月。我想：希望是本","layout":{"rects":[{"x":0,"y":6144,"width":368,"height":24}]}},{"nodeType":"text","text":"無所謂有，無所謂無的。這正如地上的路，其實地上","layout":{"rects":[{"x":0,"y":6168,"width":368,"height":24}]}},{"nodeType":"text","text":"本沒有路；走的人多了，也便成了路。","layout":{"rects":[{"x":0,"y":6192,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6216,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"（一九二一年一月。）","layout":{"rects":[{"x":0,"y":6216,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6240,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"1996年1月1日，这部作品在原著作國家或地區屬於公","layout":{"rects":[{"x":0,"y":6240,"width":373.28,"height":24}]}},{"nodeType":"text","text":"有領域，之前在美國從未出版，其作者1936年逝世，","layout":{"rects":[{"x":0,"y":6264,"width":371.53,"height":24}]}},{"nodeType":"text","text":"在美國以及版權期限是作者終身加80年以下的國家以","layout":{"rects":[{"x":0,"y":6288,"width":369.77,"height":24}]}},{"nodeType":"text","text":"及地区，屬於公有領域。","layout":{"rects":[{"x":0,"y":6312,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6336,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"这部作品也可能在本國本地版權期限更長，但對外國","layout":{"rects":[{"x":0,"y":6336,"width":368,"height":24}]}},{"nodeType":"text","text":"外地作品應用較短期限規則的國家以及地区，屬於公","layout":{"rects":[{"x":0,"y":6360,"width":368,"height":24}]}},{"nodeType":"text","text":"有領域。","layout":{"rects":[{"x":0,"y":6384,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6408,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Public domainPublic domainfalsefalse","layout":{"rects":[{"x":0,"y":6408,"width":286.25,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6432,"width":380,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"本作品現時在大中華兩岸地區因著作权保护条款过期","layout":{"rects":[{"x":0,"y":6432,"width":368,"height":24}]}},{"nodeType":"text","text":"而处于公有领域。根据《中华人民共和国著作权法》","layout":{"rects":[{"x":0,"y":6456,"width":368,"height":24}]}},{"nodeType":"text","text":"第二十一条第二款（司法管辖区为中国大陆，不包括","layout":{"rects":[{"x":0,"y":6480,"width":368,"height":24}]}},{"nodeType":"text","text":"香港和澳门）和中华民国的《著作权法》第三十三條","layout":{"rects":[{"x":0,"y":6504,"width":368,"height":24}]}},{"nodeType":"text","text":"（目前司法管辖区为台澎金马地区），所有著作权持","layout":{"rects":[{"x":0,"y":6528,"width":368,"height":24}]}},{"nodeType":"text","text":"有者为法人的作品，在首次发表50年后，或者从创作","layout":{"rects":[{"x":0,"y":6552,"width":369.77,"height":24}]}},{"nodeType":"text","text":"之日起50年未发表，即进入公有领域。其他适用作品","layout":{"rects":[{"x":0,"y":6576,"width":369.77,"height":24}]}},{"nodeType":"text","text":"则在作者死亡后50年进入公有领域。","layout":{"rects":[{"x":0,"y":6600,"width":257.77,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6624,"width":380,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"据《中华人民共和国著作权法释义》，法人作品应满","layout":{"rects":[{"x":0,"y":6624,"width":368,"height":24}]}},{"nodeType":"text","text":"足三点要求：（1）由法人（或其他组织，以下简称","layout":{"rects":[{"x":0,"y":6648,"width":360.89,"height":24}]}},{"nodeType":"text","text":"“法人”）主持创作，而非工作人员自发进行；（2）","layout":{"rects":[{"x":0,"y":6672,"width":376.89,"height":24}]}},{"nodeType":"text","text":"创作思想及表达方式体现法人意志；（3）由法人负","layout":{"rects":[{"x":0,"y":6696,"width":360.89,"height":24}]}},{"nodeType":"text","text":"责，而非执笔者。（详情）","layout":{"rects":[{"x":0,"y":6720,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6744,"width":380,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"鲁迅《故鄉》最初发表于1921年5月1日《新青年》第","layout":{"rects":[{"x":0,"y":6744,"width":373.28,"height":24}]}},{"nodeType":"text","text":"九卷第一號。《鲁迅全集》由鲁迅先生纪念委员会编","layout":{"rects":[{"x":0,"y":6768,"width":368,"height":24}]}},{"nodeType":"text","text":"印于1938年。","layout":{"rects":[{"x":0,"y":6792,"width":99.53,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6816,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Public domainPublic domainfalsefalse","layout":{"rects":[{"x":0,"y":6816,"width":286.25,"height":24}]}}]}]}]}]}}