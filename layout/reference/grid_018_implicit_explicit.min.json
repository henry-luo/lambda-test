{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":300},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n    ","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n    ","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n    ","layout":{"rects":[]}},{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"Test: Grid Implicit vs Explicit","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n    ","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n        /* Reset for consistency */\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Arial', sans-serif; font-size: 16px; }\n        \n        /* Test-specific CSS */\n        .container {\n            width: 400px;\n            height: 300px;\n            display: grid;\n            grid-template-columns: repeat(2, 100px);\n            grid-template-rows: repeat(2, 80px);\n            grid-auto-columns: 120px;\n            grid-auto-rows: 60px;\n            gap: 10px;\n            border: 2px solid #333;\n            padding: 10px;\n        }\n        .item {\n            padding: 10px;\n            box-sizing: border-box;\n            text-align: center;\n            font-size: 12px;\n            border: 2px dashed #666;\n        }\n        /* Explicit grid items */\n        .item:nth-child(1) { background-color: #ffcccc; }\n        .item:nth-child(2) { background-color: #ccffcc; }\n        .item:nth-child(3) { background-color: #ccccff; }\n        .item:nth-child(4) { background-color: #ffffcc; }\n        \n        /* Implicit grid items */\n        .item:nth-child(5) { \n            background-color: #ffccff; \n            grid-column: 3;\n            grid-row: 1;\n        }\n        .item:nth-child(6) { \n            background-color: #ccffff; \n            grid-column: 1;\n            grid-row: 3;\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":300},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":400,"height":300},"computed":{"display":"grid","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":12,"y":12,"width":100,"height":80},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Explicit 1","layout":{"rects":[{"x":37.98,"y":24,"width":48.03,"height":14}]}}]},{"nodeType":"element","tag":"div","layout":{"x":122,"y":12,"width":100,"height":80},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Explicit 2","layout":{"rects":[{"x":147.98,"y":24,"width":48.03,"height":14}]}}]},{"nodeType":"element","tag":"div","layout":{"x":12,"y":102,"width":100,"height":80},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Explicit 3","layout":{"rects":[{"x":37.98,"y":114,"width":48.03,"height":14}]}}]},{"nodeType":"element","tag":"div","layout":{"x":122,"y":102,"width":100,"height":80},"computed":{"display":"block","textAlign":"center"},"children":[{"nodeType":"text","text":"Explicit 4","layout":{"rects":[{"x":147.98,"y":114,"width