gers, and views, is contained in a single ","layout":{"rects":[{"x":8,"y":351.06,"width":780.92,"height":19}]}},{"nodeType":"text","text":"disk file.\nThe database ","layout":{"rects":[{"x":8,"y":370.06,"width":186.88,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":194.88,"y":370.06,"width":83.2,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"file format","layout":{"rects":[{"x":194.88,"y":370.06,"width":83.2,"height":19}]}}]},{"nodeType":"text","text":" is cross-platform - you can freely copy a database\nbetween ","layout":{"rects":[{"x":278.08,"y":370.06,"width":483.75,"height":19}]}},{"nodeType":"text","text":"32-bit and 64-bit systems or between \n","layout":{"rects":[{"x":8,"y":389.06,"width":310.5,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":318.5,"y":389.06,"width":85.34,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"big-endian","layout":{"rects":[{"x":318.5,"y":389.06,"width":85.34,"height":19}]}}]},{"nodeType":"text","text":" and\n","layout":{"rects":[{"x":403.84,"y":389.06,"width":40.95,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":444.8,"y":389.06,"width":96.33,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"little-endian","layout":{"rects":[{"x":444.8,"y":389.06,"width":96.33,"height":19}]}}]},{"nodeType":"text","text":"\narchitectures.  These features ","layout":{"rects":[{"x":541.13,"y":389.06,"width":240.56,"height":19}]}},{"nodeType":"text","text":"make SQLite a popular choice as\nan ","layout":{"rects":[{"x":8,"y":408.06,"width":294.38,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":302.38,"y":408.06,"width":183.72,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"Application File Format","layout":{"rects":[{"x":302.38,"y":408.06,"width":183.72,"height":19}]}}]},{"nodeType":"text","text":".  SQLite database files are a\n","layout":{"rects":[{"x":486.09,"y":408.06,"width":227.41,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":8,"y":427.06,"width":239.56,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"recommended storage format","layout":{"rects":[{"x":8,"y":427.06,"width":239.56,"height":19}]}}]},{"nodeType":"text","text":" by the US Library of Congress.\nThink of SQLite not as a ","layout":{"rects":[{"x":247.56,"y":427.06,"width":452.06,"height":19}]}},{"nodeType":"text","text":"replacement for \n","layout":{"rects":[{"x":8,"y":446.06,"width":133.14,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":141.14,"y":446.06,"width":51.02,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"Oracle","layout":{"rects":[{"x":141.14,"y":446.06,"width":51.02,"height":19}]}}]},{"nodeType":"text","text":" but\nas a replacement for ","layout":{"rects":[{"x":192.16,"y":446.06,"width":209.59,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":401.75,"y":446.06,"width":59.5,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"fopen()","layout":{"rects":[{"x":401.75,"y":446.06,"width":59.5,"height":19}]}}]}]},{"nodeType":"element","tag":"p","layout":{"x":8,"y":481.06,"width":1184,"height":133},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"SQLite is a compact library.\nWith all features enabled, the ","layout":{"rects":[{"x":8,"y":481.06,"width":470.45,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":478.45,"y":481.06,"width":87.41,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"library size","layout":{"rects":[{"x":478.45,"y":481.06,"width":87.41,"height":19}]}}]},{"nodeType":"text","text":" can be less than 900KiB,\n","layout":{"rects":[{"x":565.86,"y":481.06,"width":205.08,"height":19}]}},{"nodeType":"text","text":"depending on the target platform and compiler optimization settings.\n(64-bit code is larger.  And ","layout":{"rects":[{"x":8,"y":500.06,"width":773.02,"height":19}]}},{"nodeType":"text","text":"some compiler optimizations\nsuch as aggressive function inlining and loop unrolling can cause ","layout":{"rects":[{"x":8,"y":519.06,"width":757.47,"height":19}]}},{"nodeType":"text","text":"the\nobject code to be much larger.)\nThere is a tradeoff between memory usage and speed. ","layout":{"rects":[{"x":8,"y":538.06,"width":731.2,"height":19}]}},{"nodeType":"text","text":" \nSQLite generally runs faster the more memory\nyou give it.  Nevertheless, performance is usually ","layout":{"rects":[{"x":8,"y":557.06,"width":774.55,"height":19}]}},{"nodeType":"text","text":"quite good even\nin low-memory environments.  Depending on how it is used, SQLite can be\n","layout":{"rects":[{"x":8,"y":576.06,"width":734.28,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":8,"y":595.06,"width":258.22,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"faster than direct filesystem I/O","layout":{"rects":[{"x":8,"y":595.06,"width":258.22,"height":19}]}}]},{"nodeType":"text","text":".","layout":{"rects":[{"x":266.22,"y":595.06,"width":5.7,"height":19}]}}]},{"nodeType":"element","tag":"p","layout":{"x":8,"y":630.06,"width":1184,"height":114},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"SQLite is \n","layout":{"rects":[{"x":8,"y":630.06,"width":76.64,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":84.64,"y":630.06,"width":164.69,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"very carefully tested","layout":{"rects":[{"x":84.64,"y":630.06,"width":164.69,"height":19}]}}]},{"nodeType":"text","text":" prior to every\nrelease and has a reputation for being very reliable.\nMost of the SQLite source code is devoted purely ","layout":{"rects":[{"x":249.33,"y":630.06,"width":939.95,"height":19}]}},{"nodeType":"text","text":"to testing and\nverification.  An automated test suite runs millions and millions of\ntest cases involving hundreds of millions of individual SQL ","layout":{"rects":[{"x":8,"y":649.06,"width":1115.81,"height":19}]}},{"nodeType":"text","text":"statements\nand achieves ","layout":{"rects":[{"x":8,"y":668.06,"width":205.72,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":213.72,"y":668.06,"width":222.25,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"100% branch test coverage","layout":{"rects":[{"x":213.72,"y":668.06,"width":222.25,"height":19}]}}]},{"nodeType":"text","text":".  \nSQLite responds gracefully to memory\nallocation failures and disk I/O errors.  Transactions ","layout":{"rects":[{"x":435.97,"y":668.06,"width":736.95,"height":19}]}},{"nodeType":"text","text":"are\n","layout":{"rects":[{"x":8,"y":687.06,"width":31.59,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":39.59,"y":687.06,"width":41.17,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"ACID","layout":{"rects":[{"x":39.59,"y":687.06,"width":41.17,"height":19}]}}]},{"nodeType":"text","text":"\neven if interrupted by system crashes or power failures.  \nAll of this is verified by\nthe automated tests using special test harnesses which ","layout":{"rects":[{"x":80.77,"y":687.06,"width":1098.14,"height":19}]}},{"nodeType":"text","text":"simulate \nsystem failures.\nOf course, even with all this testing, there are still bugs.\nBut unlike some similar projects (especially commercial ","layout":{"rects":[{"x":8,"y":706.06,"width":1114.86,"height":19}]}},{"nodeType":"text","text":"competitors)\nSQLite is open and honest about all bugs and provides\n","layout":{"rects":[{"x":8,"y":725.06,"width":552.98,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":560.98,"y":725.06,"width":75.78,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"bugs lists","layout":{"rects":[{"x":560.98,"y":725.06,"width":75.78,"height":19}]}}]},{"nodeType":"text","text":" and\nminute-by-minute ","layout":{"rects":[{"x":636.77,"y":725.06,"width":192.28,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":829.05,"y":725.06,"width":101.17,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"\nchronologies","layout":{"rects":[{"x":829.05,"y":725.06,"width":101.17,"height":19}]}}]},{"nodeType":"text","text":" of code changes.","layout":{"rects":[{"x":930.22,"y":725.06,"width":141.61,"height":19}]}}]},{"nodeType":"element","tag":"p","layout":{"x":8,"y":760.06,"width":1184,"height":57},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"The SQLite code base is supported by an\n","layout":{"rects":[{"x":8,"y":760.06,"width":334.78,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":342.78,"y":760.06,"width":148.08,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"international team","layout":{"rects":[{"x":342.78,"y":760.06,"width":148.08,"height":19}]}}]},{"nodeType":"text","text":" of developers who work on\nSQLite full-time.\nThe developers continue to expand the ","layout":{"rects":[{"x":490.86,"y":760.06,"width":679.47,"height":19}]}},{"nodeType":"text","text":"capabilities of SQLite\nand enhance its reliability and performance while maintaining\nbackwards compatibility with the \n","layout":{"rects":[{"x":8,"y":779.06,"width":946.45,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":954.45,"y":779.06,"width":194.52,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"published interface spec","layout":{"rects":[{"x":954.45,"y":779.06,"width":194.52,"height":19}]}}]},{"nodeType":"text","text":",\n","layout":{"rects":[{"x":1148.97,"y":779.06,"width":5.83,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":8,"y":798.06,"width":91.38,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"SQL syntax","layout":{"rects":[{"x":8,"y":798.06,"width":91.38,"height":19}]}}]},{"nodeType":"text","text":", and database ","layout":{"rects":[{"x":99.38,"y":798.06,"width":125.34,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":224.72,"y":798.06,"width":83.2,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"file format","layout":{"rects":[{"x":224.72,"y":798.06,"width":83.2,"height":19}]}}]},{"nodeType":"text","text":".\nThe source code is absolutely free to anybody who wants it,\nbut ","layout":{"rects":[{"x":307.92,"y":798.06,"width":532.3,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":840.22,"y":798.06,"width":163.44,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"professional support","layout":{"rects":[{"x":840.22,"y":798.06,"width":163.44,"height":19}]}}]},{"nodeType":"text","text":" is also available.","layout":{"rects":[{"x":1003.66,"y":798.06,"width":138,"height":19}]}}]},{"nodeType":"element","tag":"p","layout":{"x":8,"y":833.06,"width":1184,"height":38},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"The SQLite project was started on \n","layout":{"rects":[{"x":8,"y":833.06,"width":279.72,"height":19}]}},{"nodeType":"element","tag":"a","layout":{"x":287.72,"y":833.06,"width":95.91,"height":19},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"2000-05-09","layout":{"rects":[{"x":287.72,"y":833.06,"width":95.91,"height":19}]}}]},{"nodeType":"text","text":".\nThe future is always hard to predict, but the intent of the developers\nis to support SQLite through ","layout":{"rects":[{"x":383.63,"y":833.06,"width":799.17,"height":19}]}},{"nodeType":"text","text":"the year 2050.  Design decisions are made\nwith that objective in mind.","layout":{"rects":[{"x":8,"y":852.06,"width":567.34,"height":19}]}}]},{"nodeType":"element","tag":"p","layout":{"x":8,"y":887.06,"width":1184,"height":57},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"We the developers hope that you find SQLite useful and we\nentreat you to use it well: to make good and beautiful products that\nare fast, reliable, ","layout":{"rects":[{"x":8,"y":887.06,"width":1175.97,"height":19}]}},{"nodeType":"text","text":"and simple to use.  Seek forgiveness for yourself\nas you forgive others.  And just as you have received SQLite for free,\nso also freely give, paying ","layout":{"rects":[{"x":8,"y":906.06,"width":1163.11,"height":19}]}},{"nodeType":"text","text":"the debt forward.","layout":{"rects":[{"x":8,"y":925.06,"width":140.31,"height":19}]}}]},{"nodeType":"element","tag":"p","layout":{"x":8,"y":960.06,"width":1184,"height":19},"computed":{"display":"block","textAlign":"-webkit-center"},"children":[{"nodeType":"element","tag":"small","layout":{"x":417.3,"y":963.06,"width":365.39,"height":16},"computed":{"display":"inline","textAlign":"-webkit-center"},"children":[{"nodeType":"element","tag":"i","layout":{"x":417.3,"y":963.06,"width":365.39,"height":16},"computed":{"display":"inline","textAlign":"-webkit-center"},"children":[{"nodeType":"text","text":"This page was last updated on 2025-11-13 07:12:58Z ","layout":{"rects":[{"x":417.3,"y":963.06,"width":365.39,"height":16}]}}]}]}]}]}]}}