","layout":{"rects":[{"x":0,"y":24,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":48,"width":310,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"廣い門の下には、この男の外に誰もゐな","layout":{"rects":[{"x":0,"y":48,"width":288,"height":24}]}},{"nodeType":"text","text":"い。唯、所々丹塗の剝げた、大きな圓柱","layout":{"rects":[{"x":0,"y":72,"width":288,"height":24}]}},{"nodeType":"text","text":"に、蟋蟀が一匹とまつてゐる。羅生門が、","layout":{"rects":[{"x":0,"y":96,"width":304,"height":24}]}},{"nodeType":"text","text":"朱雀大路にある以上は、この男の外にも、","layout":{"rects":[{"x":0,"y":120,"width":304,"height":24}]}},{"nodeType":"text","text":"雨やみをする市女笠や揉烏帽子が、もう二","layout":{"rects":[{"x":0,"y":144,"width":304,"height":24}]}},{"nodeType":"text","text":"三人はありさうなものである。それが、こ","layout":{"rects":[{"x":0,"y":168,"width":304,"height":24}]}},{"nodeType":"text","text":"の男の外には誰もゐない。","layout":{"rects":[{"x":0,"y":192,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":216,"width":310,"height":408},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"何故かと云ふと、この二三年、京都には、","layout":{"rects":[{"x":0,"y":216,"width":304,"height":24}]}},{"nodeType":"text","text":"地震とか辻風とか火事とか饑饉とか云ふ災","layout":{"rects":[{"x":0,"y":240,"width":304,"height":24}]}},{"nodeType":"text","text":"がつゞいて起つた。そこで洛中のさびれ方","layout":{"rects":[{"x":0,"y":264,"width":304,"height":24}]}},{"nodeType":"text","text":"は一通りでない。舊記によると、佛像や佛","layout":{"rects":[{"x":0,"y":288,"width":304,"height":24}]}},{"nodeType":"text","text":"具を打碎いて、その丹がついたり、金銀の","layout":{"rects":[{"x":0,"y":312,"width":304,"height":24}]}},{"nodeType":"text","text":"箔がついたりした木を、路ばたにつみ重ね","layout":{"rects":[{"x":0,"y":336,"width":304,"height":24}]}},{"nodeType":"text","text":"て、薪の料に賣つてゐたと云ふ事である。","layout":{"rects":[{"x":0,"y":360,"width":304,"height":24}]}},{"nodeType":"text","text":"洛中がその始末であるから、羅生門の修理","layout":{"rects":[{"x":0,"y":384,"width":304,"height":24}]}},{"nodeType":"text","text":"などは、元より誰も捨てゝ顧る者がなかつ","layout":{"rects":[{"x":0,"y":408,"width":304,"height":24}]}},{"nodeType":"text","text":"た。するとその荒れ果てたのをよい事にし","layout":{"rects":[{"x":0,"y":432,"width":304,"height":24}]}},{"nodeType":"text","text":"て、狐狸が棲む。盜人が棲む。とうとうし","layout":{"rects":[{"x":0,"y":456,"width":304,"height":24}]}},{"nodeType":"text","text":"まひには、引取り手のない死人を、この門","layout":{"rects":[{"x":0,"y":480,"width":304,"height":24}]}},{"nodeType":"text","text":"へ持つて來て、棄てゝ行くと云ふ習慣さへ","layout":{"rects":[{"x":0,"y":504,"width":304,"height":24}]}},{"nodeType":"text","text":"出來た。そこで、日の目が見えなくなる","layout":{"rects":[{"x":0,"y":528,"width":288,"height":24}]}},{"nodeType":"text","text":"と、誰でも氣味を惡るがつて、この門の近","layout":{"rects":[{"x":0,"y":552,"width":304,"height":24}]}},{"nodeType":"text","text":"所へは足ぶみをしない事になつてしまつた","layout":{"rects":[{"x":0,"y":576,"width":304,"height":24}]}},{"nodeType":"text","text":"のである。","layout":{"rects":[{"x":0,"y":600,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":624,"width":310,"height":384},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その代り又鴉が何處からか、たくさん集つ","layout":{"rects":[{"x":0,"y":624,"width":304,"height":24}]}},{"nodeType":"text","text":"て來た。晝間見ると、その鴉が何羽となく","layout":{"rects":[{"x":0,"y":648,"width":304,"height":24}]}},{"nodeType":"text","text":"輪を描いて高い鴟尾のまはりを啼きなが","layout":{"rects":[{"x":0,"y":672,"width":288,"height":24}]}},{"nodeType":"text","text":"ら、飛びまはつてゐる。殊に門の上の空","layout":{"rects":[{"x":0,"y":696,"width":288,"height":24}]}},{"nodeType":"text","text":"が、夕燒けであかくなる時には、それが胡","layout":{"rects":[{"x":0,"y":720,"width":304,"height":24}]}},{"nodeType":"text","text":"麻をまいたやうにはつきり見えた。鴉は、","layout":{"rects":[{"x":0,"y":744,"width":304,"height":24}]}},{"nodeType":"text","text":"勿論、門の上にある死人の肉を、啄みに來","layout":{"rects":[{"x":0,"y":768,"width":304,"height":24}]}},{"nodeType":"text","text":"るのである。――尤も今日は、刻限が遲い","layout":{"rects":[{"x":0,"y":792,"width":304,"height":24}]}},{"nodeType":"text","text":"せいか、一羽も見えない。唯、所々、崩れ","layout":{"rects":[{"x":0,"y":816,"width":304,"height":24}]}},{"nodeType":"text","text":"かゝつた、さうしてその崩れ目に長い草の","layout":{"rects":[{"x":0,"y":840,"width":304,"height":24}]}},{"nodeType":"text","text":"はへた石段の上に、鴉の糞が、點々と白く","layout":{"rects":[{"x":0,"y":864,"width":304,"height":24}]}},{"nodeType":"text","text":"こびりついてゐるのが見える。下人は七段","layout":{"rects":[{"x":0,"y":888,"width":304,"height":24}]}},{"nodeType":"text","text":"ある石段の一番上の段に洗ひざらした紺の","layout":{"rects":[{"x":0,"y":912,"width":304,"height":24}]}},{"nodeType":"text","text":"襖の尻を据ゑて、右の頰に出來た、大きな","layout":{"rects":[{"x":0,"y":936,"width":304,"height":24}]}},{"nodeType":"text","text":"面皰を氣にしながら、ぼんやり、雨のふる","layout":{"rects":[{"x":0,"y":960,"width":304,"height":24}]}},{"nodeType":"text","text":"のを眺めてゐるのである。","layout":{"rects":[{"x":0,"y":984,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1008,"width":310,"height":528},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"作者はさつき、「下人が雨やみを待つてゐ","layout":{"rects":[{"x":0,"y":1008,"width":304,"height":24}]}},{"nodeType":"text","text":"た」と書いた。しかし、下人は、雨がやん","layout":{"rects":[{"x":0,"y":1032,"width":304,"height":24}]}},{"nodeType":"text","text":"でも格別どうしようと云ふ當てはない。ふ","layout":{"rects":[{"x":0,"y":1056,"width":304,"height":24}]}},{"nodeType":"text","text":"だんなら、勿論、主人の家へ歸る可き筈で","layout":{"rects":[{"x":0,"y":1080,"width":304,"height":24}]}},{"nodeType":"text","text":"ある。所がその主人からは、四五日前に暇","layout":{"rects":[{"x":0,"y":1104,"width":304,"height":24}]}},{"nodeType":"text","text":"を出された。前にも書いたやうに、當時京","layout":{"rects":[{"x":0,"y":1128,"width":304,"height":24}]}},{"nodeType":"text","text":"都の町は一通りならず衰微してゐた。今こ","layout":{"rects":[{"x":0,"y":1152,"width":304,"height":24}]}},{"nodeType":"text","text":"の下人が、永年、使はれてゐた主人から、","layout":{"rects":[{"x":0,"y":1176,"width":304,"height":24}]}},{"nodeType":"text","text":"暇を出されたのも、この衰微の小さな餘波","layout":{"rects":[{"x":0,"y":1200,"width":304,"height":24}]}},{"nodeType":"text","text":"に外ならない。だから「下人が雨やみを待","layout":{"rects":[{"x":0,"y":1224,"width":304,"height":24}]}},{"nodeType":"text","text":"つてゐた」と云ふよりも、「雨にふりこめ","layout":{"rects":[{"x":0,"y":1248,"width":304,"height":24}]}},{"nodeType":"text","text":"られた下人が、行き所がなくて、途方にく","layout":{"rects":[{"x":0,"y":1272,"width":304,"height":24}]}},{"nodeType":"text","text":"れてゐた」と云ふ方が、適當である。その","layout":{"rects":[{"x":0,"y":1296,"width":304,"height":24}]}},{"nodeType":"text","text":"上、今日の空模樣も少からずこの平安朝の","layout":{"rects":[{"x":0,"y":1320,"width":304,"height":24}]}},{"nodeType":"text","text":"下人の Sentimentalisme に影響した。申","layout":{"rects":[{"x":0,"y":1344,"width":294.36,"height":24}]}},{"nodeType":"text","text":"の刻下りからふり出した雨は、未に上るけ","layout":{"rects":[{"x":0,"y":1368,"width":304,"height":24}]}},{"nodeType":"text","text":"しきがない。そこで、下人は、何を措いて","layout":{"rects":[{"x":0,"y":1392,"width":304,"height":24}]}},{"nodeType":"text","text":"も差當り明日の暮しをどうにかしようとし","layout":{"rects":[{"x":0,"y":1416,"width":304,"height":24}]}},{"nodeType":"text","text":"て――云はゞどうにもならない事を、どう","layout":{"rects":[{"x":0,"y":1440,"width":304,"height":24}]}},{"nodeType":"text","text":"にかしようとして、とりとめもない考へを","layout":{"rects":[{"x":0,"y":1464,"width":304,"height":24}]}},{"nodeType":"text","text":"たどりながら、さつきから朱雀大路にふる","layout":{"rects":[{"x":0,"y":1488,"width":304,"height":24}]}},{"nodeType":"text","text":"雨の音を、聞くともなく聞いてゐた。","layout":{"rects":[{"x":0,"y":1512,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1536,"width":310,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"雨は、羅生門をつゝんで、遠くから、ざあ","layout":{"rects":[{"x":0,"y":1536,"width":304,"height":24}]}},{"nodeType":"text","text":"つと云ふ音をあつめて來る。夕闇は次第に","layout":{"rects":[{"x":0,"y":1560,"width":304,"height":24}]}},{"nodeType":"text","text":"空を低くして、見上げると、門の屋根が、","layout":{"rects":[{"x":0,"y":1584,"width":304,"height":24}]}},{"nodeType":"text","text":"斜につき出した甍の先に、重たくうす暗い","layout":{"rects":[{"x":0,"y":1608,"width":304,"height":24}]}},{"nodeType":"text","text":"雲を支へてゐる。","layout":{"rects":[{"x":0,"y":1632,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1656,"width":310,"height":360},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"どうにもならない事を、どうにかする爲に","layout":{"rects":[{"x":0,"y":1656,"width":304,"height":24}]}},{"nodeType":"text","text":"は、手段を選んでゐる遑はない。選んでゐ","layout":{"rects":[{"x":0,"y":1680,"width":304,"height":24}]}},{"nodeType":"text","text":"れば、築土の下か、道ばたの土の上で、饑","layout":{"rects":[{"x":0,"y":1704,"width":304,"height":24}]}},{"nodeType":"text","text":"死をするばかりである。さうして、この門","layout":{"rects":[{"x":0,"y":1728,"width":304,"height":24}]}},{"nodeType":"text","text":"の上へ持つて來て、犬のやうに棄てられて","layout":{"rects":[{"x":0,"y":1752,"width":304,"height":24}]}},{"nodeType":"text","text":"しまふばかりである。選ばないとすれば","layout":{"rects":[{"x":0,"y":1776,"width":288,"height":24}]}},{"nodeType":"text","text":"――下人の考へは、何度も同じ道を低徊し","layout":{"rects":[{"x":0,"y":1800,"width":304,"height":24}]}},{"nodeType":"text","text":"た揚句に、やつとこの局所へ逢着した。し","layout":{"rects":[{"x":0,"y":1824,"width":304,"height":24}]}},{"nodeType":"text","text":"かしこの「すれば」は、何時までたつて","layout":{"rects":[{"x":0,"y":1848,"width":288,"height":24}]}},{"nodeType":"text","text":"も、結局「すれば」であつた。下人は、手","layout":{"rects":[{"x":0,"y":1872,"width":304,"height":24}]}},{"nodeType":"text","text":"段を選ばないといふ事を肯定しながらも、","layout":{"rects":[{"x":0,"y":1896,"width":304,"height":24}]}},{"nodeType":"text","text":"この「すれば」のかたをつける爲に、當","layout":{"rects":[{"x":0,"y":1920,"width":288,"height":24}]}},{"nodeType":"text","text":"然、その後に來る可き「盜人になるより外","layout":{"rects":[{"x":0,"y":1944,"width":304,"height":24}]}},{"nodeType":"text","text":"に仕方がない」と云ふ事を、積極的に肯定","layout":{"rects":[{"x":0,"y":1968,"width":304,"height":24}]}},{"nodeType":"text","text":"する丈の、勇氣が出ずにゐたのである。","layout":{"rects":[{"x":0,"y":1992,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2016,"width":310,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、大きな嚏をして、それから、大儀","layout":{"rects":[{"x":0,"y":2016,"width":304,"height":24}]}},{"nodeType":"text","text":"さうに立上つた。夕冷えのする京都は、も","layout":{"rects":[{"x":0,"y":2040,"width":304,"height":24}]}},{"nodeType":"text","text":"う火桶が欲しい程の寒さである。風は門の","layout":{"rects":[{"x":0,"y":2064,"width":304,"height":24}]}},{"nodeType":"text","text":"柱と柱との間を、夕闇と共に遠慮なく、吹","layout":{"rects":[{"x":0,"y":2088,"width":304,"height":24}]}},{"nodeType":"text","text":"きぬける。丹塗の柱にとまつてゐた蟋蟀","layout":{"rects":[{"x":0,"y":2112,"width":288,"height":24}]}},{"nodeType":"text","text":"も、もうどこかへ行つてしまつた。","layout":{"rects":[{"x":0,"y":2136,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2160,"width":310,"height":288},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、頸をちゞめながら、山吹の汗衫に","layout":{"rects":[{"x":0,"y":2160,"width":304,"height":24}]}},{"nodeType":"text","text":"重ねた、紺の襖の肩を高くして門のまはり","layout":{"rects":[{"x":0,"y":2184,"width":304,"height":24}]}},{"nodeType":"text","text":"を見まはした。雨風の患のない、人目に","layout":{"rects":[{"x":0,"y":2208,"width":288,"height":24}]}},{"nodeType":"text","text":"かゝる惧のない、一晚樂にねられさうな所","layout":{"rects":[{"x":0,"y":2232,"width":304,"height":24}]}},{"nodeType":"text","text":"があれば、そこでともかくも、夜を明かさ","layout":{"rects":[{"x":0,"y":2256,"width":304,"height":24}]}},{"nodeType":"text","text":"うと思つたからである。すると、幸門の上","layout":{"rects":[{"x":0,"y":2280,"width":304,"height":24}]}},{"nodeType":"text","text":"の樓へ上る、幅の廣い、之も丹を塗つた梯","layout":{"rects":[{"x":0,"y":2304,"width":304,"height":24}]}},{"nodeType":"text","text":"子が眼についた。上なら、人がゐたにして","layout":{"rects":[{"x":0,"y":2328,"width":304,"height":24}]}},{"nodeType":"text","text":"も、どうせ死人ばかりである。下人は、そ","layout":{"rects":[{"x":0,"y":2352,"width":304,"height":24}]}},{"nodeType":"text","text":"こで腰にさげた聖柄の太刀が鞘走らないや","layout":{"rects":[{"x":0,"y":2376,"width":304,"height":24}]}},{"nodeType":"text","text":"うに氣をつけながら、藁草履をはいた足","layout":{"rects":[{"x":0,"y":2400,"width":288,"height":24}]}},{"nodeType":"text","text":"を、その梯子の一番下の段へふみかけた。","layout":{"rects":[{"x":0,"y":2424,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2448,"width":310,"height":408},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"それから、何分かの後である。羅生門の樓","layout":{"rects":[{"x":0,"y":2448,"width":304,"height":24}]}},{"nodeType":"text","text":"の上へ出る、幅の廣い梯子の中段に、一人","layout":{"rects":[{"x":0,"y":2472,"width":304,"height":24}]}},{"nodeType":"text","text":"の男が、猫のやうに身をちゞめて、息を殺","layout":{"rects":[{"x":0,"y":2496,"width":304,"height":24}]}},{"nodeType":"text","text":"しながら、上の容子を窺つてゐた。樓の上","layout":{"rects":[{"x":0,"y":2520,"width":304,"height":24}]}},{"nodeType":"text","text":"からさす火の光が、かすかに、その男の右","layout":{"rects":[{"x":0,"y":2544,"width":304,"height":24}]}},{"nodeType":"text","text":"の頰をぬらしてゐる。短い鬚の中に、赤く","layout":{"rects":[{"x":0,"y":2568,"width":304,"height":24}]}},{"nodeType":"text","text":"膿を持つた面皰のある頰である。下人は、","layout":{"rects":[{"x":0,"y":2592,"width":304,"height":24}]}},{"nodeType":"text","text":"始めから、この上にゐる者は、死人ばかり","layout":{"rects":[{"x":0,"y":2616,"width":304,"height":24}]}},{"nodeType":"text","text":"だと高を括つてゐた。それが、梯子を二三","layout":{"rects":[{"x":0,"y":2640,"width":304,"height":24}]}},{"nodeType":"text","text":"段上つて見ると、上では誰か火をとぼし","layout":{"rects":[{"x":0,"y":2664,"width":288,"height":24}]}},{"nodeType":"text","text":"て、しかもその火を其處此處と動かしてゐ","layout":{"rects":[{"x":0,"y":2688,"width":304,"height":24}]}},{"nodeType":"text","text":"るらしい。これは、その濁つた、黃いろい","layout":{"rects":[{"x":0,"y":2712,"width":304,"height":24}]}},{"nodeType":"text","text":"光が、隅々に蜘蛛の巢をかけた天井裏に、","layout":{"rects":[{"x":0,"y":2736,"width":304,"height":24}]}},{"nodeType":"text","text":"ゆれながら映つたので、すぐにそれと知れ","layout":{"rects":[{"x":0,"y":2760,"width":304,"height":24}]}},{"nodeType":"text","text":"たのである。この雨の夜に、この羅生門の","layout":{"rects":[{"x":0,"y":2784,"width":304,"height":24}]}},{"nodeType":"text","text":"上で、火をともしてゐるからは、どうせ唯","layout":{"rects":[{"x":0,"y":2808,"width":304,"height":24}]}},{"nodeType":"text","text":"の者ではない。","layout":{"rects":[{"x":0,"y":2832,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2856,"width":310,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、守宮のやうに足音をぬすんで、や","layout":{"rects":[{"x":0,"y":2856,"width":304,"height":24}]}},{"nodeType":"text","text":"つと急な梯子を、一番上の段まで這ふやう","layout":{"rects":[{"x":0,"y":2880,"width":304,"height":24}]}},{"nodeType":"text","text":"にして上りつめた。さうして體を出來る","layout":{"rects":[{"x":0,"y":2904,"width":288,"height":24}]}},{"nodeType":"text","text":"丈、平にしながら、頸を出來る丈、前へ出","layout":{"rects":[{"x":0,"y":2928,"width":304,"height":24}]}},{"nodeType":"text","text":"して、恐る恐る、樓の內を覗いて見た。","layout":{"rects":[{"x":0,"y":2952,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2976,"width":310,"height":384},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"見ると、樓の內には、噂に聞いた通り、幾","layout":{"rects":[{"x":0,"y":2976,"width":304,"height":24}]}},{"nodeType":"text","text":"つかの屍骸が、無造作に棄てゝあるが、火","layout":{"rects":[{"x":0,"y":3000,"width":304,"height":24}]}},{"nodeType":"text","text":"の光の及ぶ範圍が、思つたより狹いので、","layout":{"rects":[{"x":0,"y":3024,"width":304,"height":24}]}},{"nodeType":"text","text":"數は幾つともわからない。唯、おぼろげな","layout":{"rects":[{"x":0,"y":3048,"width":304,"height":24}]}},{"nodeType":"text","text":"がら、知れるのは、その中に裸の屍骸と、","layout":{"rects":[{"x":0,"y":3072,"width":304,"height":24}]}},{"nodeType":"text","text":"着物を着た屍骸とがあると云ふ事である。","layout":{"rects":[{"x":0,"y":3096,"width":304,"height":24}]}},{"nodeType":"text","text":"勿論、中には女も男もまじつてゐるらし","layout":{"rects":[{"x":0,"y":3120,"width":288,"height":24}]}},{"nodeType":"text","text":"い。さうして、その屍骸は皆、それが、","layout":{"rects":[{"x":0,"y":3144,"width":288,"height":24}]}},{"nodeType":"text","text":"甞、生きてゐた人間だと云ふ事實さへ疑は","layout":{"rects":[{"x":0,"y":3168,"width":304,"height":24}]}},{"nodeType":"text","text":"れる程、土を捏ねて造つた人形のやうに、","layout":{"rects":[{"x":0,"y":3192,"width":304,"height":24}]}},{"nodeType":"text","text":"口を開いたり手を延ばしたりしてごろごろ","layout":{"rects":[{"x":0,"y":3216,"width":304,"height":24}]}},{"nodeType":"text","text":"床の上にころがつてゐた。しかも、肩とか","layout":{"rects":[{"x":0,"y":3240,"width":304,"height":24}]}},{"nodeType":"text","text":"胸とかの高くなつてゐる部分に、ぼんやり","layout":{"rects":[{"x":0,"y":3264,"width":304,"height":24}]}},{"nodeType":"text","text":"した火の光をうけて、低くなつてゐる部分","layout":{"rects":[{"x":0,"y":3288,"width":304,"height":24}]}},{"nodeType":"text","text":"の影を一層暗くしながら、永久に啞の如く","layout":{"rects":[{"x":0,"y":3312,"width":304,"height":24}]}},{"nodeType":"text","text":"默つていた。","layout":{"rects":[{"x":0,"y":3336,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3360,"width":310,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、それらの屍骸の腐爛した臭氣に思","layout":{"rects":[{"x":0,"y":3360,"width":304,"height":24}]}},{"nodeType":"text","text":"はず、鼻を掩つた。しかし、その手は、次","layout":{"rects":[{"x":0,"y":3384,"width":304,"height":24}]}},{"nodeType":"text","text":"の瞬間には、もう鼻を掩ふ事を忘れてゐ","layout":{"rects":[{"x":0,"y":3408,"width":288,"height":24}]}},{"nodeType":"text","text":"た。或る强い感情が、殆悉この男の嗅覺を","layout":{"rects":[{"x":0,"y":3432,"width":304,"height":24}]}},{"nodeType":"text","text":"奪つてしまつたからである。","layout":{"rects":[{"x":0,"y":3456,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3480,"width":310,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人の眼は、その時、はじめて、其屍骸の","layout":{"rects":[{"x":0,"y":3480,"width":304,"height":24}]}},{"nodeType":"text","text":"中に蹲つている人間を見た。檜肌色の着物","layout":{"rects":[{"x":0,"y":3504,"width":304,"height":24}]}},{"nodeType":"text","text":"を著た、背の低い、瘦せた、白髮頭の、猿","layout":{"rects":[{"x":0,"y":3528,"width":304,"height":24}]}},{"nodeType":"text","text":"のやうな老婆である。その老婆は、右の手","layout":{"rects":[{"x":0,"y":3552,"width":304,"height":24}]}},{"nodeType":"text","text":"に火をともした松の木片を持つて、その屍","layout":{"rects":[{"x":0,"y":3576,"width":304,"height":24}]}},{"nodeType":"text","text":"骸の一つの顏を覗きこむやうに眺めてゐ","layout":{"rects":[{"x":0,"y":3600,"width":288,"height":24}]}},{"nodeType":"text","text":"た。髮の毛の長い所を見ると、多分女の屍","layout":{"rects":[{"x":0,"y":3624,"width":304,"height":24}]}},{"nodeType":"text","text":"骸であらう。","layout":{"rects":[{"x":0,"y":3648,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3672,"width":310,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、六分の恐怖と四分の好奇心とに動","layout":{"rects":[{"x":0,"y":3672,"width":304,"height":24}]}},{"nodeType":"text","text":"かされて、暫時は呼吸をするのさへ忘れて","layout":{"rects":[{"x":0,"y":3696,"width":304,"height":24}]}},{"nodeType":"text","text":"ゐた。舊記の記者の語を借りれば、「頭身","layout":{"rects":[{"x":0,"y":3720,"width":304,"height":24}]}},{"nodeType":"text","text":"の毛も太る」やうに感じたのである。する","layout":{"rects":[{"x":0,"y":3744,"width":304,"height":24}]}},{"nodeType":"text","text":"と、老婆は、松の木片を、床板の間に挿し","layout":{"rects":[{"x":0,"y":3768,"width":304,"height":24}]}},{"nodeType":"text","text":"て、それから、今まで眺めてゐた屍骸の首","layout":{"rects":[{"x":0,"y":3792,"width":304,"height":24}]}},{"nodeType":"text","text":"に兩手をかけると、丁度、猿の親が猿の子","layout":{"rects":[{"x":0,"y":3816,"width":304,"height":24}]}},{"nodeType":"text","text":"の虱をとるやうに、その長い髮の毛を一本","layout":{"rects":[{"x":0,"y":3840,"width":304,"height":24}]}},{"nodeType":"text","text":"づゝ拔きはじめた。髮は手に從つて拔ける","layout":{"rects":[{"x":0,"y":3864,"width":304,"height":24}]}},{"nodeType":"text","text":"らしい。","layout":{"rects":[{"x":0,"y":3888,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3912,"width":310,"height":360},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その髮の毛が、一本ずゝ拔けるのに從つて","layout":{"rects":[{"x":0,"y":3912,"width":304,"height":24}]}},{"nodeType":"text","text":"下人の心からは、恐怖が少しづつ消えて行","layout":{"rects":[{"x":0,"y":3936,"width":304,"height":24}]}},{"nodeType":"text","text":"つた。さうして、それと同時に、この老婆","layout":{"rects":[{"x":0,"y":3960,"width":304,"height":24}]}},{"nodeType":"text","text":"に對するはげしい憎惡が、少しづゝ動いて","layout":{"rects":[{"x":0,"y":3984,"width":304,"height":24}]}},{"nodeType":"text","text":"來た。――いや、この老婆に對すると云つ","layout":{"rects":[{"x":0,"y":4008,"width":304,"height":24}]}},{"nodeType":"text","text":"ては、語弊があるかも知れない。寧、あら","layout":{"rects":[{"x":0,"y":4032,"width":304,"height":24}]}},{"nodeType":"text","text":"ゆる惡に對する反感が、一分每に强さを增","layout":{"rects":[{"x":0,"y":4056,"width":304,"height":24}]}},{"nodeType":"text","text":"して來たのである。この時、誰かがこの下","layout":{"rects":[{"x":0,"y":4080,"width":304,"height":24}]}},{"nodeType":"text","text":"人に、さつき門の下でこの男が考へてゐ","layout":{"rects":[{"x":0,"y":4104,"width":288,"height":24}]}},{"nodeType":"text","text":"た、饑死をするか盜人になるかと云ふ問題","layout":{"rects":[{"x":0,"y":4128,"width":304,"height":24}]}},{"nodeType":"text","text":"を、改めて持出したら、恐らく下人は、何","layout":{"rects":[{"x":0,"y":4152,"width":304,"height":24}]}},{"nodeType":"text","text":"の未練もなく、饑死を選んだ事であらう。","layout":{"rects":[{"x":0,"y":4176,"width":304,"height":24}]}},{"nodeType":"text","text":"それほど、この男の惡を憎む心は、老婆の","layout":{"rects":[{"x":0,"y":4200,"width":304,"height":24}]}},{"nodeType":"text","text":"床に挿した松の木片のやうに、勢よく燃え","layout":{"rects":[{"x":0,"y":4224,"width":304,"height":24}]}},{"nodeType":"text","text":"上り出してゐたのである。","layout":{"rects":[{"x":0,"y":4248,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4272,"width":310,"height":216},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人には、勿論、何故老婆が死人の髮の毛","layout":{"rects":[{"x":0,"y":4272,"width":304,"height":24}]}},{"nodeType":"text","text":"を拔くかわからなかつた。從つて、合理的","layout":{"rects":[{"x":0,"y":4296,"width":304,"height":24}]}},{"nodeType":"text","text":"には、それを善惡の何れに片づけてよいか","layout":{"rects":[{"x":0,"y":4320,"width":304,"height":24}]}},{"nodeType":"text","text":"知らなかつた。しかし下人にとつては、こ","layout":{"rects":[{"x":0,"y":4344,"width":304,"height":24}]}},{"nodeType":"text","text":"の雨の夜に、この羅生門の上で、死人の髮","layout":{"rects":[{"x":0,"y":4368,"width":304,"height":24}]}},{"nodeType":"text","text":"の毛を拔くと云ふ事が、それ丈で既に許す","layout":{"rects":[{"x":0,"y":4392,"width":304,"height":24}]}},{"nodeType":"text","text":"可らざる惡であつた。勿論、下人は、さつ","layout":{"rects":[{"x":0,"y":4416,"width":304,"height":24}]}},{"nodeType":"text","text":"き迄自分が、盜人になる氣でゐた事なぞ","layout":{"rects":[{"x":0,"y":4440,"width":288,"height":24}]}},{"nodeType":"text","text":"は、とうに忘れてゐるのである。","layout":{"rects":[{"x":0,"y":4464,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4488,"width":310,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"そこで、下人は、兩足に力を入れて、いき","layout":{"rects":[{"x":0,"y":4488,"width":304,"height":24}]}},{"nodeType":"text","text":"なり、梯子から上へ飛び上つた。さうして","layout":{"rects":[{"x":0,"y":4512,"width":304,"height":24}]}},{"nodeType":"text","text":"聖柄の太刀に手をかけながら、大股に老婆","layout":{"rects":[{"x":0,"y":4536,"width":304,"height":24}]}},{"nodeType":"text","text":"の前へ步みよつた。老婆が驚いたのは、云","layout":{"rects":[{"x":0,"y":4560,"width":304,"height":24}]}},{"nodeType":"text","text":"ふ迄もない。","layout":{"rects":[{"x":0,"y":4584,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4608,"width":310,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆は、一目下人を見ると、まるで弩にで","layout":{"rects":[{"x":0,"y":4608,"width":304,"height":24}]}},{"nodeType":"text","text":"も彈かれたやうに、飛び上つた。","layout":{"rects":[{"x":0,"y":4632,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4656,"width":310,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「おのれ、どこへ行く。」","layout":{"rects":[{"x":0,"y":4656,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4680,"width":310,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆が屍骸につまづきながら、慌","layout":{"rects":[{"x":0,"y":4680,"width":304,"height":24}]}},{"nodeType":"text","text":"てふためいて逃げようとする行手を塞い","layout":{"rects":[{"x":0,"y":4704,"width":288,"height":24}]}},{"nodeType":"text","text":"で、こう罵つた。老婆は、それでも下人を","layout":{"rects":[{"x":0,"y":4728,"width":304,"height":24}]}},{"nodeType":"text","text":"つきのけて行かうとする。下人は又、それ","layout":{"rects":[{"x":0,"y":4752,"width":304,"height":24}]}},{"nodeType":"text","text":"を行かすまいとして、押しもどす。二人は","layout":{"rects":[{"x":0,"y":4776,"width":304,"height":24}]}},{"nodeType":"text","text":"屍骸の中で、暫、無言のまゝ、つかみ合つ","layout":{"rects":[{"x":0,"y":4800,"width":304,"height":24}]}},{"nodeType":"text","text":"た。しかし勝敗は、はじめから、わかつて","layout":{"rects":[{"x":0,"y":4824,"width":304,"height":24}]}},{"nodeType":"text","text":"いる。下人はとうとう、老婆の腕をつかん","layout":{"rects":[{"x":0,"y":4848,"width":304,"height":24}]}},{"nodeType":"text","text":"で、無理にそこへ扭ぢ倒した。丁度、鷄の","layout":{"rects":[{"x":0,"y":4872,"width":304,"height":24}]}},{"nodeType":"text","text":"脚のやうな、骨と皮ばかりの腕である。","layout":{"rects":[{"x":0,"y":4896,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4920,"width":310,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「何をしてゐた。さあ何をしてゐた。云","layout":{"rects":[{"x":0,"y":4920,"width":288,"height":24}]}},{"nodeType":"text","text":"へ。云はぬと、これだぞよ。」","layout":{"rects":[{"x":0,"y":4944,"width":224,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4968,"width":310,"height":384},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆をつき放すと、いきなり、太","layout":{"rects":[{"x":0,"y":4968,"width":304,"height":24}]}},{"nodeType":"text","text":