88,"height":24}]}},{"nodeType":"text","text":"前たちは一体誰に尋いて、のぼって来","layout":{"rects":[{"x":0,"y":3096,"width":272,"height":24}]}},{"nodeType":"text","text":"た。下りろ。下りろ。」と喚きました。 ","layout":{"rects":[{"x":0,"y":3120,"width":288,"height":24}]}},{"nodeType":"text","text":"その途端でございます。今まで何ともな","layout":{"rects":[{"x":0,"y":3144,"width":288,"height":24}]}},{"nodeType":"text","text":"かった蜘蛛の糸が、急に犍陀多のぶら下","layout":{"rects":[{"x":0,"y":3168,"width":288,"height":24}]}},{"nodeType":"text","text":"っている所から、ぷつりと音を立てて断","layout":{"rects":[{"x":0,"y":3192,"width":288,"height":24}]}},{"nodeType":"text","text":"れました。ですから犍陀多もたまりませ","layout":{"rects":[{"x":0,"y":3216,"width":288,"height":24}]}},{"nodeType":"text","text":"ん。あっと云う間もなく風を切って、独","layout":{"rects":[{"x":0,"y":3240,"width":288,"height":24}]}},{"nodeType":"text","text":"楽のようにくるくるまわりながら、見る","layout":{"rects":[{"x":0,"y":3264,"width":288,"height":24}]}},{"nodeType":"text","text":"見る中に暗の底へ、まっさかさまに落ち","layout":{"rects":[{"x":0,"y":3288,"width":288,"height":24}]}},{"nodeType":"text","text":"てしまいました。 後にはただ極楽の蜘蛛","layout":{"rects":[{"x":0,"y":3312,"width":291.59,"height":24}]}},{"nodeType":"text","text":"の糸が、きらきらと細く光りながら、月","layout":{"rects":[{"x":0,"y":3336,"width":288,"height":24}]}},{"nodeType":"text","text":"も星もない空の中途に、短く垂れている","layout":{"rects":[{"x":0,"y":3360,"width":288,"height":24}]}},{"nodeType":"text","text":"ばかりでございます。 三 御釈迦様は極楽","layout":{"rects":[{"x":0,"y":3384,"width":295.17,"height":24}]}},{"nodeType":"text","text":"の蓮池のふちに立って、この一部始終を","layout":{"rects":[{"x":0,"y":3408,"width":288,"height":24}]}},{"nodeType":"text","text":"じっと見ていらっしゃいましたが、やが","layout":{"rects":[{"x":0,"y":3432,"width":288,"height":24}]}},{"nodeType":"text","text":"て犍陀多が血の池の底へ石のように沈ん","layout":{"rects":[{"x":0,"y":3456,"width":288,"height":24}]}},{"nodeType":"text","text":"でしまいますと、悲しそうな御顔をなさ","layout":{"rects":[{"x":0,"y":3480,"width":288,"height":24}]}},{"nodeType":"text","text":"りながら、またぶらぶら御歩きになり始","layout":{"rects":[{"x":0,"y":3504,"width":288,"height"