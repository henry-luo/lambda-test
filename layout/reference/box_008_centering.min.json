lor: #333;\n        }\n        \n        .box {\n            width: 200px;\n            height: 60px;\n            border: 1px solid #666;\n            text-align: center;\n            line-height: 60px;\n            font-size: 14px;\n        }\n        \n        /* Horizontal centering */\n        .margin-auto {\n            margin: 10px auto;\n            background-color: #ffcccc;\n        }\n        \n        /* Absolute positioning centering */\n        .absolute-container {\n            position: relative;\n            height: 100px;\n            background-color: #f0f0f0;\n        }\n        \n        .absolute-center {\n            position: absolute;\n            left: 50%;\n            top: 50%;\n            transform: translate(-50%, -50%);\n            background-color: #ccffcc;\n        }\n        \n        .absolute-horizontal {\n            position: absolute;\n            left: 50%;\n            top: 20px;\n            transform: translateX(-50%);\n            background-color: #ccccff;\n        }\n        \n        .absolute-vertical {\n            position: absolute;\n            top: 50%;\n            left: 20px;\n            transform: translateY(-50%);\n            background-color: #ffffcc;\n        }\n        \n        /* Table-cell centering */\n        .table-container {\n            display: table-cell;\n            width: 300px;\n            height: 100px;\n            vertical-align: middle;\n            text-align: center;\n            border: 1px solid #ccc;\n            background-color: #f0f0f0;\n        }\n        \n        .table-centered {\n            display: inline-block;\n            background-color: #ffccff;\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":700},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":600,"height":