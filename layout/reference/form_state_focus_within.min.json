d-outer:focus-within {\n            background-color: #fff3e0;\n            border-color: #ff9800;\n        }\n        \n        .fw-nested-inner {\n            padding: 15px;\n            background-color: #fff;\n            border: 2px solid #ddd;\n            border-radius: 6px;\n            margin-top: 10px;\n        }\n        \n        .fw-nested-inner:focus-within {\n            background-color: #e8f5e9;\n            border-color: #4caf50;\n        }\n        \n        /* ============================================\n           Instructions panel\n           ============================================ */\n        .instructions {\n            background-color: #e8f4fd;\n            border: 1px solid #b3d7f2;\n            border-radius: 6px;\n            padding: 15px;\n            margin-bottom: 20px;\n        }\n        \n        .instructions h3 {\n            font-size: 16px;\n            margin-bottom: 10px;\n            color: #2d6bb3;\n        }\n        \n        .instructions ul {\n            margin-left: 20px;\n            font-size: 14px;\n            color: #444;\n        }\n        \n        .instructions li {\n            margin-bottom: 5px;\n        }\n        \n        .instructions code {\n            background-color: #fff;\n            padding: 2px 6px;\n            border-radius: 3px;\n            font-family: monospace;\n            font-size: 13px;\n        }\n    ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":850.5},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"h1","layout":{"x":20,"y":20,"width":1160,"height":36},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Form State - Test 5: :focus-within state","layout":{"rects":[{"x":20,"y":24,"width":432.02,"height":28}]}}]},{"nodeType":"element","tag":"div","layout":{"x":20,"y":76,"width":116