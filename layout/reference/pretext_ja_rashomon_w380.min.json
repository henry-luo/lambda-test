{"schema_version":2,"layout_tree":{"nodeType":"element","tag":"html","layout":{"x":0,"y":0,"width":1200,"height":6336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"head","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"meta","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"title","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"Pretext corpus: width 380px","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}},{"nodeType":"element","tag":"style","layout":{"x":0,"y":0,"width":0,"height":0},"computed":{"display":"none","textAlign":"start"},"children":[{"nodeType":"text","text":"\n@font-face {\n    font-family: 'Noto Sans SC';\n    src: url('../font/NotoSansSC-Subset.otf') format('opentype');\n}\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: 'Noto Sans SC', sans-serif; font-size: 16px; line-height: 1.5; font-kerning: none; text-spacing-trim: space-all; }\n","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":6336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":380,"height":6336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"p","layout":{"x":0,"y":0,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"或日の暮方の事である。一人の下人が、羅生門の下","layout":{"rects":[{"x":0,"y":0,"width":368,"height":24}]}},{"nodeType":"text","text":"で雨やみを待つてゐた。","layout":{"rects":[{"x":0,"y":24,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":48,"width":380,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"廣い門の下には、この男の外に誰もゐない。唯、","layout":{"rects":[{"x":0,"y":48,"width":352,"height":24}]}},{"nodeType":"text","text":"所々丹塗の剝げた、大きな圓柱に、蟋蟀が一匹とま","layout":{"rects":[{"x":0,"y":72,"width":368,"height":24}]}},{"nodeType":"text","text":"つてゐる。羅生門が、朱雀大路にある以上は、この","layout":{"rects":[{"x":0,"y":96,"width":368,"height":24}]}},{"nodeType":"text","text":"男の外にも、雨やみをする市女笠や揉烏帽子が、も","layout":{"rects":[{"x":0,"y":120,"width":368,"height":24}]}},{"nodeType":"text","text":"う二三人はありさうなものである。それが、この男","layout":{"rects":[{"x":0,"y":144,"width":368,"height":24}]}},{"nodeType":"text","text":"の外には誰もゐない。","layout":{"rects":[{"x":0,"y":168,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":192,"width":380,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"何故かと云ふと、この二三年、京都には、地震とか","layout":{"rects":[{"x":0,"y":192,"width":368,"height":24}]}},{"nodeType":"text","text":"辻風とか火事とか饑饉とか云ふ災がつゞいて起つ","layout":{"rects":[{"x":0,"y":216,"width":352,"height":24}]}},{"nodeType":"text","text":"た。そこで洛中のさびれ方は一通りでない。舊記に","layout":{"rects":[{"x":0,"y":240,"width":368,"height":24}]}},{"nodeType":"text","text":"よると、佛像や佛具を打碎いて、その丹がついた","layout":{"rects":[{"x":0,"y":264,"width":352,"height":24}]}},{"nodeType":"text","text":"り、金銀の箔がついたりした木を、路ばたにつみ重","layout":{"rects":[{"x":0,"y":288,"width":368,"height":24}]}},{"nodeType":"text","text":"ねて、薪の料に賣つてゐたと云ふ事である。洛中が","layout":{"rects":[{"x":0,"y":312,"width":368,"height":24}]}},{"nodeType":"text","text":"その始末であるから、羅生門の修理などは、元より","layout":{"rects":[{"x":0,"y":336,"width":368,"height":24}]}},{"nodeType":"text","text":"誰も捨てゝ顧る者がなかつた。するとその荒れ果て","layout":{"rects":[{"x":0,"y":360,"width":368,"height":24}]}},{"nodeType":"text","text":"たのをよい事にして、狐狸が棲む。盜人が棲む。と","layout":{"rects":[{"x":0,"y":384,"width":368,"height":24}]}},{"nodeType":"text","text":"うとうしまひには、引取り手のない死人を、この門","layout":{"rects":[{"x":0,"y":408,"width":368,"height":24}]}},{"nodeType":"text","text":"へ持つて來て、棄てゝ行くと云ふ習慣さへ出來た。","layout":{"rects":[{"x":0,"y":432,"width":368,"height":24}]}},{"nodeType":"text","text":"そこで、日の目が見えなくなると、誰でも氣味を惡","layout":{"rects":[{"x":0,"y":456,"width":368,"height":24}]}},{"nodeType":"text","text":"るがつて、この門の近所へは足ぶみをしない事にな","layout":{"rects":[{"x":0,"y":480,"width":368,"height":24}]}},{"nodeType":"text","text":"つてしまつたのである。","layout":{"rects":[{"x":0,"y":504,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":528,"width":380,"height":312},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その代り又鴉が何處からか、たくさん集つて來た。","layout":{"rects":[{"x":0,"y":528,"width":368,"height":24}]}},{"nodeType":"text","text":"晝間見ると、その鴉が何羽となく輪を描いて高い鴟","layout":{"rects":[{"x":0,"y":552,"width":368,"height":24}]}},{"nodeType":"text","text":"尾のまはりを啼きながら、飛びまはつてゐる。殊に","layout":{"rects":[{"x":0,"y":576,"width":368,"height":24}]}},{"nodeType":"text","text":"門の上の空が、夕燒けであかくなる時には、それが","layout":{"rects":[{"x":0,"y":600,"width":368,"height":24}]}},{"nodeType":"text","text":"胡麻をまいたやうにはつきり見えた。鴉は、勿論、","layout":{"rects":[{"x":0,"y":624,"width":368,"height":24}]}},{"nodeType":"text","text":"門の上にある死人の肉を、啄みに來るのである。","layout":{"rects":[{"x":0,"y":648,"width":352,"height":24}]}},{"nodeType":"text","text":"――尤も今日は、刻限が遲いせいか、一羽も見えな","layout":{"rects":[{"x":0,"y":672,"width":368,"height":24}]}},{"nodeType":"text","text":"い。唯、所々、崩れかゝつた、さうしてその崩れ目","layout":{"rects":[{"x":0,"y":696,"width":368,"height":24}]}},{"nodeType":"text","text":"に長い草のはへた石段の上に、鴉の糞が、點々と白","layout":{"rects":[{"x":0,"y":720,"width":368,"height":24}]}},{"nodeType":"text","text":"くこびりついてゐるのが見える。下人は七段ある石","layout":{"rects":[{"x":0,"y":744,"width":368,"height":24}]}},{"nodeType":"text","text":"段の一番上の段に洗ひざらした紺の襖の尻を据ゑ","layout":{"rects":[{"x":0,"y":768,"width":352,"height":24}]}},{"nodeType":"text","text":"て、右の頰に出來た、大きな面皰を氣にしながら、","layout":{"rects":[{"x":0,"y":792,"width":368,"height":24}]}},{"nodeType":"text","text":"ぼんやり、雨のふるのを眺めてゐるのである。","layout":{"rects":[{"x":0,"y":816,"width":336,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":840,"width":380,"height":456},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"作者はさつき、「下人が雨やみを待つてゐた」と書","layout":{"rects":[{"x":0,"y":840,"width":368,"height":24}]}},{"nodeType":"text","text":"いた。しかし、下人は、雨がやんでも格別どうしよ","layout":{"rects":[{"x":0,"y":864,"width":368,"height":24}]}},{"nodeType":"text","text":"うと云ふ當てはない。ふだんなら、勿論、主人の家","layout":{"rects":[{"x":0,"y":888,"width":368,"height":24}]}},{"nodeType":"text","text":"へ歸る可き筈である。所がその主人からは、四五日","layout":{"rects":[{"x":0,"y":912,"width":368,"height":24}]}},{"nodeType":"text","text":"前に暇を出された。前にも書いたやうに、當時京都","layout":{"rects":[{"x":0,"y":936,"width":368,"height":24}]}},{"nodeType":"text","text":"の町は一通りならず衰微してゐた。今この下人が、","layout":{"rects":[{"x":0,"y":960,"width":368,"height":24}]}},{"nodeType":"text","text":"永年、使はれてゐた主人から、暇を出されたのも、","layout":{"rects":[{"x":0,"y":984,"width":368,"height":24}]}},{"nodeType":"text","text":"この衰微の小さな餘波に外ならない。だから「下人","layout":{"rects":[{"x":0,"y":1008,"width":368,"height":24}]}},{"nodeType":"text","text":"が雨やみを待つてゐた」と云ふよりも、「雨にふり","layout":{"rects":[{"x":0,"y":1032,"width":368,"height":24}]}},{"nodeType":"text","text":"こめられた下人が、行き所がなくて、途方にくれて","layout":{"rects":[{"x":0,"y":1056,"width":368,"height":24}]}},{"nodeType":"text","text":"ゐた」と云ふ方が、適當である。その上、今日の空","layout":{"rects":[{"x":0,"y":1080,"width":368,"height":24}]}},{"nodeType":"text","text":"模樣も少からずこの平安朝の下人の ","layout":{"rects":[{"x":0,"y":1104,"width":256,"height":24}]}},{"nodeType":"text","text":"Sentimentalisme に影響した。申の刻下りからふり","layout":{"rects":[{"x":0,"y":1128,"width":370.78,"height":24}]}},{"nodeType":"text","text":"出した雨は、未に上るけしきがない。そこで、下人","layout":{"rects":[{"x":0,"y":1152,"width":368,"height":24}]}},{"nodeType":"text","text":"は、何を措いても差當り明日の暮しをどうにかしよ","layout":{"rects":[{"x":0,"y":1176,"width":368,"height":24}]}},{"nodeType":"text","text":"うとして――云はゞどうにもならない事を、どうに","layout":{"rects":[{"x":0,"y":1200,"width":368,"height":24}]}},{"nodeType":"text","text":"かしようとして、とりとめもない考へをたどりなが","layout":{"rects":[{"x":0,"y":1224,"width":368,"height":24}]}},{"nodeType":"text","text":"ら、さつきから朱雀大路にふる雨の音を、聞くとも","layout":{"rects":[{"x":0,"y":1248,"width":368,"height":24}]}},{"nodeType":"text","text":"なく聞いてゐた。","layout":{"rects":[{"x":0,"y":1272,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1296,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"雨は、羅生門をつゝんで、遠くから、ざあつと云ふ","layout":{"rects":[{"x":0,"y":1296,"width":368,"height":24}]}},{"nodeType":"text","text":"音をあつめて來る。夕闇は次第に空を低くして、見","layout":{"rects":[{"x":0,"y":1320,"width":368,"height":24}]}},{"nodeType":"text","text":"上げると、門の屋根が、斜につき出した甍の先に、","layout":{"rects":[{"x":0,"y":1344,"width":368,"height":24}]}},{"nodeType":"text","text":"重たくうす暗い雲を支へてゐる。","layout":{"rects":[{"x":0,"y":1368,"width":240,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1392,"width":380,"height":312},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"どうにもならない事を、どうにかする爲には、手段","layout":{"rects":[{"x":0,"y":1392,"width":368,"height":24}]}},{"nodeType":"text","text":"を選んでゐる遑はない。選んでゐれば、築土の下","layout":{"rects":[{"x":0,"y":1416,"width":352,"height":24}]}},{"nodeType":"text","text":"か、道ばたの土の上で、饑死をするばかりである。","layout":{"rects":[{"x":0,"y":1440,"width":368,"height":24}]}},{"nodeType":"text","text":"さうして、この門の上へ持つて來て、犬のやうに棄","layout":{"rects":[{"x":0,"y":1464,"width":368,"height":24}]}},{"nodeType":"text","text":"てられてしまふばかりである。選ばないとすれば","layout":{"rects":[{"x":0,"y":1488,"width":352,"height":24}]}},{"nodeType":"text","text":"――下人の考へは、何度も同じ道を低徊した揚句","layout":{"rects":[{"x":0,"y":1512,"width":352,"height":24}]}},{"nodeType":"text","text":"に、やつとこの局所へ逢着した。しかしこの「すれ","layout":{"rects":[{"x":0,"y":1536,"width":368,"height":24}]}},{"nodeType":"text","text":"ば」は、何時までたつても、結局「すれば」であつ","layout":{"rects":[{"x":0,"y":1560,"width":368,"height":24}]}},{"nodeType":"text","text":"た。下人は、手段を選ばないといふ事を肯定しなが","layout":{"rects":[{"x":0,"y":1584,"width":368,"height":24}]}},{"nodeType":"text","text":"らも、この「すれば」のかたをつける爲に、當然、","layout":{"rects":[{"x":0,"y":1608,"width":368,"height":24}]}},{"nodeType":"text","text":"その後に來る可き「盜人になるより外に仕方がな","layout":{"rects":[{"x":0,"y":1632,"width":352,"height":24}]}},{"nodeType":"text","text":"い」と云ふ事を、積極的に肯定する丈の、勇氣が出","layout":{"rects":[{"x":0,"y":1656,"width":368,"height":24}]}},{"nodeType":"text","text":"ずにゐたのである。","layout":{"rects":[{"x":0,"y":1680,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1704,"width":380,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、大きな嚏をして、それから、大儀さうに立","layout":{"rects":[{"x":0,"y":1704,"width":368,"height":24}]}},{"nodeType":"text","text":"上つた。夕冷えのする京都は、もう火桶が欲しい程","layout":{"rects":[{"x":0,"y":1728,"width":368,"height":24}]}},{"nodeType":"text","text":"の寒さである。風は門の柱と柱との間を、夕闇と共","layout":{"rects":[{"x":0,"y":1752,"width":368,"height":24}]}},{"nodeType":"text","text":"に遠慮なく、吹きぬける。丹塗の柱にとまつてゐた","layout":{"rects":[{"x":0,"y":1776,"width":368,"height":24}]}},{"nodeType":"text","text":"蟋蟀も、もうどこかへ行つてしまつた。","layout":{"rects":[{"x":0,"y":1800,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":1824,"width":380,"height":240},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、頸をちゞめながら、山吹の汗衫に重ねた、","layout":{"rects":[{"x":0,"y":1824,"width":368,"height":24}]}},{"nodeType":"text","text":"紺の襖の肩を高くして門のまはりを見まはした。雨","layout":{"rects":[{"x":0,"y":1848,"width":368,"height":24}]}},{"nodeType":"text","text":"風の患のない、人目にかゝる惧のない、一晚樂にね","layout":{"rects":[{"x":0,"y":1872,"width":368,"height":24}]}},{"nodeType":"text","text":"られさうな所があれば、そこでともかくも、夜を明","layout":{"rects":[{"x":0,"y":1896,"width":368,"height":24}]}},{"nodeType":"text","text":"かさうと思つたからである。すると、幸門の上の樓","layout":{"rects":[{"x":0,"y":1920,"width":368,"height":24}]}},{"nodeType":"text","text":"へ上る、幅の廣い、之も丹を塗つた梯子が眼につい","layout":{"rects":[{"x":0,"y":1944,"width":368,"height":24}]}},{"nodeType":"text","text":"た。上なら、人がゐたにしても、どうせ死人ばかり","layout":{"rects":[{"x":0,"y":1968,"width":368,"height":24}]}},{"nodeType":"text","text":"である。下人は、そこで腰にさげた聖柄の太刀が鞘","layout":{"rects":[{"x":0,"y":1992,"width":368,"height":24}]}},{"nodeType":"text","text":"走らないやうに氣をつけながら、藁草履をはいた足","layout":{"rects":[{"x":0,"y":2016,"width":368,"height":24}]}},{"nodeType":"text","text":"を、その梯子の一番下の段へふみかけた。","layout":{"rects":[{"x":0,"y":2040,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2064,"width":380,"height":336},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"それから、何分かの後である。羅生門の樓の上へ出","layout":{"rects":[{"x":0,"y":2064,"width":368,"height":24}]}},{"nodeType":"text","text":"る、幅の廣い梯子の中段に、一人の男が、猫のやう","layout":{"rects":[{"x":0,"y":2088,"width":368,"height":24}]}},{"nodeType":"text","text":"に身をちゞめて、息を殺しながら、上の容子を窺つ","layout":{"rects":[{"x":0,"y":2112,"width":368,"height":24}]}},{"nodeType":"text","text":"てゐた。樓の上からさす火の光が、かすかに、その","layout":{"rects":[{"x":0,"y":2136,"width":368,"height":24}]}},{"nodeType":"text","text":"男の右の頰をぬらしてゐる。短い鬚の中に、赤く膿","layout":{"rects":[{"x":0,"y":2160,"width":368,"height":24}]}},{"nodeType":"text","text":"を持つた面皰のある頰である。下人は、始めから、","layout":{"rects":[{"x":0,"y":2184,"width":368,"height":24}]}},{"nodeType":"text","text":"この上にゐる者は、死人ばかりだと高を括つてゐ","layout":{"rects":[{"x":0,"y":2208,"width":352,"height":24}]}},{"nodeType":"text","text":"た。それが、梯子を二三段上つて見ると、上では誰","layout":{"rects":[{"x":0,"y":2232,"width":368,"height":24}]}},{"nodeType":"text","text":"か火をとぼして、しかもその火を其處此處と動かし","layout":{"rects":[{"x":0,"y":2256,"width":368,"height":24}]}},{"nodeType":"text","text":"てゐるらしい。これは、その濁つた、黃いろい光","layout":{"rects":[{"x":0,"y":2280,"width":352,"height":24}]}},{"nodeType":"text","text":"が、隅々に蜘蛛の巢をかけた天井裏に、ゆれながら","layout":{"rects":[{"x":0,"y":2304,"width":368,"height":24}]}},{"nodeType":"text","text":"映つたので、すぐにそれと知れたのである。この雨","layout":{"rects":[{"x":0,"y":2328,"width":368,"height":24}]}},{"nodeType":"text","text":"の夜に、この羅生門の上で、火をともしてゐるから","layout":{"rects":[{"x":0,"y":2352,"width":368,"height":24}]}},{"nodeType":"text","text":"は、どうせ唯の者ではない。","layout":{"rects":[{"x":0,"y":2376,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2400,"width":380,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、守宮のやうに足音をぬすんで、やつと急な","layout":{"rects":[{"x":0,"y":2400,"width":368,"height":24}]}},{"nodeType":"text","text":"梯子を、一番上の段まで這ふやうにして上りつめ","layout":{"rects":[{"x":0,"y":2424,"width":352,"height":24}]}},{"nodeType":"text","text":"た。さうして體を出來る丈、平にしながら、頸を出","layout":{"rects":[{"x":0,"y":2448,"width":368,"height":24}]}},{"nodeType":"text","text":"來る丈、前へ出して、恐る恐る、樓の內を覗いて見","layout":{"rects":[{"x":0,"y":2472,"width":368,"height":24}]}},{"nodeType":"text","text":"た。","layout":{"rects":[{"x":0,"y":2496,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2520,"width":380,"height":312},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"見ると、樓の內には、噂に聞いた通り、幾つかの屍","layout":{"rects":[{"x":0,"y":2520,"width":368,"height":24}]}},{"nodeType":"text","text":"骸が、無造作に棄てゝあるが、火の光の及ぶ範圍","layout":{"rects":[{"x":0,"y":2544,"width":352,"height":24}]}},{"nodeType":"text","text":"が、思つたより狹いので、數は幾つともわからな","layout":{"rects":[{"x":0,"y":2568,"width":352,"height":24}]}},{"nodeType":"text","text":"い。唯、おぼろげながら、知れるのは、その中に裸","layout":{"rects":[{"x":0,"y":2592,"width":368,"height":24}]}},{"nodeType":"text","text":"の屍骸と、着物を着た屍骸とがあると云ふ事であ","layout":{"rects":[{"x":0,"y":2616,"width":352,"height":24}]}},{"nodeType":"text","text":"る。勿論、中には女も男もまじつてゐるらしい。さ","layout":{"rects":[{"x":0,"y":2640,"width":368,"height":24}]}},{"nodeType":"text","text":"うして、その屍骸は皆、それが、甞、生きてゐた人","layout":{"rects":[{"x":0,"y":2664,"width":368,"height":24}]}},{"nodeType":"text","text":"間だと云ふ事實さへ疑はれる程、土を捏ねて造つた","layout":{"rects":[{"x":0,"y":2688,"width":368,"height":24}]}},{"nodeType":"text","text":"人形のやうに、口を開いたり手を延ばしたりしてご","layout":{"rects":[{"x":0,"y":2712,"width":368,"height":24}]}},{"nodeType":"text","text":"ろごろ床の上にころがつてゐた。しかも、肩とか胸","layout":{"rects":[{"x":0,"y":2736,"width":368,"height":24}]}},{"nodeType":"text","text":"とかの高くなつてゐる部分に、ぼんやりした火の光","layout":{"rects":[{"x":0,"y":2760,"width":368,"height":24}]}},{"nodeType":"text","text":"をうけて、低くなつてゐる部分の影を一層暗くしな","layout":{"rects":[{"x":0,"y":2784,"width":368,"height":24}]}},{"nodeType":"text","text":"がら、永久に啞の如く默つていた。","layout":{"rects":[{"x":0,"y":2808,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2832,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、それらの屍骸の腐爛した臭氣に思はず、鼻","layout":{"rects":[{"x":0,"y":2832,"width":368,"height":24}]}},{"nodeType":"text","text":"を掩つた。しかし、その手は、次の瞬間には、もう","layout":{"rects":[{"x":0,"y":2856,"width":368,"height":24}]}},{"nodeType":"text","text":"鼻を掩ふ事を忘れてゐた。或る强い感情が、殆悉こ","layout":{"rects":[{"x":0,"y":2880,"width":368,"height":24}]}},{"nodeType":"text","text":"の男の嗅覺を奪つてしまつたからである。","layout":{"rects":[{"x":0,"y":2904,"width":304,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":2928,"width":380,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人の眼は、その時、はじめて、其屍骸の中に蹲つ","layout":{"rects":[{"x":0,"y":2928,"width":368,"height":24}]}},{"nodeType":"text","text":"ている人間を見た。檜肌色の着物を著た、背の低","layout":{"rects":[{"x":0,"y":2952,"width":352,"height":24}]}},{"nodeType":"text","text":"い、瘦せた、白髮頭の、猿のやうな老婆である。そ","layout":{"rects":[{"x":0,"y":2976,"width":368,"height":24}]}},{"nodeType":"text","text":"の老婆は、右の手に火をともした松の木片を持つ","layout":{"rects":[{"x":0,"y":3000,"width":352,"height":24}]}},{"nodeType":"text","text":"て、その屍骸の一つの顏を覗きこむやうに眺めてゐ","layout":{"rects":[{"x":0,"y":3024,"width":368,"height":24}]}},{"nodeType":"text","text":"た。髮の毛の長い所を見ると、多分女の屍骸であら","layout":{"rects":[{"x":0,"y":3048,"width":368,"height":24}]}},{"nodeType":"text","text":"う。","layout":{"rects":[{"x":0,"y":3072,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3096,"width":380,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、六分の恐怖と四分の好奇心とに動かされ","layout":{"rects":[{"x":0,"y":3096,"width":352,"height":24}]}},{"nodeType":"text","text":"て、暫時は呼吸をするのさへ忘れてゐた。舊記の記","layout":{"rects":[{"x":0,"y":3120,"width":368,"height":24}]}},{"nodeType":"text","text":"者の語を借りれば、「頭身の毛も太る」やうに感じ","layout":{"rects":[{"x":0,"y":3144,"width":368,"height":24}]}},{"nodeType":"text","text":"たのである。すると、老婆は、松の木片を、床板の","layout":{"rects":[{"x":0,"y":3168,"width":368,"height":24}]}},{"nodeType":"text","text":"間に挿して、それから、今まで眺めてゐた屍骸の首","layout":{"rects":[{"x":0,"y":3192,"width":368,"height":24}]}},{"nodeType":"text","text":"に兩手をかけると、丁度、猿の親が猿の子の虱をと","layout":{"rects":[{"x":0,"y":3216,"width":368,"height":24}]}},{"nodeType":"text","text":"るやうに、その長い髮の毛を一本づゝ拔きはじめ","layout":{"rects":[{"x":0,"y":3240,"width":352,"height":24}]}},{"nodeType":"text","text":"た。髮は手に從つて拔けるらしい。","layout":{"rects":[{"x":0,"y":3264,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3288,"width":380,"height":312},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"その髮の毛が、一本ずゝ拔けるのに從つて下人の心","layout":{"rects":[{"x":0,"y":3288,"width":368,"height":24}]}},{"nodeType":"text","text":"からは、恐怖が少しづつ消えて行つた。さうして、","layout":{"rects":[{"x":0,"y":3312,"width":368,"height":24}]}},{"nodeType":"text","text":"それと同時に、この老婆に對するはげしい憎惡が、","layout":{"rects":[{"x":0,"y":3336,"width":368,"height":24}]}},{"nodeType":"text","text":"少しづゝ動いて來た。――いや、この老婆に對する","layout":{"rects":[{"x":0,"y":3360,"width":368,"height":24}]}},{"nodeType":"text","text":"と云つては、語弊があるかも知れない。寧、あらゆ","layout":{"rects":[{"x":0,"y":3384,"width":368,"height":24}]}},{"nodeType":"text","text":"る惡に對する反感が、一分每に强さを增して來たの","layout":{"rects":[{"x":0,"y":3408,"width":368,"height":24}]}},{"nodeType":"text","text":"である。この時、誰かがこの下人に、さつき門の下","layout":{"rects":[{"x":0,"y":3432,"width":368,"height":24}]}},{"nodeType":"text","text":"でこの男が考へてゐた、饑死をするか盜人になるか","layout":{"rects":[{"x":0,"y":3456,"width":368,"height":24}]}},{"nodeType":"text","text":"と云ふ問題を、改めて持出したら、恐らく下人は、","layout":{"rects":[{"x":0,"y":3480,"width":368,"height":24}]}},{"nodeType":"text","text":"何の未練もなく、饑死を選んだ事であらう。それほ","layout":{"rects":[{"x":0,"y":3504,"width":368,"height":24}]}},{"nodeType":"text","text":"ど、この男の惡を憎む心は、老婆の床に挿した松の","layout":{"rects":[{"x":0,"y":3528,"width":368,"height":24}]}},{"nodeType":"text","text":"木片のやうに、勢よく燃え上り出してゐたのであ","layout":{"rects":[{"x":0,"y":3552,"width":352,"height":24}]}},{"nodeType":"text","text":"る。","layout":{"rects":[{"x":0,"y":3576,"width":32,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3600,"width":380,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人には、勿論、何故老婆が死人の髮の毛を拔くか","layout":{"rects":[{"x":0,"y":3600,"width":368,"height":24}]}},{"nodeType":"text","text":"わからなかつた。從つて、合理的には、それを善惡","layout":{"rects":[{"x":0,"y":3624,"width":368,"height":24}]}},{"nodeType":"text","text":"の何れに片づけてよいか知らなかつた。しかし下人","layout":{"rects":[{"x":0,"y":3648,"width":368,"height":24}]}},{"nodeType":"text","text":"にとつては、この雨の夜に、この羅生門の上で、死","layout":{"rects":[{"x":0,"y":3672,"width":368,"height":24}]}},{"nodeType":"text","text":"人の髮の毛を拔くと云ふ事が、それ丈で既に許す可","layout":{"rects":[{"x":0,"y":3696,"width":368,"height":24}]}},{"nodeType":"text","text":"らざる惡であつた。勿論、下人は、さつき迄自分","layout":{"rects":[{"x":0,"y":3720,"width":352,"height":24}]}},{"nodeType":"text","text":"が、盜人になる氣でゐた事なぞは、とうに忘れてゐ","layout":{"rects":[{"x":0,"y":3744,"width":368,"height":24}]}},{"nodeType":"text","text":"るのである。","layout":{"rects":[{"x":0,"y":3768,"width":96,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3792,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"そこで、下人は、兩足に力を入れて、いきなり、梯","layout":{"rects":[{"x":0,"y":3792,"width":368,"height":24}]}},{"nodeType":"text","text":"子から上へ飛び上つた。さうして聖柄の太刀に手を","layout":{"rects":[{"x":0,"y":3816,"width":368,"height":24}]}},{"nodeType":"text","text":"かけながら、大股に老婆の前へ步みよつた。老婆が","layout":{"rects":[{"x":0,"y":3840,"width":368,"height":24}]}},{"nodeType":"text","text":"驚いたのは、云ふ迄もない。","layout":{"rects":[{"x":0,"y":3864,"width":208,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3888,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆は、一目下人を見ると、まるで弩にでも彈かれ","layout":{"rects":[{"x":0,"y":3888,"width":368,"height":24}]}},{"nodeType":"text","text":"たやうに、飛び上つた。","layout":{"rects":[{"x":0,"y":3912,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3936,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「おのれ、どこへ行く。」","layout":{"rects":[{"x":0,"y":3936,"width":192,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":3960,"width":380,"height":216},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆が屍骸につまづきながら、慌てふため","layout":{"rects":[{"x":0,"y":3960,"width":368,"height":24}]}},{"nodeType":"text","text":"いて逃げようとする行手を塞いで、こう罵つた。老","layout":{"rects":[{"x":0,"y":3984,"width":368,"height":24}]}},{"nodeType":"text","text":"婆は、それでも下人をつきのけて行かうとする。下","layout":{"rects":[{"x":0,"y":4008,"width":368,"height":24}]}},{"nodeType":"text","text":"人は又、それを行かすまいとして、押しもどす。二","layout":{"rects":[{"x":0,"y":4032,"width":368,"height":24}]}},{"nodeType":"text","text":"人は屍骸の中で、暫、無言のまゝ、つかみ合つた。","layout":{"rects":[{"x":0,"y":4056,"width":368,"height":24}]}},{"nodeType":"text","text":"しかし勝敗は、はじめから、わかつている。下人は","layout":{"rects":[{"x":0,"y":4080,"width":368,"height":24}]}},{"nodeType":"text","text":"とうとう、老婆の腕をつかんで、無理にそこへ扭ぢ","layout":{"rects":[{"x":0,"y":4104,"width":368,"height":24}]}},{"nodeType":"text","text":"倒した。丁度、鷄の脚のやうな、骨と皮ばかりの腕","layout":{"rects":[{"x":0,"y":4128,"width":368,"height":24}]}},{"nodeType":"text","text":"である。","layout":{"rects":[{"x":0,"y":4152,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4176,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「何をしてゐた。さあ何をしてゐた。云へ。云はぬ","layout":{"rects":[{"x":0,"y":4176,"width":368,"height":24}]}},{"nodeType":"text","text":"と、これだぞよ。」","layout":{"rects":[{"x":0,"y":4200,"width":144,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4224,"width":380,"height":312},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆をつき放すと、いきなり、太刀の鞘を","layout":{"rects":[{"x":0,"y":4224,"width":368,"height":24}]}},{"nodeType":"text","text":"拂つて、白い鋼の色をその眼の前へつきつけた。け","layout":{"rects":[{"x":0,"y":4248,"width":368,"height":24}]}},{"nodeType":"text","text":"れども、老婆は默つてゐる。兩手をわなわなふるは","layout":{"rects":[{"x":0,"y":4272,"width":368,"height":24}]}},{"nodeType":"text","text":"せて、肩で息を切りながら、眼を、眼球が眶の外へ","layout":{"rects":[{"x":0,"y":4296,"width":368,"height":24}]}},{"nodeType":"text","text":"出さうになる程、見開いて、啞のやうに執拗く默つ","layout":{"rects":[{"x":0,"y":4320,"width":368,"height":24}]}},{"nodeType":"text","text":"てゐる。これを見ると、下人は始めて明白にこの老","layout":{"rects":[{"x":0,"y":4344,"width":368,"height":24}]}},{"nodeType":"text","text":"婆の生死が、全然、自分の意志に支配されてゐると","layout":{"rects":[{"x":0,"y":4368,"width":368,"height":24}]}},{"nodeType":"text","text":"云ふ事を意識した。さうして、この意識は、今まで","layout":{"rects":[{"x":0,"y":4392,"width":368,"height":24}]}},{"nodeType":"text","text":"はげしく燃えてゐた憎惡の心を何時の間にか冷まし","layout":{"rects":[{"x":0,"y":4416,"width":368,"height":24}]}},{"nodeType":"text","text":"てしまつた。後に殘つたのは、唯、或仕事をして、","layout":{"rects":[{"x":0,"y":4440,"width":368,"height":24}]}},{"nodeType":"text","text":"それが圓滿に成就した時の、安らかな得意と滿足と","layout":{"rects":[{"x":0,"y":4464,"width":368,"height":24}]}},{"nodeType":"text","text":"があるばかりである。そこで、下人は、老婆を見下","layout":{"rects":[{"x":0,"y":4488,"width":368,"height":24}]}},{"nodeType":"text","text":"しながら、少し聲を柔げてかう云つた。","layout":{"rects":[{"x":0,"y":4512,"width":288,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4536,"width":380,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「己は檢非違使の廳の役人などではない。今し方こ","layout":{"rects":[{"x":0,"y":4536,"width":368,"height":24}]}},{"nodeType":"text","text":"の門の下を通りかゝつた旅の者だ。だからお前に繩","layout":{"rects":[{"x":0,"y":4560,"width":368,"height":24}]}},{"nodeType":"text","text":"をかけて、どうしようと云ふやうな事はない。唯、","layout":{"rects":[{"x":0,"y":4584,"width":368,"height":24}]}},{"nodeType":"text","text":"今時分、この門の上で、何をして居たのだか、それ","layout":{"rects":[{"x":0,"y":4608,"width":368,"height":24}]}},{"nodeType":"text","text":"を己に話しさへすればいいのだ。」","layout":{"rects":[{"x":0,"y":4632,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4656,"width":380,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"すると、老婆は、見開いてゐた眼を、一層大きくし","layout":{"rects":[{"x":0,"y":4656,"width":368,"height":24}]}},{"nodeType":"text","text":"て、ぢつとその下人の顏を見守つた。眶の赤くなつ","layout":{"rects":[{"x":0,"y":4680,"width":368,"height":24}]}},{"nodeType":"text","text":"た、肉食鳥のやうな、銳い眼で見たのである。それ","layout":{"rects":[{"x":0,"y":4704,"width":368,"height":24}]}},{"nodeType":"text","text":"から、皺で、殆、鼻と一つになつた唇を、何か物で","layout":{"rects":[{"x":0,"y":4728,"width":368,"height":24}]}},{"nodeType":"text","text":"も嚙んでゐるやうに動かした。細い喉で、尖つた喉","layout":{"rects":[{"x":0,"y":4752,"width":368,"height":24}]}},{"nodeType":"text","text":"佛の動いてゐるのが見える。その時、その喉から、","layout":{"rects":[{"x":0,"y":4776,"width":368,"height":24}]}},{"nodeType":"text","text":"鴉の啼くやうな聲が、喘ぎ喘ぎ、下人の耳へ傳はつ","layout":{"rects":[{"x":0,"y":4800,"width":368,"height":24}]}},{"nodeType":"text","text":"て來た。","layout":{"rects":[{"x":0,"y":4824,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4848,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「この髮を拔いてな、この女の髮を拔いてな、鬘に","layout":{"rects":[{"x":0,"y":4848,"width":368,"height":24}]}},{"nodeType":"text","text":"せうと思うたのぢや。」","layout":{"rects":[{"x":0,"y":4872,"width":176,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":4896,"width":380,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、老婆の答が存外、平凡なのに失望した。さ","layout":{"rects":[{"x":0,"y":4896,"width":368,"height":24}]}},{"nodeType":"text","text":"うして失望すると同時に、又前の憎惡が、冷な侮蔑","layout":{"rects":[{"x":0,"y":4920,"width":368,"height":24}]}},{"nodeType":"text","text":"と一しよに、心の中へはいつて來た。すると、その","layout":{"rects":[{"x":0,"y":4944,"width":368,"height":24}]}},{"nodeType":"text","text":"氣色が、先方へも通じたのであらう。老婆は、片手","layout":{"rects":[{"x":0,"y":4968,"width":368,"height":24}]}},{"nodeType":"text","text":"に、まだ屍骸の頭から奪つた長い拔け毛を持つたな","layout":{"rects":[{"x":0,"y":4992,"width":368,"height":24}]}},{"nodeType":"text","text":"り、蟇のつぶやくやうな聲で、口ごもりながら、こ","layout":{"rects":[{"x":0,"y":5016,"width":368,"height":24}]}},{"nodeType":"text","text":"んな事を云つた。","layout":{"rects":[{"x":0,"y":5040,"width":128,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5064,"width":380,"height":432},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"成程、死人の髮の毛を拔くと云ふ事は、惡い事かも","layout":{"rects":[{"x":0,"y":5064,"width":368,"height":24}]}},{"nodeType":"text","text":"知れぬ。しかし、かう云ふ死人の多くは、皆、その","layout":{"rects":[{"x":0,"y":5088,"width":368,"height":24}]}},{"nodeType":"text","text":"位な事を、されてもいゝ人間ばかりである。現に、","layout":{"rects":[{"x":0,"y":5112,"width":368,"height":24}]}},{"nodeType":"text","text":"自分が今、髮を拔いた女などは、蛇を四寸ばかり","layout":{"rects":[{"x":0,"y":5136,"width":352,"height":24}]}},{"nodeType":"text","text":"づゝに切つて干したのを、干魚だと云つて、太刀帶","layout":{"rects":[{"x":0,"y":5160,"width":368,"height":24}]}},{"nodeType":"text","text":"の陣へ賣りに行つた。疫病にかゝつて死ななかつた","layout":{"rects":[{"x":0,"y":5184,"width":368,"height":24}]}},{"nodeType":"text","text":"なら、今でも賣りに行つてゐたかもしれない。しか","layout":{"rects":[{"x":0,"y":5208,"width":368,"height":24}]}},{"nodeType":"text","text":"も、この女の賣る干魚は、味がよいと云ふので、太","layout":{"rects":[{"x":0,"y":5232,"width":368,"height":24}]}},{"nodeType":"text","text":"刀帶たちが、缺かさず菜料に買つてゐたのである。","layout":{"rects":[{"x":0,"y":5256,"width":368,"height":24}]}},{"nodeType":"text","text":"自分は、この女のした事が惡いとは思はない。しな","layout":{"rects":[{"x":0,"y":5280,"width":368,"height":24}]}},{"nodeType":"text","text":"ければ、饑死をするので、仕方がなくした事だから","layout":{"rects":[{"x":0,"y":5304,"width":368,"height":24}]}},{"nodeType":"text","text":"である。だから、又今、自分のしてゐた事も惡い事","layout":{"rects":[{"x":0,"y":5328,"width":368,"height":24}]}},{"nodeType":"text","text":"とは思はない。これもやはりしなければ、饑死をす","layout":{"rects":[{"x":0,"y":5352,"width":368,"height":24}]}},{"nodeType":"text","text":"るので、仕方がなくする事だからである。さうし","layout":{"rects":[{"x":0,"y":5376,"width":352,"height":24}]}},{"nodeType":"text","text":"て、その仕方がない事を、よく知つてゐたこの女","layout":{"rects":[{"x":0,"y":5400,"width":352,"height":24}]}},{"nodeType":"text","text":"は、自分のする事を許してくれるのにちがひないと","layout":{"rects":[{"x":0,"y":5424,"width":368,"height":24}]}},{"nodeType":"text","text":"思ふからである。――老婆は、大體こんな意味の事","layout":{"rects":[{"x":0,"y":5448,"width":368,"height":24}]}},{"nodeType":"text","text":"を云つた。","layout":{"rects":[{"x":0,"y":5472,"width":80,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5496,"width":380,"height":312},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、太刀を鞘におさめて、その太刀の柄を左の","layout":{"rects":[{"x":0,"y":5496,"width":368,"height":24}]}},{"nodeType":"text","text":"手でおさへながら、冷然として、この話を聞いてゐ","layout":{"rects":[{"x":0,"y":5520,"width":368,"height":24}]}},{"nodeType":"text","text":"た。勿論、右の手では、赤く頰に膿を持つた大きな","layout":{"rects":[{"x":0,"y":5544,"width":368,"height":24}]}},{"nodeType":"text","text":"面皰を氣にしながら、聞いてゐるのである。しか","layout":{"rects":[{"x":0,"y":5568,"width":352,"height":24}]}},{"nodeType":"text","text":"し、之を聞いてゐる中に、下人の心には、或勇氣が","layout":{"rects":[{"x":0,"y":5592,"width":368,"height":24}]}},{"nodeType":"text","text":"生まれて來た。それは、さつき、門の下でこの男に","layout":{"rects":[{"x":0,"y":5616,"width":368,"height":24}]}},{"nodeType":"text","text":"缺けてゐた勇氣である。さうして、又さつき、この","layout":{"rects":[{"x":0,"y":5640,"width":368,"height":24}]}},{"nodeType":"text","text":"門の上へ上つて、この老婆を捕へた時の勇氣とは、","layout":{"rects":[{"x":0,"y":5664,"width":368,"height":24}]}},{"nodeType":"text","text":"全然、反對な方向に動かうとする勇氣である。下人","layout":{"rects":[{"x":0,"y":5688,"width":368,"height":24}]}},{"nodeType":"text","text":"は、饑死をするか盜人になるかに迷はなかつたばか","layout":{"rects":[{"x":0,"y":5712,"width":368,"height":24}]}},{"nodeType":"text","text":"りではない。その時のこの男の心もちから云へば、","layout":{"rects":[{"x":0,"y":5736,"width":368,"height":24}]}},{"nodeType":"text","text":"饑死などと云ふ事は、殆、考へる事さへ出來ない","layout":{"rects":[{"x":0,"y":5760,"width":352,"height":24}]}},{"nodeType":"text","text":"程、意識の外に追ひ出されてゐた。","layout":{"rects":[{"x":0,"y":5784,"width":256,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5808,"width":380,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「きつと、そうか。」","layout":{"rects":[{"x":0,"y":5808,"width":160,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5832,"width":380,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"老婆の話が完ると、下人は嘲るやうな聲で念を押し","layout":{"rects":[{"x":0,"y":5832,"width":368,"height":24}]}},{"nodeType":"text","text":"た。さうして、一足前へ出ると、不意に、右の手を","layout":{"rects":[{"x":0,"y":5856,"width":368,"height":24}]}},{"nodeType":"text","text":"面皰から離して、老婆の襟上をつかみながら、かう","layout":{"rects":[{"x":0,"y":5880,"width":368,"height":24}]}},{"nodeType":"text","text":"云つた。","layout":{"rects":[{"x":0,"y":5904,"width":64,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5928,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"「では、己が引剝をしようと恨むまいな。己もさう","layout":{"rects":[{"x":0,"y":5928,"width":368,"height":24}]}},{"nodeType":"text","text":"しなければ、饑死をする體なのだ。」","layout":{"rects":[{"x":0,"y":5952,"width":272,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":5976,"width":380,"height":144},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、すばやく、老婆の着物を剝ぎとつた。それ","layout":{"rects":[{"x":0,"y":5976,"width":368,"height":24}]}},{"nodeType":"text","text":"から、足にしがみつかうとする老婆を、手荒く屍骸","layout":{"rects":[{"x":0,"y":6000,"width":368,"height":24}]}},{"nodeType":"text","text":"の上へ蹴倒した。梯子の口までは、僅に五步を數へ","layout":{"rects":[{"x":0,"y":6024,"width":368,"height":24}]}},{"nodeType":"text","text":"るばかりである。下人は、剝ぎとつた檜肌色の着物","layout":{"rects":[{"x":0,"y":6048,"width":368,"height":24}]}},{"nodeType":"text","text":"をわきにかゝへて、またゝく間に急な梯子を夜の底","layout":{"rects":[{"x":0,"y":6072,"width":368,"height":24}]}},{"nodeType":"text","text":"へかけ下りた。","layout":{"rects":[{"x":0,"y":6096,"width":112,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6120,"width":380,"height":168},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"暫、死んだやうに倒れてゐた老婆が、屍骸の中か","layout":{"rects":[{"x":0,"y":6120,"width":352,"height":24}]}},{"nodeType":"text","text":"ら、その裸の體を起したのは、それから間もなくの","layout":{"rects":[{"x":0,"y":6144,"width":368,"height":24}]}},{"nodeType":"text","text":"事である。老婆は、つぶやくやうな、うめくやうな","layout":{"rects":[{"x":0,"y":6168,"width":368,"height":24}]}},{"nodeType":"text","text":"聲を立てながら、まだ燃えてゐる火の光をたより","layout":{"rects":[{"x":0,"y":6192,"width":352,"height":24}]}},{"nodeType":"text","text":"に、梯子の口まで、這つて行つた。さうして、そこ","layout":{"rects":[{"x":0,"y":6216,"width":368,"height":24}]}},{"nodeType":"text","text":"から、短い白髮を倒にして、門の下を覗きこんだ。","layout":{"rects":[{"x":0,"y":6240,"width":368,"height":24}]}},{"nodeType":"text","text":"外には、唯、黑洞々たる夜があるばかりである。","layout":{"rects":[{"x":0,"y":6264,"width":352,"height":24}]}}]},{"nodeType":"element","tag":"p","layout":{"x":0,"y":6288,"width":380,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"下人は、既に、雨を冐して、京都の町へ强盜を働き","layout":{"rects":[{"x":0,"y":6288,"width":368,"height":24}]}},{"nodeType":"text","text":"に急いでゐた。","layout":{"rects":[{"x":0,"y":6312,"width":112,"height":24}]}}]}]}]}]}}