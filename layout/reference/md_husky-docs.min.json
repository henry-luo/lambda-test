moji\",\n                   \"Segoe UI Emoji\";\n      font-size: 16px;\n      line-height: 1.5;\n      color: #1f2328;\n      background-color: #ffffff;\n      margin: 0;\n      padding: 0;\n    }\n\n    /* Top breadcrumb bar */\n    .gh-header {\n      background: #f6f8fa;\n      border-bottom: 1px solid #d0d7de;\n      padding: 8px 16px;\n      font-size: 13px;\n      color: #57606a;\n    }\n    .gh-header a {\n      color: #0969da;\n      text-decoration: none;\n      font-weight: 600;\n    }\n    .gh-header a:hover { text-decoration: underline; }\n    .gh-header .sep { margin: 0 4px; color: #57606a; }\n\n    /* Centered content area, exactly as GitHub renders READMEs */\n    .gh-content {\n      max-width: 1012px;\n      margin: 0 auto;\n      padding: 32px 16px;\n    }\n\n    /* The rendered markdown box */\n    .gh-box {\n      border: 1px solid #d0d7de;\n      border-radius: 6px;\n      overflow: hidden;\n    }\n\n    .gh-box-header {\n      background: #f6f8fa;\n      border-bottom: 1px solid #d0d7de;\n      padding: 8px 16px;\n      font-size: 14px;\n      font-weight: 600;\n      color: #1f2328;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .gh-box-header .icon {\n      color: #57606a;\n    }\n\n    /* Override markdown-body padding to fit inside box */\n    .gh-box .markdown-body {\n      padding: 32px 40px 24px;\n    }\n\n    @media (max-width: 767px) {\n      .gh-box .markdown-body { padding: 16px; }\n      .gh-content { padding: 16px 12px; }\n    }\n\n    /* ── Syntax highlighting fixes ──────────────────────────────────────── */\n    /* Ensure code blocks have the right background, matching GitHub exactly */\n    .markdown-body pre {\n      background-color: #f6f8fa;\n      border-radius: 6px;\n    }\n\n    .markdown-body pre code.hljs {\n      background: transparent;\n      padding: 0;\n      font-size: 85%;\n    }\n\n    /* Inline code — GitHub uses a reddish tint */\n    .markdown-body code:not(pre code) {\n      background-color: #f6f8fa;\n      border-radius: 6px;\n      font-size: 85%;\n      padding: 0.2em 0.4em;\n    }\n\n    /* ── KaTeX display math centering ──────────────────────────────────── */\n    .katex-display {\n      overflow-x: auto;\n      overflow-y: hidden;\n      padding: 4px 0;\n    }\n\n    /* ── Table improvements ─────────────────────────────────────────────── */\n    .markdown-body table {\n      display: block;\n      width: max-content;\n      max-width: 100%;\n      overflow: auto;\n    }\n\n    /* ── Footer ─────────────────────────────────────────────────────────── */\n    .gh-footer {\n      text-align: center;\n      padding: 24px 16px;\n      font-size: 12px;\n      color: #57606a;\n    }\n    .gh-footer a { color: #57606a; }\n  ","layout":{"rects":[]}}]},{"nodeType":"text","text":"\n","layout":{"rects":[]}}]},{"nodeType":"element","tag":"body","layout":{"x":0,"y":0,"width":1200,"height":2199.25},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"div","layout":{"x":0,"y":0,"width":1200,"height":36.5},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"a","layout":{"x":16,"y":9,"width":131.95,"height":16},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"Markdown Test Suite","layout":{"rects":[{"x":16,"y":9,"width":131.95,"height":16}]}}]},{"nodeType":"text","text":"\n    ","layout":{"rects":[{"x":147.95,"y":9,"width":3.59,"height":16}]}},{"nodeType":"element","tag":"span","layout":{"x":155.55,"y":9,"width":3.89,"height":16},"selector":"span.sep:nth-of-type(1)","computed":{"display":"inline","textAlign":"start","fontFamily":"-apple-system, \"system-ui\", \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"","fontSize":13,"fontWeight":"400"},"children":[{"nodeType":"text","text":"/","layout":{"rects":[{"x":155.55,"y":9,"width":3.89,"height":16}]}}]},{"nodeType":"text","text"