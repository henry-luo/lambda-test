n":"start"},"children":[{"nodeType":"text","text":"Overview","layout":{"rects":[{"x":151,"y":437.09,"width":102.89,"height":28}]}}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":490.28,"width":898,"height":120},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Rollup is a module bundler for JavaScript which compiles small pieces of code into something larger and more complex, ","layout":{"rects":[{"x":151,"y":493.28,"width":864.56,"height":18}]}},{"nodeType":"text","text":"such as a library or application. It uses the standardized ES module format for code, instead of previous idiosyncratic ","layout":{"rects":[{"x":151,"y":517.28,"width":843.08,"height":18}]}},{"nodeType":"text","text":"solutions such as CommonJS and AMD. ES modules let you freely and seamlessly combine the most useful individual ","layout":{"rects":[{"x":151,"y":541.28,"width":845.64,"height":18}]}},{"nodeType":"text","text":"functions from your favorite libraries. Rollup can optimize ES modules for faster native loading in modern browsers, or ","layout":{"rects":[{"x":151,"y":565.28,"width":847.67,"height":18}]}},{"nodeType":"text","text":"output a legacy module format allowing ES module workflows today.","layout":{"rects":[{"x":151,"y":589.28,"width":491.89,"height":18}]}}]},{"nodeType":"element","tag":"h2","layout":{"x":151,"y":634.28,"width":898,"height":38.19},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Quick Start Guide","layout":{"rects":[{"x":151,"y":635.28,"width":192.33,"height":28}]}}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":688.47,"width":898,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Install with ","layout":{"rects":[{"x":151,"y":691.47,"width":81.16,"height":18}]}},{"nodeType":"element","tag":"code","layout":{"x":232.16,"y":690.75,"width":231.95,"height":21.44},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"npm install --global rollup","layout":{"rects":[{"x":237.59,"y":693.47,"width":221.08,"height":16}]}}]},{"nodeType":"text","text":". Rollup can be used either through a ","layout":{"rects":[{"x":464.11,"y":691.47,"width":269.94,"height":18}]}},{"nodeType":"element","tag":"a","layout":{"x":734.05,"y":691.47,"width":170.02,"height":18},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"command line interface","layout":{"rects":[{"x":734.05,"y":691.47,"width":170.02,"height":18}]}}]},{"nodeType":"text","text":" with an optional ","layout":{"rects":[{"x":904.06,"y":691.47,"width":118.58,"height":18}]}},{"nodeType":"text","text":"configuration file or else through its ","layout":{"rects":[{"x":151,"y":715.47,"width":261.06,"height":18}]}},{"nodeType":"element","tag":"a","layout":{"x":412.06,"y":715.47,"width":104.44,"height":18},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"JavaScript API","layout":{"rects":[{"x":412.06,"y":715.47,"width":104.44,"height":18}]}}]},{"nodeType":"text","text":". Run ","layout":{"rects":[{"x":516.5,"y":715.47,"width":41,"height":18}]}},{"nodeType":"element","tag":"code","layout":{"x":557.5,"y":714.75,"width":117.33,"height":21.44},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"rollup --help","layout":{"rects":[{"x":562.94,"y":717.47,"width":106.45,"height":16}]}}]},{"nodeType":"text","text":" to see the available options and parameters. The ","layout":{"rects":[{"x":674.83,"y":715.47,"width":355.72,"height":18}]}},{"nodeType":"text","text":"starter project templates, ","layout":{"rects":[{"x":151,"y":739.47,"width":187.63,"height":18}]}},{"nodeType":"element","tag":"a","layout":{"x":338.63,"y":739.47,"width":119.3,"height":18},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"rollup-starter-lib","layout":{"rects":[{"x":338.63,"y":739.47,"width":119.3,"height":18}]}}]},{"nodeType":"text","text":" and ","layout":{"rects":[{"x":457.92,"y":739.47,"width":35.44,"height":18}]}},{"nodeType":"element","tag":"a","layout":{"x":493.36,"y":739.47,"width":129.67,"height":18},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"rollup-starter-app","layout":{"rects":[{"x":493.36,"y":739.47,"width":129.67,"height":18}]}}]},{"nodeType":"text","text":", demonstrate common configuration options, and more ","layout":{"rects":[{"x":623.03,"y":739.47,"width":403.41,"height":18}]}},{"nodeType":"text","text":"detailed instructions are available throughout the ","layout":{"rects":[{"x":151,"y":763.47,"width":357.89,"height":18}]}},{"nodeType":"element","tag":"a","layout":{"x":508.89,"y":763.47,"width":76.33,"height":18},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"user guide","layout":{"rects":[{"x":508.89,"y":763.47,"width":76.33,"height":18}]}}]},{"nodeType":"text","text":".","layout":{"rects":[{"x":585.22,"y":763.47,"width":4.44,"height":18}]}}]},{"nodeType":"element","tag":"h3","layout":{"x":151,"y":808.47,"width":898,"height":25},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Commands","layout":{"rects":[{"x":151,"y":809.47,"width":105.34,"height":23}]}}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":849.47,"width":898,"height":48},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"These commands assume the entry point to your application is named main.js, and that you’d like all imports compiled into a ","layout":{"rects":[{"x":151,"y":852.47,"width":897.05,"height":18}]}},{"nodeType":"text","text":"single file named bundle.js.","layout":{"rects":[{"x":151,"y":876.47,"width":196.67,"height":18}]}}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":913.47,"width":898,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"For browsers:","layout":{"rects":[{"x":151,"y":916.47,"width":98.7,"height":18}]}}]},{"nodeType":"element","tag":"pre","layout":{"x":151,"y":953.47,"width":898,"height":71.41},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"code","layout":{"x":167,"y":970.47,"width":515.84,"height":35.7},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"# compile to a <script> containing a self-executing function\n","layout":{"rects":[{"x":167,"y":970.47,"width":491.28,"height":16}]}},{"nodeType":"text","text":"rollup main.js --format iife --name \"myBundle\" --file bundle.js\n","layout":{"rects":[{"x":167,"y":990.17,"width":515.84,"height":16}]}}]}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":1040.88,"width":898,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"For Node.js:","layout":{"rects":[{"x":151,"y":1043.88,"width":87.58,"height":18}]}}]},{"nodeType":"element","tag":"pre","layout":{"x":151,"y":1080.88,"width":898,"height":71.41},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"code","layout":{"x":167,"y":1097.88,"width":360.28,"height":35.7},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"# compile to a CommonJS module\n","layout":{"rects":[{"x":167,"y":1097.88,"width":245.64,"height":16}]}},{"nodeType":"text","text":"rollup main.js --format cjs --file bundle.js\n","layout":{"rects":[{"x":167,"y":1117.58,"width":360.28,"height":16}]}}]}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":1168.28,"width":898,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"For both browsers and Node.js:","layout":{"rects":[{"x":151,"y":1171.28,"width":226.77,"height":18}]}}]},{"nodeType":"element","tag":"pre","layout":{"x":151,"y":1208.28,"width":898,"height":71.41},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"code","layout":{"x":167,"y":1225.28,"width":507.66,"height":35.7},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"# UMD format requires a bundle name\n","layout":{"rects":[{"x":167,"y":1225.28,"width":286.58,"height":16}]}},{"nodeType":"text","text":"rollup main.js --format umd --name \"myBundle\" --file bundle.js\n","layout":{"rects":[{"x":167,"y":1244.98,"width":507.66,"height":16}]}}]}]},{"nodeType":"element","tag":"h2","layout":{"x":151,"y":1303.69,"width":898,"height":38.19},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Why","layout":{"rects":[{"x":151,"y":1304.69,"width":49.78,"height":28}]}}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":1357.88,"width":898,"height":96},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Developing software is usually easier if you break your project into smaller separate pieces, since that often removes ","layout":{"rects":[{"x":151,"y":1360.88,"width":841.38,"height":18}]}},{"nodeType":"text","text":"unexpected interactions and dramatically reduces the complexity of the problems you’ll need to solve, and simply writing ","layout":{"rects":[{"x":151,"y":1384.88,"width":873.55,"height":18}]}},{"nodeType":"text","text":"smaller projects in the first place ","layout":{"rects":[{"x":151,"y":1408.88,"width":239.69,"height":18}]}},{"nodeType":"element","tag":"a","layout":{"x":390.69,"y":1408.88,"width":198.72,"height":18},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"isn’t necessarily the answer","layout":{"rects":[{"x":390.69,"y":1408.88,"width":198.72,"height":18}]}}]},{"nodeType":"text","text":". Unfortunately, JavaScript has not historically included this ","layout":{"rects":[{"x":589.41,"y":1408.88,"width":427.31,"height":18}]}},{"nodeType":"text","text":"capability as a core feature in the language.","layout":{"rects":[{"x":151,"y":1432.88,"width":314.52,"height":18}]}}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":1469.88,"width":898,"height":192},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"This finally changed with ES modules support in JavaScript, which provides a syntax for importing and exporting functions ","layout":{"rects":[{"x":151,"y":1472.88,"width":881.89,"height":18}]}},{"nodeType":"text","text":"and data so they can be shared between separate scripts. Most browsers and Node.js support ES modules. However, ","layout":{"rects":[{"x":151,"y":1496.88,"width":846.09,"height":18}]}},{"nodeType":"text","text":"Node.js releases before 12.17 support ES modules only behind the ","layout":{"rects":[{"x":151,"y":1520.88,"width":481.45,"height":18}]}},{"nodeType":"element","tag":"code","layout":{"x":632.45,"y":1520.16,"width":191.02,"height":21.44},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"--experimental-modules","layout":{"rects":[{"x":637.89,"y":1522.88,"width":180.14,"height":16}]}}]},{"nodeType":"text","text":" flag, and older browsers like ","layout":{"rects":[{"x":823.47,"y":1520.88,"width":207.09,"height":18}]}},{"nodeType":"text","text":"Internet Explorer do not support ES modules at all. Rollup allows you to write your code using ES modules, and run your ","layout":{"rects":[{"x":151,"y":1544.88,"width":860.39,"height":18}]}},{"nodeType":"text","text":"application even in environments that do not support ES modules natively. For environments that support them, Rollup can ","layout":{"rects":[{"x":151,"y":1568.88,"width":882.97,"height":18}]}},{"nodeType":"text","text":"output optimized ES modules; for environments that don’t, Rollup can compile your code to other formats such as ","layout":{"rects":[{"x":151,"y":1592.88,"width":820.89,"height":18}]}},{"nodeType":"text","text":"CommonJS modules, AMD modules, and IIFE-style scripts. This means that you get to ","layout":{"rects":[{"x":151,"y":1616.88,"width":626.38,"height":18}]}},{"nodeType":"element","tag":"em","layout":{"x":777.38,"y":1616.88,"width":170.2,"height":18},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"write future-proof code","layout":{"rects":[{"x":777.38,"y":1616.88,"width":170.2,"height":18}]}}]},{"nodeType":"text","text":", and you also ","layout":{"rects":[{"x":947.58,"y":1616.88,"width":99.73,"height":18}]}},{"nodeType":"text","text":"get the tremendous benefits of…","layout":{"rects":[{"x":151,"y":1640.88,"width":236.06,"height":18}]}}]},{"nodeType":"element","tag":"h2","layout":{"x":151,"y":1685.88,"width":898,"height":38.19},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"Tree Shaking","layout":{"rects":[{"x":151,"y":1686.88,"width":141.25,"height":28}]}}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":1740.06,"width":898,"height":72},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"In addition to enabling the use of ES modules, Rollup also statically analyzes and optimizes the code you are importing, and ","layout":{"rects":[{"x":151,"y":1743.06,"width":889.17,"height":18}]}},{"nodeType":"text","text":"will exclude anything that isn’t actually used. This allows you to build on top of existing tools and modules without adding ","layout":{"rects":[{"x":151,"y":1767.06,"width":872.7,"height":18}]}},{"nodeType":"text","text":"extra dependencies or bloating the size of your project.","layout":{"rects":[{"x":151,"y":1791.06,"width":399.52,"height":18}]}}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":1828.06,"width":898,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"For example, with CommonJS, the ","layout":{"rects":[{"x":151,"y":1831.06,"width":251.91,"height":18}]}},{"nodeType":"element","tag":"em","layout":{"x":402.91,"y":1831.06,"width":275.28,"height":18},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"entire tool or library must be imported","layout":{"rects":[{"x":402.91,"y":1831.06,"width":275.28,"height":18}]}}]},{"nodeType":"text","text":".","layout":{"rects":[{"x":678.19,"y":1831.06,"width":4.44,"height":18}]}}]},{"nodeType":"element","tag":"pre","layout":{"x":151,"y":1868.06,"width":898,"height":130.52},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"element","tag":"code","layout":{"x":167,"y":1885.06,"width":614.09,"height":94.81},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"// import the entire utils object with CommonJS\n","layout":{"rects":[{"x":167,"y":1885.06,"width":384.84,"height":16}]}},{"nodeType":"text","text":"var utils = require('node:utils');\n","layout":{"rects":[{"x":167,"y":1904.77,"width":278.39,"height":16}]}},{"nodeType":"text","text":"var query = 'Rollup';\n","layout":{"rects":[{"x":167,"y":1924.47,"width":171.95,"height":16}]}},{"nodeType":"text","text":"// use the ajax method of the utils object\n","layout":{"rects":[{"x":167,"y":1944.17,"width":343.91,"height":16}]}},{"nodeType":"text","text":"utils.ajax('https://api.example.com?search=' + query).then(handleResponse);\n","layout":{"rects":[{"x":167,"y":1963.88,"width":614.09,"height":16}]}}]}]},{"nodeType":"element","tag":"p","layout":{"x":151,"y":2014.58,"width":898,"height":24},"computed":{"display":"block","textAlign":"start"},"children":[{"nodeType":"text","text":"But with ES modules, instead of importing the whole ","layout":{"rects":[{"x":151,"y":2017.58,"width":381.39,"height":18}]}},{"nodeType":"element","tag":"code","layout":{"x":532.39,"y":2016.86,"width":51.83,"height":21.44},"computed":{"display":"inline","textAlign":"start"},"children":[{"nodeType":"text","text":"utils","layout":{"rects":[{"x":537.83,"y":2019.58,"width":40.95,"height":16}]}}]},{"nodeType":"text","t